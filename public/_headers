/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://static.cloudflareinsights.com https://api.web3forms.com; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  ! Access-Control-Allow-Origin

# Edge compression is intentionally enabled: NO Cache-Control rule may carry
# `no-transform` (Cloudflare does not compress responses with that directive —
# it multiplied the uncompressed HTML/CSS wire payload ~2.5-4x and drove the
# Ahrefs "Slow pages" report, 2026-08-17/18). The JSD/CSP risk that motivated
# the directive (TD-0099) is now guarded by the post-deploy validation in
# docs/operations/runbooks/CSP_CLOUDFLARE_JSD_2026-08-02.md; if JavaScript
# Detections re-injects its bootstrap, restore no-transform immediately
# (rollback documented there).

# Security disclosure policy
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

# The Ko-fi cup image is served locally by the support-page button.
/apoyar/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://static.cloudflareinsights.com https://api.web3forms.com; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'

# Hashed assets (Astro build output) — cache forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

# Extensionless JPEG used by social crawlers. Keeping the URL extensionless
# avoids Cloudflare Hotlink Protection's extension-based external-referrer rule.
/og-image
  Content-Type: image/jpeg
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400
  X-Robots-Tag: noindex, nofollow

# Pagefind search bundle — keep TTL short so CSP/_headers changes propagate
# within 5 min to the worker + WASM without needing a manual cache purge.
# Rationale: CSP rules live in _headers; when the CSP changes but the
# pagefind binary doesn't, CDNs serve the old CSP from cache. Short TTL
# bounds the staleness window.
/pagefind/*
  Cache-Control: public, max-age=300

# HTML pages — browser caches 5 min; edge revalidates (no s-maxage) so deploys
# propagate within ~5 min without needing programmatic cache purge.
# Rationale: ADR-20260516 appendix. Pages auto-purge only applies to *.pages.dev,
# not to custom domains with explicit s-maxage.
# Volatile indicators page: always revalidate HTML so daily economic snapshots
# are not hidden behind long-lived browser/CDN freshness windows.
/guias/uf-costo-de-vida/indicadores-economicos/
  Cache-Control: public, max-age=300, must-revalidate

/guias/uf-costo-de-vida/indicadores-economicos/*
  Cache-Control: public, max-age=300, must-revalidate

# uf-hoy: same volatile treatment as the converters and the hub — the page's
# primary content is today's UF/dólar values. Must stay in sync with
# VOLATILE_HTML_PATHS in public/sw.js.
/uf-hoy/
  Cache-Control: public, max-age=300, must-revalidate

/api/indicadores-hoy.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

/calculadoras/*
  Cache-Control: public, max-age=300

/posts/*
  Cache-Control: public, max-age=300

/guias/*
  Cache-Control: public, max-age=300

/leyes/*
  Cache-Control: public, max-age=300

/glosario/*
  Cache-Control: public, max-age=300

/tags/*
  Cache-Control: public, max-age=300

/about
  Cache-Control: public, max-age=300

/autor
  Cache-Control: public, max-age=300

# Homepage
/
  Cache-Control: public, max-age=300
