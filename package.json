{
  "name": "monedario",
  "type": "module",
  "version": "5.5.1",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "astro dev",
    "build": "pnpm run check:images && pnpm run check:hero-images && pnpm run check:frontmatter && pnpm run check:legal-citations && astro check && astro build && pnpm run check:toc-i18n && pnpm run check:editorial-guard && pagefind --site dist && cp -r dist/pagefind public/ && pnpm run check:urls",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "check": "pnpm run check:context && pnpm run check:policy-registry && pnpm run check:docs && pnpm run check:images && pnpm run check:hero-images && pnpm run check:hero-prompts && pnpm run check:frontmatter && pnpm run check:legal-citations && pnpm run check:links && pnpm run check:editorial && pnpm run check:editorial-timeliness && pnpm run check:no-postid-urls && astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:context": "node scripts/check-context.mjs",
    "check:policy-registry": "node scripts/check-policy-registry.mjs",
    "check:docs": "node scripts/check-docs-structure.mjs",
    "check:images": "pnpm run images:convert && pnpm run og:jpegs && node scripts/check-images.mjs",
    "check:hero-images": "node scripts/check-hero-images.mjs",
    "check:hero-prompts": "node scripts/check-hero-prompts.mjs",
    "images:convert": "node scripts/png-to-avif.mjs --dir public/images/hero",
    "og:jpegs": "node scripts/generate-og-jpegs.mjs",
    "og:jpegs:force": "node scripts/generate-og-jpegs.mjs --force",
    "check:frontmatter": "node scripts/check-frontmatter.mjs",
    "check:legal-citations": "node scripts/check-legal-citations.mjs",
    "check:legal-citations:live": "node scripts/check-legal-citations.mjs --verify-bcn",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:urls": "node scripts/check-urls.mjs",
    "check:editorial-structure": "node scripts/check-editorial-structure.mjs",
    "check:dialect": "node scripts/check-dialect.mjs",
    "check:editorial-artifacts": "node scripts/check-editorial-artifacts.mjs",
    "check:editorial-timeliness": "node scripts/check-editorial-timeliness.mjs",
    "check:reader-facing-copy": "node scripts/check-reader-facing-copy.mjs",
    "check:editorial": "node scripts/check-editorial-structure.mjs && node scripts/check-dialect.mjs && node scripts/check-reader-facing-copy.mjs && node scripts/check-editorial-artifacts.mjs",
    "scaffold:editorial-artifacts": "node scripts/scaffold-editorial-artifacts.mjs",
    "audit:reader-copy": "node scripts/audit-reader-facing-copy.mjs",
    "audit:topic-overlap": "node scripts/audit-topic-overlap.mjs",
    "check:no-postid-urls": "node scripts/check-no-postid-urls.mjs",
    "routes:snapshot": "node scripts/snapshot-routes.mjs",
    "routes:compare": "node scripts/compare-routes.mjs docs/reports/routes_snapshot_before.json output/validation/routes_snapshot_after.json",
    "check:routes": "node scripts/snapshot-routes.mjs --out output/validation/routes_snapshot_after.json && pnpm run routes:compare",
    "rss:snapshot": "node scripts/rss-to-json.mjs --in dist/rss.xml --out docs/reports/rss_snapshot.json",
    "rss:compare": "node scripts/compare-rss.mjs docs/reports/rss_snapshot.json output/validation/rss_snapshot_after.json",
    "check:rss": "node scripts/rss-to-json.mjs --in dist/rss.xml --out output/validation/rss_snapshot_after.json && pnpm run rss:compare",
    "perf:ci": "lhci collect --config=lighthouserc.cjs && lhci assert --config=lighthouserc.cjs",
    "check:boundaries": "node scripts/check-domain-boundaries.mjs",
    "check:toc-i18n": "node scripts/check-toc-i18n.mjs",
    "check:editorial-guard": "node scripts/check-editorial-guard.mjs",
    "economic:snapshot:refresh": "node scripts/refresh-economic-snapshot.mjs",
    "data-signals:gsc": "node scripts/data-signals/gsc-fetch.mjs",
    "data-signals:cloudflare": "node scripts/data-signals/cloudflare-fetch.mjs",
    "editorial:volatile-data:refresh": "node scripts/refresh-editorial-volatile-data.mjs",
    "editorial:review-policies:compute": "node scripts/compute-review-policies.mjs",
    "check:afp-commissions": "node scripts/check-afp-commissions.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "astro sync && eslint .",
    "check:urls:ci": "URLCHECK_MODE=ci node scripts/check-urls.mjs",
    "check:urls:canary": "node scripts/check-urls.mjs --canary && node scripts/check-urls-external.mjs --canary",
    "check:urls:external:ci": "node scripts/check-urls-external.mjs --ci",
    "check:urls:external:audit": "node scripts/check-urls-external.mjs --audit",
    "check:urls:baseline:update": "node scripts/check-urls.mjs --update-baseline --allow-baseline-update",
    "images:build-prompts": "node scripts/hero-images/build-prompts.mjs",
    "images:generate": "node scripts/hero-images/manual-only.mjs images:generate",
    "images:generate:force": "node scripts/hero-images/manual-only.mjs images:generate:force",
    "images:generate:one": "node scripts/hero-images/manual-only.mjs images:generate:one",
    "images:generate:cluster": "node scripts/hero-images/manual-only.mjs images:generate:cluster",
    "images:generate:retry": "node scripts/hero-images/manual-only.mjs images:generate:retry",
    "codacy:lint:clean": "bash scripts/codacy-eslint-clean.sh"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/react": "^5.0.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^6.3.2",
    "dayjs": "^1.11.20",
    "lodash.kebabcase": "^4.1.1",
    "node-fetch": "^3.3.2",
    "openai": "^6.36.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.13",
      "picomatch@4.0.3": "4.0.4",
      "fast-uri": "3.1.2",
      "fast-xml-builder": "1.1.9",
      "tmp": "0.2.5",
      "yaml": "2.8.4"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@pagefind/default-ui": "^1.5.2",
    "@playwright/test": "^1.59.1",
    "@shikijs/transformers": "^4.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.3.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.6.0",
    "js-yaml": "^4.1.1",
    "linkinator": "^7.6.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sitemap": "^9.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  }
}
