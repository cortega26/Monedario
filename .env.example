# ─────────────────────────────────────────────────────────────────────────────
# Monedario — local environment template
# Copy to .env and keep out of version control (.gitignore already excludes it).
# Agents: read context/AGENT_PREFLIGHT.md before editing runtime behaviour.
# ─────────────────────────────────────────────────────────────────────────────

# ── Economic data provider ───────────────────────────────────────────────────
# Controls how economic parameters (UF, UTM, TMC, AFC caps) are sourced.
#   snapshot  → reads src/infrastructure/economic/economic-parameters.snapshot.json
#               Deterministic, no network required. Use for CI and local agent work.
#   live      → fetches from https://mindicador.cl/api at build/SSR time.
#               Requires network. Adds latency. Not recommended for agent sessions.
# Affects: pnpm run check:editorial-timeliness, pnpm run economic:snapshot:refresh
TPI_ECONOMIC_PROVIDER_MODE=snapshot

# ── Hero image generation (manual pipeline only) ─────────────────────────────
# Used by scripts/hero-images/pipeline.mjs (OpenAI DALL·E generation).
# Not required for check, test, lint, or build gates.
# OPENAI_API_KEY=

# ── Hero image generation via ChatGPT browser automation ────────────────────
# Used by scripts/hero-images/generate-pool-chatgpt.mjs.
# All of these are optional overrides; defaults shown on the right.
# CHROME_CDP_URL=http://127.0.0.1:9222
# CHATGPT_IMAGES_URL=https://chatgpt.com/images
# CHATGPT_IMAGE_TIMEOUT_MS=180000
# CHATGPT_IMAGE_DELAY_MS=2500
# CHATGPT_IMAGE_MAX_FAILURES=5
# CHATGPT_IMAGE_MAX_ATTEMPTS_PER_ITEM=3
# CHATGPT_IMAGE_RETRY_BASE_DELAY_MS=8000
# CHATGPT_IMAGE_RETRY_MAX_DELAY_MS=120000
# CHATGPT_IMAGE_BACKOFF_FACTOR=2
# CHATGPT_IMAGE_BACKOFF_JITTER_MS=1200
# CHATGPT_IMAGE_OUTPUT_FORMAT=avif

# ── Editorial gate overrides (CI / selective audit use) ──────────────────────
# EDITORIAL_SCOPE=all            # Values: all | changed
#                                # Scopes check:reader-facing-copy to changed files only.
# EDITORIAL_DIFF_BASE_REF=       # Git ref for diff base (e.g. main). Used with EDITORIAL_SCOPE=changed.
# EDITORIAL_ENFORCE=0            # Set to 1 to run check:editorial-artifacts in strict/blocking mode.
# EDITORIAL_TIMELINESS_ROOT=     # Absolute path override for the repo root in timeliness checks.
# EDITORIAL_TIMELINESS_TODAY=    # ISO date override for "today" in timeliness checks (e.g. 2026-04-15).

# ── Hero prompt gate override ────────────────────────────────────────────────
# HERO_PROMPTS_STRICT_FALLBACK=0 # Set to 1 to fail check:hero-prompts on any fallback sceneId.
#                                # Keep warn-first during rollout; promote to 1 only when fallback warnings are intentionally resolved.

# ── Domain boundary gate overrides ───────────────────────────────────────────
# DOMAIN_BOUNDARY_ROOT=          # Absolute path override for the boundary checker root.
# DOMAIN_BOUNDARY_MIN_FILES=2    # Minimum files required to count a boundary violation.

# ── Small-details gate mode ────────────────────────────────────────────────
# SMALL_DETAILS_ENFORCE=0        # Values: 0 (warn-only, local default) | 1 (blocking).
#                                # Read by scripts/check-small-details.mjs (ENFORCE flag).
#                                # Local `pnpm run check:ci` stays warn-only; strict runs
#                                # (incl. CI per AGENTS.md) set it to 1.
#                                # Strict run: `pnpm run check:small-details:enforce`.

# ── URL checker mode ───────────────────────────────────────────────────────
# URLCHECK_MODE=                 # Values: empty (local mode) | ci (CI mode).
#                                # Read by scripts/check-urls.mjs (forcedMode).
#                                # `pnpm run check:urls:ci` sets URLCHECK_MODE=ci.
#                                # Local mode targets a built/preview site; needs network.

# ── Dev pages in builds ────────────────────────────────────────────────────
# BUILD_DEV_PAGES=               # Values: empty (dev pages excluded from builds) | 1 (included).
#                                # Read by astro.config.ts. `/dev/*` tools load under
#                                # `pnpm run dev` always; set to 1 only for a diagnostic
#                                # build (`BUILD_DEV_PAGES=1 pnpm run build`).

# ── Worker secrets (names only — never commit values) ─────────────────────
# Set with `wrangler secret put <NAME> --config workers/<worker>/wrangler.toml`
# (or the Cloudflare dashboard). Full contract: each worker's README + `Env`.
#   analytics-collector:       EXPORT_SECRET (optional export gate)
#   economic-snapshot-refresh: GITHUB_TOKEN, TRIGGER_SECRET, BCCH_USER, BCCH_PASSWORD (BCCh pair optional)
