---
import { getPath } from "@/utils/getPath";

type Props = {
  location?: string;
  aboutHref?: string;
};

const {
  location = "calculator_header",
  aboutHref = "/metodologia/#metodologia",
} = Astro.props as Props;
---

<aside
  class="app-layout mt-5 rounded-lg border border-border bg-surface-muted/40 px-4 py-3"
  aria-label="Privacidad y confianza de la calculadora"
>
  <div
    class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="text-sm leading-relaxed text-secondary">
      Las fórmulas de esta calculadora están cubiertas por pruebas automáticas.
      El cálculo corre en tu navegador. No guardamos los datos que ingresas ni
      los enviamos a un servidor. Solo contamos interacciones en categorías
      agregadas, sin montos ni resultados.
    </p>
    <a
      href={getPath(aboutHref)}
      class="shrink-0 text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
      data-analytics-cta="calculator-trust-link"
      data-analytics-label="Proceso editorial y privacidad"
      data-analytics-location={location}
    >
      Ver proceso editorial
    </a>
  </div>
</aside>
