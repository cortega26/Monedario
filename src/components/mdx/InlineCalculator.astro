---
/**
 * InlineCalculator — mini-calculadora de interés compuesto para embeber en artículos MDX.
 *
 * Props:
 * - title: string (título opcional)
 * - initialLabel: string (etiqueta para capital inicial, default "Capital inicial")
 * - monthlyLabel: string (etiqueta para aporte mensual, default "Aporte mensual")
 * - rateLabel: string (etiqueta para tasa de interés, default "Tasa de interés anual")
 * - yearsLabel: string (etiqueta para años, default "Años")
 * - defaultInitial: number (valor por defecto capital inicial)
 * - defaultMonthly: number (valor por defecto aporte mensual)
 * - defaultRate: number (valor por defecto tasa anual en %)
 * - defaultYears: number (valor por defecto años)
 *
 * Uso en MDX:
 *   import InlineCalculator from "@/components/mdx/InlineCalculator.astro";
 *
 *   <InlineCalculator
 *     title="Simula tu propio escenario"
 *     defaultInitial={1000000}
 *     defaultMonthly={50000}
 *     defaultRate={12}
 *     defaultYears={10}
 *   />
 *
 * La calculadora usa vanilla JS (sin React) para la interactividad cliente.
 * Los valores por defecto se renderizan en SSR y el JS cliente actualiza el resultado.
 */

interface Props {
  title?: string;
  initialLabel?: string;
  monthlyLabel?: string;
  rateLabel?: string;
  yearsLabel?: string;
  defaultInitial?: number;
  defaultMonthly?: number;
  defaultRate?: number;
  defaultYears?: number;
}

const {
  title = "Calculadora rápida",
  initialLabel = "Capital inicial ($)",
  monthlyLabel = "Aporte mensual ($)",
  rateLabel = "Rentabilidad anual (%)",
  yearsLabel = "Años",
  defaultInitial = 0,
  defaultMonthly = 0,
  defaultRate = 10,
  defaultYears = 10,
} = Astro.props;

const id = `inline-calc-${crypto.randomUUID().slice(0, 8)}`;

function formatCLP(n: number): string {
  return "$" + Math.round(n).toLocaleString("es-CL");
}

function calculateCompoundInterest(
  initial: number,
  monthly: number,
  rate: number,
  years: number
): { finalAmount: number; totalContributions: number; totalInterest: number } {
  if (years <= 0) return { finalAmount: initial, totalContributions: 0, totalInterest: 0 };

  const monthlyRate = rate / 100 / 12;
  const totalMonths = years * 12;
  let balance = initial;

  for (let i = 0; i < totalMonths; i++) {
    balance += monthly;
    balance *= 1 + monthlyRate;
  }

  const totalContributions = initial + monthly * totalMonths;
  const totalInterest = balance - totalContributions;

  return {
    finalAmount: balance,
    totalContributions,
    totalInterest,
  };
}

const initialResult = calculateCompoundInterest(
  defaultInitial,
  defaultMonthly,
  defaultRate,
  defaultYears
);
---

<div
  id={id}
  class="inline-calculator my-6 rounded-xl border border-border bg-surface-muted p-5 not-prose"
>
  {title && (
    <p class="mb-4 text-sm font-semibold text-accent">{title}</p>
  )}

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <label class="flex flex-col gap-1 text-xs text-muted">
      {initialLabel}
      <input
        type="number"
        data-calc-field="initial"
        value={defaultInitial}
        min="0"
        class="rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground"
      />
    </label>

    <label class="flex flex-col gap-1 text-xs text-muted">
      {monthlyLabel}
      <input
        type="number"
        data-calc-field="monthly"
        value={defaultMonthly}
        min="0"
        class="rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground"
      />
    </label>

    <label class="flex flex-col gap-1 text-xs text-muted">
      {rateLabel}
      <input
        type="number"
        data-calc-field="rate"
        value={defaultRate}
        min="0"
        max="100"
        step="0.1"
        class="rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground"
      />
    </label>

    <label class="flex flex-col gap-1 text-xs text-muted">
      {yearsLabel}
      <input
        type="number"
        data-calc-field="years"
        value={defaultYears}
        min="1"
        max="80"
        class="rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground"
      />
    </label>
  </div>

  <div
    class="mt-4 grid grid-cols-1 gap-3 rounded-lg border border-accent/20 bg-accent/5 p-4 sm:grid-cols-3"
    data-calc-results
  >
    <div class="text-center">
      <p class="text-xs text-muted">Monto final</p>
      <p class="text-lg font-bold text-accent" data-calc-final>
        {formatCLP(initialResult.finalAmount)}
      </p>
    </div>
    <div class="text-center">
      <p class="text-xs text-muted">Total aportado</p>
      <p class="text-lg font-bold text-foreground" data-calc-contributions>
        {formatCLP(initialResult.totalContributions)}
      </p>
    </div>
    <div class="text-center">
      <p class="text-xs text-muted">Interés generado</p>
      <p class="text-lg font-bold text-foreground" data-calc-interest>
        {formatCLP(initialResult.totalInterest)}
      </p>
    </div>
  </div>

  <p class="mt-3 text-xs text-muted">
    Los valores son nominales, no consideran inflación ni impuestos.
  </p>
</div>

<script>
  (function () {
    const container: HTMLElement | null = document.currentScript
      ? (document.currentScript.parentElement as HTMLElement)
      : null;
    if (!container) return;

    const initialInput = container.querySelector("[data-calc-field='initial']") as HTMLInputElement | null;
    const monthlyInput = container.querySelector("[data-calc-field='monthly']") as HTMLInputElement | null;
    const rateInput = container.querySelector("[data-calc-field='rate']") as HTMLInputElement | null;
    const yearsInput = container.querySelector("[data-calc-field='years']") as HTMLInputElement | null;

    if (!initialInput || !monthlyInput || !rateInput || !yearsInput) return;

    const finalEl = container.querySelector("[data-calc-final]") as HTMLElement | null;
    const contribEl = container.querySelector("[data-calc-contributions]") as HTMLElement | null;
    const interestEl = container.querySelector("[data-calc-interest]") as HTMLElement | null;

    if (!finalEl || !contribEl || !interestEl) return;

    const safeInitial = initialInput!;
    const safeMonthly = monthlyInput!;
    const safeRate = rateInput!;
    const safeYears = yearsInput!;
    const safeFinal = finalEl!;
    const safeContrib = contribEl!;
    const safeInterest = interestEl!;

    function formatCLP(n: number): string {
      return "$" + Math.round(n).toLocaleString("es-CL");
    }

    function calculate(): void {
      const initial = parseFloat(safeInitial.value) || 0;
      const monthly = parseFloat(safeMonthly.value) || 0;
      const rate = parseFloat(safeRate.value) || 0;
      const years = parseFloat(safeYears.value) || 0;

      if (years <= 0) {
        safeFinal.textContent = formatCLP(initial);
        safeContrib.textContent = formatCLP(initial);
        safeInterest.textContent = formatCLP(0);
        return;
      }

      const monthlyRate = rate / 100 / 12;
      const totalMonths = years * 12;
      let balance = initial;

      for (let i = 0; i < totalMonths; i++) {
        balance += monthly;
        balance *= 1 + monthlyRate;
      }

      const totalContributions = initial + monthly * totalMonths;
      const totalInterest = balance - totalContributions;

      safeFinal.textContent = formatCLP(balance);
      safeContrib.textContent = formatCLP(totalContributions);
      safeInterest.textContent = formatCLP(totalInterest);
    }

    // Attach event listeners
    const inputs = [safeInitial, safeMonthly, safeRate, safeYears];
    for (const input of inputs) {
      input.addEventListener("input", calculate);
      input.addEventListener("change", calculate);
    }
  })();
</script>
