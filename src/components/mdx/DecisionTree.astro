---
/**
 * DecisionTree — mini-árbol de decisión para embeber en artículos MDX.
 *
 * Props:
 * - steps: array de pasos, donde cada paso tiene:
 *     - question: string (pregunta)
 *     - options: array de { label, next, result? }
 *       - next: índice del siguiente paso (-1 = fin)
 *       - result?: { title, description, emoji? } (opcional si next=-1)
 * - title: string (título opcional del widget)
 *
 * Renderiza un árbol de decisión paso a paso con vanilla JS.
 *
 * Uso en MDX:
 *   import DecisionTree from "@/components/mdx/DecisionTree.astro";
 *
 *   <DecisionTree
 *     title="¿Qué régimen APV te conviene?"
 *     steps={[
 *       {
 *         question: "¿Tu tasa marginal efectiva es mayor o menor a 15%?",
 *         options: [
 *           { label: "Mayor a 15%", next: -1, result: { title: "Régimen B", description: "La rebaja de base imponible suele ser más beneficiosa.", emoji: "📉" } },
 *           { label: "15% o menor", next: -1, result: { title: "Régimen A", description: "La bonificación estatal del 15% suele ser mejor.", emoji: "💰" } },
 *         ]
 *       }
 *     ]}
 *   />
 */

interface DecisionOption {
  label: string;
  next: number;
  result?: {
    title: string;
    description: string;
    emoji?: string;
  };
}

interface DecisionStep {
  question: string;
  options: DecisionOption[];
}

interface Props {
  steps: DecisionStep[];
  title?: string;
}

const { steps, title } = Astro.props;
const id = `decision-tree-${crypto.randomUUID().slice(0, 8)}`;
const stepsJson = JSON.stringify(steps);
---

<div
  id={id}
  class="decision-tree my-6 rounded-xl border border-border bg-surface-muted p-5 not-prose"
  data-dt-config={stepsJson}
>
  {title && (
    <p class="mb-3 text-sm font-semibold text-accent">{title}</p>
  )}

  <div data-dt-step="0" class="dt-step">
    <p class="mb-3 text-base font-semibold" data-dt-question></p>
    <div class="flex flex-col gap-2" data-dt-options></div>
  </div>

  <div data-dt-result class="hidden dt-result">
    <div class="rounded-lg border border-accent/20 bg-accent/5 p-4">
      <p class="text-lg" data-dt-result-emoji></p>
      <p class="text-base font-bold" data-dt-result-title></p>
      <p class="mt-1 text-sm text-secondary" data-dt-result-desc></p>
    </div>
    <button
      type="button"
      class="dt-restart mt-4 cursor-pointer rounded-lg border border-border bg-background px-4 py-2 text-sm transition-opacity hover:opacity-80"
    >
      Volver a empezar
    </button>
  </div>
</div>

<script>
  (function () {
    const container: HTMLElement | null = document.currentScript
      ? (document.currentScript.parentElement as HTMLElement)
      : null;
    if (!container) return;

    const configRaw: string | null = container.getAttribute("data-dt-config");
    if (!configRaw) return;

    let steps: any[];
    try {
      steps = JSON.parse(configRaw) as any[];
    } catch {
      return;
    }
    if (!steps || steps.length === 0) return;

    const stepView: HTMLElement | null = container.querySelector("[data-dt-step]");
    const questionEl: HTMLElement | null = container.querySelector("[data-dt-question]");
    const optionsEl: HTMLElement | null = container.querySelector("[data-dt-options]");
    const resultView: HTMLElement | null = container.querySelector("[data-dt-result]");
    const resultEmoji: HTMLElement | null = container.querySelector("[data-dt-result-emoji]");
    const resultTitle: HTMLElement | null = container.querySelector("[data-dt-result-title]");
    const resultDesc: HTMLElement | null = container.querySelector("[data-dt-result-desc]");
    const restartBtn: HTMLElement | null = container.querySelector(".dt-restart");

    if (!stepView || !questionEl || !optionsEl || !resultView || !restartBtn) return;
    if (!resultEmoji || !resultTitle || !resultDesc) return;

    // Non-null-asserted aliases for use in closure functions
    const safeQuestion = questionEl!;
    const safeOptions = optionsEl!;
    const safeStepView = stepView!;
    const safeResultView = resultView!;
    const safeResultEmoji = resultEmoji!;
    const safeResultTitle = resultTitle!;
    const safeResultDesc = resultDesc!;
    const safeRestartBtn = restartBtn!;

    function renderStep(index: number): void {
      const step: any = steps[index];
      if (!step) return;

      safeQuestion.textContent = step.question;
      safeOptions.innerHTML = "";

      for (const opt of step.options) {
        const btn: HTMLButtonElement = document.createElement("button");
        btn.textContent = opt.label;
        btn.className =
          "dt-option cursor-pointer rounded-lg border border-border bg-background px-4 py-2 text-left text-sm transition-colors hover:border-accent hover:bg-accent/5";
        btn.addEventListener("click", function () {
          goToStep(opt.next, opt.result);
        });
        safeOptions.appendChild(btn);
      }

      safeStepView.classList.remove("hidden");
      safeResultView.classList.add("hidden");
    }

    function showResult(result: any): void {
      safeStepView.classList.add("hidden");
      safeResultView.classList.remove("hidden");

      safeResultEmoji.textContent = result.emoji || "";
      safeResultTitle.textContent = result.title;
      safeResultDesc.textContent = result.description;
    }

    function goToStep(next: number, result?: any): void {
      if (next === -1 && result) {
        showResult(result);
      } else if (next >= 0 && next < steps.length) {
        renderStep(next);
      }
    }

    safeRestartBtn.addEventListener("click", function () {
      renderStep(0);
    });

    // Render initial step
    renderStep(0);
  })();
</script>
