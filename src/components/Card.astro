---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getCanonicalPathFromSlug } from "@/domain/content/path";
import { getReadingTime } from "@/utils/readingTime";
import { resolveEditorialImage } from "@/utils/editorialImages";
import Datetime from "./Datetime.astro";
import ArticlePlaceholder from "./ArticlePlaceholder.astro";

type Props = {
  variant?: "h2" | "h3";
  earlyLoad?: boolean;
  showImage?: boolean;
} & CollectionEntry<"blog">;

const {
  variant: Heading = "h2",
  earlyLoad = false,
  showImage = true,
  data,
  body,
} = Astro.props;
const { title, description, tags, ogImage, ...props } = data;
const href = getCanonicalPathFromSlug(data.slug);
const firstTag = tags?.[0] ?? "";
const image = resolveEditorialImage(data.slug, ogImage);
const readingTime = getReadingTime(body ?? "");
---

<li class="card group my-4 rounded-xl border border-border p-5">
  <!-- Miniatura + Título -->
  <a
    href={href}
    class="transition-colors group-hover:text-accent"
    data-image-version={showImage ? image?.version : undefined}
    data-image-article={showImage && image ? data.slug : undefined}
    data-image-surface={showImage && image ? "article_card" : undefined}
  >
    <div class="mb-3 overflow-hidden rounded-lg">
      {
        image && showImage ? (
          <img
            src={image.src}
            alt=""
            width="1200"
            height="630"
            srcset={image.srcset}
            sizes="auto, (min-width: 1280px) 340px, (min-width: 768px) 45vw, calc(100vw - 4rem)"
            class="aspect-[40/21] w-full object-cover"
            loading={earlyLoad ? "eager" : "lazy"}
            fetchpriority={earlyLoad ? "high" : undefined}
            decoding={earlyLoad ? "sync" : "async"}
          />
        ) : (
          <ArticlePlaceholder tag={firstTag} />
        )
      }
    </div>
    <Heading
      class="card-heading mb-1 text-lg leading-snug font-semibold text-foreground transition-colors group-hover:text-accent"
      style={{
        viewTransitionName: slugifyStr(title.replaceAll(".", "-")),
      }}
    >
      {title}
    </Heading>
  </a>

  <!-- Fecha -->
  <div class="mb-2">
    <Datetime {...props} readingTime={readingTime} />
  </div>

  <!-- Descripción -->
  <p class="text-sm leading-relaxed text-secondary">{description}</p>
</li>

<style>
  .card-heading {
    font-family: var(--font-body);
  }

  .card {
    transition:
      box-shadow 0.2s ease,
      border-top-color 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
      border-top-color: var(--color-accent-2);
    }
  }
</style>
