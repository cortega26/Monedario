---
type Props = {
  slug: string;
};

const { slug } = Astro.props;
---

<section
  data-next-best-step
  data-calculator-slug={slug}
  aria-label="Próximos pasos sugeridos"
  style="content-visibility: auto; contain-intrinsic-size: 200px;"
>
</section>

<script>
  import "@/scripts/next-best-step";
</script>
