---
import { getCollection } from "astro:content";
import { getPath } from "@/utils/getPath";

interface Props {
  headline?: string;
  description?: string;
}

const {
  headline = "Entiende tu plata en Chile — guías, calculadoras y herramientas",
  description = "Sueldo líquido, AFP, impuestos, crédito, UF y presupuesto en lenguaje claro. Sin publicidad. Sin registro.",
} = Astro.props;

const ctaLinks = [
  {
    label: "💵 Sueldo líquido",
    href: "/calculadoras/sueldo-liquido/",
    secondary: false,
  },
  {
    label: "📄 Finiquito",
    href: "/calculadoras/finiquito-indemnizacion/",
    secondary: false,
  },
  {
    label: "📐 Conversor UF",
    href: "/calculadoras/conversor-uf/",
    secondary: true,
  },
  {
    label: "🔍 ¿Estoy en DICOM?",
    href: "/posts/donde-ver-si-estoy-en-dicom-gratis/",
    secondary: true,
  },
];

// Fecha automática: máximo de updatedDate / pubDate entre todos los posts publicados.
// Se usa la parte de fecha en UTC (YYYY-MM-DD del ISO string) para evitar que el offset
// de Santiago (UTC-4 en otoño) retroceda la fecha en medianoche UTC.
const publishedPosts = await getCollection(
  "blog",
  ({ data }) => !data.draft && !data.unlisted
);
const latestDate = publishedPosts.reduce<Date>((max, post) => {
  const d = post.data.updatedDate ?? post.data.pubDate;
  return d > max ? d : max;
}, new Date(0));
const [ly, lm, ld] = latestDate
  .toISOString()
  .slice(0, 10)
  .split("-")
  .map(Number);
const latestDateLabel = new Date(ly, lm - 1, ld).toLocaleDateString("es-CL", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const trustSignals: Array<string | { label: string; href: string }> = [
  "Sin publicidad",
  "Fuentes oficiales",
  "Sin registro requerido",
  "Legislación chilena vigente",
  {
    label: `Actualizado al ${latestDateLabel}`,
    href: "/cambios/",
  },
];
---

<div class="max-w-3xl">
  <h1
    class="homepage-body-heading mb-3 max-w-3xl text-2xl leading-tight font-bold sm:text-4xl"
    style="font-family: var(--font-body);"
  >
    {headline}
  </h1>
  <p
    class="mb-5 max-w-3xl text-base leading-relaxed text-foreground"
    style="font-family: system-ui, sans-serif;"
  >
    {description}
  </p>

  <!-- 4 CTAs directos -->
  <div class="mb-5 flex flex-wrap gap-2 sm:gap-3">
    {
      ctaLinks.map(link => (
        <a
          href={getPath(link.href)}
          class:list={[
            "rounded-lg px-4 py-2 text-sm font-semibold transition-opacity hover:opacity-85",
            link.secondary
              ? "border border-border bg-surface-muted/40 text-foreground"
              : "bg-accent text-background",
          ]}
          data-analytics-cta="home-hero-cta"
          data-analytics-label={link.label}
          data-analytics-location="home_hero"
        >
          {link.label}
        </a>
      ))
    }
  </div>

  <!-- Señales de confianza -->
  <ul
    class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted"
    aria-label="Características del sitio"
  >
    {
      trustSignals.map((signal, i) => (
        <>
          <li>
            {typeof signal === "string" ? (
              signal
            ) : (
              <a
                href={getPath(signal.href)}
                class="underline underline-offset-2 transition-colors hover:text-foreground"
              >
                {signal.label}
              </a>
            )}
          </li>
          {i < trustSignals.length - 1 && (
            <li aria-hidden="true" class="hidden sm:inline">
              ·
            </li>
          )}
        </>
      ))
    }
  </ul>
</div>
