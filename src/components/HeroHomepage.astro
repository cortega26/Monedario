---
import { getCollection } from "astro:content";
import { getPath } from "@/utils/getPath";

interface Props {
  headline?: string;
  description?: string;
}

const {
  headline = "Decisiones de plata en Chile, basadas en matemáticas y la ley vigente",
  description = "Sueldo, AFP, impuestos, crédito, UF y presupuesto. Sin opinión, sin gurú, sin conflicto de interés: fórmulas verificables y fuentes oficiales.",
} = Astro.props;

const ctaLinks = [
  {
    label: "Calcular sueldo líquido",
    href: "/calculadoras/sueldo-liquido/",
  },
  {
    label: "Simular finiquito",
    href: "/calculadoras/finiquito-indemnizacion/",
  },
  {
    label: "Convertir UF",
    href: "/calculadoras/conversor-uf/",
  },
  {
    label: "¿Estoy en DICOM?",
    href: "/posts/donde-ver-si-estoy-en-dicom-gratis/",
  },
];

// Fecha automática: máximo de updatedDate / pubDate entre todos los posts publicados.
const publishedPosts = await getCollection(
  "blog",
  ({ data }) => !data.draft && !data.unlisted
);
const latestDate = publishedPosts.reduce<Date>((max, post) => {
  const d = post.data.updatedDate ?? post.data.pubDate;
  return d > max ? d : max;
}, new Date(0));
const [ly, lm, ld] = latestDate
  .toISOString()
  .slice(0, 10)
  .split("-")
  .map(Number);
const latestDateLabel = new Date(ly, lm - 1, ld).toLocaleDateString("es-CL", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Partir el headline en partes para subrayar "plata"
const headlineParts = headline.split("plata");
---

<div class="max-w-3xl">
  <!-- H1 en Fraunces — fuente display editorial -->
  <h1
    class="homepage-body-heading mb-3 max-w-3xl text-3xl leading-tight font-bold sm:text-5xl"
    style="font-family: var(--font-display); line-height: 1.05;"
  >
    {headlineParts[0]}<span class="italic">plata</span>{headlineParts[1]}
  </h1>

  <p class="mb-6 max-w-2xl text-sm leading-relaxed text-secondary sm:text-base">
    {description}
  </p>

  <!-- CTAs como links editoriales con dashed underline -->
  <nav aria-label="Calculadoras principales" class="mb-6">
    <ul class="divide-y divide-border border-y border-border">
      {
        ctaLinks.map(link => (
          <li>
            <a
              href={getPath(link.href)}
              class="group -mx-2 flex items-center justify-between rounded px-2 py-2.5 text-sm transition-colors hover:bg-accent/5"
              data-analytics-cta="home-hero-cta"
              data-analytics-label={link.label}
              data-analytics-location="home_hero"
            >
              <span class="text-foreground underline decoration-border decoration-dashed underline-offset-2 transition-colors group-hover:text-accent group-hover:decoration-accent">
                {link.label}
              </span>
              <span
                class="text-muted transition-colors group-hover:text-accent"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- Nota editorial en cursiva — una sola línea, no chips -->
  <p
    class="text-xs text-muted italic"
    style="font-family: var(--font-display);"
  >
    Sin publicidad, sin registro requerido, sin recolección de datos. Fuentes
    oficiales.{" "}
    <a
      href={getPath("/cambios/")}
      class="underline decoration-dashed underline-offset-2 transition-colors hover:text-secondary"
    >
      Última actualización: {latestDateLabel}.
    </a>
  </p>
</div>
