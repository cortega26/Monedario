---
import { serializeJsonLd } from "@/utils/serializeJsonLd";
/**
 * Breadcrumbs robustos para deploy bajo dominio raíz o subpath sin duplicar base.
 * - No usa BASE/RAW_BASE.
 * - Stripea el basePath de Astro.site para el cálculo de segmentos.
 * - Construye hrefs acumulados correctos (no por segmento suelto).
 * - Labels (display) separados del href real.
 * - Acepta `tags` para mostrar hub contextual en artículos.
 *
 * Nota TS: Astro.site es URL | undefined. Usamos fallback seguro para evitar error de tipos.
 */
import { getPath } from "@/utils/getPath";
import { getHubFromTags } from "@/config/tagHubMap";
import { getHubFromCluster } from "@/config/clusters";

type Props = {
  tags?: string[];
  cluster?: string;
};

const { tags, cluster } = Astro.props;

const SITE_URL = Astro.site ?? new URL("http://localhost");

// Remove trailing slash from pathname (except keep "/" as "/")
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

// basePath: "" / "/" en dominio raíz, o "/subpath" si el deploy lo requiere
const basePath = SITE_URL.pathname.replace(/\/+$/, "");

// Remove basePath from pathname to get the "site-local" path
const normalizedPath =
  basePath && currentUrlPath.startsWith(basePath)
    ? currentUrlPath.slice(basePath.length) || "/"
    : currentUrlPath;

// Segments without base (e.g. "/tags/afp/2" -> ["tags","afp","2"])
const segments = normalizedPath.split("/").filter(Boolean);

// Crumbs with cumulative hrefs (WITHOUT leading slash so new URL resolves relative to SITE_URL)
const crumbs = segments.map((seg, i) => ({
  seg,
  href: segments.slice(0, i + 1).join("/") + "/",
}));

const routeLabels: Record<string, string> = {
  about: "Nosotros",
  archives: "Archivo",
  autor: "Autor",
  calculadoras: "Calculadoras",
  leyes: "Leyes",
  glosario: "Glosario",
  posts: "Artículos",
  buscar: "Buscar",
  search: "Buscar",
  tags: "Etiquetas",
};

// Labels only for display (do not use for href building)
const labels = crumbs.map(c => {
  const decoded = decodeURIComponent(c.seg);
  const mapped = routeLabels[decoded];
  return mapped ? mapped : decoded.replace(/-/g, " ");
});

// Display tweaks
if (segments[0] === "posts") {
  const page = Number(segments[1]);
  if (!Number.isNaN(page)) labels.splice(0, 2, `Artículos (página ${page})`);
  else labels.splice(0, 1, "Artículos");
}

if (segments[0] === "tags" && !isNaN(Number(segments[2]))) {
  const page = Number(segments[2]);
  labels.splice(
    1,
    3,
    `${segments[1]} ${page === 1 ? "" : `(página ${segments[2]})`}`.trim()
  );
}

// Contextual hub: for article pages, replace "Artículos" crumb with the matched hub.
// Canonical cluster → hub (GUIDE_HUBS) is preferred; tagHubMap is the fallback for
// posts without a hub cluster, keeping breadcrumbs aligned with the guide hubs.
const isArticlePage = segments[0] === "posts" && segments.length === 2;
const hub = isArticlePage
  ? (getHubFromCluster(cluster) ?? (tags ? getHubFromTags(tags) : null))
  : null;

if (hub) {
  labels[0] = hub.label;
}

const breadcrumbItems = [
  {
    "@type": "ListItem",
    position: 1,
    name: "Inicio",
    item: new URL(getPath("/"), Astro.site ?? Astro.url.origin).href,
  },
  ...crumbs.map((crumb, index) => ({
    "@type": "ListItem",
    position: index + 2,
    name: labels[index],
    item: new URL(
      getPath(index === 0 && hub ? hub.href : crumb.href),
      Astro.site ?? Astro.url.origin
    ).href,
  })),
];
---

{
  breadcrumbItems.length > 1 && (
    <script
      type="application/ld+json"
      is:inline
      set:html={serializeJsonLd({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbItems,
      })}
    />
  )
}
<nav class="app-layout mt-8 mb-1" aria-label="Migas de pan">
  <ul class="font-light [&>li]:inline">
    <li>
      <a
        href={getPath("/")}
        class="text-secondary underline decoration-border underline-offset-4 transition-colors hover:text-foreground hover:decoration-foreground"
      >
        Inicio
      </a>
      {
        crumbs.length > 0 ? (
          <span aria-hidden="true" class="inline-block text-muted">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="inline-block align-middle"
            >
              <>
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M9 6l6 6l-6 6" />
              </>
            </svg>
          </span>
        ) : null
      }
    </li>

    {
      crumbs.map((crumb, index) =>
        index + 1 === crumbs.length ? (
          <li>
            <span class="text-muted" aria-current="page">
              {labels[index]}
            </span>
          </li>
        ) : (
          <li>
            <a
              href={getPath(index === 0 && hub ? hub.href : crumb.href)}
              class="text-secondary underline decoration-border underline-offset-4 transition-colors hover:text-foreground hover:decoration-foreground"
            >
              {labels[index]}
            </a>
            <span aria-hidden="true" class="inline-block text-muted">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="inline-block align-middle"
              >
                <>
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M9 6l6 6l-6 6" />
                </>
              </svg>
            </span>
          </li>
        )
      )
    }
  </ul>
</nav>
