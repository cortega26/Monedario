---
import { serializeJsonLd } from "@/utils/serializeJsonLd";
/**
 * ArticleJsonLd.astro
 *
 * Emits JSON-LD structured data for a blog post:
 *   1. BlogPosting (Article) — full E-E-A-T compliant
 *   2. FAQPage — auto-extracted when the post contains a ## Preguntas frecuentes section
 *
 * BreadcrumbList is emitted by Breadcrumb.astro so article pages keep one
 * contextual breadcrumb schema.
 *
 * Usage: <ArticleJsonLd {post} canonicalUrl={...} ogImageUrl={...} />
 */
import type { CollectionEntry } from "astro:content";
import { SITE } from "@/config";
import { buildAuthorEntity, buildReview } from "@/utils/articleStructuredData";

export interface Props {
  post: CollectionEntry<"blog">;
  canonicalUrl: string;
  ogImageUrl?: string;
  readingTime?: string;
}

const { post, canonicalUrl, ogImageUrl, readingTime } = Astro.props;

const readingMinutes = readingTime ? parseInt(readingTime, 10) : NaN;
const { title, description, pubDate, updatedDate, author, reviewPolicy } =
  post.data;

const reviewFields = buildReview(reviewPolicy);

const AUTHOR_URL = new URL("/autor/", Astro.site ?? Astro.url.origin).href;
const AUTHOR_IMAGE_URL = new URL(
  SITE.authorImage,
  Astro.site ?? Astro.url.origin
).href;
const SITE_URL = (Astro.site ?? new URL(Astro.url.origin)).href.replace(
  /\/$/,
  ""
);

// ── BlogPosting ──────────────────────────────────────────────────────────────
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": canonicalUrl,
  headline: title,
  description: description ?? "",
  url: canonicalUrl,
  ...(ogImageUrl ? { image: ogImageUrl } : {}),
  ...(readingMinutes && !Number.isNaN(readingMinutes)
    ? { timeRequired: `PT${readingMinutes}M` }
    : {}),
  datePublished: pubDate?.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  // lastReviewed/reviewedBy solo cuando hay una revisión humana registrada.
  // Derivarlo de reviewPolicy.computedAt publicaba una afirmación falsa (D18).
  ...reviewFields,
  inLanguage: "es-CL",
  author: {
    "@id": AUTHOR_URL,
    ...buildAuthorEntity(author, {
      authorUrl: AUTHOR_URL,
      imageUrl: AUTHOR_IMAGE_URL,
    }),
  },
  publisher: {
    "@type": "Organization",
    "@id": `${SITE_URL}/#organization`,
    name: SITE.title,
    url: SITE_URL,
    logo: {
      "@type": "ImageObject",
      url: `${SITE_URL}/favicon.svg`,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: ["h1", "#article"],
  },
};

// ── FAQPage — auto-extracted ─────────────────────────────────────────────────
/**
 * Extract Q&A pairs from the raw markdown body.
 * Looks for an H2 "Preguntas frecuentes" section and collects
 * H3 questions with the paragraph text that follows each one.
 */
function extractFaqItems(body: string): { question: string; answer: string }[] {
  if (!body) return [];

  const faqSectionMatch = body.match(
    /##\s+Preguntas\s+frecuentes\s*([\s\S]*?)(?=\n##\s|\n---|\s*$)/i
  );
  if (!faqSectionMatch) return [];

  const faqSection = faqSectionMatch[1];
  const questionBlocks = faqSection.split(/\n###\s+/).slice(1);

  return questionBlocks
    .map(block => {
      const lines = block.trim().split("\n");
      const question = lines[0]?.replace(/\*\*/g, "").trim() ?? "";
      // Answer: all non-empty non-heading lines until the next question
      const answerLines = lines
        .slice(1)
        .filter(l => l.trim() && !l.startsWith("###"))
        .map(l =>
          l
            .replace(/^\*\*|\*\*$/g, "")
            .replace(/\*\*/g, "")
            .trim()
        );
      const answer = answerLines.join(" ").substring(0, 1000); // cap for schema
      return question && answer ? { question, answer } : null;
    })
    .filter(
      (item): item is { question: string; answer: string } => item !== null
    );
}

const autoFaqItems = extractFaqItems(post.body ?? "");
const frontmatterFaqs = (post.data.faqs ?? []).map(({ q, a }) => ({
  question: q,
  answer: a,
}));
const faqItems = autoFaqItems.length > 0 ? autoFaqItems : frontmatterFaqs;

const faqSchema =
  faqItems.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqItems.map(({ question, answer }) => ({
          "@type": "Question",
          name: question,
          acceptedAnswer: {
            "@type": "Answer",
            text: answer,
          },
        })),
      }
    : null;
---

<script
  type="application/ld+json"
  is:inline
  set:html={serializeJsonLd(articleSchema)}
></script>
{faqSchema && (
  <script
    type="application/ld+json"
    is:inline
    set:html={serializeJsonLd(faqSchema)}
  ></script>
)}
