---
import type { WizardConfig } from "@/domain/wizard/WizardConfig";
import {
  PROFILE_FIELDS,
  PROFILE_SCHEMA_VERSION,
  PROFILE_STORAGE_KEY,
} from "@/utils/userProfile";

interface Props {
  config: WizardConfig;
}

const { config } = Astro.props;

// Serialize config to pass to client-side script
const configJson = JSON.stringify(config);
const wizardId = `wizard-${config.id}`;
---

<div
  id={wizardId}
  class="rounded-xl border border-border p-6"
  data-wizard-config={configJson}
  data-profile-fields={JSON.stringify(PROFILE_FIELDS)}
>
  <!-- Step view -->
  <div id={`${wizardId}-step`}>
    <p class="mb-4 text-sm text-muted">
      Responde las preguntas para ver tu ruta recomendada.
    </p>
    <p id={`${wizardId}-pregunta`} class="mb-4 text-base font-semibold"></p>
    <div id={`${wizardId}-opciones`} class="flex flex-col gap-2"></div>
  </div>

  <!-- Result view (hidden initially) -->
  <div id={`${wizardId}-resultado`} class="hidden">
    <div class="mb-4 rounded-lg border border-accent/20 bg-accent/5 p-4">
      <p id={`${wizardId}-res-titulo`} class="text-base font-bold"></p>
      <p
        id={`${wizardId}-res-descripcion`}
        class="mt-1 text-sm text-secondary"
      ></p>
    </div>
    <div id={`${wizardId}-res-pasos`} class="mb-4 hidden">
      <p class="mb-2 text-sm font-semibold">Pasos a seguir:</p>
      <ol
        id={`${wizardId}-res-pasos-lista`}
        class="list-decimal space-y-1 pl-5 text-sm text-secondary"
      ></ol>
    </div>
    <div id={`${wizardId}-res-links`} class="mb-4 flex hidden flex-col gap-2">
      <p class="text-sm font-semibold">Canales oficiales:</p>
      <ul id={`${wizardId}-res-links-lista`} class="space-y-1"></ul>
    </div>
    <div
      id={`${wizardId}-res-secondary`}
      class="mb-4 flex hidden flex-col gap-2"
    >
      <p class="text-sm font-semibold">También puedes revisar:</p>
      <ul id={`${wizardId}-res-secondary-lista`} class="space-y-1"></ul>
    </div>
    <a
      id={`${wizardId}-res-primary-cta`}
      class="hidden inline-flex items-center rounded-full bg-accent px-4 py-2 text-sm font-semibold text-background transition-opacity hover:opacity-90"
    ></a>
    <p
      id={`${wizardId}-res-nota`}
      class="mt-3 hidden border-t border-border pt-3 text-xs text-muted"
    ></p>
    <button
      id={`${wizardId}-reiniciar`}
      type="button"
      class="mt-4 rounded-lg border border-border px-4 py-2 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
    >
      ← Volver al inicio
    </button>
  </div>
</div>

<script
  is:inline
  define:vars={{
    configJson,
    wizardId,
    profileStorageKey: PROFILE_STORAGE_KEY,
    profileSchemaVersion: PROFILE_SCHEMA_VERSION,
  }}
>
  (function () {
    const config = JSON.parse(configJson);
    const root = document.getElementById(wizardId);
    if (!root) return;
    const profileFields = new Set(
      JSON.parse(root.dataset.profileFields || "[]")
    );

    const stepEl = document.getElementById(`${wizardId}-step`);
    const resultEl = document.getElementById(`${wizardId}-resultado`);
    const preguntaEl = document.getElementById(`${wizardId}-pregunta`);
    const opcionesEl = document.getElementById(`${wizardId}-opciones`);
    const resTituloEl = document.getElementById(`${wizardId}-res-titulo`);
    const resDescEl = document.getElementById(`${wizardId}-res-descripcion`);
    const resPasosSection = document.getElementById(`${wizardId}-res-pasos`);
    const resPasosLista = document.getElementById(
      `${wizardId}-res-pasos-lista`
    );
    const resLinksSection = document.getElementById(`${wizardId}-res-links`);
    const resLinksLista = document.getElementById(
      `${wizardId}-res-links-lista`
    );
    const resSecondarySection = document.getElementById(
      `${wizardId}-res-secondary`
    );
    const resSecondaryLista = document.getElementById(
      `${wizardId}-res-secondary-lista`
    );
    const resPrimaryCtaEl = document.getElementById(
      `${wizardId}-res-primary-cta`
    );
    const resNotaEl = document.getElementById(`${wizardId}-res-nota`);
    const reiniciarBtn = document.getElementById(`${wizardId}-reiniciar`);

    let stepHistory = [];
    let currentResult = null;

    const analytics = {
      startEvent: config.analytics?.startEvent || "wizard_start",
      stepEvent: config.analytics?.stepEvent || "wizard_step",
      completeEvent: config.analytics?.completeEvent || "wizard_complete",
      ctaClickEvent: config.analytics?.ctaClickEvent || "wizard_cta_click",
    };

    function trackEvent(eventName, extra) {
      window.monedarioAnalytics?.track(eventName, {
        guide_id: config.id,
        wizard_id: config.id,
        ...extra,
      });
    }

    function readProfile() {
      if (typeof localStorage === "undefined") {
        return { v: profileSchemaVersion, ts: 0 };
      }
      try {
        const raw = localStorage.getItem(profileStorageKey);
        if (!raw) return { v: profileSchemaVersion, ts: 0 };
        const parsed = JSON.parse(raw);
        if (!parsed || parsed.v !== profileSchemaVersion) {
          return { v: profileSchemaVersion, ts: 0 };
        }
        return parsed;
      } catch {
        return { v: profileSchemaVersion, ts: 0 };
      }
    }

    function writeProfilePatch(patch) {
      if (!patch || typeof localStorage === "undefined") return;
      const next = {
        ...readProfile(),
        v: profileSchemaVersion,
        ts: Date.now(),
      };
      for (const [key, value] of Object.entries(patch)) {
        if (!profileFields.has(key)) continue;
        if (value === undefined || value === null || value === "") {
          delete next[key];
          continue;
        }
        next[key] = value;
      }
      try {
        localStorage.setItem(profileStorageKey, JSON.stringify(next));
      } catch {
        // Silent degrade.
      }
    }

    function showStep(stepId) {
      const step = config.steps[stepId];
      if (!step) return;

      stepEl.classList.remove("hidden");
      resultEl.classList.add("hidden");

      preguntaEl.textContent = step.pregunta;
      opcionesEl.replaceChildren();

      step.opciones.forEach((opcion, idx) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className =
          "w-full rounded-lg border border-border px-4 py-3 text-left text-sm font-medium hover:border-accent hover:text-accent transition-colors";
        btn.textContent = opcion.label;
        btn.addEventListener("click", () => {
          writeProfilePatch(opcion.profilePatch);
          trackEvent(analytics.stepEvent, {
            step_id: stepId,
            option_index: idx,
            option_label: opcion.label,
            source_page: window.location.pathname,
          });
          stepHistory.push(stepId);
          if (opcion.next) {
            showStep(opcion.next);
          } else if (opcion.resultado) {
            showResult(opcion.resultado);
          }
        });
        opcionesEl.appendChild(btn);
      });
    }

    function showResult(resultado) {
      stepEl.classList.add("hidden");
      resultEl.classList.remove("hidden");
      currentResult = resultado;

      resTituloEl.textContent = resultado.titulo;
      resDescEl.textContent = resultado.descripcion;

      if (resultado.pasos && resultado.pasos.length > 0) {
        resPasosSection.classList.remove("hidden");
        resPasosLista.replaceChildren();
        resultado.pasos.forEach(paso => {
          const li = document.createElement("li");
          li.textContent = paso;
          resPasosLista.appendChild(li);
        });
      } else {
        resPasosSection.classList.add("hidden");
      }

      if (resultado.links && resultado.links.length > 0) {
        resLinksSection.classList.remove("hidden");
        resLinksLista.replaceChildren();
        resultado.links.forEach(link => {
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = link.href;
          a.textContent = link.label;
          a.target = "_blank";
          a.rel = "noopener noreferrer";
          a.className =
            "text-sm text-accent underline underline-offset-4 hover:opacity-80";
          li.appendChild(a);
          resLinksLista.appendChild(li);
        });
      } else {
        resLinksSection.classList.add("hidden");
      }

      if (resultado.secondaryLinks && resultado.secondaryLinks.length > 0) {
        resSecondarySection.classList.remove("hidden");
        resSecondaryLista.replaceChildren();
        resultado.secondaryLinks.forEach(link => {
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = link.href;
          a.textContent = link.label;
          a.className =
            "text-sm text-accent underline underline-offset-4 hover:opacity-80";
          li.appendChild(a);
          resSecondaryLista.appendChild(li);
        });
      } else {
        resSecondarySection.classList.add("hidden");
      }

      if (resultado.primaryCta?.href && resultado.primaryCta?.label) {
        resPrimaryCtaEl.classList.remove("hidden");
        resPrimaryCtaEl.setAttribute("href", resultado.primaryCta.href);
        resPrimaryCtaEl.textContent = resultado.primaryCta.label;
      } else {
        resPrimaryCtaEl.classList.add("hidden");
        resPrimaryCtaEl.removeAttribute("href");
        resPrimaryCtaEl.textContent = "";
      }

      if (resultado.nota) {
        resNotaEl.classList.remove("hidden");
        resNotaEl.textContent = resultado.nota;
      } else {
        resNotaEl.classList.add("hidden");
      }

      trackEvent(analytics.completeEvent, {
        result_key: resultado.resultKey || "",
        result_titulo: resultado.titulo,
        source_page: window.location.pathname,
      });
    }

    reiniciarBtn?.addEventListener("click", () => {
      stepHistory = [];
      currentResult = null;
      showStep(config.firstStep);
    });

    resPrimaryCtaEl?.addEventListener("click", () => {
      if (!currentResult?.primaryCta?.href) return;
      trackEvent(analytics.ctaClickEvent, {
        result_key: currentResult.resultKey || "",
        target_href: currentResult.primaryCta.href,
        source_page: window.location.pathname,
      });
    });

    // Init
    trackEvent(analytics.startEvent, { source_page: window.location.pathname });
    showStep(config.firstStep);
  })();
</script>
