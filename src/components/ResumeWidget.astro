---
// ResumeWidget — shows the user's recent pages and last calculator result.
// Rendered only client-side (reads localStorage); server renders nothing visible.
---

<div
  id="resume-widget"
  class="hidden rounded-xl border border-border p-5"
  aria-label="Continúa donde lo dejaste"
>
  <div class="mb-3 flex items-center justify-between">
    <p class="text-sm font-semibold">Continúa donde lo dejaste</p>
    <button
      id="resume-clear"
      type="button"
      class="text-xs text-muted transition-colors hover:text-foreground"
    >
      Borrar historial
    </button>
  </div>

  <div id="resume-calculator" class="mb-3 hidden">
    <p class="mb-1 text-xs font-semibold tracking-wide text-muted uppercase">
      Última calculadora
    </p>
    <a
      id="resume-calculator-link"
      href="#"
      class="text-sm font-medium text-accent underline underline-offset-4 hover:opacity-80"
    ></a>
  </div>

  <div id="resume-pages" class="hidden">
    <p class="mb-1 text-xs font-semibold tracking-wide text-muted uppercase">
      Páginas recientes
    </p>
    <ul id="resume-pages-list" class="space-y-1"></ul>
  </div>
</div>

<script>
  import {
    getResumeData,
    clearResumeData,
    savePageVisit,
  } from "@/utils/resumeState";
  import { trackAnalyticsEvent } from "@/utils/analytics";

  function scheduleIdle(callback: () => void) {
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(callback, { timeout: 1200 });
      return;
    }

    globalThis.setTimeout(callback, 120);
  }

  scheduleIdle(() => {
    savePageVisit(window.location.pathname, document.title);
  });

  function initResumeWidget() {
    const widget = document.getElementById("resume-widget");
    if (!(widget instanceof HTMLElement)) return;
    if (widget.dataset.resumeHydrated === "true") return;

    widget.dataset.resumeHydrated = "true";

    const data = getResumeData();
    let hasContent = false;

    if (data.calculator) {
      const calcSection = document.getElementById("resume-calculator");
      const calcLink = document.getElementById(
        "resume-calculator-link"
      ) as HTMLAnchorElement | null;

      if (calcSection instanceof HTMLElement && calcLink) {
        calcLink.href = data.calculator.id;
        calcLink.textContent = data.calculator.label;
        calcSection.classList.remove("hidden");
        hasContent = true;

        calcLink.addEventListener("click", () => {
          trackAnalyticsEvent("resume_click", {
            item_type: "calculator",
            item_id: data.calculator!.id,
          });
        });
      }
    }

    const otherPages = data.pages.filter(
      page => page.url !== window.location.pathname
    );

    if (otherPages.length > 0) {
      const pagesSection = document.getElementById("resume-pages");
      const pagesList = document.getElementById("resume-pages-list");

      if (
        pagesSection instanceof HTMLElement &&
        pagesList instanceof HTMLElement
      ) {
        otherPages.forEach(page => {
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = page.url;
          a.textContent = page.title;
          a.className =
            "text-sm text-secondary hover:text-foreground hover:underline underline-offset-4 transition-colors";
          a.addEventListener("click", () => {
            trackAnalyticsEvent("resume_click", {
              item_type: "page",
              item_url: page.url,
            });
          });
          li.appendChild(a);
          pagesList.appendChild(li);
        });
        pagesSection.classList.remove("hidden");
        hasContent = true;
      }
    }

    if (hasContent) {
      widget.classList.remove("hidden");
    }

    document.getElementById("resume-clear")?.addEventListener("click", () => {
      clearResumeData();
      widget.classList.add("hidden");
      trackAnalyticsEvent("resume_cleared", {});
    });
  }

  function scheduleResumeWidget() {
    const widget = document.getElementById("resume-widget");
    if (!(widget instanceof HTMLElement)) return;
    if (widget.dataset.resumeScheduled === "true") return;

    widget.dataset.resumeScheduled = "true";

    const run = () => {
      scheduleIdle(initResumeWidget);
    };

    if (!("IntersectionObserver" in window)) {
      run();
      return;
    }

    const observer = new IntersectionObserver(
      entries => {
        if (!entries.some(entry => entry.isIntersecting)) return;

        observer.disconnect();
        run();
      },
      { rootMargin: "240px 0px" }
    );

    observer.observe(widget);
  }

  scheduleResumeWidget();
  document.addEventListener("astro:page-load", scheduleResumeWidget);
</script>
