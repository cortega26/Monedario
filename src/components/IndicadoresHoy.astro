---
import { getIndicadores, fmt, fmtFecha } from "@/utils/indicadores";
import { getPath } from "@/utils/getPath";

const indicadores = await getIndicadores();

const items = [
  {
    label: "UF",
    value: indicadores.uf.toLocaleString("es-CL", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }),
    prefix: "$",
    href: getPath("/calculadoras/conversor-uf/"),
  },
  {
    label: "UTM",
    value: fmt(indicadores.utm).slice(1),
    prefix: "$",
  },
  ...(indicadores.dolar
    ? [
        {
          label: "Dólar",
          value: indicadores.dolar.toLocaleString("es-CL", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
          }),
          prefix: "$",
        },
      ]
    : []),
];

const fechaDisplay = fmtFecha(indicadores.fecha);
---

<div
  class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-secondary"
  aria-label="Indicadores económicos del día"
>
  {
    items.map(item => {
      const inner = (
        <span class="inline-flex items-baseline gap-1">
          <span class="text-xs font-semibold tracking-wide text-muted uppercase">
            {item.label}
          </span>
          <span class="font-semibold text-foreground tabular-nums">
            {item.prefix}
            {item.value}
          </span>
        </span>
      );

      return item.href ? (
        <a
          href={item.href}
          class="rounded-md transition-colors hover:text-accent"
          data-analytics-cta="home-indicador"
          data-analytics-label={item.label}
          data-analytics-location="home_indicadores_hoy"
        >
          {inner}
        </a>
      ) : (
        <span>{inner}</span>
      );
    })
  }
  <span
    class="text-xs text-muted"
    title={`Fuente: mindicador.cl — ${fechaDisplay}`}
  >
    al {fechaDisplay}
  </span>
</div>
