---
import {
  fmtDelta,
  fmtDiaMesCorto,
  fmtFecha,
  fmtMesCorto,
  getIndicadores,
} from "@/utils/indicadores";
import { getPath } from "@/utils/getPath";

const indicadores = await getIndicadores();

const ufFecha = indicadores.fechas.uf;
const utmFecha = indicadores.fechas.utm;
const dolarFecha = indicadores.fechas.dolar ?? indicadores.fecha;

const ufValue = indicadores.uf.toLocaleString("es-CL", {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
const utmValue = Math.round(indicadores.utm).toLocaleString("es-CL");
const dolarValue = indicadores.dolar?.toLocaleString("es-CL", {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});

const hasDolar = indicadores.dolar !== undefined && dolarValue !== undefined;
const cols = hasDolar ? "3" : "2";

const prev = indicadores.prev;

const ufDelta = prev?.uf
  ? {
      pct: fmtDelta(indicadores.uf, prev.uf.valor),
      up: indicadores.uf >= prev.uf.valor,
      vs: fmtDiaMesCorto(prev.uf.fecha),
    }
  : null;
const utmDelta = prev?.utm
  ? {
      pct: fmtDelta(indicadores.utm, prev.utm.valor),
      up: indicadores.utm >= prev.utm.valor,
      vs: fmtMesCorto(prev.utm.fecha),
    }
  : null;
const dolarDelta =
  prev?.dolar && indicadores.dolar !== undefined
    ? {
        pct: fmtDelta(indicadores.dolar, prev.dolar.valor),
        up: indicadores.dolar >= prev.dolar.valor,
        vs: fmtDiaMesCorto(prev.dolar.fecha),
      }
    : null;

const indicadoresEndpoint = getPath("/api/indicadores-hoy.json");
---

<section
  aria-labelledby="indicadores-hoy-heading"
  data-indicadores-hoy
  data-endpoint={indicadoresEndpoint}
>
  <h2 id="indicadores-hoy-heading" class="sr-only">
    Indicadores económicos vigentes
  </h2>
  <div class="indicadores-grid" style={`--cols:${cols}`}>
    <div class="indicador" data-indicator="uf">
      <span class="indicador-label" data-field="label">
        UF · {fmtDiaMesCorto(ufFecha)}
      </span>
      <a
        href={getPath("/calculadoras/conversor-uf/")}
        class="indicador-value indicador-value--link"
        title={`Fuente: Banco Central de Chile — UF al ${fmtFecha(ufFecha)}`}
        data-field="value"
        data-analytics-cta="home-indicador"
        data-analytics-label="UF"
        data-analytics-location="home_indicadores_hoy"
      >
        ${ufValue}
      </a>
      {
        ufDelta ? (
          <span
            class={`indicador-delta ${ufDelta.up ? "indicador-delta--up" : "indicador-delta--down"}`}
            data-field="delta"
          >
            {ufDelta.up ? "▲" : "▼"} {ufDelta.pct}% vs. {ufDelta.vs}
          </span>
        ) : (
          <span class="indicador-delta" data-field="delta" aria-hidden="true">
            &nbsp;
          </span>
        )
      }
    </div>

    <div class="indicador" data-indicator="utm">
      <span class="indicador-label" data-field="label">
        UTM · {fmtMesCorto(utmFecha)}
      </span>
      <span
        class="indicador-value"
        title={`Fuente: mindicador.cl — UTM al ${fmtFecha(utmFecha)}`}
        data-field="value"
      >
        ${utmValue}
      </span>
      {
        utmDelta ? (
          <span
            class={`indicador-delta ${utmDelta.up ? "indicador-delta--up" : "indicador-delta--down"}`}
            data-field="delta"
          >
            {utmDelta.up ? "▲" : "▼"} {utmDelta.pct}% vs. {utmDelta.vs}
          </span>
        ) : (
          <span class="indicador-delta" data-field="delta" aria-hidden="true">
            &nbsp;
          </span>
        )
      }
    </div>

    {
      hasDolar && (
        <div class="indicador indicador--last" data-indicator="dolar">
          <span class="indicador-label" data-field="label">
            DÓLAR OBS. · {fmtDiaMesCorto(dolarFecha)}
          </span>
          <span
            class="indicador-value"
            title={`Fuente: Banco Central de Chile — Dólar al ${fmtFecha(dolarFecha)}`}
            data-field="value"
          >
            ${dolarValue}
          </span>
          {dolarDelta ? (
            <span
              class={`indicador-delta ${dolarDelta.up ? "indicador-delta--up" : "indicador-delta--down"}`}
              data-field="delta"
            >
              {dolarDelta.up ? "▲" : "▼"} {dolarDelta.pct}% vs. {dolarDelta.vs}
            </span>
          ) : (
            <span class="indicador-delta" data-field="delta" aria-hidden="true">
              &nbsp;
            </span>
          )}
        </div>
      )
    }

    <div class="indicador-cta">
      <a
        href={getPath("/guias/uf-costo-de-vida/indicadores-economicos/")}
        class="indicador-cta-link"
        data-analytics-cta="home-indicadores-hub"
        data-analytics-label="Ver todos"
        data-analytics-location="home_indicadores_hoy"
        aria-label="Ver todos los indicadores económicos"
      >
        Ver<br />todos<br />→
      </a>
    </div>
  </div>
</section>

<script>
  type IndicatorDelta = {
    text: string;
    direction: "up" | "down";
  } | null;

  type IndicatorPayload = {
    label: string;
    value: string;
    title: string;
    delta: IndicatorDelta;
  };

  type IndicadoresPayload = {
    indicators: {
      uf?: IndicatorPayload;
      utm?: IndicatorPayload;
      dolar?: IndicatorPayload;
    };
  };

  const DELTA_CLASSES = [
    "indicador-delta--up",
    "indicador-delta--down",
  ] as const;

  function setText(root: Element, selector: string, value: string): void {
    const element = root.querySelector(selector);
    if (!element) return;
    element.textContent = value;
  }

  function updateIndicator(
    root: Element,
    code: keyof IndicadoresPayload["indicators"],
    indicator: IndicatorPayload | undefined
  ): void {
    if (!indicator) return;
    const item = root.querySelector(`[data-indicator="${code}"]`);
    if (!item) return;

    setText(item, '[data-field="label"]', indicator.label);

    const value = item.querySelector('[data-field="value"]');
    if (value) {
      value.textContent = indicator.value;
      value.setAttribute("title", indicator.title);
    }

    const delta = item.querySelector('[data-field="delta"]');
    if (!delta) return;
    delta.classList.remove(...DELTA_CLASSES);

    if (!indicator.delta) {
      delta.textContent = "\u00A0";
      delta.setAttribute("aria-hidden", "true");
      return;
    }

    delta.textContent = indicator.delta.text;
    delta.removeAttribute("aria-hidden");
    delta.classList.add(
      indicator.delta.direction === "up"
        ? "indicador-delta--up"
        : "indicador-delta--down"
    );
  }

  async function refreshIndicadoresHoy(root: HTMLElement): Promise<void> {
    const endpoint = root.dataset.endpoint;
    if (!endpoint) return;

    const response = await fetch(endpoint, {
      headers: { Accept: "application/json" },
    });
    if (!response.ok) return;

    const payload = (await response.json()) as IndicadoresPayload;
    updateIndicator(root, "uf", payload.indicators.uf);
    updateIndicator(root, "utm", payload.indicators.utm);
    updateIndicator(root, "dolar", payload.indicators.dolar);
  }

  function initIndicadoresHoy(): void {
    document
      .querySelectorAll<HTMLElement>("[data-indicadores-hoy]")
      .forEach(root => {
        refreshIndicadoresHoy(root).catch(() => {});
      });
  }

  initIndicadoresHoy();
  document.addEventListener("astro:after-swap", initIndicadoresHoy, {
    once: true,
  });
</script>

<style>
  .indicadores-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    row-gap: 14px;
  }

  @media (max-width: 639px) {
    .indicadores-grid {
      padding: 10px 0;
      row-gap: 10px;
    }
  }

  @media (min-width: 640px) {
    .indicadores-grid {
      grid-template-columns: repeat(var(--cols, 3), 1fr) auto;
      align-items: end;
      row-gap: 0;
    }

    .indicador {
      border-right: 1px solid var(--border);
    }

    .indicador:first-child {
      padding-left: 0;
    }

    .indicador--last {
      border-right: none;
    }

    .indicador-cta {
      padding-left: 16px;
      padding-bottom: 2px;
    }
  }

  .indicador {
    padding: 0 16px;
  }

  .indicador:first-child {
    padding-left: 0;
  }

  @media (max-width: 639px) {
    .indicador:nth-child(odd) {
      padding-left: 0;
    }
  }

  .indicador-label {
    display: block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 3px;
  }

  .indicador-value {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 3.5vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    line-height: 1.15;
    text-decoration: none;
  }

  .indicador-value--link {
    transition: color 0.15s ease;
  }

  .indicador-value--link:hover {
    color: var(--accent);
  }

  .indicador-delta {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    margin-top: 3px;
    letter-spacing: 0.01em;
  }

  .indicador-delta--up {
    color: var(--color-accent-2-text);
  }

  .indicador-delta--down {
    color: var(--color-highlight-text);
  }

  .indicador-cta {
    display: flex;
    align-items: flex-end;
    padding-left: 16px;
    padding-bottom: 2px;
  }

  .indicador-cta-link {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    line-height: 1.4;
    text-align: center;
    transition: opacity 0.15s ease;
  }

  .indicador-cta-link:hover {
    opacity: 0.7;
  }
</style>
