---
import DecisionWizard from "@/components/DecisionWizard.astro";
import { getArticleEntryGuide } from "@/config/articleEntryGuides";

interface Props {
  guideId?: string | null;
}

const { guideId } = Astro.props;
const guide = getArticleEntryGuide(guideId);
---

{
  guide && (
    <aside
      class="not-prose my-8 rounded-2xl border border-accent/20 bg-accent/5 p-6"
      aria-label={guide.title}
      data-entry-guide-id={guide.id}
    >
      <p class="mb-2 text-xs font-semibold tracking-widest text-accent uppercase">
        {guide.eyebrow}
      </p>
      <h2 class="mb-3 text-2xl font-semibold text-foreground">{guide.title}</h2>
      <p class="mb-5 max-w-2xl text-sm text-secondary">{guide.description}</p>
      <DecisionWizard config={guide.config} />
    </aside>
  )
}
