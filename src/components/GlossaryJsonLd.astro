---
import { serializeJsonLd } from "@/utils/serializeJsonLd";
interface Props {
  term: string;
  shortDefinition: string;
  canonicalUrl: string;
  glossaryIndexUrl: string;
}

const { term, shortDefinition, canonicalUrl, glossaryIndexUrl } = Astro.props;

const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "@id": canonicalUrl,
  name: term,
  description: shortDefinition,
  url: canonicalUrl,
  inDefinedTermSet: {
    "@type": "DefinedTermSet",
    "@id": glossaryIndexUrl,
    name: "Glosario Monedario",
    url: glossaryIndexUrl,
  },
  inLanguage: "es-CL",
};
---

<script
  type="application/ld+json"
  is:inline
  set:html={serializeJsonLd(definedTermSchema)}
></script>
