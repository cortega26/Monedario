---
/**
 * Componente IndicadorEconomico
 * Muestra un valor calculado en base a UF o UTM obtenido desde mindicador.cl
 *
 * Props:
 * - tipo: "uf" | "utm" — qué indicador usar como base
 * - multiplicador: número por el que se multiplica el indicador (ej: 600 para 600 UF)
 * - descripcion: texto descriptivo que acompaña al valor (ej: "600 UF anuales")
 * - mostrarFecha: si se muestra la fecha de actualización (default: true)
 */

import { getIndicadores, formatCLP, fmtFecha } from "@/utils/indicadores";

interface Props {
  tipo: "uf" | "utm";
  multiplicador: number;
  descripcion?: string;
  mostrarFecha?: boolean;
}

const { tipo, multiplicador, descripcion, mostrarFecha = true } = Astro.props;

const indicadores = await getIndicadores();
const base = tipo === "uf" ? indicadores.uf : indicadores.utm;
const indicatorDate =
  tipo === "uf" ? indicadores.fechas.uf : indicadores.fechas.utm;
const valor = base * multiplicador;
const sourceLabel =
  indicadores.source === "live"
    ? "dato en línea"
    : indicadores.source === "snapshot"
      ? "dato de referencia"
      : "fallback de emergencia";
---

<span class="indicador-economico">
  <strong class="text-accent">{formatCLP(valor)}</strong>
  {descripcion && <span class="text-secondary"> ({descripcion})</span>}
  {
    mostrarFecha && (
      <sup
        title={`Basado en ${tipo.toUpperCase()} = ${formatCLP(base)} al ${fmtFecha(indicatorDate)} (${sourceLabel})`}
        class="ml-0.5 cursor-help text-xs text-muted"
      >
        ⓘ
      </sup>
    )
  }
</span>
