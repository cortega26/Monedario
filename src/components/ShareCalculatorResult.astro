---
// No Astro props — entirely client-side driven
---

<div id="share-calculator-result" class="mt-6 hidden">
  <p class="mb-3 text-sm font-medium text-secondary">Compartir resultado:</p>
  <a
    id="share-whatsapp"
    href="#"
    target="_blank"
    rel="noopener noreferrer"
    class="mr-2 inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-accent/10"
    data-analytics-cta="share-result"
    data-analytics-label="whatsapp"
  >
    📲 WhatsApp
  </a>
  <button
    id="share-copy"
    class="inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-accent/10"
    data-analytics-cta="share-result"
    data-analytics-label="copy-link"
  >
    🔗 Copiar enlace
  </button>
  <span id="share-copy-feedback" class="ml-2 hidden text-xs text-accent"
    >¡Copiado!</span
  >
</div>

<script>
  declare global {
    interface Window {
      showShareResult?: (text: string) => void;
    }
  }

  const copyBtn = document.getElementById("share-copy");
  if (copyBtn) {
    copyBtn.addEventListener("click", () => {
      navigator.clipboard.writeText(window.location.href).then(() => {
        const feedback = document.getElementById("share-copy-feedback");
        if (feedback) {
          feedback.classList.remove("hidden");
          setTimeout(() => {
            feedback.classList.add("hidden");
          }, 2000);
        }
      });
    });
  }

  document.addEventListener("calculator:result", (event: Event) => {
    const { summaryText } = (event as CustomEvent).detail;
    showShareResultFn(summaryText);
  });

  function showShareResultFn(summaryText: string): void {
    const container = document.getElementById("share-calculator-result");
    if (container) {
      container.classList.remove("hidden");
    }

    const waLink = document.getElementById(
      "share-whatsapp"
    ) as HTMLAnchorElement | null;
    if (waLink) {
      waLink.href = `https://wa.me/?text=${encodeURIComponent(summaryText + "\n" + window.location.href)}`;
    }
  }

  window.showShareResult = showShareResultFn;
</script>
