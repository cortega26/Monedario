---
import { getPath } from "@/utils/getPath";
import { deriveCalculatorId, deriveNextStepId } from "@/utils/nextSteps";

export type NextStepItem = {
  href: string;
  title: string;
  description?: string;
  label?: string;
  cta?: string;
};

function defaultCta(href: string): string {
  if (href.startsWith("/calculadoras/")) return "Calcular →";
  if (href.startsWith("/posts/")) return "Leer guía →";
  if (href.startsWith("/guias/")) return "Explorar sección →";
  return "Continuar →";
}

type Props = {
  currentHref: string;
  cluster?: string;
  items?: NextStepItem[];
  excludeHrefs?: string[];
  title?: string;
  description?: string;
  location?: string;
};

const {
  currentHref,
  cluster,
  items = [],
  excludeHrefs = [],
  title = "Qué sigue",
  description = "Elige el siguiente paso según lo que necesitas resolver ahora.",
  location = "next_steps",
} = Astro.props as Props;

function normalizeHref(href: string): string {
  return href.replace(/\/+$/, "") || "/";
}

const excluded = new Set([
  normalizeHref(currentHref),
  ...excludeHrefs.map(normalizeHref),
]);
const seen = new Set<string>();
const visibleItems = items
  .filter(item => {
    const normalizedHref = normalizeHref(item.href);
    if (excluded.has(normalizedHref) || seen.has(normalizedHref)) return false;
    seen.add(normalizedHref);
    return true;
  })
  .slice(0, 3);

// Identidad derivada de `currentHref` (no de una prop nueva, ver Notas de
// mantenimiento del plan 083): en `/calculadoras/<slug>/` resuelve el slug;
// en cualquier otro origen (índice, artículos) queda `undefined` a propósito.
const resolvedCalculatorId = deriveCalculatorId(currentHref);
---

{
  visibleItems.length > 0 && (
    <section
      class="mt-10 border-t border-border pt-8 pb-10"
      data-next-steps-cluster={cluster}
      data-analytics-next-steps
      data-analytics-calculator-id={resolvedCalculatorId}
      aria-labelledby="next-steps-title"
    >
      <div class="mb-5 max-w-2xl">
        <h2
          id="next-steps-title"
          class="text-2xl font-bold"
          style="font-family: var(--font-body);"
        >
          {title}
        </h2>
        {description && (
          <p class="mt-2 text-sm leading-relaxed text-secondary">
            {description}
          </p>
        )}
      </div>
      <ul class="grid gap-4 md:grid-cols-3">
        {visibleItems.map(item => (
          <li class="rounded-lg border border-border bg-background p-4">
            {item.label && (
              <p class="mb-2 text-xs font-semibold tracking-[0.14em] text-accent uppercase">
                {item.label}
              </p>
            )}
            <h3 class="text-base leading-snug font-semibold">{item.title}</h3>
            {item.description && (
              <p class="mt-2 text-sm leading-relaxed text-secondary">
                {item.description}
              </p>
            )}
            <a
              href={getPath(item.href)}
              class="mt-4 inline-flex min-h-6 items-center py-1 text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
              data-next-step-id={deriveNextStepId(item.href)}
              data-analytics-label={item.title}
              data-analytics-location={location}
              aria-label={`${item.cta ?? defaultCta(item.href)} ${item.title}`}
            >
              {item.cta ?? defaultCta(item.href)}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<script>
  import { trackAnalyticsEvent } from "@/utils/analytics";

  const ROOT_SELECTOR = "[data-analytics-next-steps]";

  // page_type se lee del marcador de página vigente (igual que el manejador
  // genérico en src/scripts/analytics.ts) en vez de fijarse en "calculator":
  // este componente también se renderiza en páginas de artículo
  // (PostDetails.astro), donde el page_type correcto es "article".
  function getPageType(): string {
    const typed = document.querySelector<HTMLElement>(
      "[data-analytics-page-type]"
    );
    return typed?.dataset.analyticsPageType ?? "unknown";
  }

  function initNextSteps() {
    const roots = document.querySelectorAll<HTMLElement>(ROOT_SELECTOR);

    roots.forEach(root => {
      if (root.dataset.initialized === "true") return;
      root.dataset.initialized = "true";

      const calculatorId = root.dataset.analyticsCalculatorId;
      const cluster = root.dataset.nextStepsCluster;
      const pageType = getPageType();
      // F1 (PLAN-result-panel-conversion): todo clic/impresión lleva
      // calculator_id (cuando resuelve a /calculadoras/<slug>/) +
      // interaction_variant. cluster se adjunta cuando la página lo declara.
      // En artículos calculator_id queda ausente a propósito (identidad falsa
      // es peor que ausente; ver CALCULATOR-REGISTRY § Cross-check W36).
      const basePayload = {
        ...(calculatorId ? { calculator_id: calculatorId } : {}),
        ...(cluster ? { cluster } : {}),
        page_type: pageType,
        interaction_variant: "contextual_v1",
      };

      const shown = new Set<string>();
      const observer = new IntersectionObserver(
        entries => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const target = entry.target as HTMLElement;
            const nextStepId = target.dataset.nextStepId;
            if (nextStepId && !shown.has(nextStepId)) {
              shown.add(nextStepId);
              trackAnalyticsEvent("next_step_shown", {
                ...basePayload,
                next_step_id: nextStepId,
              });
            }
            observer.unobserve(target);
          }
        },
        { threshold: 0.25 }
      );

      root
        .querySelectorAll<HTMLAnchorElement>("[data-next-step-id]")
        .forEach(link => {
          observer.observe(link);
          link.addEventListener("click", () => {
            const nextStepId = link.dataset.nextStepId;
            if (!nextStepId) return;
            trackAnalyticsEvent("next_step_click", {
              ...basePayload,
              next_step_id: nextStepId,
            });
          });
        });
    });
  }

  initNextSteps();
  document.addEventListener("astro:page-load", initNextSteps);
</script>
