---
import { serializeJsonLd } from "@/utils/serializeJsonLd";
import { SITE } from "@/config";
import { getPageLastmod } from "@/utils/pageLastmod";

export interface CalculatorFaq {
  question: string;
  answer: string;
}

interface Props {
  name: string;
  description: string;
  faqs?: CalculatorFaq[];
  /**
   * Fecha ISO (YYYY-MM-DD) del dato subyacente de la calculadora. Cuando se
   * provee, emite `dateModified` en el schema WebApplication como señal de
   * frescura. Útil en conversores cuyo valor (UF, UTM) cambia a diario o
   * mensualmente.
   */
  dateModified?: string;
}

const { name, description, faqs, dateModified: dateModifiedProp } = Astro.props;
const dateModified = dateModifiedProp ?? getPageLastmod(Astro.url.pathname);

const SITE_URL = (Astro.site ?? new URL(Astro.url.origin)).href.replace(
  /\/$/,
  ""
);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

const applicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name,
  description,
  url: canonicalUrl,
  applicationCategory: "FinanceApplication",
  operatingSystem: "Web",
  inLanguage: "es-CL",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "CLP",
  },
  publisher: {
    "@type": "Organization",
    name: SITE.title,
    url: SITE_URL,
  },
  ...(dateModified ? { dateModified } : {}),
};

const faqSchema =
  faqs && faqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs.map(({ question, answer }: CalculatorFaq) => ({
          "@type": "Question",
          name: question,
          acceptedAnswer: {
            "@type": "Answer",
            text: answer,
          },
        })),
      }
    : null;
---

<script
  type="application/ld+json"
  is:inline
  set:html={serializeJsonLd(applicationSchema)}
/>
{
  faqSchema && (
    <script
      type="application/ld+json"
      is:inline
      set:html={serializeJsonLd(faqSchema)}
    />
  )
}
