---
import { SITE } from "@/config";

interface Props {
  name: string;
  description: string;
}

const { name, description } = Astro.props;

const SITE_URL = (Astro.site ?? new URL(Astro.url.origin)).href.replace(
  /\/$/,
  ""
);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name,
  description,
  url: canonicalUrl,
  applicationCategory: "FinanceApplication",
  operatingSystem: "Web",
  inLanguage: "es-CL",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "CLP",
  },
  publisher: {
    "@type": "Organization",
    name: SITE.title,
    url: SITE_URL,
  },
};
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(schema)}
/>
