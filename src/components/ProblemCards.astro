---
import { getCollection } from "astro:content";
import { getPath } from "@/utils/getPath";
import type { HubCluster } from "@/config/clusters";

// ---------------------------------------------------------------
// "¿Qué necesitas resolver?" — variante A+
//
// Lista numerada editorial agrupada en 3 temas, con una línea de
// meta por fila ("Actualizado may 2026 · calculadora").
//
// Fechas (TD-0089): TODAS las fechas se derivan del contenido, sin
// valores manuales. Las cards de blog usan `updatedDate ?? pubDate`
// del propio artículo; las cards que enlazan calculadoras/hubs usan
// el post más reciente del cluster del tema (señal real de frescura
// del área). El guardrail check:homepage-surface-freshness impide
// reintroducir fechas hardcodeadas.
// ---------------------------------------------------------------

type ContentType = "calculadora" | "guía" | "artículo";

type CardSource =
  | { kind: "blog"; slug: string }
  | { kind: "cluster"; cluster: HubCluster };

interface Card {
  number: string;
  title: string;
  description: string;
  href: string;
  ctaLabel: string;
  contentTypes: ContentType[];
  source: CardSource;
}

interface Group {
  eyebrow: string;
  cards: Card[];
}

const groups: Group[] = [
  {
    eyebrow: "I · Trabajo",
    cards: [
      {
        number: "01",
        title: "Me contrataron",
        description:
          "Entiende tu liquidación, cotizaciones y qué derechos tienes desde el primer día.",
        href: "/posts/liquidacion-de-sueldo/",
        ctaLabel: "Ver artículo",
        contentTypes: ["artículo"],
        source: { kind: "blog", slug: "liquidacion-de-sueldo" },
      },
      {
        number: "02",
        title: "Me van a despedir / me despidieron",
        description:
          "Calcula tu finiquito, aviso previo e indemnización según la causal de término.",
        href: "/calculadoras/finiquito-indemnizacion/",
        ctaLabel: "Usar calculadora",
        contentTypes: ["calculadora"],
        source: { kind: "cluster", cluster: "empleo-ingresos" },
      },
    ],
  },
  {
    eyebrow: "II · Deuda y crédito",
    cards: [
      {
        number: "03",
        title: "Tengo deudas",
        description:
          "Entiende tus opciones: renegociación, DICOM, Ley del consumidor y derechos frente al cobrador.",
        href: "/guias/deuda-credito/",
        ctaLabel: "Ver guía",
        contentTypes: ["guía"],
        source: { kind: "cluster", cluster: "deuda-credito" },
      },
      {
        number: "04",
        title: "Me cobraron algo que no reconozco",
        description:
          "Qué hacer si apareces en DICOM sin saber por qué, o si detectas fraude en tu tarjeta.",
        href: "/posts/fraude-tarjeta-que-hacer/",
        ctaLabel: "Leer artículo",
        contentTypes: ["artículo"],
        source: { kind: "blog", slug: "fraude-tarjeta-que-hacer" },
      },
    ],
  },
  {
    eyebrow: "III · Ahorro e impuestos",
    cards: [
      {
        number: "05",
        title: "Quiero ahorrar",
        description:
          "APV, fondos mutuos, UF y estrategias de ahorro con herramientas concretas.",
        href: "/guias/ahorro-e-inversion/",
        ctaLabel: "Ver guía",
        contentTypes: ["guía"],
        source: { kind: "cluster", cluster: "ahorro-e-inversion" },
      },
      {
        number: "06",
        title: "Debo declarar renta",
        description:
          "Calcula cuánto pagar o cuánto te devuelven, y navega el proceso del F-22 sin errores.",
        href: "/calculadoras/operacion-renta/",
        ctaLabel: "Usar calculadora",
        contentTypes: ["calculadora"],
        source: { kind: "cluster", cluster: "impuestos-personas" },
      },
    ],
  },
];

// Resolver fechas reales desde el contenido (sin valores manuales).
const blogEntries = await getCollection("blog");
const publishedEntries = blogEntries.filter(e => e.data.draft !== true);

const blogDateMap = new Map<string, Date>(
  publishedEntries.map(e => [
    e.data.slug,
    (e.data.updatedDate ?? e.data.pubDate) as Date,
  ])
);

// Cluster → fecha del post más reciente (updatedDate ?? pubDate) del tema.
const clusterDateMap = new Map<string, Date>();
for (const e of publishedEntries) {
  const cluster = e.data.cluster as string | undefined;
  if (!cluster) continue;
  const date = (e.data.updatedDate ?? e.data.pubDate) as Date;
  const current = clusterDateMap.get(cluster);
  if (!current || date > current) clusterDateMap.set(cluster, date);
}

function resolveDate(source: CardSource): Date | null {
  if (source.kind === "blog") {
    return blogDateMap.get(source.slug) ?? null;
  }
  return clusterDateMap.get(source.cluster) ?? null;
}

function formatDate(date: Date | null): string {
  if (!date) return "";
  return date.toLocaleDateString("es-CL", { month: "short", year: "numeric" });
}

function metaLine(card: Card): string {
  const date = resolveDate(card.source);
  const dateStr = date ? `Actualizado ${formatDate(date)}` : "Actualizado";
  const types = card.contentTypes.join(" + ");
  return `${dateStr} · ${types}`;
}
---

<section class="border-b border-border py-8">
  <h2 class="mb-1 text-xl font-bold sm:text-2xl">¿Qué necesitas resolver?</h2>
  <p class="mb-6 text-sm text-secondary">Elige tu situación y entra directo.</p>

  <div class="space-y-6">
    {
      groups.map(group => (
        <div>
          <p class="mb-2 text-xs font-semibold tracking-widest text-secondary uppercase">
            {group.eyebrow}
          </p>
          <ul class="divide-y divide-border">
            {group.cards.map(card => (
              <li>
                <a
                  href={getPath(card.href)}
                  class="group -mx-2 flex items-start gap-4 rounded px-2 py-3 transition-colors hover:bg-accent/5"
                  data-analytics-cta="home-problem-card"
                  data-analytics-label={card.title}
                  data-analytics-location="home_problem_cards"
                >
                  <span
                    class="w-7 shrink-0 text-lg font-bold text-secondary tabular-nums transition-colors group-hover:text-accent"
                    style="font-family: var(--font-display)"
                  >
                    {card.number}
                  </span>
                  <div class="min-w-0 flex-1">
                    <p class="font-semibold text-foreground transition-colors group-hover:text-accent">
                      {card.title}
                    </p>
                    <p class="mt-0.5 text-sm leading-relaxed text-secondary">
                      {card.description}
                    </p>
                    <p class="mt-1 font-mono text-xs text-muted">
                      {metaLine(card)}
                    </p>
                  </div>
                  <span class="shrink-0 text-sm whitespace-nowrap text-accent underline decoration-dashed underline-offset-2">
                    {card.ctaLabel} →
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
