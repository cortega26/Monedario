---
interface Props {
  id?: string;
  headingId?: string;
  title?: string;
  class?: string;
  /** Añade el bloque de estimación referencial bajo el resultado (F-08). */
  disclaimer?: boolean;
}

const {
  id,
  headingId,
  title = "Resultado",
  class: extraClass,
  disclaimer,
} = Astro.props;
---

<div
  id={id ?? "resultado"}
  class:list={["rounded-xl border border-border bg-background p-6", extraClass]}
>
  <h2 id={headingId} class="mb-5 text-lg font-semibold" tabindex="-1">
    {title}
  </h2>
  <slot />
  {
    disclaimer && (
      <p class="mt-4 rounded-lg border border-border bg-surface-muted/30 px-3 py-2 text-xs text-muted">
        <span class="font-semibold text-foreground">
          Estimación referencial.
        </span>{" "}
        No es una cotización ni una liquidación oficial.
      </p>
    )
  }
</div>
