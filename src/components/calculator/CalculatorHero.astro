---
import ContentTypeBadge from "@/components/ContentTypeBadge.astro";

interface Props {
  title: string;
  description?: string;
  descriptionClass?: string;
}

const {
  title,
  description,
  descriptionClass = "max-w-2xl text-secondary",
} = Astro.props;
---

<section class="border-b border-border pt-8 pb-6">
  <ContentTypeBadge type="Calculadora" class="mt-4" />
  <h1 class="mb-4 text-3xl font-bold sm:text-4xl">{title}</h1>
  {description && <p class={descriptionClass}>{description}</p>}
  <slot />
</section>
