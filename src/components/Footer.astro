---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { getPath } from "@/utils/getPath";

const currentYear = new Date().getFullYear();
const topicLinks = [
  { href: "/guias/sueldo-remuneraciones/", label: "Sueldo" },
  { href: "/guias/deuda-credito/", label: "Deuda" },
  { href: "/guias/pensiones-afp/", label: "AFP" },
  { href: "/guias/impuestos-personas/", label: "Impuestos" },
  { href: "/guias/uf-costo-de-vida/", label: "UF" },
];
const toolLinks = [
  { href: "/calculadoras/sueldo-liquido/", label: "Sueldo líquido" },
  { href: "/calculadoras/finiquito-indemnizacion/", label: "Finiquito" },
  { href: "/calculadoras/credito-consumo/", label: "Crédito" },
  { href: "/calculadoras/apv/", label: "APV" },
  { href: "/calculadoras/", label: "Todas" },
];
const trustLinks = [
  { href: "/about/", label: "Proceso editorial" },
  { href: "/glosario/", label: "Glosario" },
  { href: "/leyes/", label: "Leyes" },
  { href: "/cambios/", label: "Novedades" },
  { href: "/contacto/", label: "Contacto" },
  { href: "/accessibilidad/", label: "Accesibilidad" },
  { href: "/apoyar/?src=footer", label: "Apoyar el proyecto" },
];

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  style="content-visibility: auto; contain-intrinsic-size: 450px;"
  {...attrs}
>
  <div class="border-t border-border py-8">
    <div class="grid gap-7 md:grid-cols-3">
      <nav aria-label="Explora por tema">
        <h2 class="text-sm font-semibold text-foreground">Explora por tema</h2>
        <ul class="mt-3 space-y-2 text-sm text-secondary">
          {
            topicLinks.map(link => (
              <li>
                <a
                  href={getPath(link.href)}
                  class="hover:text-accent hover:underline"
                  data-analytics-cta="hub-route"
                  data-analytics-label={link.label}
                  data-analytics-location="footer_topics"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label="Herramientas">
        <h2 class="text-sm font-semibold text-foreground">Herramientas</h2>
        <ul class="mt-3 space-y-2 text-sm text-secondary">
          {
            toolLinks.map(link => (
              <li>
                <a
                  href={getPath(link.href)}
                  class="hover:text-accent hover:underline"
                  data-analytics-cta="hub-route"
                  data-analytics-label={link.label}
                  data-analytics-location="footer_tools"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label="Confianza">
        <h2 class="text-sm font-semibold text-foreground">Confianza</h2>
        <ul class="mt-3 space-y-2 text-sm text-secondary">
          {
            trustLinks.map(link => (
              <li>
                <a
                  href={getPath(link.href)}
                  class="hover:text-accent hover:underline"
                  data-analytics-cta="hub-route"
                  data-analytics-label={link.label}
                  data-analytics-location="footer_trust"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-8 flex flex-col items-center justify-between gap-4 border-t border-border pt-5 text-sm text-secondary sm:flex-row-reverse"
    >
      <Socials />
      <div class="text-center sm:text-left">
        <span>Contenido &#169; {currentYear} Monedario</span>
        <span aria-hidden="true" class="hidden sm:inline">&nbsp;·&nbsp;</span>
        <span>
          {/*
            Sin noreferrer: es el portafolio del autor, nos interesa el
            referrer para tracking de visitas desde Monedario.
          */}
          Desarrollado por <a
            href="https://tooltician.com/"
            target="_blank"
            rel="noopener"
            class="hover:text-accent hover:underline">Tooltician</a
          >
        </span>
      </div>
    </div>
  </div>
</footer>
