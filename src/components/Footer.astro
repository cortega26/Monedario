---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { SITE } from "@/config";
import { CALCULATOR_FOOTER_SHORTCUTS } from "@/config/calculatorPortfolio";
import { GUIDE_HUB_ORDER, GUIDE_HUBS } from "@/config/clusters";
import { getPath } from "@/utils/getPath";

const currentYear = new Date().getFullYear();
const topicLinks = GUIDE_HUB_ORDER.map(slug => ({
  href: `/guias/${slug}/`,
  label: GUIDE_HUBS[slug].nombre,
}));
const toolLinks = [
  ...CALCULATOR_FOOTER_SHORTCUTS,
  { href: "/calculadoras/", label: "Todas" },
];
const trustLinks = [
  { href: "/acerca-de/", label: "Acerca de" },
  { href: "/autor/", label: "Autor" },
  { href: "/metodologia/", label: "Metodología" },
  { href: "/calendario/", label: "Calendario financiero" },
  { href: "/como-usamos-los-datos/", label: "Cómo usamos los datos" },
  { href: "/glosario/", label: "Glosario" },
  { href: "/leyes/", label: "Leyes" },
  { href: "/accessibilidad/", label: "Accesibilidad" },
  { href: "/privacidad/", label: "Privacidad" },
  { href: "/cookies/", label: "Cookies" },
  { href: "/terminos/", label: "Términos" },
  { href: "/apoyar/?src=footer", label: "Apoyar el proyecto" },
];

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-t border-border py-8">
    <div class="grid grid-cols-2 gap-x-6 gap-y-7 md:grid-cols-3">
      <nav aria-label="Explora por tema">
        <h2 class="text-sm font-semibold text-foreground">Explora por tema</h2>
        <ul class="mt-3 space-y-2 text-sm text-secondary">
          {
            topicLinks.map(link => (
              <li>
                <a
                  href={getPath(link.href)}
                  class="inline-flex min-h-[32px] items-center py-0.5 hover:text-accent hover:underline md:min-h-[24px]"
                  data-analytics-cta="hub-route"
                  data-analytics-label={link.label}
                  data-analytics-location="footer_topics"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label="Herramientas">
        <h2 class="text-sm font-semibold text-foreground">Herramientas</h2>
        <ul class="mt-3 space-y-2 text-sm text-secondary">
          {
            toolLinks.map(link => (
              <li>
                <a
                  href={getPath(link.href)}
                  class="inline-flex min-h-[32px] items-center py-0.5 hover:text-accent hover:underline md:min-h-[24px]"
                  data-analytics-cta="hub-route"
                  data-analytics-label={link.label}
                  data-analytics-location="footer_tools"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav class="col-span-2 md:col-span-1" aria-label="Confianza">
        <h2 class="text-sm font-semibold text-foreground">Confianza</h2>
        <ul
          class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm text-secondary md:block md:space-y-2"
        >
          {
            trustLinks.map(link => (
              <li>
                <a
                  href={getPath(link.href)}
                  class="inline-flex min-h-[32px] items-center py-0.5 hover:text-accent hover:underline md:min-h-[24px]"
                  data-analytics-cta="hub-route"
                  data-analytics-label={link.label}
                  data-analytics-location="footer_trust"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-8 flex flex-col items-center justify-between gap-4 border-t border-border pt-5 text-sm text-secondary sm:flex-row"
    >
      <div class="text-center sm:text-left">
        <span>Contenido &#169; {currentYear} Monedario</span>
        <br class="sm:hidden" /><span
          aria-hidden="true"
          class="hidden sm:inline">&nbsp;·&nbsp;</span
        ><span>
          {
            /*
            Sin noreferrer: es el portafolio del autor, nos interesa el
            referrer para tracking de visitas desde Monedario.
          */
          }
          Desarrollado por <a
            href={SITE.authorPortfolio}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-[32px] items-center py-0.5 hover:text-accent hover:underline sm:min-h-[24px]"
            >Tooltician</a
          >
        </span>
      </div>
      <Socials />
    </div>
  </div>
</footer>
