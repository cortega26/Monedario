---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import generalSans600 from "@/assets/fonts/general-sans-600.woff2";
import Dropdown from "./Dropdown.astro";
import type { DropdownItem } from "./Dropdown.astro";
import { SITE } from "@/config";
import { GUIDE_HUB_ORDER, GUIDE_HUBS } from "@/config/clusters";
import { getPath } from "@/utils/getPath";

const generalSans600Src = `url("${generalSans600}") format("woff2")`;

const guiasDropdown: DropdownItem[] = GUIDE_HUB_ORDER.map(slug => ({
  href: getPath(`/guias/${slug}/`),
  label: GUIDE_HUBS[slug].nombre,
}));

const { pathname } = Astro.url;
const basePath = getPath("/").replace(/\/$/, "");
const normalizedPathname =
  basePath && pathname.startsWith(basePath)
    ? pathname.slice(basePath.length) || "/"
    : pathname;

// Remove trailing slash from normalized pathname if exists
const currentPath =
  normalizedPathname.endsWith("/") && normalizedPathname !== "/"
    ? normalizedPathname.slice(0, -1)
    : normalizedPathname;

const normalizeNavPath = (path: string) => {
  const normalizedPath =
    basePath && path.startsWith(basePath)
      ? path.slice(basePath.length) || "/"
      : path;

  return normalizedPath.endsWith("/") && normalizedPath !== "/"
    ? normalizedPath.slice(0, -1)
    : normalizedPath;
};

const isActive = (path: string) => {
  const targetPath = normalizeNavPath(path);

  return (
    currentPath === targetPath ||
    (targetPath !== "/" && currentPath.startsWith(`${targetPath}/`))
  );
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
>
  Saltar al contenido
</a>

<header class="relative z-50 app-layout">
  <div
    id="top-nav-wrap"
    class:list={[
      "py-4 lg:py-6",
      "border-b border-border",
      "relative w-full bg-background",
    ]}
  >
    <nav
      id="nav-menu"
      class="flex w-full flex-col lg:flex-row lg:items-center lg:justify-between"
    >
      <div class="flex items-center justify-between lg:shrink-0">
        <a href={getPath("/")} class="brand-mark py-1 whitespace-nowrap">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="brand-icon"
            aria-hidden="true"
            focusable="false"
          >
            <rect x="6" y="1.5" width="12" height="5" rx="2.5"></rect>
            <rect x="3" y="9.5" width="18" height="5" rx="2.5"></rect>
            <rect x="0" y="17.5" width="24" height="5" rx="2.5"></rect>
          </svg>
          {SITE.title}
        </a>
        <button
          id="menu-btn"
          class="focus-outline p-3 lg:hidden"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="menu-items"
        >
          <IconX id="close-icon" class="hidden" />
          <IconMenuDeep id="menu-icon" />
        </button>
      </div>
      <ul
        id="menu-items"
        class:list={[
          "mt-3 grid w-full grid-cols-2 gap-x-3 gap-y-1 border-t border-border/60 pt-2",
          "hidden",
          "lg:mt-0 lg:flex lg:w-auto lg:flex-row lg:items-center lg:gap-x-5 lg:gap-y-0 lg:border-t-0 lg:pt-0",
        ]}
      >
        <li class="col-span-2 rounded-lg transition-colors hover:bg-accent/5 focus-within:bg-accent/5 lg:rounded-none lg:hover:bg-transparent lg:focus-within:bg-transparent">
          <Dropdown
            id="guias-dropdown"
            label="Guías"
            items={guiasDropdown.map(i => ({
              ...i,
              isActive: isActive(i.href),
              analyticsCta: "hub-route",
              analyticsLocation: "header_guides",
            }))}
            isActive={isActive("/guias")}
          />
        </li>
        <!-- La sección Actualidad está omitida por ser una sección futura sin contenido de noticias -->
        <li class="col-span-2">
          <a
            href={getPath("/calculadoras/")}
            class:list={[
              "header-nav-item block w-full rounded-lg px-4 py-[14px] text-left transition-colors hover:bg-accent/5 focus-visible:bg-accent/5 lg:w-auto lg:rounded-none lg:px-2 lg:py-1 lg:hover:bg-transparent lg:focus-visible:bg-transparent",
              { "active-nav text-foreground": isActive("/calculadoras") },
            ]}
            data-analytics-cta="hub-route"
            data-analytics-label="Calculadoras"
            data-analytics-location="header_primary"
          >
            Calculadoras
          </a>
        </li>
        <li class="col-span-2">
          <a
            href={getPath("/glosario/")}
            class:list={[
              "header-nav-item block w-full rounded-lg px-4 py-[14px] text-left transition-colors hover:bg-accent/5 focus-visible:bg-accent/5 lg:w-auto lg:rounded-none lg:px-2 lg:py-1 lg:hover:bg-transparent lg:focus-visible:bg-transparent",
              { "active-nav text-foreground": isActive("/glosario") },
            ]}
            data-analytics-cta="hub-route"
            data-analytics-label="Glosario"
            data-analytics-location="header_primary"
          >
            Glosario
          </a>
        </li>
        <li class="col-span-2">
          <a
            href={getPath("/metodologia/")}
            class:list={[
              "header-nav-item block w-full rounded-lg px-4 py-[14px] text-left transition-colors hover:bg-accent/5 focus-visible:bg-accent/5 lg:w-auto lg:rounded-none lg:px-2 lg:py-1 lg:hover:bg-transparent lg:focus-visible:bg-transparent",
              { "active-nav text-foreground": isActive("/metodologia") },
            ]}
            data-analytics-cta="hub-route"
            data-analytics-label="Metodología"
            data-analytics-location="header_primary"
          >
            Metodología
          </a>
        </li>
        <li class="col-span-1 flex items-center justify-start border-t border-border/60 pt-3 lg:border-t-0 lg:pt-0">
          <a
            href={getPath("/buscar/")}
            class:list={[
              "focus-outline flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm font-medium transition-colors",
              {
                "border-accent text-accent":
                  isActive("/buscar") || isActive("/search"),
                "border-border text-secondary hover:border-accent/60 hover:text-foreground":
                  !(isActive("/buscar") || isActive("/search")),
              },
            ]}
            title="Buscar en Monedario"
            aria-label="Buscar"
          >
            <IconSearch class="size-3.5 shrink-0" />
            <span>Buscar</span>
          </a>
        </li>
        {SITE.lightAndDarkMode && (
          <li class="col-span-1 flex items-center justify-end border-t border-border/60 pt-3 lg:justify-center lg:border-t-0 lg:pt-0">
            <button
              id="theme-btn"
              class="focus-outline relative size-12 p-4 lg:size-11 hover:[&>svg]:stroke-accent"
              title="Cambiar modo claro/oscuro"
              aria-label="Cambiar tema"
            >
              <IconMoon
                aria-hidden="true"
                class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90"
              />
              <IconSunHigh
                aria-hidden="true"
                class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0"
              />
            </button>
          </li>
        )}
      </ul>
    </nav>
  </div>
</header>

<style is:global define:vars={{ generalSans600Src }}>
  @font-face {
    font-family: "General Sans";
    font-style: normal;
    font-weight: 600;
    font-display: optional;
    src: var(--generalSans600Src);
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.38em;
    font-family: "General Sans", var(--font-body);
    font-size: clamp(1.5rem, 1.3rem + 0.78vw, 1.82rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: 0.015em;
    color: var(--text-primary);
    text-decoration: none;
    transition: opacity 150ms ease;
  }

  .brand-icon {
    width: 1.1em;
    height: 1.1em;
    fill: var(--color-accent);
    flex-shrink: 0;
    translate: 0 0.04em; /* optical alignment with cap-height */
  }

  .brand-mark:hover,
  .brand-mark:focus-visible {
    opacity: 0.9;
  }

  .header-nav-item {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 150ms ease;
  }

  .header-nav-item:hover,
  .header-nav-item:focus-visible {
    color: var(--text-primary);
  }
</style>

<script>
  const SELECTORS = {
    menuBtn: "#menu-btn",
    menuItems: "#menu-items",
    menuIcon: "#menu-icon",
    closeIcon: "#close-icon",
    navLink: "#menu-items a",
  };

  function toggleNav() {
    const navWindow = window as Window & {
      __monedarioNavAbort?: AbortController;
    };
    navWindow.__monedarioNavAbort?.abort();
    const controller = new AbortController();
    navWindow.__monedarioNavAbort = controller;

    const menuBtn = document.querySelector<HTMLButtonElement>(
      SELECTORS.menuBtn
    );
    const menuItems = document.querySelector<HTMLElement>(SELECTORS.menuItems);
    const menuIcon = document.querySelector(SELECTORS.menuIcon);
    const closeIcon = document.querySelector(SELECTORS.closeIcon);

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const isOpen = () => menuBtn.getAttribute("aria-expanded") === "true";

    const open = () => {
      menuBtn.setAttribute("aria-expanded", "true");
      menuBtn.setAttribute("aria-label", "Cerrar menú");
      menuItems.classList.remove("hidden");
      menuIcon.classList.add("hidden");
      closeIcon.classList.remove("hidden");
      const firstControl = menuItems.querySelector<HTMLElement>(
        "button, a, [tabindex]:not([tabindex='-1'])"
      );
      firstControl?.focus();
    };

    const close = ({ restoreFocus = true } = {}) => {
      menuBtn.setAttribute("aria-expanded", "false");
      menuBtn.setAttribute("aria-label", "Abrir menú");
      menuItems.classList.add("hidden");
      menuIcon.classList.remove("hidden");
      closeIcon.classList.add("hidden");
      if (restoreFocus) menuBtn.focus();
    };

    menuBtn.addEventListener(
      "click",
      () => {
        if (isOpen()) {
          close();
        } else {
          open();
        }
      },
      { signal: controller.signal }
    );

    // Escape to close
    document.addEventListener(
      "keydown",
      (e: KeyboardEvent) => {
        if (e.key === "Escape" && isOpen()) {
          close();
        }
      },
      { signal: controller.signal }
    );

    // Close when clicking a nav link
    menuItems.querySelectorAll(SELECTORS.navLink).forEach(link => {
      link.addEventListener(
        "click",
        () => {
          if (isOpen()) close({ restoreFocus: false });
        },
        { signal: controller.signal }
      );
    });

    // Close when clicking outside
    document.addEventListener(
      "click",
      e => {
        const target = e.target as Node;
        if (
          isOpen() &&
          !menuBtn.contains(target) &&
          !menuItems.contains(target)
        ) {
          close();
        }
      },
      { signal: controller.signal }
    );
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>
