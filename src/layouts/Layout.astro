---
import { serializeJsonLd } from "@/utils/serializeJsonLd";
import { ClientRouter } from "astro:transitions";
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import { SITE } from "@/config";
import { robotsMetaFor } from "@/config/indexability";
import packageInfo from "../../package.json";
import { getPath } from "@/utils/getPath";
import "@/styles/global.css";

type Props = {
  title?: string;
  author?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  enableClientRouter?: boolean;
  privacyMode?: boolean;
};

const performanceSensitivePath = /^\/(?:posts|guias|calculadoras)(?:\/|$)/.test(
  Astro.url.pathname
);
// Fraunces uses `font-display: swap`. Preload it where initial content needs it
// so CSS discovery does not delay the font and shift the fallback text.
// Calculator headings and footers use the body font (TD-0101); sueldo-liquido
// alone needs Fraunces for its visible result figure and already downloads it.
const isHomepage = Astro.url.pathname === "/" || Astro.url.pathname === "";
const shouldPreloadDisplayFont =
  !/^\/calculadoras(?:\/|$)/.test(Astro.url.pathname) ||
  Astro.url.pathname === "/calculadoras/sueldo-liquido/";

const {
  title = SITE.title,
  author = SITE.author,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.url).href,
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  enableClientRouter = !performanceSensitivePath,
  privacyMode = false,
} = Astro.props;

const siteContext = Astro.site ?? Astro.url;
const resolvedCanonicalURL = new URL(canonicalURL, siteContext).href;
// Indexabilidad declarativa (plan 120): el contrato decide el meta robots por
// path; las páginas no lo hardcodean.
const robotsMeta = robotsMetaFor(Astro.url.pathname);
// Resiliencia RES-04 (plan 122): en calculadoras, sin JS el formulario debe
// verse explícitamente no operativo (el cálculo es client-side por diseño).
const isCalculatorPage = /^\/calculadoras\/.+/.test(Astro.url.pathname);
const socialImageURL = new URL(ogImage, siteContext);
const defaultSocialImagePath = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png";
const defaultSocialImageURL = new URL(defaultSocialImagePath, siteContext);
const ogImageExt = socialImageURL.pathname.split(".").pop()?.toLowerCase();
const ogImageType =
  socialImageURL.pathname === defaultSocialImageURL.pathname
    ? SITE.ogImageType
    : ogImageExt === "jpg" || ogImageExt === "jpeg"
      ? "image/jpeg"
      : ogImageExt === "webp"
        ? "image/webp"
        : "image/png";

const SITE_ORIGIN = (Astro.site ?? new URL(Astro.url.origin)).href.replace(
  /\/+$/,
  ""
);

const ORGANIZATION_ID = `${SITE_ORIGIN}/#organization`;

const structuredData = !pubDatetime
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${SITE_ORIGIN}/#website`,
          name: SITE.title,
          url: SITE_ORIGIN,
          description: description,
          inLanguage: "es-CL",
          publisher: { "@id": ORGANIZATION_ID },
          potentialAction: {
            "@type": "SearchAction",
            target: {
              "@type": "EntryPoint",
              urlTemplate: `${SITE_ORIGIN}/buscar/?q={search_term_string}`,
            },
            "query-input": "required name=search_term_string",
          },
        },
        {
          "@type": "Organization",
          "@id": ORGANIZATION_ID,
          name: SITE.title,
          url: SITE_ORIGIN,
          description,
          foundingDate: "2026-01",
          areaServed: "CL",
          sameAs: [SITE.companyLinkedIn],
          contactPoint: {
            "@type": "ContactPoint",
            contactType: "editorial",
            email: "contacto@monedario.cl",
            availableLanguage: "es",
          },
          logo: {
            "@type": "ImageObject",
            url: `${SITE_ORIGIN}/favicon.svg`,
          },
          founder: {
            "@type": "Person",
            "@id": `${SITE_ORIGIN}/autor/`,
            name: SITE.authorFullName,
          },
        },
        ...(isHomepage
          ? [
              {
                "@type": "WebPage",
                "@id": `${SITE_ORIGIN}/#webpage`,
                url: `${SITE_ORIGIN}/`,
                name: SITE.title,
                ...(modDatetime
                  ? { dateModified: modDatetime.toISOString() }
                  : {}),
                isPartOf: { "@id": `${SITE_ORIGIN}/#website` },
                about: { "@id": ORGANIZATION_ID },
                speakable: {
                  "@type": "SpeakableSpecification",
                  cssSelector: ["h1", "[data-speakable]"],
                },
              },
            ]
          : []),
      ],
    }
  : null;
---

<!doctype html>
<html
  dir={SITE.dir}
  lang={SITE.lang ?? "es"}
  class:list={["no-js", scrollSmooth && "scroll-smooth"]}
  data-analytics-transport={
    !privacyMode && SITE.analyticsTransport ? "enabled" : undefined
  }
  data-private-compute={privacyMode ? "true" : undefined}
  data-app-version={packageInfo.version}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={getPath("/fonts/source-sans-3-latin-es-400-600.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {shouldPreloadDisplayFont && (
      <link
        rel="preload"
        href={getPath("/fonts/fraunces-latin-es-400-700.woff2")}
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}
    <link rel="icon" href={getPath("/favicon.ico")} sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={getPath("/favicon-32x32.png")}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={getPath("/favicon-16x16.png")}
    />
    <link rel="icon" type="image/svg+xml" href={getPath("/favicon.svg")} />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={getPath("/apple-touch-icon.png")}
    />
    <link rel="manifest" href={getPath("/site.webmanifest")} />
    <meta name="apple-mobile-web-app-title" content={SITE.title} />
    <meta name="theme-color" content="#1a4f8a" />
    <link rel="canonical" href={resolvedCanonicalURL} />
    {robotsMeta && <meta name="robots" content={robotsMeta} />}
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href={getPath("/sitemap-index.xml")} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={pubDatetime ? "article" : "website"} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:secure_url" content={socialImageURL} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />

    <!-- Article Published/Modified time -->
    {pubDatetime && (
      <meta
        property="article:published_time"
        content={pubDatetime.toISOString()}
      />
    )}
    {modDatetime && (
      <meta
        property="article:modified_time"
        content={modDatetime.toISOString()}
      />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@monedario_cl" />
    <meta name="twitter:url" content={resolvedCanonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={description} />

    <!-- Google JSON-LD Structured data -->
    {structuredData && (
      <script
        type="application/ld+json"
        is:inline
        set:html={serializeJsonLd(structuredData)}
      ></script>
    )}

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", siteContext).href}
    />

    <meta name="theme-color" content="#f8f9fb" id="theme-color-meta" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    {enableClientRouter && <ClientRouter />}

    <slot name="head" />

    <!-- Minimal inline script to prevent FOUC - sets theme immediately -->
    <script is:inline>
      (function () {
        const initialColorScheme = ""; // "light" | "dark"
        // Resiliencia RES-04 (plan 122): con JS disponible, el formulario de
        // calculadora vuelve a ser operable (el CSS de .no-js lo atenúa).
        document.documentElement.classList.remove("no-js");
        // Resiliencia RES-035/036 (plan 122): storage bloqueado no debe
        // impedir el render ni el cálculo.
        let currentTheme = null;
        try {
          currentTheme = localStorage.getItem("theme");
        } catch {
          currentTheme = null;
        }

        function getPreferTheme() {
          if (currentTheme) return currentTheme;
          if (initialColorScheme) return initialColorScheme;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        const themeValue = getPreferTheme();
        const isDark = themeValue === "dark";
        const html = document.documentElement;

        // Set theme immediately to prevent flash
        html.setAttribute("data-theme", themeValue);

        // Set inline style on <html> so the background is correct before the
        // stylesheet is downloaded and parsed. Without this, the browser canvas
        // defaults to white and the dark background only kicks in once CSS
        // variables cascade — causing the visible white flash.
        html.style.backgroundColor = isDark ? "#0f1923" : "#f8f9fb";
        // color-scheme tells the browser which native UI palette (scrollbars,
        // form controls, canvas between-page color) to use immediately.
        html.style.colorScheme = themeValue;

        // Set theme-color meta to match background (prevents white flash on dark mode)
        const themeColor = document.querySelector('meta[name="theme-color"]');
        if (themeColor) {
          themeColor.setAttribute("content", isDark ? "#0f1923" : "#f8f9fb");
        }

        // Export minimal API for external script
        window.theme = {
          themeValue: themeValue,
          getTheme: () => window.theme.themeValue,
          setTheme: val => {
            window.theme.themeValue = val;
          },
        };
      })();
    </script>
  </head>
  <body>
    {isCalculatorPage && (
      <noscript>
        <div
          class="app-layout mt-4 rounded-lg border border-amber-500/30 bg-amber-500/10 p-3 text-sm text-secondary"
          role="status"
        >
          Esta calculadora necesita JavaScript para calcular. Puedes leer la
          explicación y los valores de referencia; para usar el formulario,
          activa JavaScript en tu navegador.
        </div>
      </noscript>
    )}
    <slot />

    <!-- Load full theme logic -->
    {!privacyMode && <script src="../scripts/analytics.ts"></script>}
    <script src="../scripts/theme.ts"></script>
    {!privacyMode && <script is:inline src="/sw-register.js" defer></script>}
  </body>
</html>
