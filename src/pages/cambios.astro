---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { changelog } from "@/data/changelog";
import { SITE } from "@/config";
---

<Layout
  title="Novedades y cambios | Monedario"
  description={`Registro de cambios editoriales, correcciones y mejoras en ${SITE.title}.`}
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout">
    <section class="border-b border-border pt-8 pb-6">
      <h1 class="my-4 text-3xl font-bold sm:text-4xl">
        📋 Novedades y cambios
      </h1>
      <p class="max-w-xl text-secondary">
        Registro de actualizaciones editoriales, correcciones de datos y mejoras
        en calculadoras. Ordenado del más reciente al más antiguo.
      </p>
    </section>

    <section class="py-8">
      <ol class="space-y-8 border-l border-border pl-10">
        {
          changelog.map(entry => (
            <li class="relative">
              <span class="absolute -left-8 flex h-6 w-6 items-center justify-center rounded-full bg-accent/15 text-xs font-bold text-accent">
                ✦
              </span>
              <p class="mb-1 text-xs font-medium tracking-wide text-muted uppercase">
                {entry.date}
              </p>
              <h2 class="mb-1 text-base font-semibold">{entry.title}</h2>
              <p class="text-sm text-secondary">{entry.description}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
  <Footer />
</Layout>
