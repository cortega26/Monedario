---
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import { getPath } from "@/utils/getPath";
import { SITE } from "@/config";
import registry from "@/data/correcciones.json";
import {
  correctionAreas,
  correctionSearchText,
  effectiveDate,
  formatCorrectionDate,
  groupCorrectionsByMonth,
  type Correction,
} from "@/utils/corrections";

const corrections = (registry as { corrections: Correction[] }).corrections;
const groups = groupCorrectionsByMonth(corrections);
const lastDate = corrections
  .map(correction => effectiveDate(correction))
  .sort()
  .at(-1);
const areas = ["all", ...new Set(corrections.flatMap(correctionAreas))].sort();
---

<Layout
  title={`Correcciones | ${SITE.title}`}
  description="Registro público de las correcciones materiales hechas en Monedario: qué estaba incorrecto, qué se corrigió, a quién podía afectar y qué control se añadió para evitar que se repita."
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-16">
    <section class="border-b border-border py-10">
      <p class="mb-3 text-xs font-semibold tracking-widest text-accent uppercase">
        Transparencia
      </p>
      <h1 class="mb-4 text-3xl font-bold sm:text-4xl">Correcciones</h1>
      <div class="max-w-2xl space-y-3 text-base leading-relaxed text-secondary">
        <p>
          Aquí registramos los errores materiales que encontramos en contenido
          ya publicado: los que cambian un número, un plazo, un requisito o una
          conclusión. Las erratas y los cambios de estilo se corrigen sin
          registro.
        </p>
        <p>
          No prometemos no equivocarnos. Prometemos buscar los errores,
          corregirlos y mejorar el proceso que permitió que ocurrieran. Por eso
          cada entrada indica también qué control se añadió. El criterio está en
          la
          <a
            href={getPath("/metodologia/#correcciones")}
            class="text-accent underline underline-offset-4 hover:opacity-80"
          >
            metodología
          </a>
          ; si encuentras un error,
          <a
            href={getPath("/autor/#reportar-error")}
            class="text-accent underline underline-offset-4 hover:opacity-80"
          >
            repórtalo
          </a>
          .
        </p>
        <p class="text-sm">
          Las correcciones de septiembre de 2026 vienen de una auditoría de
          correctitud de las calculadoras y los contenidos tributarios,
          previsionales y laborales, verificada contra fuentes primarias en
          varias rondas.
        </p>
      </div>
    </section>

    <section class="border-b border-border py-6" aria-label="Directorio">
      <p class="text-sm text-secondary" aria-live="polite">
        <span id="corrections-count">{corrections.length}</span> correcciones
        registradas
        {lastDate ? (
          <>
            {" · "}última:{" "}
            <time datetime={lastDate}>
              {formatCorrectionDate(
                corrections.find(
                  correction => effectiveDate(correction) === lastDate
                ) ?? corrections[0]
              )}
            </time>
          </>
        ) : null}
      </p>
      <form
        id="corrections-search"
        role="search"
        aria-label="Buscar correcciones"
        class="mt-4 flex max-w-2xl flex-col gap-3 sm:flex-row"
        onsubmit="return false;"
      >
        <div class="flex-1">
          <label for="corrections-query" class="sr-only">
            Buscar por tema, página o fuente
          </label>
          <input
            id="corrections-query"
            name="q"
            type="search"
            autocomplete="off"
            placeholder="Buscar por tema, página o fuente…"
            class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-foreground placeholder:text-muted"
          />
        </div>
        <div>
          <label for="corrections-area" class="sr-only">
            Filtrar por área
          </label>
          <select
            id="corrections-area"
            name="area"
            class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-foreground sm:w-auto"
          >
            {areas.map(area => (
              <option value={area}>
                {area === "all" ? "Todas las áreas" : area}
              </option>
            ))}
          </select>
        </div>
      </form>
      <nav aria-label="Índice por fecha" class="mt-4">
        <ul class="flex flex-wrap gap-2 text-sm">
          {groups.map(group => (
            <li>
              <a
                href={`#${group.key}`}
                data-month-link={group.key}
                class="rounded-full border border-border px-3 py-1 text-secondary underline-offset-4 hover:opacity-80 hover:underline"
              >
                {group.label}{" "}
                <span data-month-count={group.key}>
                  ({group.corrections.length})
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </section>

    <div id="corrections-list">
      {groups.map(group => (
        <section id={group.key} data-month-group={group.key} class="py-10">
          <h2 class="mb-6 text-2xl font-bold">
            {group.label}{" "}
            <span class="text-base font-normal text-muted">
              ({group.corrections.length})
            </span>
          </h2>
          <ol class="max-w-2xl space-y-10">
            {group.corrections.map(correction => (
              <li
                id={correction.id}
                class="scroll-mt-24"
                data-correction
                data-search-text={correctionSearchText(correction)}
                data-areas={correctionAreas(correction).join(",")}
              >
                <article>
                  <p class="text-xs font-semibold tracking-wide text-muted uppercase">
                    <time datetime={correction.date}>
                      {formatCorrectionDate(correction)}
                    </time>
                  </p>
                  <h3 class="mt-1 mb-2 text-xl font-bold">
                    {correction.title}
                  </h3>
                  <p class="mb-4 text-sm text-secondary">
                    Afecta a:{" "}
                    {correction.pages.map((page, i) => (
                      <>
                        {i > 0 && " · "}
                        <a
                          href={getPath(page.href)}
                          class="text-accent underline underline-offset-4 hover:opacity-80"
                        >
                          {page.label}
                        </a>
                      </>
                    ))}
                  </p>
                  <dl class="space-y-4 text-sm leading-relaxed text-secondary">
                    <div>
                      <dt class="font-semibold text-foreground">
                        Qué estaba incorrecto
                      </dt>
                      <dd>
                        <ul class="mt-1 list-disc space-y-1 pl-5">
                          {correction.wrong.map(item => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                    <div>
                      <dt class="font-semibold text-foreground">
                        Qué se corrigió
                      </dt>
                      <dd>
                        <ul class="mt-1 list-disc space-y-1 pl-5">
                          {correction.fixed.map(item => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                    <div>
                      <dt class="font-semibold text-foreground">
                        A quién podía afectar
                      </dt>
                      <dd class="mt-1">{correction.affected}</dd>
                    </div>
                    <div>
                      <dt class="font-semibold text-foreground">
                        Fuente usada para corregir
                      </dt>
                      <dd class="mt-1">{correction.sources}</dd>
                    </div>
                    <div>
                      <dt class="font-semibold text-foreground">
                        Qué hicimos para que no se repita
                      </dt>
                      <dd class="mt-1">{correction.prevention}</dd>
                    </div>
                  </dl>
                </article>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>

    <p
      id="corrections-empty"
      class="hidden max-w-2xl py-10 text-sm text-secondary"
    >
      Sin resultados para esa búsqueda. Prueba con otras palabras o revisa el
      índice por fecha.
    </p>
  </main>
  <Footer />
</Layout>

<script>
  const form = document.getElementById(
    "corrections-search"
  ) as HTMLFormElement | null;
  if (form) {
    const queryInput = document.getElementById(
      "corrections-query"
    ) as HTMLInputElement | null;
    const areaSelect = document.getElementById(
      "corrections-area"
    ) as HTMLSelectElement | null;
    const countEl = document.getElementById("corrections-count");
    const emptyEl = document.getElementById("corrections-empty");
    const entries = [
      ...document.querySelectorAll<HTMLElement>("[data-correction]"),
    ];
    const groups = [
      ...document.querySelectorAll<HTMLElement>("[data-month-group]"),
    ];

    function matches(
      entry: HTMLElement,
      terms: string[],
      area: string
    ): boolean {
      if (area !== "all") {
        const areas = (entry.dataset.areas ?? "").split(",");
        if (!areas.includes(area)) return false;
      }
      if (terms.length === 0) return true;
      const haystack = entry.dataset.searchText ?? "";
      return terms.every(term => haystack.includes(term));
    }

    function applyFilter(): void {
      const query = (queryInput?.value ?? "").toLowerCase();
      const terms = query.split(/\s+/).filter(term => term.length > 1);
      const area = areaSelect?.value ?? "all";
      let visible = 0;
      for (const entry of entries) {
        const show = matches(entry, terms, area);
        entry.classList.toggle("hidden", !show);
        if (show) visible += 1;
      }
      for (const group of groups) {
        const hasVisible = [
          ...group.querySelectorAll("[data-correction]"),
        ].some(entry => !(entry as HTMLElement).classList.contains("hidden"));
        group.classList.toggle("hidden", !hasVisible);
      }
      if (countEl) countEl.textContent = String(visible);
      emptyEl?.classList.toggle("hidden", visible > 0);
    }

    queryInput?.addEventListener("input", applyFilter);
    areaSelect?.addEventListener("change", applyFilter);
  }
</script>
