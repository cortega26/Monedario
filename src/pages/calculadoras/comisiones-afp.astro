---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import CalculatorJsonLd from "@/components/CalculatorJsonLd.astro";
import Footer from "@/components/Footer.astro";
import MethodologyBlock from "@/components/MethodologyBlock.astro";
import PrimaryCTA from "@/components/PrimaryCTA.astro";
import ShareCalculatorResult from "@/components/ShareCalculatorResult.astro";
import NextBestStep from "@/components/NextBestStep.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CalculatorTrustBadge from "@/components/CalculatorTrustBadge.astro";
import NextSteps from "@/components/NextSteps.astro";
import { CALCULATOR_PORTFOLIO } from "@/config/calculatorPortfolio";
import { getPath } from "@/utils/getPath";
import { AFP_COMMISSIONS_PERCENT } from "@/config/afpCommissions";
import CalculatorHero from "@/components/calculator/CalculatorHero.astro";

const simuladorJubilacionPath = getPath("/calculadoras/simulador-jubilacion/");
const pensionesHubPath = getPath("/guias/pensiones-afp/");
const cambiarseAfpPath = getPath("/posts/como-cambiarse-de-afp/");

const AFP_LIST = [...AFP_COMMISSIONS_PERCENT].sort(
  (a, b) => a.commission - b.commission
);

const cheapest = AFP_LIST[0]; // lowest commission after ascending sort (AFP Uno)
const mostExpensive = AFP_LIST[AFP_LIST.length - 1]; // highest commission (AFP ProVida)
const afpByName = Object.fromEntries(AFP_LIST.map(afp => [afp.name, afp]));

// es-CL percentage formatting (comma decimal) derived from the verified config.
const fmtPct = (n: number) => `${n.toFixed(2).replace(".", ",")}%`;

// FAQ answers are derived from the verified AFP_COMMISSIONS_PERCENT config
// (validated monthly against Previred by check:afp-commissions) — never hardcoded.
const comisionFaqs = [
  {
    question: "¿Cuál es la AFP con la comisión más baja en 2026?",
    answer: `En 2026, ${cheapest.name} tiene la comisión más baja: ${fmtPct(cheapest.commission)} del sueldo imponible. La más alta es ${mostExpensive.name} con ${fmtPct(mostExpensive.commission)}. El 10% de cotización obligatoria es igual en todas las AFP; lo único que cambia entre administradoras es la comisión.`,
  },
  {
    question: "¿Cuánto descuenta la AFP de mi sueldo en total?",
    answer: `El descuento total es 10% de cotización —que va íntegro a tu cuenta individual— más la comisión de administración de la AFP. En 2026 el total va desde ${fmtPct(cheapest.total)} (${cheapest.name}) hasta ${fmtPct(mostExpensive.total)} (${mostExpensive.name}) del sueldo imponible.`,
  },
  {
    question: "¿Cuánto cobra de comisión AFP Uno y AFP Modelo?",
    answer: `En 2026, AFP Uno cobra ${fmtPct(afpByName["Uno"].commission)} de comisión y AFP Modelo ${fmtPct(afpByName["Modelo"].commission)}. Recuerda que sobre eso se suma el 10% de cotización que va a tu propio fondo, igual en todas las AFP.`,
  },
  {
    question: "¿Las comisiones AFP cambian? ¿Dónde verifico la vigente?",
    answer: `Sí: cada AFP fija su comisión y la Superintendencia de Pensiones publica las tasas vigentes. Esta calculadora usa las comisiones vigentes 2026, pero antes de cambiarte conviene confirmar la tasa actual directamente en la Superintendencia de Pensiones.`,
  },
  {
    question: "¿Conviene cambiarse a la AFP más barata?",
    answer: `Cambiarte a una AFP con menor comisión reduce el descuento mensual sin afectar el 10% que acumulas en tu fondo (es el mismo en todas). En sueldos altos o plazos largos, la diferencia de comisión acumula un costo real significativo. Revisa el proceso y los plazos en la guía de cómo cambiarse de AFP.`,
  },
];
const currentCalculator = CALCULATOR_PORTFOLIO.find(
  calc => calc.slug === "comisiones-afp"
);
const calculatorRelatedItems = (currentCalculator?.related ?? []).map(item => ({
  href: item.href,
  title: item.label,
  description: item.when,
  label: "Relacionado",
}));
const calculatorNextStepItems = [
  ...calculatorRelatedItems,
  ...(calculatorRelatedItems.length < 2
    ? [
        {
          href: "/calculadoras/",
          title: "Ver todas las calculadoras",
          description: "Compara otra herramienta si tu pregunta cambió.",
          label: "Herramientas",
        },
      ]
    : []),
];
---

<Layout
  title="Comisiones AFP 2026: compara cuál es la más barata | Monedario"
  description="Compara las comisiones vigentes de las 7 AFP en 2026 y descubre cuál es la más barata. Ingresa tu sueldo y mira cuánto te descuenta cada AFP al mes en comisión."
>
  <CalculatorJsonLd
    name="Calculadora de Comisión AFP Chile 2026"
    description="Calcula cuánto descuenta cada AFP de tu sueldo y compara las comisiones vigentes en Chile 2026."
    faqs={comisionFaqs}
  />
  <Header />
  <Breadcrumb />
  <CalculatorTrustBadge location="calculator_header" />
  <main
    data-layout="calculator"
    id="main-content"
    class="app-layout"
    data-analytics-page-type="calculator"
    data-analytics-calculator="comisiones-afp"
    data-analytics-calculator-name="Comparador Comisiones AFP"
    data-profile-prefill-host="#calculator-form-card"
  >
    <CalculatorHero
      title="Comparador de Comisiones AFP"
      description="Ingresa tu sueldo imponible y compara cuánto te descuenta cada AFP solo en comisión. El 10% siempre va a tu fondo personal — lo que cambia según la AFP es la comisión adicional."
      descriptionClass="max-w-xl text-secondary"
    />

    <!-- CALCULADORA -->
    <section class="py-8">
      <div id="calculator-form-card" class="mb-6 max-w-sm">
        <label
          for="imponible"
          class="mb-1 block text-sm font-medium text-secondary"
        >
          Sueldo imponible mensual ($) — opcional
        </label>
        <div class="flex gap-2">
          <input
            type="number"
            id="imponible"
            placeholder="Ej: 1.200.000"
            min="0"
            data-profile-bind="sueldoImponible"
            class="flex-1 rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          />
          <button
            id="calcBtn"
            class="rounded-lg bg-accent px-4 py-2 text-sm font-bold text-background transition-opacity hover:opacity-90"
          >
            Calcular
          </button>
        </div>
        <p class="mt-1 text-xs text-muted">
          Si lo dejas vacío, la tabla muestra solo los porcentajes sin montos.
        </p>
      </div>

      <!-- TABLA AFP -->
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr
              class="border-b border-border text-left text-xs font-semibold text-muted uppercase"
            >
              <th class="pr-4 pb-2">AFP</th>
              <th class="pr-4 pb-2 text-right">Comisión</th>
              <th class="pr-4 pb-2 text-right">Tasa total</th>
              <th class="pr-4 pb-2 text-right" id="col-mensual">
                Comisión/mes
              </th>
              <th class="pb-2 text-right" id="col-extra">
                Extra vs {cheapest.name}
              </th>
            </tr>
          </thead>
          <tbody id="afp-table-body" aria-live="polite">
            {
              AFP_LIST.map(afp => {
                const isCheapest = afp.commission === cheapest.commission;
                return (
                  <tr
                    data-total={afp.total}
                    data-commission={afp.commission}
                    class:list={[
                      "border-b border-border/50 transition-colors last:border-0",
                      { "bg-accent/5": isCheapest },
                    ]}
                  >
                    <td class="py-3 pr-4">
                      <span class="font-semibold">{afp.name}</span>
                      {isCheapest && (
                        <span class="ml-2 rounded-full bg-accent/15 px-2 py-0.5 text-xs font-medium text-accent">
                          más barata
                        </span>
                      )}
                    </td>
                    <td class="py-3 pr-4 text-right font-mono">
                      {afp.commission.toFixed(2)}%
                    </td>
                    <td class="py-3 pr-4 text-right font-mono text-secondary">
                      {afp.total.toFixed(2)}%
                    </td>
                    <td
                      class="py-3 pr-4 text-right font-mono"
                      data-cell="mensual"
                    >
                      —
                    </td>
                    <td
                      class:list={[
                        "py-3 text-right font-mono",
                        { "text-red-400": !isCheapest },
                        { "text-green-500": isCheapest },
                      ]}
                      data-cell="extra"
                    >
                      {isCheapest ? "referencia" : "—"}
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>

      <p class="mt-3 text-xs text-muted">
        Tasas vigentes 2026. El 10% de cotización va siempre a tu cuenta
        personal independientemente de la AFP. Solo la comisión es el costo real
        del servicio.
      </p>

      <!-- RESUMEN DE AHORRO -->
      <div
        id="savings-summary"
        class="mt-6 hidden rounded-xl border border-accent/20 bg-accent/5 p-5"
      >
        <h3 class="mb-2 text-base font-semibold">Ahorro anual estimado</h3>
        <p id="savings-text" class="text-sm text-secondary"></p>
      </div>
    </section>

    <NextBestStep slug="comisiones-afp" />

    <!-- EXPLICACIÓN -->
    <section
      class="prose prose-sm max-w-none border-t border-border pt-8 pb-12 dark:prose-invert"
    >
      <h2>¿Qué es la comisión AFP y por qué importa?</h2>
      <p>
        Cada AFP descuenta de tu sueldo imponible dos cosas distintas: el{" "}
        <strong>10% de cotización obligatoria</strong>, que va íntegramente a tu
        cuenta individual de capitalización (es tuyo), y la{" "}
        <strong>comisión</strong>, que es el costo del servicio de
        administración y va a la AFP.
      </p>
      <ul>
        <li>
          La cotización del 10% es igual en todas las AFP — no cambia si te
          cambias.
        </li>
        <li>
          La comisión varía entre AFP: en 2026 va desde{" "}
          {fmtPct(cheapest.commission)} ({cheapest.name}) hasta{" "}
          {fmtPct(mostExpensive.commission)} ({mostExpensive.name}) según la
          administradora.
        </li>
        <li>
          Cambiarte a la AFP más barata reduce el descuento mensual sin afectar
          el saldo que acumulas (el 10% es el mismo).
        </li>
        <li>
          La diferencia de comisión puede parecer pequeña en porcentaje, pero en
          sueldos altos o en plazos largos acumula un costo real significativo.
        </li>
      </ul>
      <p>
        Para decidir si te conviene cambiar de AFP, revisa también la{" "}
        <a href={cambiarseAfpPath}>guía de cómo cambiarse de AFP</a> y el{" "}
        <a href={pensionesHubPath}>hub de pensiones y AFP</a>. Si tu decisión es
        de largo plazo y quieres proyectar pensión futura, usa el{" "}
        <a href={simuladorJubilacionPath}>simulador de jubilación</a>.
      </p>
      <p class="text-sm text-muted">
        Las comisiones AFP pueden cambiar. Verifica la tasa vigente en la{" "}
        <a
          href="https://www.spensiones.cl"
          target="_blank"
          rel="noopener noreferrer">Superintendencia de Pensiones</a
        > antes de tomar una decisión.
      </p>
    </section>

    <section class="border-t border-border py-8">
      <h2 class="mb-6 text-xl font-semibold">
        Preguntas frecuentes sobre comisiones AFP
      </h2>
      <dl class="space-y-6">
        {
          comisionFaqs.map(faq => (
            <div>
              <dt class="mb-1 font-medium text-foreground">{faq.question}</dt>
              <dd class="text-sm leading-relaxed text-secondary">
                {faq.answer}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <PrimaryCTA
      text="Guía completa para cambiarte de AFP →"
      href="/posts/como-cambiarse-de-afp/"
      context="Conoce el proceso, los plazos y cuándo conviene cambiar según tu situación."
    />
    <ShareCalculatorResult />
    <MethodologyBlock
      notes="Las comisiones muestran la tasa total de descuento del trabajador: 10% va íntegro al fondo personal y el resto es la comisión de la AFP. Los datos se actualizan con las tasas publicadas por la Superintendencia de Pensiones, que las revisa periódicamente."
      sources={[
        {
          name: "Superintendencia de Pensiones — Comisiones AFP vigentes",
          url: "https://www.spensiones.cl/portal/institucional/594/w3-article-13665.html",
          date: "2026-03",
        },
      ]}
    />
    <NextSteps
      currentHref="/calculadoras/comisiones-afp/"
      items={calculatorNextStepItems}
      title="Qué hacer con este resultado"
      description="Sigue con una herramienta relacionada o vuelve al índice si necesitas resolver otra pregunta."
      location="calculator_next_steps"
    />
  </main>
  <Footer />
</Layout>

<script>
  import "@/scripts/calculator-prefill";
  import { compareAfpCommissions } from "@/application/use-cases/CompareAfpCommissions";
  import { AFP_COMMISSIONS_PERCENT } from "@/config/afpCommissions";
  import { trackAnalyticsEvent } from "@/utils/analytics";

  declare global {
    interface Window {
      showShareResult?: (text: string) => void;
    }
  }

  const fmt = (n: number) => "$" + Math.round(n).toLocaleString("es-CL");

  function calcular() {
    const imponible =
      parseFloat(
        (document.getElementById("imponible") as HTMLInputElement).value
      ) || 0;

    const rows =
      document.querySelectorAll<HTMLTableRowElement>("#afp-table-body tr");

    const comparison = compareAfpCommissions(
      imponible,
      AFP_COMMISSIONS_PERCENT
    );
    const cheapestCommission = comparison.cheapestCommissionPercent;

    rows.forEach(row => {
      const commission = parseFloat(row.dataset.commission ?? "0");
      const isCheapest = commission === cheapestCommission;

      const mensualCell = row.querySelector<HTMLElement>(
        '[data-cell="mensual"]'
      );
      const extraCell = row.querySelector<HTMLElement>('[data-cell="extra"]');

      if (!mensualCell || !extraCell) return;

      if (imponible > 0) {
        const monthlyCost = (commission / 100) * imponible;
        mensualCell.textContent = fmt(monthlyCost);

        if (isCheapest) {
          extraCell.textContent = "referencia";
        } else {
          const extraMonthly =
            ((commission - cheapestCommission) / 100) * imponible;
          extraCell.textContent = `+${fmt(extraMonthly)}/mes`;
        }
      } else {
        mensualCell.textContent = "—";
        if (!isCheapest) extraCell.textContent = "—";
      }
    });

    // Savings summary
    const summaryEl = document.getElementById("savings-summary");
    const summaryText = document.getElementById("savings-text");
    if (summaryEl && summaryText && imponible > 0) {
      const maxExtraMonthly = comparison.maxExtraMonthlyCost;
      const maxExtraAnnual = comparison.maxExtraAnnualCost;

      summaryText.textContent = `Con un imponible de ${fmt(imponible)}, elegir la AFP más barata frente a la más cara te ahorraría ${fmt(maxExtraMonthly)}/mes — ${fmt(maxExtraAnnual)} al año solo en comisiones.`;
      summaryEl.classList.remove("hidden");

      document.dispatchEvent(
        new CustomEvent("calculator:result", {
          detail: {
            summaryText: `Comisiones AFP: imponible ${fmt(imponible)}, ahorro máx. ${fmt(maxExtraAnnual)}/año`,
          },
        })
      );
      trackAnalyticsEvent("calculator_complete", {
        calculator_slug: "comisiones-afp",
        calculator_name: "Comparador Comisiones AFP",
        outcome: "success",
      });
    } else if (summaryEl) {
      summaryEl.classList.add("hidden");
    }
  }

  document.getElementById("calcBtn")?.addEventListener("click", calcular);
  document
    .getElementById("imponible")
    ?.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Enter") calcular();
    });
</script>
