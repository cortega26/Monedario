---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import CalculatorJsonLd from "@/components/CalculatorJsonLd.astro";
import Footer from "@/components/Footer.astro";
import MethodologyBlock from "@/components/MethodologyBlock.astro";
import PrimaryCTA from "@/components/PrimaryCTA.astro";
import ShareCalculatorResult from "@/components/ShareCalculatorResult.astro";
import NextBestStep from "@/components/NextBestStep.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CalculatorTrustBadge from "@/components/CalculatorTrustBadge.astro";
import NextSteps from "@/components/NextSteps.astro";
import { CALCULATOR_PORTFOLIO } from "@/config/calculatorPortfolio";
import { getEconomicParameters } from "@/application/use-cases/GetEconomicParameters";
import { secondCategoryTaxWorkedExample } from "@/domain/taxation/calculateSecondCategoryTax.methodology";
import { resolveEconomicIndicatorDate } from "@/domain/economic/EconomicParameters";
import {
  buildSecondCategoryTaxBrackets,
  calculateSecondCategoryTax,
} from "@/domain/taxation/TaxEngine";
import { getPath } from "@/utils/getPath";
import CalculatorDataFreshness from "@/components/calculator/CalculatorDataFreshness.astro";
import CalculatorField from "@/components/calculator/CalculatorField.astro";
import { formatEconomicDate } from "@/domain/economic/economicSourcePresentation";
import { formatCLP } from "@/utils/formatCLP";

const { parameters: economicParameters } = await getEconomicParameters();
const utm = economicParameters.utm;
const utmLastUpdated = resolveEconomicIndicatorDate(economicParameters, "utm");

const fmt = formatCLP;

const taxBrackets = buildSecondCategoryTaxBrackets(utm);
const exampleResult = calculateSecondCategoryTax({
  taxableIncome: 1_200_000,
  utm,
});

const bracketRows = [
  {
    desde: "0",
    hasta: "13,5",
    hastaPesos: fmt(13.5 * utm),
    tasa: "Exento (0%)",
    rebaja: "—",
  },
  {
    desde: "13,5",
    hasta: "30",
    hastaPesos: fmt(30 * utm),
    tasa: "4%",
    rebaja: fmt(taxBrackets[1].deduction),
  },
  {
    desde: "30",
    hasta: "50",
    hastaPesos: fmt(50 * utm),
    tasa: "8%",
    rebaja: fmt(taxBrackets[2].deduction),
  },
  {
    desde: "50",
    hasta: "70",
    hastaPesos: fmt(70 * utm),
    tasa: "13,5%",
    rebaja: fmt(taxBrackets[3].deduction),
  },
  {
    desde: "70",
    hasta: "90",
    hastaPesos: fmt(90 * utm),
    tasa: "23%",
    rebaja: fmt(taxBrackets[4].deduction),
  },
  {
    desde: "90",
    hasta: "120",
    hastaPesos: fmt(120 * utm),
    tasa: "30,4%",
    rebaja: fmt(taxBrackets[5].deduction),
  },
  {
    desde: "120",
    hasta: "310",
    hastaPesos: fmt(310 * utm),
    tasa: "35%",
    rebaja: fmt(taxBrackets[6].deduction),
  },
  {
    desde: "310",
    hasta: "∞",
    hastaPesos: "Sin límite",
    tasa: "40%",
    rebaja: fmt(taxBrackets[7].deduction),
  },
];

const sueldoLiquidoPath = getPath("/calculadoras/sueldo-liquido/");
const currentCalculator = CALCULATOR_PORTFOLIO.find(
  calc => calc.slug === "impuesto-segunda-categoria"
);
const calculatorRelatedItems = (currentCalculator?.related ?? []).map(item => ({
  href: item.href,
  title: item.label,
  description: item.when,
  label: "Relacionado",
}));
const calculatorNextStepItems = [
  ...calculatorRelatedItems,
  ...(calculatorRelatedItems.length < 2
    ? [
        {
          href: "/calculadoras/",
          title: "Ver todas las calculadoras",
          description: "Compara otra herramienta si tu pregunta cambió.",
          label: "Herramientas",
        },
      ]
    : []),
];
---

<Layout
  title="Calcula tu Impuesto Único 2026 — Segunda Categoría | Monedario"
  description="Calcula al instante tu impuesto único 2026 según tu sueldo imponible: descubre tu tramo SII y cuánto pagas, con tabla actualizada a la UTM vigente."
>
  <CalculatorJsonLd
    name="Calculadora Impuesto Segunda Categoría Chile 2026"
    description="Calcula al instante tu impuesto único 2026 según tu sueldo imponible: descubre tu tramo SII y cuánto pagas, con tabla actualizada a la UTM vigente."
  />
  <Header />
  <Breadcrumb />
  <CalculatorTrustBadge location="calculator_header" />
  <main
    data-layout="calculator"
    id="main-content"
    class="app-layout"
    data-analytics-page-type="calculator"
    data-analytics-calculator="impuesto-segunda-categoria"
    data-analytics-calculator-name="Calculadora Impuesto Segunda Categoría"
    data-profile-prefill-host="#calculator-form-card"
  >
    <section class="border-b border-border pt-8 pb-6">
      <h1 class="my-4 text-3xl font-bold sm:text-4xl">
        Calculadora Impuesto Segunda Categoría
      </h1>
      <p class="max-w-xl text-secondary">
        Ingresa tu sueldo imponible mensual y calcula cuánto pagas de impuesto
        único al trabajo, en qué tramo tributas y cuál es tu tasa marginal.
      </p>
    </section>

    <section class="grid items-start gap-6 py-8 sm:grid-cols-2">
      <!-- FORMULARIO -->
      <div
        id="calculator-form-card"
        class="rounded-xl border border-border p-6"
      >
        <h2 class="mb-5 text-lg font-semibold">Ingresa tu imponible</h2>

        <CalculatorField
          id="imponible"
          label="Sueldo imponible mensual ($)"
          placeholder="Ej: 1.200.000"
          min="0"
          inputAttrs={{ "data-profile-bind": "sueldoImponible" }}
        />
        <p class="mt-1 text-xs text-muted">
          El imponible es el bruto menos asignaciones no imponibles (colación,
          movilización). Si no lo separas, ingresa tu bruto total.
        </p>
      </div>

      <button
        id="calcBtn"
        class="mt-2 w-full rounded-lg bg-accent px-4 py-3 text-base font-bold text-background transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
      >
        Calcular impuesto →
      </button>
      <div
        id="segunda-categoria-error"
        class="mt-3 hidden rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-sm text-danger"
        role="alert"
      ></div>
    </section>

    <!-- RESULTADO -->
    <div
      id="resultado"
      class="rounded-xl border border-border bg-background p-6"
    >
      <h2 class="mb-5 text-lg font-semibold">Resultado</h2>
      <div id="resultado-contenido" data-is-example="true" aria-live="polite">
        <div class="mb-5 rounded-lg border border-border bg-surface-muted/40 p-4 text-center">
          <p class="mb-1 text-xs font-bold tracking-widest text-muted uppercase">
            Impuesto mensual (Ejemplo ilustrativo)
          </p>
          <p class="text-4xl font-bold text-foreground/80">
            {fmt(exampleResult.taxAmount)}
          </p>
        </div>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-secondary">Sueldo imponible</span>
            <span class="font-medium text-foreground/80">$1.200.000</span>
          </div>
          <div class="flex justify-between">
            <span class="text-secondary">Tasa marginal</span>
            <span class="font-medium text-foreground/80">
              {(exampleResult.marginalRate * 100).toFixed(1)}%
            </span>
          </div>
          <div class="flex justify-between">
            <span class="text-secondary">Impuesto anual estimado</span>
            <span class="font-medium text-foreground/80">
              {fmt(exampleResult.taxAmount * 12)}
            </span>
          </div>
        </div>
        <p class="mt-4 text-xs text-muted">
          Ejemplo: sueldo imponible de $1.200.000 con la UTM vigente. Ingresa
          tus datos para ver tu resultado.
        </p>
      </div>
      <div
        id="economic-parameters"
        data-utm={String(utm)}
        class="hidden"
        aria-hidden="true"
      ></div>
      <CalculatorDataFreshness
        source={economicParameters.source}
        updatedDate={formatEconomicDate(utmLastUpdated)}
        variant="result"
      >
        {" · "}Valor usado: {fmt(utm)}.
      </CalculatorDataFreshness>
    </div>
  </main>

  <NextBestStep slug="impuesto-segunda-categoria" />

  <!-- TABLA DE TRAMOS -->
  <section class="border-t border-border py-8">
    <h2 class="mb-2 text-xl font-bold">Tabla de tramos vigente 2026</h2>
    <p class="mb-4 max-w-3xl text-sm text-secondary">
      Calculada con UTM {fmt(utm)}. Fórmula:{" "}
      <strong>impuesto = imponible × tasa − cuantía a rebajar</strong>. El
      impuesto es progresivo: solo tributa la parte del sueldo que supera cada
      umbral.
    </p>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border text-left text-xs font-semibold text-muted uppercase">
            <th class="pr-4 pb-2">Tramo (UTM)</th>
            <th class="pr-4 pb-2">Hasta ($)</th>
            <th class="pr-4 pb-2">Tasa</th>
            <th class="pb-2">Cuantía a rebajar</th>
          </tr>
        </thead>
        <tbody>
          {bracketRows.map((row, i) => (
            <tr
              id={`tramo-${i}`}
              class="border-b border-border/50 transition-colors last:border-0"
            >
              <td class="py-2 pr-4 font-mono text-secondary">
                {row.desde}–{row.hasta} UTM
              </td>
              <td class="py-2 pr-4 font-mono">{row.hastaPesos}</td>
              <td class="py-2 pr-4 font-semibold">{row.tasa}</td>
              <td class="py-2 font-mono text-muted">{row.rebaja}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- EXPLICACIÓN -->
  <section class="prose prose-sm max-w-none border-t border-border pt-8 pb-12 dark:prose-invert">
    <h2>¿Cómo funciona el impuesto de segunda categoría?</h2>
    <p>
      El impuesto único al trabajo (segunda categoría) aplica a sueldos de
      trabajadores dependientes. Se calcula sobre el{" "}
      <strong>sueldo imponible mensual</strong> y usa una tabla progresiva del
      SII que se actualiza con la UTM.
    </p>
    <ul>
      <li>
        <strong>Tramo exento:</strong> Si tu imponible no supera las 13,5 UTM
        mensuales (~{fmt(13.5 * utm)}), no pagas impuesto.
      </li>
      <li>
        <strong>Progresividad:</strong> Solo paga impuesto la parte de tu sueldo
        que supera el umbral de cada tramo, no el total.
      </li>
      <li>
        <strong>Cuantía a rebajar:</strong> Equivale a la suma de los tramos
        inferiores ya pagados. La fórmula SII es: impuesto = imponible × tasa −
        rebaja.
      </li>
      <li>
        <strong>Retención mensual:</strong> El empleador retiene y entera este
        impuesto cada mes directamente al SII.
      </li>
    </ul>
    <p class="text-sm text-muted">
      Valores de referencia calculados con UTM vigente. El SII publica la tabla
      oficial cada mes. Para información oficial consulta{" "}
      <a href="https://www.sii.cl" target="_blank" rel="noopener noreferrer">
        sii.cl
      </a>
      .
    </p>
    <p class="text-sm text-secondary">
      Lee también:{" "}
      <a
        href="/glosario/impuesto-unico/"
        class="text-accent underline underline-offset-4 hover:opacity-80"
      >
        Qué es el impuesto único (glosario)
      </a>{" "}
      ·{" "}
      <a
        href="/posts/como-calcular-sueldo-liquido/"
        class="text-accent underline underline-offset-4 hover:opacity-80"
      >
        Cómo calcular el sueldo líquido
      </a>
    </p>
    <p>
      Si necesitas el cálculo completo con AFP, salud y cesantía, usa la{" "}
      <a
        href={sueldoLiquidoPath}
        data-analytics-cta="calculator-related"
        data-analytics-label="Calculadora sueldo liquido"
        data-analytics-location="calculator_explainer"
      >
        calculadora de sueldo líquido
      </a>
      .
    </p>
  </section>

  <PrimaryCTA
    text="Simula tu Operación Renta completa →"
    href="/calculadoras/operacion-renta/"
    context="Si tienes más de un empleador, boletas o arriendos, el impuesto de segunda categoría es solo una parte del cálculo."
  />
  <ShareCalculatorResult />
  <MethodologyBlock
    example={secondCategoryTaxWorkedExample.example}
    notes="El impuesto de segunda categoría se calcula aplicando la tabla de tramos progresivos publicada por el SII, usando la UTM vigente para convertir los tramos a pesos. La fórmula es: impuesto = base imponible × tasa del tramo — cantidad a rebajar del tramo correspondiente."
    sources={[
      {
        name: "SII — Tabla impuesto único de segunda categoría",
        url: "https://www.sii.cl",
        date: "2026-03",
      },
      {
        name: "SII — Valores UTM vigentes",
        url: "https://www.sii.cl/valores_y_fechas/utm/utm2026.htm",
        date: "2026-03",
      },
    ]}
  />
  <NextSteps
    currentHref="/calculadoras/impuesto-segunda-categoria/"
    items={calculatorNextStepItems}
    title="Qué hacer con este resultado"
    description="Sigue con una herramienta relacionada o vuelve al índice si necesitas resolver otra pregunta."
    location="calculator_next_steps"
  />
</Layout>
<Footer />

<script>
  import "@/scripts/calculator-prefill";
  import { calculateSecondCategoryTax } from "@/domain/taxation/TaxEngine";
  import { trackAnalyticsEvent } from "@/utils/analytics";
  import { renderHeadlineDelta } from "@/utils/calculatorDelta";
  import { formatCLP } from "@/utils/formatCLP";
  import {
    markResultState,
    renderInvalidResultState,
  } from "@/utils/calculatorResultState";

  declare global {
    interface Window {
      showShareResult?: (text: string) => void;
    }
  }

  function fmt(n: number): string {
    return formatCLP(n);
  }

  function fmtPct(n: number): string {
    return (n * 100).toFixed(1) + "%";
  }

  function readUtm(): number {
    const utm = Number(
      document.getElementById("economic-parameters")?.dataset?.utm
    );
    if (!Number.isFinite(utm) || utm <= 0) throw new Error("UTM no disponible");
    return utm;
  }

  const utm = readUtm();

  // Highlight the active bracket row (tabla general: 35% hasta 310 UTM)
  const BRACKET_UPPER_LIMITS_UTM = [13.5, 30, 50, 70, 90, 120, 310, Infinity];

  function highlightBracket(taxableIncome: number) {
    BRACKET_UPPER_LIMITS_UTM.forEach((limit, i) => {
      const row = document.getElementById(`tramo-${i}`);
      if (!row) return;
      const isActive = taxableIncome <= limit * utm;
      const prevActive =
        i === 0 || taxableIncome > BRACKET_UPPER_LIMITS_UTM[i - 1] * utm;
      row.classList.toggle("bg-accent/10", isActive && prevActive);
    });
  }

  function showInlineError(message: string) {
    renderInvalidResultState();
    const errorBox = document.getElementById("segunda-categoria-error");
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.remove("hidden");
  }

  function clearInlineError() {
    const errorBox = document.getElementById("segunda-categoria-error");
    if (!errorBox) return;
    errorBox.textContent = "";
    errorBox.classList.add("hidden");
  }

  document.getElementById("calcBtn")?.addEventListener("click", () => {
    clearInlineError();
    const imponible =
      parseFloat(
        (document.getElementById("imponible") as HTMLInputElement).value
      ) || 0;

    if (imponible <= 0) {
      showInlineError("Por favor ingresa un sueldo imponible válido.");
      return;
    }

    let result;
    try {
      result = calculateSecondCategoryTax({ taxableIncome: imponible, utm });
    } catch (e) {
      showInlineError(
        e instanceof Error ? e.message : "No se pudo calcular el impuesto."
      );
      return;
    }

    highlightBracket(imponible);

    const contenido = document.getElementById("resultado-contenido")!;

    const headline = document.createElement("div");
    headline.className =
      "mb-5 rounded-lg border border-accent/20 bg-accent/10 p-4 text-center";

    const headlineLabel = document.createElement("p");
    headlineLabel.className =
      "mb-1 text-xs font-bold tracking-widest text-accent uppercase";
    headlineLabel.textContent =
      result.taxAmount === 0 ? "Sin impuesto" : "Impuesto mensual";

    const headlineValue = document.createElement("p");
    headlineValue.className = "text-4xl font-bold";
    headlineValue.textContent = fmt(result.taxAmount);

    headline.append(headlineLabel, headlineValue);

    const delta = renderHeadlineDelta(
      window.location.pathname,
      result.taxAmount,
      fmt
    );
    if (delta) headline.append(delta);

    const buildRow = (label: string, value: string, color = "") => {
      const row = document.createElement("div");
      row.className =
        "flex items-center justify-between border-b border-border py-2 text-sm last:border-0";
      const l = document.createElement("span");
      l.className = "text-secondary";
      l.textContent = label;
      const v = document.createElement("span");
      v.className = `font-mono font-semibold ${color}`.trim();
      v.textContent = value;
      row.append(l, v);
      return row;
    };

    const rows = [
      buildRow("Sueldo imponible", fmt(imponible)),
      buildRow(
        "Tasa marginal",
        result.taxAmount === 0 ? "Exento" : fmtPct(result.marginalRate)
      ),
      buildRow(
        "Impuesto mensual",
        fmt(result.taxAmount),
        result.taxAmount > 0 ? "text-danger" : "text-success"
      ),
      buildRow("Impuesto anual estimado", fmt(result.taxAmount * 12)),
      buildRow(
        "% sobre imponible",
        imponible > 0
          ? ((result.taxAmount / imponible) * 100).toFixed(2) + "%"
          : "—"
      ),
    ];

    const note = document.createElement("p");
    note.className = "mt-3 text-xs text-muted";
    note.textContent =
      result.taxAmount === 0
        ? "Tu imponible está dentro del tramo exento. No pagas impuesto de segunda categoría."
        : "El impuesto anual es una estimación asumiendo el mismo imponible mensual los 12 meses.";

    contenido.replaceChildren(headline, ...rows, note);
    markResultState(contenido, "result");

    document.dispatchEvent(
      new CustomEvent("calculator:result", {
        detail: {
          summaryText: `Impuesto 2ª categoría: ${fmt(result.taxAmount)}/mes sobre imponible ${fmt(imponible)}`,
        },
      })
    );
    trackAnalyticsEvent("calculator_complete", {
      calculator_slug: "impuesto-segunda-categoria",
      calculator_name: "Calculadora Impuesto Segunda Categoría",
      outcome: "success",
    });
  });

  document
    .getElementById("imponible")
    ?.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Enter")
        (document.getElementById("calcBtn") as HTMLButtonElement)?.click();
    });
</script>
