---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import CalculatorJsonLd from "@/components/CalculatorJsonLd.astro";
import Footer from "@/components/Footer.astro";
import MethodologyBlock from "@/components/MethodologyBlock.astro";
import PrimaryCTA from "@/components/PrimaryCTA.astro";
import ShareCalculatorResult from "@/components/ShareCalculatorResult.astro";
import CalculatorResultNextActions from "@/components/CalculatorResultNextActions.astro";
import NextBestStep from "@/components/NextBestStep.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CalculatorTrustBadge from "@/components/CalculatorTrustBadge.astro";
import NextSteps from "@/components/NextSteps.astro";
import { CALCULATOR_PORTFOLIO } from "@/config/calculatorPortfolio";
import CompareTable from "@/components/CompareTable.astro";
import { getEconomicParameters } from "@/application/use-cases/GetEconomicParameters";
import { getPath } from "@/utils/getPath";
import { AFP_COMMISSIONS_PERCENT } from "@/config/afpCommissions";
import CalculatorHero from "@/components/calculator/CalculatorHero.astro";
import GlossaryContentWrapper from "@/components/GlossaryContentWrapper.astro";
import CalculatorField from "@/components/calculator/CalculatorField.astro";
import CalculatorResultPanel from "@/components/calculator/CalculatorResultPanel.astro";
import { calculateApvComparison } from "@/application/use-cases/CalculateApvComparison";
import { apvWorkedExample } from "@/application/use-cases/CalculateApvComparison.methodology";
import CalculatorDataFreshness from "@/components/calculator/CalculatorDataFreshness.astro";
import { formatEconomicDate } from "@/domain/economic/economicSourcePresentation";

const { parameters: economicParameters } = await getEconomicParameters();
const apvGuidePath = getPath("/posts/que-es-el-apv/");
const formatCurrency = (value: number) =>
  "$" + Math.round(value).toLocaleString("es-CL");
const monthlyRegimeATarget = (40 * economicParameters.utm) / 12;
const annualRegimeABonusCap = 6 * economicParameters.utm;
const annualRegimeBContributionCap = 600 * economicParameters.uf;
const exampleResult = calculateApvComparison({
  grossSalary: 1_500_000,
  monthlyApvContribution: 100_000,
  afpRatePercent: 11.44,
  healthSystem: "fonasa",
  economicParameters,
});
const apvFaqs = [
  {
    question: "¿Qué es el APV y en qué se diferencia del ahorro en la AFP?",
    answer:
      "El APV es un ahorro complementario y voluntario a la cotización obligatoria del 10% en la AFP. Tiene beneficios tributarios que el ahorro común no ofrece (Régimen A: bonificación estatal del 15%; Régimen B: deducción de la base imponible del IGC).",
  },
  {
    question: "¿Cuándo conviene el Régimen A y cuándo el Régimen B?",
    answer:
      "Régimen A conviene si tus ingresos son bajos o medianos y el bono estatal del 15% supera al ahorro tributario. Régimen B conviene si tienes ingresos altos y una tasa marginal elevada en el Impuesto Global Complementario, ya que el aporte reduce tu base imponible.",
  },
  {
    question: "¿Puedo retirar mi APV antes de jubilar?",
    answer:
      "Sí, pero un retiro anticipado tiene costo tributario: en Régimen A debes devolver la bonificación estatal; en Régimen B el monto se agrega a tu renta del año y tributa con un recargo adicional del 3%.",
  },
  {
    question: "¿Cuánto es el monto máximo de APV que puedo aportar al año?",
    answer:
      "El tope con beneficio tributario es 600 UF anuales en Régimen B. En Régimen A, el bono estatal se topa en 6 UTM anuales (15% sobre lo aportado hasta ese límite).",
  },
  {
    question: "¿El APV reduce mi impuesto en la Operación Renta?",
    answer:
      "Solo en Régimen B: los aportes se deducen de la renta imponible antes de calcular el IGC en el formulario F-22, lo que puede reducir lo que debes pagar o aumentar tu devolución en abril.",
  },
  {
    question: "¿Qué pasa con mi APV si me cambio de AFP o de institución?",
    answer:
      "Si el APV está en tu AFP, se traspasa junto con tu cuenta individual al cambiar de AFP. Si está en otra institución (banco, fondo mutuo o seguro), el cambio de AFP no lo afecta.",
  },
];
const currentCalculator = CALCULATOR_PORTFOLIO.find(
  calc => calc.slug === "apv"
);
const calculatorRelatedItems = (currentCalculator?.related ?? []).map(item => ({
  href: item.href,
  title: item.label,
  description: item.when,
  label: "Relacionado",
}));
const calculatorNextStepItems = [
  ...calculatorRelatedItems,
  ...(calculatorRelatedItems.length < 2
    ? [
        {
          href: "/calculadoras/",
          title: "Ver todas las calculadoras",
          description: "Compara otra herramienta si tu pregunta cambió.",
          label: "Herramientas",
        },
      ]
    : []),
];
---

<Layout
  title="Simulador APV Chile 2026: ¿cuánto ahorras en Régimen A o B?"
  description="¿Te conviene APV en Chile? Compara Régimen A y B según tu sueldo y aporte mensual, y calcula el ahorro tributario real antes de decidir."
>
  <CalculatorJsonLd
    name="Simulador APV Chile: ¿Régimen A o B conviene más?"
    description="¿Te conviene APV en Chile? Compara Régimen A y B según tu sueldo y aporte mensual, y calcula el ahorro tributario real antes de decidir."
    faqs={apvFaqs}
  />
  <Header />
  <Breadcrumb />
  <CalculatorTrustBadge location="calculator_header" />
  <main
    data-layout="calculator"
    id="main-content"
    class="app-layout"
    data-analytics-page-type="calculator"
    data-analytics-calculator="apv"
    data-analytics-calculator-name="Simulador APV"
    data-profile-prefill-host="#calculator-form-card"
  >
    <CalculatorHero
      title="Simulador APV"
      description="Estima de forma orientativa cuánto podrías ganar con APV en Régimen A, Régimen B o una combinación de ambos según tu sueldo, tu imponible real, tu ahorro mensual y eventuales depósitos directos adicionales."
      descriptionClass="max-w-xl text-secondary"
    />

    <section class="grid items-start gap-6 py-8 sm:grid-cols-2">
      <!-- FORMULARIO -->
      <div
        id="calculator-form-card"
        class="rounded-xl border border-border p-6"
      >
        <h2 class="mb-5 text-lg font-semibold">Ingresa tus datos</h2>

        <CalculatorField
          id="sueldo"
          label="Sueldo bruto mensual ($)"
          placeholder="Ej: 1.500.000"
          min="0"
          hint="Ingresa el bruto total. Si tu liquidación separa colación, movilización u otros no imponibles, puedes ajustar el imponible abajo."
        />

        <CalculatorField
          id="sueldo-imponible"
          label="Sueldo imponible mensual ($) - opcional"
          placeholder="Ej: 1.350.000"
          min="0"
          inputAttrs={{ "data-profile-bind": "sueldoImponible" }}
          hint="Si lo dejas vacío, el simulador usa el bruto como aproximación de imponible."
        />

        <CalculatorField
          id="ahorro"
          label="Ahorro APV mensual ($)"
          placeholder="Ej: 100.000"
          min="0"
          hint={`Para recibir el bono máximo del Régimen A necesitas ahorrar al menos ~${formatCurrency(monthlyRegimeATarget)}/mes (≈ 40 UTM / 12).`}
        />

        <CalculatorField
          id="aporte-directo-anual"
          label="Aporte directo adicional anual ($) - opcional"
          placeholder="Ej: 1.000.000"
          min="0"
          value="0"
          hint={`Úsalo solo si además haces depósitos directos fuera de planilla. En Régimen B ese beneficio suele reflejarse en Operación Renta y comparte el tope anual conjunto de ~${formatCurrency(annualRegimeBContributionCap)} (600 UF) con los descuentos por planilla.`}
        />

        <div class="mb-4">
          <label class="mb-2 block text-sm font-medium text-secondary"
            >Tipo de contrato</label
          >
          <div class="flex gap-2">
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="tipo-contrato"
                value="indefinido"
                checked
                data-profile-bind="contratoTipo"
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-2 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                Indefinido
              </span>
            </label>
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="tipo-contrato"
                value="plazo-fijo"
                data-profile-bind="contratoTipo"
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-2 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                Plazo fijo / obra
              </span>
            </label>
          </div>
          <p class="mt-1 text-xs text-muted">
            Cambia la cotización del trabajador al seguro de cesantía y, por lo
            tanto, la base para impuesto y APV.
          </p>
        </div>

        <div class="mb-4">
          <label class="mb-2 block text-sm font-medium text-secondary"
            >Sistema de salud</label
          >
          <div class="flex gap-2">
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="salud"
                value="fonasa"
                checked
                data-profile-bind="saludRegimen"
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-2 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                Fonasa (7%)
              </span>
            </label>
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="salud"
                value="isapre"
                data-profile-bind="saludRegimen"
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-2 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                Isapre (7%+)
              </span>
            </label>
          </div>
        </div>

        <CalculatorField
          id="isapre-adicional"
          label="Cotización adicional Isapre (%)"
          type="number"
          placeholder="Ej: 2.5"
          min="0"
          max="20"
          step="0.1"
          value="2"
          wrapperId="isapre-field"
          class="hidden"
          inputAttrs={{ "data-profile-bind": "isapreAdicionalPct" }}
        />

        <CalculatorField id="afp-tasa" label="AFP">
          <select
            id="afp-tasa"
            data-profile-bind="afpId"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          >
            {
              AFP_COMMISSIONS_PERCENT.map(afp => (
                <option
                  value={afp.name}
                  data-commission={String(afp.total)}
                  selected={afp.name === "Habitat"}
                >
                  {afp.name} – {afp.total.toFixed(2)}%
                </option>
              ))
            }
          </select>
        </CalculatorField>

        <div
          class="mb-4 rounded-lg border border-border/60 bg-surface-muted/40 px-4 py-3 text-xs leading-relaxed text-secondary"
        >
          <strong class="font-semibold text-foreground"
            >¿Cuándo conviene el Régimen B?</strong
          >
          Solo cuando tu tasa marginal supera el 15% que ofrece el Régimen A. Si tu
          imponible mensual está por debajo de ~70 UTM, el Régimen A suele ganar.
          El simulador calculará tu tasa marginal con el imponible que ingresaste
          y la mostrará en los resultados.
        </div>

        <button
          id="calcBtn"
          class="mt-2 w-full rounded-lg bg-accent px-4 py-3 text-base font-bold text-background transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Comparar APV →
        </button>
        <div
          id="form-error"
          class="mt-3 hidden rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-sm text-red-500"
          role="alert"
        >
        </div>
      </div>

      <CalculatorResultPanel title="Comparación de regímenes">
        <div id="resultado-contenido" data-is-example="true" aria-live="polite">
          <div
            class="mb-5 rounded-lg border border-border bg-surface-muted/40 p-4 text-center"
          >
            <p
              class="mb-1 text-xs font-bold tracking-widest text-muted uppercase"
            >
              Beneficio anual Régimen B (Ejemplo)
            </p>
            <p class="text-4xl font-bold text-foreground/80">
              {formatCurrency(exampleResult.regimeB.annualBenefit)}
            </p>
          </div>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-secondary">Régimen A — bono anual</span>
              <span class="font-medium text-foreground/80">
                {formatCurrency(exampleResult.regimeA.annualBonus)}
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Régimen B — beneficio anual</span>
              <span class="font-medium text-foreground/80">
                {formatCurrency(exampleResult.regimeB.annualBenefit)}
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Régimen recomendado</span>
              <span class="font-medium text-foreground/80">
                Régimen {exampleResult.recommendedStrategy}
              </span>
            </div>
          </div>
          <p class="mt-4 text-xs text-muted">
            Ejemplo: sueldo $1.500.000, aporte APV $100.000/mes, AFP 11,44%,
            Fonasa.
          </p>
        </div>
        <div
          id="economic-parameters"
          data-utm={String(economicParameters.utm)}
          data-uf={String(economicParameters.uf)}
          class="hidden"
          aria-hidden="true"
        >
        </div>
        <CalculatorDataFreshness
          source={economicParameters.source}
          updatedDate={formatEconomicDate(economicParameters.lastUpdated)}
        />
      </CalculatorResultPanel>
    </section>

    <NextBestStep slug="apv" />

    <!-- COMPARACIÓN ESTÁTICA RÉGIMEN A vs B -->
    <section class="border-t border-border pt-8 pb-4">
      <h2 class="mb-2 text-xl font-bold">
        Régimen A vs Régimen B: diferencias clave
      </h2>
      <p class="mb-4 max-w-3xl text-sm text-secondary">
        Ambos regímenes te dan un beneficio tributario, pero funciona de forma
        distinta. Elige según tu tramo de impuesto actual.
      </p>
      <CompareTable
        columns={[
          { header: "Régimen A", key: "a" },
          { header: "Régimen B", key: "b" },
        ]}
        rows={[
          {
            aspecto: "Mecanismo",
            a: "El Estado deposita un bono directo del 15% sobre lo ahorrado",
            b: "Tus aportes reducen la base imponible: pagas menos impuesto mensual",
          },
          {
            aspecto: "Tope de beneficio anual",
            a: `Bono máximo 6 UTM (~${formatCurrency(annualRegimeABonusCap)})`,
            b: "Sin tope de beneficio — depende de tu tasa marginal y del aporte",
          },
          {
            aspecto: "Tope de aporte con beneficio",
            a: `40 UTM anuales para agotar el bono (~${formatCurrency(annualRegimeABonusCap / 0.15)})`,
            b: `600 UF anuales en total (planilla + depósito directo)`,
          },
          {
            aspecto: "¿Cuándo conviene más?",
            a: "Tramo cero o bajo (tasa marginal < 15%)",
            b: "Tramo alto (tasa marginal ≥ 23%)",
          },
          {
            aspecto: "Retiro anticipado",
            a: "Debes devolver el bono recibido",
            b: "Pagas impuesto diferido + sobretasa del 3%",
          },
        ]}
        nota="Valores de referencia calculados con parámetros económicos vigentes. Para casos individuales, revisa la guía completa de APV."
      />
    </section>

    <!-- EXPLICACIÓN -->
    <section
      class="prose prose-sm max-w-none border-t border-border pt-8 pb-12 dark:prose-invert"
    >
      <h2>¿Qué es el APV y cómo funciona el beneficio?</h2>
      <p>
        El APV (Ahorro Previsional Voluntario) es un mecanismo legal para
        reducir impuestos mientras ahorras para tu pensión. Debes elegir entre
        dos regímenes:
      </p>
      <ul>
        <li>
          <strong>Régimen A:</strong> El Estado te deposita directamente un bono del
          15% de lo que ahorraste, con tope de 6 UTM anuales (~{
            formatCurrency(annualRegimeABonusCap)
          }).
        </li>
        <li>
          <strong>Régimen B:</strong> Tus aportes se descuentan de tu base imponible,
          reduciendo el impuesto que pagas cada mes. Ideal si estás en tramos altos
          de impuesto (23%+).
        </li>
        <li>
          <strong>Estrategia mixta:</strong> en algunos casos conviene usar una parte
          en A y otra en B. Eso depende de tu base imponible efectiva, de tu tramo
          marginal y de cuánto del bono A todavía puedes aprovechar.
        </li>
      </ul>
      <p>
        Si retiras antes de jubilar, en Régimen A devuelves el bono; en Régimen
        B pagas impuesto diferido más una sobretasa. El APV es un instrumento de
        largo plazo.
      </p>
      <p class="text-sm text-muted">
        Valores referenciales. Parámetros económicos vigentes al momento del
        build. Si no ingresas el imponible, este simulador usa tu sueldo bruto
        como aproximación. En Régimen B trata el tope de 50 UF mensuales para
        aportes por planilla y el tope conjunto anual de 600 UF como referencias
        normativas para estimar beneficio tributario. Para información oficial
        visita la <a
          href="https://www.spensiones.cl"
          target="_blank"
          rel="noopener noreferrer">Superintendencia de Pensiones</a
        > y el <a
          href="https://www.sii.cl"
          target="_blank"
          rel="noopener noreferrer">SII</a
        >.
      </p>
      <p>
        Antes de decidir régimen, revisa la <a
          href={apvGuidePath}
          data-analytics-cta="calculator-guide"
          data-analytics-label="Guia completa de APV"
          data-analytics-location="calculator_explainer">guía completa de APV</a
        > para entender beneficios, límites y costos de retiro anticipado. Si tu duda
        cambió y ya no es tributaria, vuelve a la <a
          href="/posts/reforma-previsional-2025-que-cambia-y-como-te-afecta/"
          data-analytics-cta="calculator-related"
          data-analytics-label="Reforma previsional 2025"
          data-analytics-location="calculator_explainer"
          >reforma previsional 2025</a
        > o a <a
          href="/posts/fondos-afp-a-b-c-d-e/"
          data-analytics-cta="calculator-related"
          data-analytics-label="Fondos AFP A-E"
          data-analytics-location="calculator_explainer">fondos AFP A-E</a
        >.
      </p>
    </section>
    <section class="border-t border-border py-8">
      <h2 class="mb-6 text-xl font-semibold">Preguntas frecuentes sobre APV</h2>
      <dl class="space-y-6">
        {
          apvFaqs.map(faq => (
            <div>
              <dt class="mb-1 font-medium text-foreground">{faq.question}</dt>
              <dd class="text-sm leading-relaxed text-secondary">
                <GlossaryContentWrapper>{faq.answer}</GlossaryContentWrapper>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
    <PrimaryCTA
      text="Aprende todo sobre el APV →"
      href="/posts/que-es-el-apv/"
      context="Entiende las reglas del Régimen A y B antes de elegir dónde ahorrar para tu jubilación."
    />
    <ShareCalculatorResult />
    <CalculatorResultNextActions
      calculatorSlug="apv"
      actions={[
        { label: "Imprimir resultado", href: "#", type: "print" },
        {
          label: "¿Qué es el APV?",
          href: "/posts/que-es-el-apv/",
          type: "article",
        },
        {
          label: "Simulador Operación Renta",
          href: "/calculadoras/operacion-renta/",
          type: "calculator",
        },
      ]}
    />
    <MethodologyBlock
      example={apvWorkedExample.example}
      notes="Los beneficios tributarios del APV se calculan según la legislación vigente (Ley 20.255 y normativas SII). Régimen A: el Estado bonifica el 15% de los aportes (con tope de 6 UTM anuales). Régimen B: el aporte se deduce de la base imponible del impuesto global complementario. Los límites de aporte se expresan en UF (600 UF anuales para Régimen B) según valores al momento del cálculo."
      sources={[
        {
          name: "BCN — Ley sobre Impuesto a la Renta (art. 42 bis APV)",
          url: "https://www.bcn.cl/leychile/navegar?idNorma=6368",
          date: "2026-01",
        },
        {
          name: "Superintendencia de Pensiones — Límites APV",
          url: "https://www.spensiones.cl/portal/institucional/594/w3-article-3557.html",
          date: "2026-01",
        },
      ]}
    />

    <section
      class="prose prose-sm max-w-none border-t border-border pt-8 pb-12 dark:prose-invert"
      aria-label="Preguntas frecuentes sobre APV"
    >
      <h2>Preguntas frecuentes sobre APV</h2>

      <h3>¿Qué es el APV y en qué se diferencia del ahorro en la AFP?</h3>
      <p>
        El Ahorro Previsional Voluntario (APV) es un instrumento de ahorro
        complementario a la cotización obligatoria en la AFP (10% del sueldo
        imponible). Mientras la cotización obligatoria va a tu cuenta individual
        de capitalización, el APV se realiza de forma adicional y voluntaria, y
        tiene beneficios tributarios que el ahorro común no tiene.
      </p>

      <h3>¿Cuándo conviene el Régimen A y cuándo el Régimen B?</h3>
      <p>
        El <strong>Régimen A</strong> conviene si tus ingresos son bajos o medianos
        y estás exento o en tramos bajos del impuesto a la renta: el Estado te bonifica
        directamente el 15% de tus aportes (hasta 6 UTM anuales de bono). El <strong
          >Régimen B</strong
        > conviene si tienes ingresos altos y pagas una tasa marginal elevada en el
        Impuesto Global Complementario, ya que el aporte reduce tu base imponible
        y el ahorro tributario puede superar la bonificación del Régimen A.
      </p>

      <h3>¿Puedo retirar mi APV antes de jubilar?</h3>
      <p>
        Sí, puedes retirar el APV antes de pensionarte, pero el retiro
        anticipado conlleva un costo tributario: si usaste Régimen A, debes
        devolver la bonificación estatal recibida. Si usaste Régimen B, el monto
        retirado se agrega a tu renta del año y tributa según tu tasa marginal,
        más un recargo adicional del 3%. Por este motivo el APV es más útil si
        el horizonte de ahorro supera los 10 años.
      </p>

      <h3>¿Cuánto es el monto máximo de APV que puedo aportar al año?</h3>
      <p>
        El tope del APV con beneficio tributario es <strong
          >600 UF anuales</strong
        >
        en Régimen B. Para el Régimen A, el bono estatal se topa en el equivalente
        a 6 UTM anuales (15% sobre lo aportado hasta ese tope). Puedes aportar más
        allá de estos límites, pero el exceso no recibe beneficio tributario.
      </p>

      <h3>¿El APV reduce mi impuesto en la Operación Renta?</h3>
      <p>
        Sí, pero solo en <strong>Régimen B</strong>. Los aportes al APV en
        Régimen B se deducen de tu renta imponible antes de calcular el Impuesto
        Global Complementario (F-22). Esto puede reducir lo que debes pagar o
        aumentar tu devolución en abril. En Régimen A, la bonificación es un
        abono directo en tu cuenta de APV, no una deducción del impuesto.
      </p>

      <h3>¿Qué pasa con mi APV si me cambio de AFP o de institución?</h3>
      <p>
        El APV puede estar depositado en tu AFP, en un banco, en una
        administradora de fondos mutuos o en una compañía de seguros. Si te
        cambias de AFP, el APV que tengas en esa AFP se traspasa junto con tu
        saldo de cuenta individual. Si el APV está en otra institución (banco o
        fondo mutuo), el traspaso de AFP no lo afecta.
      </p>
    </section>
    <NextSteps
      currentHref="/calculadoras/apv/"
      items={calculatorNextStepItems}
      title="Qué hacer con este resultado"
      description="Sigue con una herramienta relacionada o vuelve al índice si necesitas resolver otra pregunta."
      location="calculator_next_steps"
    />
  </main>
  <Footer />
</Layout>

<script>
  import "@/scripts/calculator-prefill";
  import { calculateApvComparison } from "@/application/use-cases/CalculateApvComparison";
  import { trackAnalyticsEvent } from "@/utils/analytics";

  declare global {
    interface Window {
      showShareResult?: (text: string) => void;
      showCalculatorNextActions?: () => void;
    }
  }

  function fmt(n: number): string {
    return "$" + Math.round(n).toLocaleString("es-CL");
  }

  function fmtPct(n: number): string {
    return (n * 100).toFixed(1) + "%";
  }

  function showFormError(message: string): void {
    const errorBox = document.getElementById("form-error");
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.remove("hidden");
  }

  function clearFormError(): void {
    const errorBox = document.getElementById("form-error");
    if (!errorBox) return;
    errorBox.textContent = "";
    errorBox.classList.add("hidden");
  }

  function readEconomicParameters(): { uf: number; utm: number } {
    const element = document.getElementById("economic-parameters");
    const uf = Number(element?.dataset?.uf);
    const utm = Number(element?.dataset?.utm);
    if (!Number.isFinite(uf) || uf <= 0 || !Number.isFinite(utm) || utm <= 0) {
      throw new Error("No se pudieron cargar los parámetros económicos.");
    }
    return { uf, utm };
  }

  const economicParameters = readEconomicParameters();

  document.querySelectorAll("input[name='salud']").forEach(radio => {
    radio.addEventListener("change", () => {
      const isIsapre =
        (
          document.querySelector(
            "input[name='salud']:checked"
          ) as HTMLInputElement
        )?.value === "isapre";
      document
        .getElementById("isapre-field")
        ?.classList.toggle("hidden", !isIsapre);
    });
  });

  document.getElementById("calcBtn")?.addEventListener("click", () => {
    clearFormError();

    const bruto =
      parseFloat(
        (document.getElementById("sueldo") as HTMLInputElement).value
      ) || 0;
    const imponibleRaw = parseFloat(
      (document.getElementById("sueldo-imponible") as HTMLInputElement).value
    );
    const imponible =
      Number.isFinite(imponibleRaw) && imponibleRaw > 0
        ? imponibleRaw
        : undefined;
    const ahorro =
      parseFloat(
        (document.getElementById("ahorro") as HTMLInputElement).value
      ) || 0;
    const aporteDirectoAnual =
      parseFloat(
        (document.getElementById("aporte-directo-anual") as HTMLInputElement)
          .value
      ) || 0;

    if (bruto <= 0 || ahorro + aporteDirectoAnual <= 0) {
      showFormError(
        "Ingresa tu sueldo y al menos un aporte APV: mensual por planilla o directo anual."
      );
      return;
    }

    const afpSelect = document.getElementById("afp-tasa") as HTMLSelectElement;
    const afpTasaPercent = parseFloat(
      afpSelect.options[afpSelect.selectedIndex]?.dataset.commission ?? "0"
    );
    const healthSystem =
      (
        document.querySelector(
          "input[name='salud']:checked"
        ) as HTMLInputElement
      )?.value === "isapre"
        ? "isapre"
        : "fonasa";
    const contractType =
      (
        document.querySelector(
          "input[name='tipo-contrato']:checked"
        ) as HTMLInputElement
      )?.value === "plazo-fijo"
        ? "plazo-fijo"
        : "indefinido";
    const isapreAdicionalPercent =
      parseFloat(
        (document.getElementById("isapre-adicional") as HTMLInputElement).value
      ) || 0;

    let resultado;
    try {
      resultado = calculateApvComparison({
        grossSalary: bruto,
        taxableSalary: imponible,
        monthlyApvContribution: ahorro,
        annualDirectApvContribution: aporteDirectoAnual,
        afpRatePercent: afpTasaPercent,
        healthSystem,
        contractType,
        isapreAdditionalPercent: isapreAdicionalPercent,
        economicParameters,
      });
    } catch (error) {
      showFormError(
        error instanceof Error
          ? error.message
          : "No se pudo calcular la comparación APV."
      );
      return;
    }

    const buildCard = (
      title: string,
      colorClass: string,
      items: Array<{ label: string; value: string }>,
      badgeLabel?: string
    ): HTMLDivElement => {
      const card = document.createElement("div");
      card.className = `mb-4 rounded-lg border p-4 ${
        badgeLabel ? "border-accent bg-accent/5" : "border-border"
      }`;

      if (badgeLabel) {
        const badge = document.createElement("p");
        badge.className =
          "mb-2 text-xs font-bold tracking-widest text-accent uppercase";
        badge.textContent = badgeLabel;
        card.appendChild(badge);
      }

      const titleElement = document.createElement("h3");
      titleElement.className = `mb-3 text-base font-bold ${colorClass}`;
      titleElement.textContent = title;
      card.appendChild(titleElement);

      for (const item of items) {
        const line = document.createElement("div");
        line.className =
          "flex justify-between border-b border-border py-1.5 text-sm last:border-0";

        const labelElement = document.createElement("span");
        labelElement.className = "text-secondary";
        labelElement.textContent = item.label;

        const valueElement = document.createElement("span");
        valueElement.className = "font-mono font-semibold";
        valueElement.textContent = item.value;

        line.append(labelElement, valueElement);
        card.appendChild(line);
      }

      return card;
    };

    const summary = document.createElement("div");
    summary.className =
      "mb-4 rounded-lg bg-foreground/5 p-3 text-sm text-secondary";
    const marginalText = document.createElement("p");
    const marginalStrong = document.createElement("strong");
    marginalStrong.textContent = "Tu tasa marginal de impuesto:";
    marginalText.append(marginalStrong, ` ${fmtPct(resultado.marginalRate)}`);
    const taxText = document.createElement("p");
    const taxStrong = document.createElement("strong");
    taxStrong.textContent = "Impuesto sin APV:";
    taxText.append(taxStrong, ` ${fmt(resultado.taxWithoutApv)}/mes`);
    const targetText = document.createElement("p");
    const targetStrong = document.createElement("strong");
    targetStrong.textContent = "Aporte mensual para agotar bono A:";
    targetText.append(
      targetStrong,
      ` ${fmt(resultado.regimeA.monthlyContributionForMaxBonus)}`
    );
    const directContributionText = document.createElement("p");
    const directContributionStrong = document.createElement("strong");
    directContributionStrong.textContent = "Aporte directo anual adicional:";
    directContributionText.append(
      directContributionStrong,
      ` ${fmt(aporteDirectoAnual)}`
    );
    const taxableSalaryText = document.createElement("p");
    const taxableSalaryStrong = document.createElement("strong");
    taxableSalaryStrong.textContent = "Imponible usado:";
    taxableSalaryText.append(
      taxableSalaryStrong,
      ` ${fmt(resultado.taxableSalary)}`
    );
    const nonTaxableText = document.createElement("p");
    const nonTaxableStrong = document.createElement("strong");
    nonTaxableStrong.textContent = "No imponible estimado:";
    nonTaxableText.append(
      nonTaxableStrong,
      ` ${fmt(resultado.nonTaxableIncome)}`
    );
    summary.append(
      marginalText,
      taxText,
      targetText,
      directContributionText,
      taxableSalaryText,
      nonTaxableText
    );

    const strategyMessage = document.createElement("div");
    strategyMessage.className =
      "mb-4 rounded-lg border border-border p-3 text-sm text-secondary";

    const strategyLabel = document.createElement("strong");
    strategyLabel.textContent = "Sugerencia orientativa:";

    const strategyCopy =
      resultado.recommendedStrategy === "A"
        ? " Tu beneficio estimado es mayor si concentras este aporte en Régimen A."
        : resultado.recommendedStrategy === "B"
          ? " Tu beneficio estimado es mayor si concentras este aporte en Régimen B."
          : ` Podría convenirte dividir el aporte: ${fmt(
              resultado.mixedStrategy.contributionToRegimeA
            )} en A y ${fmt(resultado.mixedStrategy.contributionToRegimeB)} en B.`;

    strategyMessage.append(strategyLabel, strategyCopy);

    const regimeACard = buildCard(
      "Régimen A — Bono del Estado",
      "text-blue-500",
      [
        {
          label: "Aporte anual bonificable considerado",
          value: fmt(resultado.regimeA.effectiveAnnualContribution),
        },
        { label: "Impuesto mensual", value: fmt(resultado.regimeA.monthlyTax) },
        {
          label: "Bono Estado anual (15%)",
          value: `+ ${fmt(resultado.regimeA.annualBonus)}`,
        },
        {
          label: "Beneficio mensual equivalente",
          value: fmt(resultado.regimeA.monthlyBenefit),
        },
        {
          label: "Aporte anual para bono máximo",
          value: fmt(resultado.regimeA.annualContributionForMaxBonus),
        },
      ],
      resultado.recommendedStrategy === "A"
        ? "Sugerencia orientativa"
        : undefined
    );

    const regimeBCard = buildCard(
      "Régimen B — Rebaja de impuesto",
      "text-green-500",
      [
        {
          label: "Aporte anual con beneficio considerado",
          value: fmt(resultado.regimeB.effectiveAnnualContribution),
        },
        {
          label: "Promedio mensual equivalente",
          value: fmt(resultado.regimeB.effectiveMonthlyContribution),
        },
        {
          label: "Descuento por planilla con beneficio",
          value: fmt(resultado.regimeB.effectiveAnnualPayrollContribution),
        },
        {
          label: "Depósito directo anual con beneficio",
          value: fmt(resultado.regimeB.effectiveAnnualDirectContribution),
        },
        {
          label: "Base imponible reducida (equiv. mensual)",
          value: fmt(resultado.regimeB.reducedTaxBase),
        },
        {
          label: "Impuesto con APV (equiv. mensual)",
          value: fmt(resultado.regimeB.monthlyTax),
        },
        {
          label: "Ahorro impuesto mensual equivalente",
          value: fmt(resultado.regimeB.monthlyBenefit),
        },
        {
          label: "Ahorro impuesto anual",
          value: fmt(resultado.regimeB.annualBenefit),
        },
      ],
      resultado.recommendedStrategy === "B"
        ? "Sugerencia orientativa"
        : undefined
    );

    const shouldRenderMixedCard =
      resultado.mixedStrategy.contributionToRegimeA > 0 &&
      resultado.mixedStrategy.contributionToRegimeB > 0;

    const mixedCard = shouldRenderMixedCard
      ? buildCard(
          "Estrategia mixta — Parte en A y parte en B",
          "text-accent",
          [
            {
              label: "Aporte anual a Régimen A",
              value: fmt(resultado.mixedStrategy.annualContributionToRegimeA),
            },
            {
              label: "Aporte anual a Régimen B",
              value: fmt(resultado.mixedStrategy.annualContributionToRegimeB),
            },
            {
              label: "Bono A mensual equivalente",
              value: fmt(resultado.mixedStrategy.regimeAMonthlyBenefit),
            },
            {
              label: "Ahorro tributario B mensual equivalente",
              value: fmt(resultado.mixedStrategy.regimeBMonthlyBenefit),
            },
            {
              label: "Beneficio total mensual",
              value: fmt(resultado.mixedStrategy.monthlyBenefit),
            },
          ],
          resultado.recommendedStrategy === "MIXED"
            ? "Sugerencia orientativa"
            : undefined
        )
      : null;

    const note = document.createElement("p");
    note.className = "mt-2 text-xs text-muted";
    note.textContent = `El bono del Régimen A se acredita en tu cuenta APV al año siguiente (Operación Renta). En Régimen B, los descuentos por planilla tienen tope mensual de 50 UF (~${fmt(resultado.regimeB.monthlyContributionCap)}) y los aportes con beneficio comparten además un tope anual conjunto de 600 UF (~${fmt(resultado.regimeB.annualContributionCap)}). Si incluyes depósitos directos, esta tarjeta muestra equivalentes mensuales para aproximar un beneficio que normalmente se regulariza en Operación Renta.`;

    document
      .getElementById("resultado-contenido")!
      .replaceChildren(
        summary,
        strategyMessage,
        regimeACard,
        regimeBCard,
        ...(mixedCard ? [mixedCard] : []),
        note
      );

    const _annualBenefit =
      resultado.recommendedStrategy === "A"
        ? resultado.regimeA.annualBonus
        : resultado.recommendedStrategy === "B"
          ? resultado.regimeB.annualBenefit
          : resultado.mixedStrategy.monthlyBenefit * 12;

    document.dispatchEvent(
      new CustomEvent("calculator:result", {
        detail: {
          summaryText: `Simulador APV: régimen recomendado ${resultado.recommendedStrategy} — beneficio anual estimado ${fmt(_annualBenefit)}`,
        },
      })
    );
    window.showCalculatorNextActions?.();
    trackAnalyticsEvent("calculator_complete", {
      calculator_slug: "apv",
      calculator_name: "Simulador APV",
      outcome: "success",
    });
  });
</script>
