---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import CalculatorJsonLd from "@/components/CalculatorJsonLd.astro";
import Footer from "@/components/Footer.astro";
import MethodologyBlock from "@/components/MethodologyBlock.astro";
import { finiquitoWorkedExample } from "@/application/use-cases/EstimateFiniquito.methodology";
import PrimaryCTA from "@/components/PrimaryCTA.astro";
import ShareCalculatorResult from "@/components/ShareCalculatorResult.astro";
import CalculatorResultNextActions from "@/components/CalculatorResultNextActions.astro";
import NextBestStep from "@/components/NextBestStep.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CalculatorTrustBadge from "@/components/CalculatorTrustBadge.astro";
import NextSteps from "@/components/NextSteps.astro";
import { CALCULATOR_PORTFOLIO } from "@/config/calculatorPortfolio";
import { getPath } from "@/utils/getPath";
import CalculatorHero from "@/components/calculator/CalculatorHero.astro";
import CalculatorField from "@/components/calculator/CalculatorField.astro";
import CalculatorRadioGroup from "@/components/calculator/CalculatorRadioGroup.astro";
import CalculatorResultPanel from "@/components/calculator/CalculatorResultPanel.astro";
import CalculatorExplainerSection from "@/components/calculator/CalculatorExplainerSection.astro";
import { getEconomicParameters } from "@/application/use-cases/GetEconomicParameters";

const { parameters: economicParameters } = await getEconomicParameters();

const finiquitoGuidePath = getPath(
  "/posts/finiquito-e-indemnizaciones-en-chile/"
);
const cesantiaGuidePath = getPath("/posts/seguro-de-cesantia/");
const finiquitoFaqs = [
  {
    question: "¿Cuántos días de vacaciones proporcionales me corresponden?",
    answer:
      "Según el art. 71 del Código del Trabajo, te corresponden 1,25 días hábiles por cada mes trabajado desde tu último ciclo de vacaciones. Por ejemplo, con 8 meses transcurridos: 8 × 1,25 = 10 días proporcionales. Esta calculadora incluye un modo 'Vacaciones proporcionales' para estimarlo directamente.",
  },
  {
    question: "¿Cómo se calcula el monto por feriado proporcional?",
    answer:
      "El valor diario equivale a la última remuneración mensual dividida por 30. Ese valor se multiplica por los días proporcionales. Ejemplo: sueldo $900.000, 10 días proporcionales → $900.000 ÷ 30 × 10 = $300.000.",
  },
  {
    question: "¿Corresponde feriado proporcional si renuncio?",
    answer:
      "Sí. El derecho al pago proporcional de vacaciones no tomadas existe en todas las causales de término: renuncia voluntaria, despido, mutuo acuerdo o vencimiento de plazo. Es exigible siempre que hayas trabajado al menos un período proporcional desde el último ciclo de vacaciones.",
  },
  {
    question: "¿Qué incluye el finiquito en Chile?",
    answer:
      "El finiquito puede incluir: sueldo pendiente del mes, feriado proporcional (vacaciones no tomadas), indemnización por años de servicio (art. 163 CT), aviso previo sustitutivo si aplica (art. 161) y gratificación proporcional si tu empresa la paga anualmente. El monto final depende de la causal de término.",
  },
];
const currentCalculator = CALCULATOR_PORTFOLIO.find(
  calc => calc.slug === "finiquito-indemnizacion"
);
const calculatorRelatedItems = (currentCalculator?.related ?? []).map(item => ({
  href: item.href,
  title: item.label,
  description: item.when,
  label: "Relacionado",
}));
const calculatorNextStepItems = [
  ...calculatorRelatedItems,
  ...(calculatorRelatedItems.length < 2
    ? [
        {
          href: "/calculadoras/",
          title: "Ver todas las calculadoras",
          description: "Compara otra herramienta si tu pregunta cambió.",
          label: "Herramientas",
        },
      ]
    : []),
];
---

<Layout
  title="Calculadora de Finiquito e Indemnización | Chile"
  description="Estima finiquito, aviso previo, años de servicio y feriado proporcional con supuestos visibles para revisar tu salida laboral."
>
  <CalculatorJsonLd
    name="Calculadora de Finiquito e Indemnización | Chile"
    description="Estima finiquito, aviso previo, años de servicio y feriado proporcional con supuestos visibles para revisar tu salida laboral."
    faqs={finiquitoFaqs}
  />
  <Header />
  <Breadcrumb />
  <CalculatorTrustBadge location="calculator_header" />
  <main
    data-layout="calculator"
    id="main-content"
    class="app-layout"
    data-analytics-page-type="calculator"
    data-analytics-calculator="finiquito-indemnizacion"
    data-analytics-calculator-name="Calculadora Finiquito e Indemnizacion"
    data-profile-prefill-host="#calculator-form-card"
  >
    <CalculatorHero
      title="Calculadora de Finiquito e Indemnización"
      description="Estima un caso base de salida laboral: sueldo pendiente, feriado proporcional, aviso previo e indemnización por años de servicio. No reemplaza la revisión del documento real ni un caso judicial."
    />

    <section
      class="grid items-start gap-6 py-8 lg:grid-cols-[minmax(0,420px)_minmax(0,1fr)]"
    >
      <div
        id="calculator-form-card"
        class="rounded-xl border border-border p-6"
      >
        <CalculatorRadioGroup
          legend="Modo de cálculo"
          name="finiquito-modo"
          options={[
            {
              id: "modo-finiquito",
              value: "finiquito",
              label: "Finiquito completo",
              checked: true,
            },
            {
              id: "modo-vacaciones",
              value: "vacaciones",
              label: "Vacaciones proporcionales",
            },
          ]}
        />

        <h2 class="mb-4 text-base font-semibold" id="modo-label-heading">
          Datos del caso
        </h2>

        <CalculatorField
          id="monthly-salary"
          label="Última remuneración mensual ($)"
          min="0"
          placeholder="Ej: 900.000"
          hint="No incluyas horas extra ni bonos anuales (aguinaldos, gratificaciones): la ley los excluye de la base (art. 172). Si tienes remuneraciones variables, usa el promedio de los últimos 3 meses."
          inputAttrs={{ "data-profile-bind": "sueldoImponible" }}
        />

        <div class="grid gap-4 sm:grid-cols-2" data-finiquito-only>
          <CalculatorField
            id="years-worked"
            label="Años completos trabajados"
            min="0"
            value="0"
          />
          <CalculatorField
            id="months-worked"
            label="Meses adicionales"
            min="0"
            max="11"
            value="0"
          />
        </div>

        <CalculatorField
          id="termination-cause"
          label="Causal de término"
          data-finiquito-only
        >
          <select
            id="termination-cause"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          >
            <option value="necesidad"
              >Necesidades de la empresa (art. 161)</option
            >
            <option value="mutuo-acuerdo">Mutuo acuerdo</option>
            <option value="renuncia">Renuncia voluntaria</option>
            <option value="disciplinaria"
              >Despido por causal disciplinaria</option
            >
            <option value="vencimiento-obra"
              >Vencimiento de plazo / fin de obra</option
            >
            <option value="judicial"
              >Despido injustificado declarado judicialmente</option
            >
          </select>
        </CalculatorField>

        <CalculatorField
          id="judicial-declaration"
          label="Tipo de declaración judicial (art. 168)"
          wrapperId="judicial-declaration-field"
          class="hidden"
        >
          <select
            id="judicial-declaration"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          >
            <option value="">No especificado — lo fija el tribunal</option>
            <option value="improcedente-161"
              >Improcedente del art. 161 (recargo 30%)</option
            >
            <option value="injustificada-159"
              >Injustificada del art. 159 o sin causal (recargo 50%)</option
            >
            <option value="indebida-160"
              >Indebida del art. 160 (recargo 80%)</option
            >
          </select>
        </CalculatorField>

        <div
          id="economic-parameters"
          data-uf={String(economicParameters.uf)}
          class="hidden"
          aria-hidden="true"
        >
        </div>

        <CalculatorRadioGroup
          legend="¿Te avisaron con 30 días de anticipación?"
          name="notice-given"
          class="mb-4"
          data-finiquito-only
          options={[
            { id: "notice-si", value: "si", label: "Sí", checked: true },
            { id: "notice-no", value: "no", label: "No" },
          ]}
        />

        <div class="grid gap-4 sm:grid-cols-2">
          <CalculatorField
            id="pending-salary-days"
            label="Días trabajados del mes sin pagar"
            min="0"
            max="30"
            value="0"
            hint="Días del mes en curso que ya trabajaste y aún no te han pagado. Ej: si te van el día 20 y el sueldo se paga el 30, son 20 días."
            data-finiquito-only={true}
          />
          <CalculatorField
            id="vacation-months"
            label="Meses desde el último ciclo de vacaciones"
            min="0"
            max="12"
            value="0"
          />
        </div>

        <CalculatorField
          id="vacation-extra-days"
          label="Días adicionales trabajados en el ciclo"
          min="0"
          max="30"
          value="0"
          hint="Si no sabes este dato exacto, usa 0 y revisa luego con tus fechas reales."
        />

        <CalculatorRadioGroup
          legend="¿Tu empresa paga gratificación anual (art. 47)?"
          name="gratificacion-anual"
          class="mb-4"
          data-finiquito-only
          hint="Solo si la gratificación se paga en una suma anual en balance, no integrada en el sueldo mensual."
          options={[
            { id: "grat-no", value: "no", label: "No / No sé", checked: true },
            { id: "grat-si", value: "si", label: "Sí, pago anual" },
          ]}
        />

        <button
          id="calcBtn"
          class="mt-2 w-full rounded-lg bg-accent px-4 py-3 text-base font-bold text-background transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
        >
          <span id="calcBtn-label">Estimar finiquito →</span>
        </button>

        <div
          id="finiquito-error"
          class="mt-3 hidden rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-sm text-danger"
          role="alert"
        >
        </div>
      </div>

      <CalculatorResultPanel title="Estimación orientativa" disclaimer>
        <div id="resultado-contenido" data-is-example="true" aria-live="polite">
          <div
            class="mb-5 rounded-lg border border-border bg-surface-muted/40 p-4 text-center"
          >
            <p
              class="mb-1 text-xs font-bold tracking-widest text-muted uppercase"
            >
              Total estimado (Ejemplo ilustrativo)
            </p>
            <p class="text-4xl font-bold text-foreground/80">$3.600.000</p>
          </div>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-secondary">Sueldo pendiente (15 días)</span>
              <span class="font-medium text-foreground/80">$450.000</span>
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Feriado proporcional</span>
              <span class="font-medium text-foreground/80">$450.000</span>
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Aviso previo</span>
              <span class="font-medium text-foreground/80">$900.000</span>
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Indemnización (3 años)</span>
              <span class="font-medium text-foreground/80">$2.700.000</span>
            </div>
          </div>
          <p class="mt-4 text-xs text-muted">
            Ejemplo: sueldo $900.000, 3 años, necesidades de la empresa, sin
            aviso previo. Ingresa tus datos para ver tu resultado.
          </p>
        </div>
      </CalculatorResultPanel>
    </section>

    <NextBestStep slug="finiquito-indemnizacion" />

    <CalculatorExplainerSection>
      <h2>Cuándo esta calculadora sí sirve</h2>
      <ul>
        <li>
          Para revisar rápido si el orden de magnitud del finiquito parece
          razonable.
        </li>
        <li>
          Para separar sueldo pendiente, vacaciones, aviso previo e
          indemnización.
        </li>
        <li>
          Para detectar si la causal declarada cambia por completo el resultado.
        </li>
      </ul>

      <h2>Cuándo debes escalar</h2>
      <ul>
        <li>
          Si tu remuneración incluye variables complejas, comisiones o promedio
          de bonos.
        </li>
        <li>
          Si hay discusión por causal de despido, reserva de derechos o recargo
          judicial.
        </li>
        <li>
          Si el documento ya viene firmado o el empleador no entrega desglose.
        </li>
      </ul>

      <p class="text-sm text-muted">
        Estimador educativo. El finiquito real puede cambiar por topes, pactos,
        variables remuneracionales y controversias legales.
      </p>
      <p>
        Para revisar la lógica completa, abre la <a
          href={finiquitoGuidePath}
          data-analytics-cta="calculator-guide"
          data-analytics-label="Guia de finiquito"
          data-analytics-location="calculator_explainer"
          >guía de finiquito e indemnizaciones</a
        >. Si además quedaste sin trabajo, complementa con la guía de <a
          href={cesantiaGuidePath}
          data-analytics-cta="calculator-guide"
          data-analytics-label="Guia de seguro de cesantia"
          data-analytics-location="calculator_explainer_secondary"
          >seguro de cesantía</a
        >.
      </p>

      <h2>Vacaciones proporcionales (art. 71 CT)</h2>
      <p>
        Al término de la relación laboral, el trabajador tiene derecho al pago
        del feriado proporcional por los días trabajados desde el último ciclo
        completo de vacaciones. La fórmula es: <strong
          >1,25 días hábiles × meses trabajados</strong
        > desde el último ciclo. El valor diario se calcula dividiendo la última remuneración
        mensual por 30.
      </p>
      <p>
        Usa el modo <strong>Vacaciones proporcionales</strong> de esta calculadora
        para estimar solo ese componente sin ingresar todos los datos del finiquito.
      </p>
    </CalculatorExplainerSection>

    <PrimaryCTA
      text="Conoce todos tus derechos en el finiquito →"
      href="/posts/finiquito-e-indemnizaciones-en-chile/"
      context="Antes de firmar, asegúrate de entender qué corresponde en cada causal de término."
    />
    <ShareCalculatorResult />
    <CalculatorResultNextActions
      calculatorSlug="finiquito-indemnizacion"
      actions={[
        { label: "Imprimir resultado", href: "#", type: "print" },
        {
          label: "Guía completa: finiquito",
          href: "/posts/finiquito-e-indemnizaciones-en-chile/",
          type: "article",
        },
        {
          label: "Seguro de cesantía",
          href: "/calculadoras/seguro-cesantia/",
          type: "calculator",
        },
      ]}
    />
    <MethodologyBlock
      example={finiquitoWorkedExample.example}
      notes="Esta calculadora estima el finiquito según las reglas del Código del Trabajo de Chile: indemnización por años de servicio (art. 163), aviso previo (art. 161), vacaciones proporcionales (art. 71 — 1,25 días/mes) y sueldo pendiente del mes. El modo Vacaciones proporcionales aplica solo la lógica del art. 71 CT. Los montos son orientativos; remuneraciones variables o cláusulas especiales requieren revisión profesional."
      sources={[
        {
          name: "Código del Trabajo — Artículos 159, 160, 161, 163",
          url: "https://www.bcn.cl/leychile/navegar?idNorma=207436",
          date: "2025-12",
        },
        {
          name: "Código del Trabajo — Art. 71 (feriado proporcional al término)",
          url: "https://www.bcn.cl/leychile/navegar?idNorma=207436",
          date: "2025-12",
        },
        {
          name: "Dirección del Trabajo — Plazo y formalidades del finiquito",
          url: "https://www.dt.gob.cl/portal/1628/w3-article-60613.html",
          date: "2026-01",
        },
      ]}
    />
    <NextSteps
      currentHref="/calculadoras/finiquito-indemnizacion/"
      items={calculatorNextStepItems}
      title="Qué hacer con este resultado"
      description="Sigue con una herramienta relacionada o vuelve al índice si necesitas resolver otra pregunta."
      location="calculator_next_steps"
    />
  </main>
  <Footer />
</Layout>

<script>
  import "@/scripts/calculator-prefill";
  import { estimateFiniquito } from "@/application/use-cases/EstimateFiniquito";
  import { trackAnalyticsEvent } from "@/utils/analytics";
  import { renderHeadlineDelta } from "@/utils/calculatorDelta";
  import {
    markResultState,
    renderInvalidResultState,
  } from "@/utils/calculatorResultState";

  declare global {
    interface Window {
      showShareResult?: (text: string) => void;
      showCalculatorNextActions?: () => void;
    }
  }

  const currencyFormatter = new Intl.NumberFormat("es-CL", {
    style: "currency",
    currency: "CLP",
    maximumFractionDigits: 0,
  });

  function fmtCurrency(value: number): string {
    return currencyFormatter.format(Math.round(value));
  }

  function buildRow(
    label: string,
    value: string,
    colorClass = ""
  ): HTMLDivElement {
    const line = document.createElement("div");
    line.className =
      "flex items-center justify-between border-b border-border py-2 text-sm last:border-0";
    const labelElement = document.createElement("span");
    labelElement.className = "text-secondary";
    labelElement.textContent = label;
    const valueElement = document.createElement("span");
    valueElement.className = `font-mono font-semibold ${colorClass}`.trim();
    valueElement.textContent = value;
    line.append(labelElement, valueElement);
    return line;
  }

  function showInlineError(message: string) {
    renderInvalidResultState();
    const errorBox = document.getElementById("finiquito-error");
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.remove("hidden");
  }

  function clearInlineError() {
    const errorBox = document.getElementById("finiquito-error");
    if (!errorBox) return;
    errorBox.textContent = "";
    errorBox.classList.add("hidden");
  }

  function getModo(): "finiquito" | "vacaciones" {
    return (
      document.querySelector(
        "input[name='finiquito-modo']:checked"
      ) as HTMLInputElement
    )?.value === "vacaciones"
      ? "vacaciones"
      : "finiquito";
  }

  function updateModoUI() {
    const modo = getModo();
    const esVacaciones = modo === "vacaciones";
    const label = document.getElementById("calcBtn-label");
    const heading = document.getElementById("modo-label-heading");
    if (label)
      label.textContent = esVacaciones
        ? "Calcular vacaciones proporcionales →"
        : "Estimar finiquito →";
    if (heading)
      heading.textContent = esVacaciones
        ? "Datos para vacaciones"
        : "Datos del caso";
    document
      .querySelectorAll("[data-finiquito-only]")
      .forEach(el =>
        (el as HTMLElement).classList.toggle("hidden", esVacaciones)
      );

    // El tipo de declaración judicial solo aplica con causal "judicial".
    const judicialField = document.getElementById("judicial-declaration-field");
    const cause = (
      document.getElementById("termination-cause") as HTMLSelectElement | null
    )?.value;
    judicialField?.classList.toggle(
      "hidden",
      esVacaciones || cause !== "judicial"
    );
  }

  // Run on load to handle browser form state restoration (e.g. after refresh).
  updateModoUI();

  document
    .getElementById("termination-cause")
    ?.addEventListener("change", updateModoUI);

  document.querySelectorAll("input[name='finiquito-modo']").forEach(radio => {
    radio.addEventListener("change", () => {
      updateModoUI();
      trackAnalyticsEvent("calculator_mode_toggle", {
        calculator_slug: "finiquito-indemnizacion",
        mode: getModo(),
      });
    });
  });

  document.getElementById("calcBtn")?.addEventListener("click", () => {
    clearInlineError();

    const monthlySalary =
      parseFloat(
        (document.getElementById("monthly-salary") as HTMLInputElement).value
      ) || 0;
    const vacationMonths =
      parseInt(
        (document.getElementById("vacation-months") as HTMLInputElement).value
      ) || 0;
    const vacationExtraDays =
      parseInt(
        (document.getElementById("vacation-extra-days") as HTMLInputElement)
          .value
      ) || 0;

    if (monthlySalary <= 0) {
      showInlineError(
        "Ingresa una remuneración mensual válida antes de calcular."
      );
      return;
    }

    const modo = getModo();

    // --- Modo vacaciones proporcionales (art. 71 CT) ---
    if (modo === "vacaciones") {
      let result;
      try {
        result = estimateFiniquito({
          monthlySalary,
          yearsWorked: 0,
          additionalMonthsWorked: 0,
          pendingSalaryDays: 0,
          monthsSinceLastVacationCycle: vacationMonths,
          additionalVacationDaysWorked: vacationExtraDays,
          terminationCause: "renuncia",
          noticeGiven: true,
          gratificacionAnual: false,
        });
      } catch (error) {
        showInlineError(
          error instanceof Error
            ? error.message
            : "No se pudo calcular las vacaciones proporcionales."
        );
        return;
      }

      const headline = document.createElement("div");
      headline.className =
        "mb-5 rounded-lg border border-accent/20 bg-accent/10 p-4 text-center";
      const headlineLabel = document.createElement("p");
      headlineLabel.className =
        "mb-1 text-xs font-bold tracking-widest text-accent uppercase";
      headlineLabel.textContent = "Feriado proporcional estimado";
      const headlineDays = document.createElement("p");
      headlineDays.className = "text-2xl font-semibold mt-1";
      headlineDays.textContent = `${result.proportionalVacationDays.toFixed(2)} días`;
      const headlineValue = document.createElement("p");
      headlineValue.className = "text-4xl font-bold mt-1";
      headlineValue.textContent = fmtCurrency(
        result.proportionalVacationAmount
      );
      headline.append(headlineLabel, headlineDays, headlineValue);

      const delta = renderHeadlineDelta(
        window.location.pathname,
        result.proportionalVacationAmount,
        fmtCurrency
      );
      if (delta) headline.append(delta);

      const note = document.createElement("p");
      note.className = "mt-4 text-xs text-muted";
      note.textContent =
        "Base: 1,25 días hábiles por mes trabajado (art. 71 CT). Valor diario = remuneración mensual ÷ 30.";

      const vacationContainer = document.getElementById("resultado-contenido");
      vacationContainer?.replaceChildren(
        headline,
        buildRow("Meses transcurridos", `${vacationMonths}`, "text-secondary"),
        buildRow("Días adicionales", `${vacationExtraDays}`, "text-secondary"),
        buildRow(
          "Días proporcionales",
          `${result.proportionalVacationDays.toFixed(2)}`,
          "text-accent"
        ),
        buildRow(
          "Valor diario",
          fmtCurrency(monthlySalary / 30),
          "text-secondary"
        ),
        buildRow(
          "Monto feriado proporcional",
          fmtCurrency(result.proportionalVacationAmount),
          "text-accent"
        ),
        note
      );
      markResultState(vacationContainer, "result");

      document.dispatchEvent(
        new CustomEvent("calculator:result", {
          detail: {
            summaryText: `Feriado proporcional: ${result.proportionalVacationDays.toFixed(2)} días — ${fmtCurrency(result.proportionalVacationAmount)}`,
          },
        })
      );
      window.showCalculatorNextActions?.();
      trackAnalyticsEvent("calculator_complete", {
        calculator_slug: "finiquito-indemnizacion",
        calculator_name: "Calculadora Finiquito e Indemnizacion",
        outcome: "success",
        mode: "vacaciones-proporcionales",
      });
      return;
    }

    // --- Modo finiquito completo ---
    const yearsWorked =
      parseInt(
        (document.getElementById("years-worked") as HTMLInputElement).value
      ) || 0;
    const monthsWorked =
      parseInt(
        (document.getElementById("months-worked") as HTMLInputElement).value
      ) || 0;
    const pendingSalaryDays =
      parseInt(
        (document.getElementById("pending-salary-days") as HTMLInputElement)
          .value
      ) || 0;
    const terminationCause = (
      document.getElementById("termination-cause") as HTMLSelectElement
    ).value;
    const noticeGiven =
      (
        document.querySelector(
          "input[name='notice-given']:checked"
        ) as HTMLInputElement
      )?.value === "si";
    const gratificacionAnualEl = document.querySelector(
      'input[name="gratificacion-anual"]:checked'
    ) as HTMLInputElement | null;
    const gratificacionAnual = gratificacionAnualEl?.value === "si";
    const ufValue = Number(
      (document.getElementById("economic-parameters") as HTMLElement | null)
        ?.dataset?.uf
    );
    const judicialDeclarationType = (
      document.getElementById("judicial-declaration") as HTMLSelectElement
    )?.value as "improcedente-161" | "injustificada-159" | "indebida-160" | "";

    let result;
    try {
      result = estimateFiniquito({
        monthlySalary,
        ufValue: Number.isFinite(ufValue) && ufValue > 0 ? ufValue : undefined,
        yearsWorked,
        additionalMonthsWorked: monthsWorked,
        pendingSalaryDays,
        monthsSinceLastVacationCycle: vacationMonths,
        additionalVacationDaysWorked: vacationExtraDays,
        terminationCause: terminationCause as
          | "necesidad"
          | "mutuo-acuerdo"
          | "renuncia"
          | "disciplinaria"
          | "vencimiento-obra"
          | "judicial",
        noticeGiven,
        judicialDeclarationType:
          judicialDeclarationType === "" ? undefined : judicialDeclarationType,
        gratificacionAnual,
      });
    } catch (error) {
      showInlineError(
        error instanceof Error
          ? error.message
          : "No se pudo calcular el finiquito."
      );
      return;
    }

    const headline = document.createElement("div");
    headline.className =
      "mb-5 rounded-lg border border-accent/20 bg-accent/10 p-4 text-center";
    const headlineLabel = document.createElement("p");
    headlineLabel.className =
      "mb-1 text-xs font-bold tracking-widest text-accent uppercase";
    headlineLabel.textContent = "Total estimado";
    const headlineValue = document.createElement("p");
    headlineValue.className = "text-4xl font-bold";
    headlineValue.textContent = fmtCurrency(result.totalEstimate);
    headline.append(headlineLabel, headlineValue);

    const notes = document.createElement("ul");
    notes.className = "mt-4 space-y-2 text-xs leading-relaxed text-muted";
    result.assumptions.forEach(item => {
      const line = document.createElement("li");
      line.textContent = `• ${item}`;
      notes.appendChild(line);
    });

    const flags = document.createElement("div");
    flags.className = "mt-4 flex flex-wrap gap-2";
    const buildFlag = (text: string, className: string) => {
      const badge = document.createElement("span");
      badge.className = className;
      badge.textContent = text;
      return badge;
    };

    if (result.compensationProfile.appliesYearsOfService) {
      flags.appendChild(
        buildFlag(
          "Incluye años de servicio",
          "rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-semibold text-accent"
        )
      );
    }
    if (!result.compensationProfile.appliesYearsOfService) {
      flags.appendChild(
        buildFlag(
          "No incluye años de servicio",
          "rounded-full border border-border px-3 py-1 text-xs font-semibold text-secondary"
        )
      );
    }
    if (result.compensationProfile.requiresProfessionalReview) {
      flags.appendChild(
        buildFlag(
          "Revisión profesional recomendada",
          "rounded-full border border-red-500/30 bg-red-500/10 px-3 py-1 text-xs font-semibold text-danger"
        )
      );
    }

    const resultContainer = document.getElementById("resultado-contenido");
    resultContainer?.replaceChildren(
      headline,
      buildRow(
        "Años contados",
        `${result.serviceYearsCounted}`,
        "text-secondary"
      ),
      buildRow(
        "Años con tope legal",
        `${result.cappedServiceYears}`,
        "text-secondary"
      ),
      buildRow(
        "Días trabajados del mes sin pagar",
        fmtCurrency(result.pendingSalaryAmount),
        "text-secondary"
      ),
      buildRow(
        "Feriado proporcional",
        `${result.proportionalVacationDays.toFixed(2)} días`,
        "text-secondary"
      ),
      buildRow(
        "Monto por feriado proporcional",
        fmtCurrency(result.proportionalVacationAmount),
        "text-secondary"
      ),
      buildRow(
        "Indemnización años de servicio",
        fmtCurrency(result.yearsOfServiceIndemnity),
        result.yearsOfServiceIndemnity > 0 ? "text-accent" : "text-secondary"
      ),
      buildRow(
        "Indemnización obra o faena (art. 163)",
        fmtCurrency(result.obraFaenaIndemnity),
        result.obraFaenaIndemnity > 0 ? "text-accent" : "text-secondary"
      ),
      ...(result.baseSalaryCappedByUf
        ? [
            buildRow(
              "Base topada a 90 UF (art. 172)",
              fmtCurrency(result.cappedSalaryBase),
              "text-secondary"
            ),
          ]
        : []),
      buildRow(
        "Aviso previo sustitutivo",
        fmtCurrency(result.substituteNoticeIndemnity),
        result.substituteNoticeIndemnity > 0 ? "text-accent" : "text-secondary"
      ),
      buildRow(
        "Gratificación proporcional (art. 47)",
        fmtCurrency(result.gratificacionProporcionalAmount),
        result.gratificacionProporcionalAmount > 0
          ? "text-accent"
          : "text-secondary"
      ),
      buildRow(
        `Recargo despido injustificado (art. 168 — ${(result.art168SurchargePercent * 100).toFixed(0)}%)`,
        fmtCurrency(result.art168SurchargeAmount),
        result.art168SurchargeAmount > 0 ? "text-accent" : "text-secondary"
      ),
      flags,
      notes
    );
    markResultState(resultContainer, "result");

    document.dispatchEvent(
      new CustomEvent("calculator:result", {
        detail: {
          summaryText: `Finiquito estimado: ${fmtCurrency(result.totalEstimate)} (causal: ${terminationCause})`,
        },
      })
    );
    window.showCalculatorNextActions?.();
    trackAnalyticsEvent("calculator_complete", {
      calculator_slug: "finiquito-indemnizacion",
      calculator_name: "Calculadora Finiquito e Indemnizacion",
      outcome: "success",
      mode: "finiquito-completo",
    });
  });
</script>
