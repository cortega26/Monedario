---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import CalculatorJsonLd from "@/components/CalculatorJsonLd.astro";
import Footer from "@/components/Footer.astro";
import MethodologyBlock from "@/components/MethodologyBlock.astro";
import PrimaryCTA from "@/components/PrimaryCTA.astro";
import ShareCalculatorResult from "@/components/ShareCalculatorResult.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CalculatorTrustBadge from "@/components/CalculatorTrustBadge.astro";
import NextSteps from "@/components/NextSteps.astro";
import { CALCULATOR_PORTFOLIO } from "@/config/calculatorPortfolio";
import { getEconomicParameters } from "@/application/use-cases/GetEconomicParameters";
const { parameters: economicParameters } = await getEconomicParameters();
const economicSourceLabel =
  economicParameters.source === "live"
    ? "dato en línea"
    : economicParameters.source === "snapshot"
      ? "dato de referencia"
      : "fallback de emergencia";
const currentCalculator = CALCULATOR_PORTFOLIO.find(
  calc => calc.slug === "prepago-credito"
);
const calculatorRelatedItems = (currentCalculator?.related ?? []).map(item => ({
  href: item.href,
  title: item.label,
  description: item.when,
  label: "Relacionado",
}));
const calculatorNextStepItems = [
  ...calculatorRelatedItems,
  ...(calculatorRelatedItems.length < 2
    ? [
        {
          href: "/calculadoras/",
          title: "Ver todas las calculadoras",
          description: "Compara otra herramienta si tu pregunta cambió.",
          label: "Herramientas",
        },
      ]
    : []),
];
---

<Layout
  title="¿Conviene prepagar el crédito? Simulador hipotecario y consumo Chile 2026"
  description="Calcula cuánto ahorras en intereses al hacer un abono extraordinario a tu crédito hipotecario o de consumo. Compara prepagar vs. invertir ese dinero."
>
  <CalculatorJsonLd
    name="Simulador de Prepago de Crédito: hipotecario y consumo Chile 2026"
    description="Calcula cuánto ahorras en intereses al hacer un abono extraordinario a tu crédito hipotecario o de consumo. Compara prepagar vs. invertir ese dinero."
  />
  <Header />
  <Breadcrumb />
  <CalculatorTrustBadge location="calculator_header" />
  <main
    data-layout="calculator"
    id="main-content"
    class="app-layout"
    data-analytics-page-type="calculator"
    data-analytics-calculator="prepago-credito"
    data-analytics-calculator-name="Calculadora de Prepago de Credito"
  >
    <section class="border-b border-border pt-8 pb-6">
      <h1 class="my-4 text-3xl font-bold sm:text-4xl">
        💡 ¿Me conviene prepagar el crédito?
      </h1>
      <p class="max-w-xl text-secondary">
        Calcula cuánto ahorras en intereses si haces un abono extraordinario a
        tu crédito y si conviene más prepagar o invertir ese dinero.
      </p>
    </section>

    <section class="grid items-start gap-6 py-8 sm:grid-cols-2">
      <!-- FORMULARIO -->
      <div class="rounded-xl border border-border p-6">
        <h2 class="mb-4 text-lg font-semibold">Tu crédito actual</h2>

        <div class="mb-5">
          <p class="mb-2 text-xs font-medium text-secondary">
            Moneda de ingreso
          </p>
          <div class="flex gap-2">
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="moneda"
                value="CLP"
                checked
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-2 text-center text-xs font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                $ CLP
              </span>
            </label>
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="moneda"
                value="UF"
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-2 text-center text-xs font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                UF
              </span>
            </label>
          </div>
          <p class="mt-1 text-xs text-muted">
            UF del día: ${
              economicParameters.uf.toLocaleString("es-CL", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
              })
            } (fuente: {economicSourceLabel})
          </p>
        </div>

        <div class="mb-4">
          <label
            for="saldo"
            class="mb-1 block text-sm font-medium text-secondary"
          >
            Saldo pendiente ($)
          </label>
          <input
            type="number"
            id="saldo"
            placeholder="Ej: 15.000.000"
            min="0"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          />
        </div>

        <div class="mb-4">
          <label
            for="cuota"
            class="mb-1 block text-sm font-medium text-secondary"
          >
            Cuota mensual actual ($)
          </label>
          <input
            type="number"
            id="cuota"
            placeholder="Ej: 350.000"
            min="0"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          />
        </div>

        <div class="mb-4">
          <label
            for="tasa-credito"
            class="mb-1 block text-sm font-medium text-secondary"
          >
            Tasa de interés mensual (%)
          </label>
          <input
            type="number"
            id="tasa-credito"
            placeholder="Ej: 0.8"
            min="0"
            max="5"
            step="0.01"
            value="0.8"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          />
          <p class="mt-1 text-xs text-muted">
            Hipotecarios: ~0.4–0.8% mensual. Consumo: ~1.5–3.5% mensual.
          </p>
          <div
            class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted"
          >
            <span>¿Solo conoces tu tasa anual o CAE?</span>
            <div class="flex items-center gap-1">
              <input
                id="tasa-anual-helper"
                type="number"
                placeholder="Ej: 12"
                min="0"
                max="200"
                step="0.1"
                aria-label="Tasa anual para convertir a mensual"
                class="w-20 rounded border border-border bg-background px-2 py-1 text-xs text-foreground focus:border-accent focus:outline-none"
              />
              <span>% anual</span>
            </div>
            <span id="tasa-conversion-resultado" class="font-medium text-accent"
            ></span>
          </div>
        </div>

        <div class="mb-4">
          <label
            for="meses-restantes"
            class="mb-1 block text-sm font-medium text-secondary"
          >
            Meses restantes
          </label>
          <input
            type="number"
            id="meses-restantes"
            placeholder="Ej: 180"
            min="1"
            max="480"
            value="180"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          />
        </div>

        <div class="mb-4">
          <label
            for="monto-prepago"
            class="mb-1 block text-sm font-medium text-secondary"
          >
            Monto del abono extraordinario ($)
          </label>
          <input
            type="number"
            id="monto-prepago"
            placeholder="Ej: 2.000.000"
            min="0"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          />
        </div>

        <div class="mb-4">
          <label
            for="costo-prepago"
            class="mb-1 block text-sm font-medium text-secondary"
          >
            Comisión o costo de prepago ($)
          </label>
          <input
            type="number"
            id="costo-prepago"
            placeholder="Ej: 120.000"
            min="0"
            value="0"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          />
          <p class="mt-1 text-xs text-muted">
            Si no conoces el dato exacto, déjalo en `0` como supuesto
            provisional y revísalo después en tu contrato o con el banco.
          </p>
        </div>

        <div class="mb-4">
          <label class="mb-2 block text-sm font-medium text-secondary"
            >Efecto del prepago</label
          >
          <div class="flex gap-2">
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="efecto"
                value="reducir-plazo"
                checked
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-2 text-center text-xs font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                Acortar plazo
              </span>
            </label>
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="efecto"
                value="reducir-cuota"
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-2 text-center text-xs font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                Bajar cuota
              </span>
            </label>
          </div>
        </div>

        <div class="mb-4 border-t border-border pt-4">
          <label
            for="rentabilidad-alternativa"
            class="mb-1 block text-sm font-medium text-secondary"
          >
            Rentabilidad alternativa (% anual)
          </label>
          <select
            id="rentabilidad-alternativa"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          >
            <option value="3">3% — DAP / Fondo E AFP</option>
            <option value="5" selected>5% — Fondo mutuo conservador</option>
            <option value="7">7% — Fondo mixto / APV</option>
            <option value="10">10% — Renta variable (estimado histórico)</option
            >
          </select>
          <p class="mt-1 text-xs text-muted">
            Para comparar: ¿qué pasaría si en vez de prepagar, invirtieras ese
            dinero?
          </p>
        </div>

        <button
          id="calcBtn"
          class="mt-2 w-full rounded-lg bg-accent px-4 py-3 text-base font-bold text-background transition-opacity hover:opacity-90"
        >
          Calcular ahorro →
        </button>
        <div
          id="prepago-error"
          class="mt-3 hidden rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-sm text-red-200"
        >
        </div>
      </div>

      <!-- RESULTADO -->
      <div class="rounded-xl border border-border bg-background p-6">
        <h2 class="mb-5 text-lg font-semibold">¿Conviene prepagar?</h2>
        <div
          id="resultado-contenido"
          data-uf={String(economicParameters.uf)}
          class="py-8 text-center text-muted"
          aria-live="polite"
        >
          <p class="mb-3 text-4xl">💡</p>
          <p class="text-sm">
            Ingresa los datos del crédito y el monto a prepagar.
          </p>
        </div>
      </div>
    </section>

    <section
      class="prose prose-sm max-w-none border-t border-border pt-8 pb-12 dark:prose-invert"
    >
      <h2>¿Cuándo conviene prepagar y cuándo no?</h2>
      <p>
        La regla básica: <strong
          >si la tasa de tu crédito es mayor a la rentabilidad que puedes
          obtener invirtiendo, conviene prepagar</strong
        >. Si es al revés, puede ser mejor invertir.
      </p>
      <ul>
        <li>
          <strong>Crédito de consumo (tasa alta ~3% mensual):</strong> Casi siempre
          conviene prepagar. Ninguna inversión segura renta más que el 36–50% anual
          que cobran estas deudas.
        </li>
        <li>
          <strong>Crédito hipotecario (tasa baja ~0.5% mensual):</strong> La decisión
          es más pareja. Una inversión en fondos mutuos o ETF puede superar fácilmente
          ese costo anual de ~6%.
        </li>
        <li>
          <strong>Factor emocional:</strong> Quedar sin deudas tiene un valor que
          los números no capturan. Si la deuda te genera estrés, eso también importa.
        </li>
        <li>
          <strong>Comisión de prepago:</strong> Algunos créditos cobran hasta 1 mes
          de interés por prepago anticipado. Verifica en tu contrato antes de decidir.
        </li>
      </ul>
      <p class="text-sm text-muted">
        Simulación educativa con supuestos simplificados. Las condiciones reales
        de tu crédito pueden variar. Consulta tu contrato antes de hacer un
        prepago.
      </p>
    </section>

    <PrimaryCTA
      text="¿Cuándo conviene hacer un prepago de crédito? →"
      href="/posts/prepago-credito-cuando-conviene-chile/"
      context="Entiende cuándo un abono extraordinario ahorra intereses y cuándo no."
    />
    <ShareCalculatorResult />
    <MethodologyBlock
      notes="El ahorro por prepago se calcula como la diferencia de intereses totales entre el plan original y el plan modificado tras el abono. La Ley 18.010 (art. 10) reconoce el derecho a prepago sin multa en créditos de consumo; para créditos hipotecarios pueden aplicar condiciones distintas según contrato."
      sources={[
        {
          name: "CMF Chile — Ley 18.010 art. 10 (prepago sin multa)",
          url: "https://www.cmfchile.cl/portal/principal/613/w3-channel.html",
          date: "2026-01",
        },
        {
          name: "BCCh — Ley 18.010 texto vigente",
          url: "https://www.bcn.cl/leychile/navegar?idNorma=29438",
          date: "2026-01",
        },
      ]}
    />
    <NextSteps
      currentHref="/calculadoras/prepago-credito/"
      items={calculatorNextStepItems}
      title="Qué hacer con este resultado"
      description="Sigue con una herramienta relacionada o vuelve al índice si necesitas resolver otra pregunta."
      location="calculator_next_steps"
    />
  </main>
  <Footer />
</Layout>

<script>
  import { simulateCreditPrepayment } from "@/application/use-cases/SimulateCreditPrepayment";
  import { trackAnalyticsEvent } from "@/utils/analytics";

  declare global {
    interface Window {
      showShareResult?: (text: string) => void;
    }
  }

  function fmt(n: number) {
    return "$" + Math.round(n).toLocaleString("es-CL");
  }

  function fmtM(n: number) {
    if (n >= 1_000_000) return "$" + (n / 1_000_000).toFixed(2) + " M";
    return fmt(n);
  }

  function getUFValue(): number {
    const container = document.getElementById(
      "resultado-contenido"
    ) as HTMLElement | null;
    return parseFloat(container?.dataset.uf ?? "0") || 0;
  }

  function isUFMode(): boolean {
    return (
      (
        document.querySelector(
          "input[name='moneda']:checked"
        ) as HTMLInputElement | null
      )?.value === "UF"
    );
  }

  function fmtR(n: number): string {
    if (isUFMode()) {
      const uf = getUFValue();
      if (uf > 0) {
        const ufVal = n / uf;
        return (
          "UF\u00a0" +
          ufVal.toLocaleString("es-CL", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
          })
        );
      }
    }
    return fmt(n);
  }

  function fmtMR(n: number): string {
    if (isUFMode()) return fmtR(n);
    return fmtM(n);
  }

  function buildRow(
    label: string,
    value: string,
    colorClass = ""
  ): HTMLDivElement {
    const line = document.createElement("div");
    line.className =
      "flex items-center justify-between border-b border-border py-2 text-sm last:border-0";

    const labelElement = document.createElement("span");
    labelElement.className = "text-secondary";
    labelElement.textContent = label;

    const valueElement = document.createElement("span");
    valueElement.className = `font-mono font-semibold ${colorClass}`.trim();
    valueElement.textContent = value;

    line.append(labelElement, valueElement);
    return line;
  }

  function showInlineError(message: string): void {
    const errorBox = document.getElementById("prepago-error");
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.remove("hidden");
  }

  function clearInlineError(): void {
    const errorBox = document.getElementById("prepago-error");
    if (!errorBox) return;
    errorBox.textContent = "";
    errorBox.classList.add("hidden");
  }

  document.getElementById("calcBtn")?.addEventListener("click", () => {
    clearInlineError();
    const isUF = isUFMode();
    const ufValue = getUFValue();
    let saldo =
      parseFloat(
        (document.getElementById("saldo") as HTMLInputElement).value
      ) || 0;
    let cuota =
      parseFloat(
        (document.getElementById("cuota") as HTMLInputElement).value
      ) || 0;
    const tasa =
      parseFloat(
        (document.getElementById("tasa-credito") as HTMLInputElement).value
      ) / 100;
    const mesesRestantes =
      parseInt(
        (document.getElementById("meses-restantes") as HTMLInputElement).value
      ) || 0;
    let montoPrepago =
      parseFloat(
        (document.getElementById("monto-prepago") as HTMLInputElement).value
      ) || 0;
    let costoPrepago =
      parseFloat(
        (document.getElementById("costo-prepago") as HTMLInputElement).value
      ) || 0;
    const inputMontoPrepago = montoPrepago;
    if (isUF && ufValue > 0) {
      saldo *= ufValue;
      cuota *= ufValue;
      montoPrepago *= ufValue;
      costoPrepago *= ufValue;
    }
    const efecto = (
      document.querySelector("input[name='efecto']:checked") as HTMLInputElement
    )?.value;
    const rentAlternativa =
      parseFloat(
        (
          document.getElementById(
            "rentabilidad-alternativa"
          ) as HTMLSelectElement
        ).value
      ) / 100;

    if (saldo <= 0 || cuota <= 0 || montoPrepago <= 0) {
      showInlineError(
        "Ingresa saldo, cuota y monto de prepago antes de calcular."
      );
      return;
    }

    if (mesesRestantes <= 0) {
      showInlineError("Indica cuántos meses restan del crédito.");
      return;
    }

    if (costoPrepago < 0) {
      showInlineError("La comisión o costo de prepago no puede ser negativa.");
      return;
    }

    if (!Number.isFinite(rentAlternativa) || rentAlternativa < 0) {
      showInlineError(
        "Selecciona una rentabilidad alternativa válida para comparar el prepago con una inversión."
      );
      return;
    }

    let simulacion;
    try {
      simulacion = simulateCreditPrepayment({
        currentBalance: saldo,
        monthlyPayment: cuota,
        monthlyRatePercent: tasa * 100,
        remainingMonths: mesesRestantes,
        prepaymentAmount: montoPrepago,
        prepaymentCost: costoPrepago,
        effect: efecto === "reducir-cuota" ? "reducir-cuota" : "reducir-plazo",
        alternativeAnnualReturnPercent: rentAlternativa * 100,
      });
    } catch (error) {
      showInlineError(
        error instanceof Error
          ? error.message
          : "No se pudo simular el prepago."
      );
      return;
    }

    const container = document.getElementById("resultado-contenido")!;

    const verdict = document.createElement("div");
    verdict.className = `mb-5 rounded-lg border p-4 text-center ${
      simulacion.mathematicallyBetterToPrepay
        ? "border-green-500/30 bg-green-500/5"
        : "border-yellow-500/30 bg-yellow-500/5"
    }`;

    const verdictLabel = document.createElement("p");
    verdictLabel.className = `mb-1 text-xs font-bold tracking-widest uppercase ${
      simulacion.mathematicallyBetterToPrepay
        ? "text-green-500"
        : "text-yellow-500"
    }`;
    verdictLabel.textContent = simulacion.mathematicallyBetterToPrepay
      ? "✓ Conviene prepagar"
      : "Puede convenir más invertir";

    const verdictValue = document.createElement("p");
    verdictValue.className = "text-2xl font-bold";
    verdictValue.textContent = fmtMR(simulacion.netSavingsAfterPrepaymentCost);

    const verdictSub = document.createElement("p");
    verdictSub.className = "text-sm text-muted";
    verdictSub.textContent = "beneficio neto después del costo de prepago";
    verdict.append(verdictLabel, verdictValue, verdictSub);

    const withoutLabel = document.createElement("p");
    withoutLabel.className = "mb-2 text-xs font-bold text-muted uppercase";
    withoutLabel.textContent = "Sin prepago";

    const withLabel = document.createElement("p");
    withLabel.className = "mb-2 mt-4 text-xs font-bold text-muted uppercase";
    withLabel.textContent = isUF
      ? `Con prepago de UF\u00a0${inputMontoPrepago.toLocaleString("es-CL", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`
      : `Con prepago de ${fmt(montoPrepago)}`;

    const investmentBox = document.createElement("div");
    investmentBox.className = "mt-5 rounded-lg bg-foreground/5 p-3";
    const investmentLabel = document.createElement("p");
    investmentLabel.className = "mb-2 text-xs font-bold text-muted uppercase";
    investmentLabel.textContent = `Alternativa: invertir ${isUF ? `UF\u00a0${inputMontoPrepago.toLocaleString("es-CL", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}` : fmt(montoPrepago)} al ${rentAlternativa * 100}% anual`;
    investmentBox.append(
      investmentLabel,
      buildRow(
        `Valor futuro (en ${simulacion.withoutPrepayment.months} meses)`,
        fmtMR(simulacion.futureInvestmentValue)
      ),
      buildRow(
        "Ganancia estimada",
        fmtMR(simulacion.investmentGain),
        simulacion.investmentGain > simulacion.interestSavings
          ? "text-green-500"
          : "text-secondary"
      ),
      buildRow(
        "vs ahorro por prepago",
        fmtMR(simulacion.netSavingsAfterPrepaymentCost),
        simulacion.netSavingsAfterPrepaymentCost >= simulacion.investmentGain
          ? "text-green-500"
          : "text-secondary"
      )
    );

    const finalNote = document.createElement("p");
    finalNote.className = "mt-3 text-xs text-muted";
    finalNote.textContent = simulacion.mathematicallyBetterToPrepay
      ? `Con tu tasa de ${simulacion.annualCreditRatePercent.toFixed(1)}% anual, el crédito "renta" más caro que la alternativa de inversión (${(
          rentAlternativa * 100
        ).toFixed(
          0
        )}% anual). Incluso descontando el costo de prepago informado, prepagar sigue siendo la mejor opción matemática.`
      : "La inversión podría generar más que el beneficio neto del prepago. Pero ojo: la rentabilidad de la inversión no está garantizada.";

    const conditionalRow =
      efecto === "reducir-plazo"
        ? buildRow(
            "Meses que se acorta",
            simulacion.monthsSaved > 0
              ? `${simulacion.monthsSaved} meses menos`
              : "Se liquida",
            "text-green-500"
          )
        : buildRow(
            "Nueva cuota mensual",
            simulacion.newMonthlyPaymentIfReducePayment !== null
              ? fmtR(simulacion.newMonthlyPaymentIfReducePayment)
              : "Saldado",
            "text-green-500"
          );

    container.replaceChildren(
      verdict,
      withoutLabel,
      buildRow(
        "Meses restantes",
        simulacion.withoutPrepayment.months.toString()
      ),
      buildRow(
        "Total intereses",
        fmtR(simulacion.withoutPrepayment.totalInterest),
        "text-red-400"
      ),
      withLabel,
      conditionalRow,
      buildRow(
        "Total intereses con prepago",
        fmtR(simulacion.withPrepayment.totalInterest),
        "text-green-500"
      ),
      buildRow(
        "Costo de prepago informado",
        fmtR(simulacion.prepaymentCost),
        simulacion.prepaymentCost > 0 ? "text-yellow-500" : "text-secondary"
      ),
      buildRow(
        "Ahorro bruto en intereses",
        fmtR(simulacion.interestSavings),
        "text-green-500"
      ),
      buildRow(
        "Beneficio neto tras costo",
        fmtR(simulacion.netSavingsAfterPrepaymentCost),
        simulacion.netSavingsAfterPrepaymentCost >= 0
          ? "text-green-500"
          : "text-red-400"
      ),
      investmentBox,
      finalNote
    );

    if (typeof window.showShareResult === "function") {
      window.showShareResult(
        `Prepago crédito: ahorro neto ${fmtMR(simulacion.netSavingsAfterPrepaymentCost)}`
      );
    }
    trackAnalyticsEvent("calculator_complete", {
      calculator_slug: "prepago-credito",
      calculator_name: "Calculadora de Prepago de Credito",
      outcome: "success",
    });
  });

  // Annual-to-monthly rate conversion helper
  const tasaAnualHelper = document.getElementById(
    "tasa-anual-helper"
  ) as HTMLInputElement | null;
  const tasaConversionResultado = document.getElementById(
    "tasa-conversion-resultado"
  );
  const tasaCreditoInput = document.getElementById(
    "tasa-credito"
  ) as HTMLInputElement | null;

  tasaAnualHelper?.addEventListener("input", () => {
    const anual = parseFloat(tasaAnualHelper!.value);
    if (!isNaN(anual) && anual > 0) {
      const mensual = (Math.pow(1 + anual / 100, 1 / 12) - 1) * 100;
      if (tasaCreditoInput) tasaCreditoInput.value = mensual.toFixed(2);
      if (tasaConversionResultado)
        tasaConversionResultado.textContent = `≈ ${mensual.toFixed(2)}% mensual`;
    } else {
      if (tasaConversionResultado) tasaConversionResultado.textContent = "";
    }
  });

  // Currency toggle: update labels and placeholders when switching CLP ↔ UF
  const labelFields: Record<
    string,
    { clp: string; uf: string; phClp: string; phUf: string }
  > = {
    saldo: {
      clp: "Saldo pendiente ($)",
      uf: "Saldo pendiente (UF)",
      phClp: "Ej: 15.000.000",
      phUf: "Ej: 400",
    },
    cuota: {
      clp: "Cuota mensual actual ($)",
      uf: "Cuota mensual actual (UF)",
      phClp: "Ej: 350.000",
      phUf: "Ej: 15",
    },
    "monto-prepago": {
      clp: "Monto del abono extraordinario ($)",
      uf: "Monto del abono extraordinario (UF)",
      phClp: "Ej: 2.000.000",
      phUf: "Ej: 50",
    },
    "costo-prepago": {
      clp: "Comisión o costo de prepago ($)",
      uf: "Comisión o costo de prepago (UF)",
      phClp: "Ej: 120.000",
      phUf: "Ej: 3",
    },
  };

  function updateCurrencyLabels(): void {
    const uf = isUFMode();
    for (const [fieldId, texts] of Object.entries(labelFields)) {
      const label = document.querySelector(`label[for="${fieldId}"]`);
      const input = document.getElementById(fieldId) as HTMLInputElement | null;
      if (label) label.textContent = uf ? texts.uf : texts.clp;
      if (input) input.placeholder = uf ? texts.phUf : texts.phClp;
    }
  }

  document.querySelectorAll("input[name='moneda']").forEach(radio => {
    radio.addEventListener("change", updateCurrencyLabels);
  });
</script>
