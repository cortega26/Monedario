---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import CalculatorJsonLd from "@/components/CalculatorJsonLd.astro";
import Footer from "@/components/Footer.astro";
import MethodologyBlock from "@/components/MethodologyBlock.astro";
import PrimaryCTA from "@/components/PrimaryCTA.astro";
import ShareCalculatorResult from "@/components/ShareCalculatorResult.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CalculatorTrustBadge from "@/components/CalculatorTrustBadge.astro";
import NextSteps from "@/components/NextSteps.astro";
import { CALCULATOR_PORTFOLIO } from "@/config/calculatorPortfolio";
import { getEconomicParameters } from "@/application/use-cases/GetEconomicParameters";
import { getPath } from "@/utils/getPath";
import CalculatorHero from "@/components/calculator/CalculatorHero.astro";
import CalculatorField from "@/components/calculator/CalculatorField.astro";

const { parameters: economicParameters } = await getEconomicParameters();
const economicSourceLabel =
  economicParameters.source === "live"
    ? "dato en línea"
    : economicParameters.source === "snapshot"
      ? "dato de referencia"
      : "fallback de emergencia";
const fmtClp = (n: number) => "$" + Math.round(n).toLocaleString("es-CL");
const exampleRentBase = 400_000;
const exampleIpcPercent = 3.5;
const exampleRentNew = Math.round(
  exampleRentBase * (1 + exampleIpcPercent / 100)
);
const rentGuidePath = getPath("/posts/reajuste-arriendo-uf-ipc-chile/");
const ufHubPath = getPath("/guias/uf-costo-de-vida/");
const currentCalculator = CALCULATOR_PORTFOLIO.find(
  calc => calc.slug === "reajuste-arriendo"
);
const calculatorRelatedItems = (currentCalculator?.related ?? []).map(item => ({
  href: item.href,
  title: item.label,
  description: item.when,
  label: "Relacionado",
}));
const calculatorNextStepItems = [
  ...calculatorRelatedItems,
  ...(calculatorRelatedItems.length < 2
    ? [
        {
          href: "/calculadoras/",
          title: "Ver todas las calculadoras",
          description: "Compara otra herramienta si tu pregunta cambió.",
          label: "Herramientas",
        },
      ]
    : []),
];
---

<Layout
  title="Calculadora de Reajuste de Arriendo | UF, IPC y Pesos"
  description="Calcula el reajuste de arriendo según variación de UF o IPC y estima tu nuevo canon mensual."
>
  <CalculatorJsonLd
    name="Calculadora de Reajuste de Arriendo | UF, IPC y Pesos"
    description="Calcula el reajuste de arriendo según variación de UF o IPC y estima tu nuevo canon mensual."
  />
  <Header />
  <Breadcrumb />
  <CalculatorTrustBadge location="calculator_header" />
  <main
    data-layout="calculator"
    id="main-content"
    class="app-layout"
    data-analytics-page-type="calculator"
    data-analytics-calculator="reajuste-arriendo"
    data-analytics-calculator-name="Calculadora de Reajuste de Arriendo"
  >
    <CalculatorHero
      title="Calculadora de Reajuste de Arriendo"
      description="Calcula cuánto sube tu arriendo según la variación de la UF o el IPC. Útil tanto para arrendatarios como para propietarios."
      descriptionClass="max-w-xl text-secondary"
    >
      <p class="mt-3 max-w-2xl text-sm text-secondary">
        Si antes de calcular necesitas interpretar la cláusula, revisa la guía
        <a href={rentGuidePath} class="underline underline-offset-4">
          Reajuste de arriendo en Chile: UF, IPC y cálculo
        </a>. Si quieres ver además cómo esta herramienta se conecta con UF e
        inflación, parte por la{" "}
        <a href={ufHubPath} class="underline underline-offset-4">
          guía UF, inflación y costo de vida
        </a>.
      </p>
    </CalculatorHero>

    <section class="grid items-start gap-6 py-8 sm:grid-cols-2">
      <!-- FORMULARIO -->
      <div class="rounded-xl border border-border p-6">
        <h2 class="mb-5 text-lg font-semibold">Datos del arriendo</h2>

        <div class="mb-4">
          <label class="mb-2 block text-sm font-medium text-secondary"
            >Tipo de reajuste según contrato</label
          >
          <div class="flex gap-2">
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="tipo"
                value="uf"
                checked
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-2 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                En UF
              </span>
            </label>
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="tipo"
                value="ipc"
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-2 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                Por IPC
              </span>
            </label>
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="tipo"
                value="pesos"
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-2 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                Pesos fijos
              </span>
            </label>
          </div>
        </div>

        <!-- CAMPOS UF -->
        <div id="campos-uf">
          <CalculatorField
            id="arriendo-uf"
            label="Monto del arriendo en UF"
            placeholder="Ej: 15.5"
            min="0"
            step="0.01"
          />
          <CalculatorField
            id="uf-antes"
            label="Valor UF al pagar el último arriendo ($)"
            placeholder="Ej: 38.500"
            min="0"
          />
          <CalculatorField
            id="uf-hoy"
            label="Valor UF hoy ($)"
            min="0"
            value={String(economicParameters.uf)}
            hint="Valor cargado desde parámetros económicos vigentes. Ajusta si es necesario."
          />
        </div>

        <!-- CAMPOS IPC -->
        <div id="campos-ipc" class="hidden">
          <CalculatorField
            id="arriendo-pesos-ipc"
            label="Arriendo actual en pesos ($)"
            placeholder="Ej: 450.000"
            min="0"
          />
          <div class="mb-4">
            <label
              for="ipc-variacion"
              class="mb-1 block text-sm font-medium text-secondary"
            >
              Variación IPC del período (%)
            </label>
            <input
              type="number"
              id="ipc-variacion"
              placeholder="Ej: 4.7"
              step="0.1"
              class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
            />
            <p class="mt-1 text-xs text-muted">
              IPC acumulado del año o del período pactado. Verifica en <a
                href="https://www.ine.gob.cl"
                target="_blank"
                rel="noopener noreferrer"
                class="underline">ine.gob.cl</a
              >.
            </p>
          </div>
        </div>

        <!-- CAMPOS PESOS FIJOS -->
        <div id="campos-pesos" class="hidden">
          <CalculatorField
            id="arriendo-pesos"
            label="Arriendo actual en pesos ($)"
            placeholder="Ej: 450.000"
            min="0"
          />
          <div
            class="mb-4 rounded-lg border border-yellow-500/20 bg-yellow-500/10 p-3 text-sm text-secondary"
          >
            Un contrato en pesos fijos <strong
              >no se reajusta automáticamente</strong
            >. El propietario solo puede subir el arriendo al renovar o
            renegociar el contrato. Si el contrato dice "reajuste por IPC" o
            "por UF", usa las otras opciones.
          </div>
        </div>

        <button
          id="calcBtn"
          class="mt-2 w-full rounded-lg bg-accent px-4 py-3 text-base font-bold text-background transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Calcular reajuste →
        </button>
        <div
          id="reajuste-error"
          class="mt-3 hidden rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-sm text-red-500"
        >
        </div>
      </div>

      <!-- RESULTADO -->
      <div class="rounded-xl border border-border bg-background p-6">
        <h2 class="mb-5 text-lg font-semibold">Resultado</h2>
        <div id="resultado-contenido" data-is-example="true" aria-live="polite">
          <div
            class="mb-5 rounded-lg border border-border bg-surface-muted/40 p-4 text-center"
          >
            <p
              class="mb-1 text-xs font-bold tracking-widest text-muted uppercase"
            >
              Nuevo arriendo (Ejemplo)
            </p>
            <p class="text-4xl font-bold text-foreground/80">
              {fmtClp(exampleRentNew)}
            </p>
          </div>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-secondary">Arriendo actual</span>
              <span class="font-medium text-foreground/80">
                {fmtClp(exampleRentBase)}
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Alza mensual</span>
              <span class="font-medium text-foreground/80">
                {fmtClp(exampleRentNew - exampleRentBase)}
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Reajuste aplicado</span>
              <span class="font-medium text-foreground/80">3,5%</span>
            </div>
          </div>
          <p class="mt-4 text-xs text-muted">
            Ejemplo: arriendo de $400.000 reajustado por un IPC acumulado de
            3,5%.
          </p>
        </div>
        <div
          id="economic-parameters"
          data-uf={String(economicParameters.uf)}
          class="hidden"
          aria-hidden="true"
        >
        </div>
        <p class="mt-3 text-xs text-muted">
          Fuente económica: {economicSourceLabel} ({
            economicParameters.lastUpdated
          }).
        </p>
      </div>
    </section>

    <section
      class="prose prose-sm max-w-none border-t border-border pt-8 pb-12 dark:prose-invert"
    >
      <h2>¿Cómo se reajusta legalmente un arriendo en Chile?</h2>
      <p>
        En Chile, el reajuste del arriendo depende de lo que diga el contrato.
        La ley no obliga a usar UF ni IPC; simplemente exige respetar lo
        pactado. Los tres casos más comunes son:
      </p>
      <ul>
        <li>
          <strong>Contrato en UF:</strong> El arriendo se convierte a pesos al valor
          de la UF del día de pago. No hay "reajuste" propiamente tal: el monto en
          UF es fijo, pero su equivalencia en pesos sube con la inflación automáticamente
          cada mes.
        </li>
        <li>
          <strong>Contrato con reajuste anual por IPC:</strong> El arriendo en pesos
          sube según la variación del IPC del período y en la oportunidad que indique
          la cláusula. Verifica siempre base, fecha y forma de cálculo.
        </li>
        <li>
          <strong>Contrato en pesos fijos sin cláusula:</strong> El monto no cambia
          hasta que se acuerde una modificación. El propietario no puede subir unilateralmente
          el precio durante la vigencia del contrato.
        </li>
      </ul>
      <p>
        Ante cualquier duda o conflicto, el organismo competente es el <strong
          >Juzgado de Letras con competencia en arrendamiento</strong
        >.
      </p>
    </section>

    <PrimaryCTA
      text="Todo sobre el reajuste de arriendo en Chile →"
      href="/posts/reajuste-arriendo-uf-ipc-chile/"
      context="Interpreta la cláusula de tu contrato y entiende cuándo aplica UF o IPC."
    />
    <ShareCalculatorResult />
    <MethodologyBlock
      notes="El reajuste en UF usa el valor oficial de la UF publicado por el Banco Central de Chile (BCCh). El reajuste en IPC usa la variación anual del Índice de Precios al Consumidor publicado por el INE. La aplicación exacta del reajuste depende de la cláusula contractual pactada."
      sources={[
        {
          name: "INE — Índice de Precios al Consumidor (IPC)",
          url: "https://www.ine.gob.cl",
          date: "2026-03",
        },
        {
          name: "BCCh — Valor oficial de la UF",
          url: "https://www.bcentral.cl",
          date: "2026-03",
        },
      ]}
    />
    <NextSteps
      currentHref="/calculadoras/reajuste-arriendo/"
      items={calculatorNextStepItems}
      title="Qué hacer con este resultado"
      description="Sigue con una herramienta relacionada o vuelve al índice si necesitas resolver otra pregunta."
      location="calculator_next_steps"
    />
  </main>
  <Footer />
</Layout>

<script>
  import {
    calculateIpcRentAdjustment,
    calculateUfRentAdjustment,
  } from "@/application/use-cases/CalculateRentAdjustment";
  import { trackAnalyticsEvent } from "@/utils/analytics";
  import { renderHeadlineDelta } from "@/utils/calculatorDelta";

  declare global {
    interface Window {
      showShareResult?: (text: string) => void;
    }
  }

  function fmt(n: number) {
    return "$" + Math.round(n).toLocaleString("es-CL");
  }

  function buildRow(
    label: string,
    value: string,
    colorClass = ""
  ): HTMLDivElement {
    const line = document.createElement("div");
    line.className =
      "flex items-center justify-between border-b border-border py-2 text-sm last:border-0";

    const labelElement = document.createElement("span");
    labelElement.className = "text-secondary";
    labelElement.textContent = label;

    const valueElement = document.createElement("span");
    valueElement.className = `font-mono font-semibold ${colorClass}`.trim();
    valueElement.textContent = value;

    line.append(labelElement, valueElement);
    return line;
  }

  function showInlineError(message: string): void {
    const errorBox = document.getElementById("reajuste-error");
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.remove("hidden");
  }

  function clearInlineError(): void {
    const errorBox = document.getElementById("reajuste-error");
    if (!errorBox) return;
    errorBox.textContent = "";
    errorBox.classList.add("hidden");
  }

  // Toggle campos
  document.querySelectorAll("input[name='tipo']").forEach(r => {
    r.addEventListener("change", () => {
      const val = (
        document.querySelector("input[name='tipo']:checked") as HTMLInputElement
      )?.value;
      document
        .getElementById("campos-uf")!
        .classList.toggle("hidden", val !== "uf");
      document
        .getElementById("campos-ipc")!
        .classList.toggle("hidden", val !== "ipc");
      document
        .getElementById("campos-pesos")!
        .classList.toggle("hidden", val !== "pesos");
    });
  });

  document.getElementById("calcBtn")?.addEventListener("click", () => {
    clearInlineError();
    const tipo = (
      document.querySelector("input[name='tipo']:checked") as HTMLInputElement
    )?.value;

    if (tipo === "pesos") {
      const arriendo =
        parseFloat(
          (document.getElementById("arriendo-pesos") as HTMLInputElement).value
        ) || 0;
      if (arriendo <= 0) {
        showInlineError(
          "Ingresa el arriendo actual en pesos para mostrar el caso de contrato sin reajuste automático."
        );
        return;
      }
      const box = document.createElement("div");
      box.className =
        "rounded-lg border border-yellow-500/30 bg-yellow-500/10 p-4 text-sm text-secondary";

      const title = document.createElement("p");
      title.className = "mb-2 font-bold text-yellow-500";
      title.textContent = "Sin reajuste automático";

      const paragraph1 = document.createElement("p");
      const strongAmount = document.createElement("strong");
      strongAmount.textContent = fmt(arriendo);
      paragraph1.append(
        "Tu arriendo actual es ",
        strongAmount,
        ". Con un contrato en pesos fijos sin cláusula de reajuste, este monto no cambia hasta que se modifique el contrato de mutuo acuerdo."
      );

      const paragraph2 = document.createElement("p");
      paragraph2.className = "mt-2";
      paragraph2.textContent =
        "Si tu contrato sí tiene cláusula de reajuste por UF o IPC, usa las otras opciones del formulario.";

      box.append(title, paragraph1, paragraph2);
      document.getElementById("resultado-contenido")!.replaceChildren(box);
      if (typeof window.showShareResult === "function") {
        window.showShareResult(
          `Arriendo: ${fmt(arriendo)} fijos sin reajuste automático`
        );
      }
      trackAnalyticsEvent("calculator_complete", {
        calculator_slug: "reajuste-arriendo",
        calculator_name: "Calculadora de Reajuste de Arriendo",
        outcome: "fixed-pesos",
      });
      return;
    }

    if (tipo === "uf") {
      const arriendoUF =
        parseFloat(
          (document.getElementById("arriendo-uf") as HTMLInputElement).value
        ) || 0;
      const ufAntes =
        parseFloat(
          (document.getElementById("uf-antes") as HTMLInputElement).value
        ) || 0;
      const ufHoy =
        parseFloat(
          (document.getElementById("uf-hoy") as HTMLInputElement).value
        ) || 0;

      if (arriendoUF <= 0 || ufAntes <= 0 || ufHoy <= 0) {
        showInlineError("Completa todos los campos de UF antes de calcular.");
        return;
      }

      let reajusteUf;
      try {
        reajusteUf = calculateUfRentAdjustment({
          rentUf: arriendoUF,
          previousUfValue: ufAntes,
          currentUfValue: ufHoy,
        });
      } catch (error) {
        showInlineError(
          error instanceof Error
            ? error.message
            : "No se pudo calcular el reajuste por UF."
        );
        return;
      }

      const header = document.createElement("div");
      header.className =
        "mb-5 rounded-lg border border-accent/20 bg-accent/10 p-4 text-center";
      const headerTitle = document.createElement("p");
      headerTitle.className =
        "mb-1 text-xs font-bold tracking-widest text-accent uppercase";
      headerTitle.textContent = "Arriendo este mes";
      const headerValue = document.createElement("p");
      headerValue.className = "text-4xl font-bold";
      headerValue.textContent = fmt(reajusteUf.currentRentClp);
      const headerSub = document.createElement("p");
      headerSub.className = "mt-1 text-sm text-muted";
      headerSub.textContent = `${arriendoUF.toLocaleString("es-CL", {
        minimumFractionDigits: 2,
      })} UF × ${fmt(ufHoy)}`;
      header.append(headerTitle, headerValue, headerSub);

      const delta = renderHeadlineDelta(
        window.location.pathname + "#uf",
        reajusteUf.currentRentClp,
        fmt
      );
      if (delta) header.append(delta);

      const note = document.createElement("p");
      note.className = "mt-3 text-xs text-muted";
      note.textContent = `El arriendo en UF no "sube" - siempre son ${arriendoUF} UF. Lo que varía es el equivalente en pesos según el valor diario de la UF.`;

      document
        .getElementById("resultado-contenido")!
        .replaceChildren(
          header,
          buildRow("Arriendo mes anterior", fmt(reajusteUf.previousRentClp)),
          buildRow(
            "Diferencia",
            `${reajusteUf.differenceClp >= 0 ? "+ " : ""}${fmt(reajusteUf.differenceClp)}`,
            reajusteUf.differenceClp > 0 ? "text-red-400" : "text-green-500"
          ),
          buildRow(
            "Variación UF del período",
            `${reajusteUf.ufVariationPercent.toFixed(2)}%`
          ),
          note
        );
      if (typeof window.showShareResult === "function") {
        window.showShareResult(
          `Arriendo UF: ${fmt(reajusteUf.currentRentClp)}/mes (${arriendoUF.toFixed(2)} UF)`
        );
      }
      trackAnalyticsEvent("calculator_complete", {
        calculator_slug: "reajuste-arriendo",
        calculator_name: "Calculadora de Reajuste de Arriendo",
        outcome: "uf",
      });
      return;
    }

    if (tipo === "ipc") {
      const arriendoPesos =
        parseFloat(
          (document.getElementById("arriendo-pesos-ipc") as HTMLInputElement)
            .value
        ) || 0;
      const ipcVariacion = parseFloat(
        (document.getElementById("ipc-variacion") as HTMLInputElement).value
      );

      if (arriendoPesos <= 0 || isNaN(ipcVariacion)) {
        showInlineError(
          "Completa el arriendo actual y la variación IPC antes de calcular."
        );
        return;
      }

      let reajusteIpc;
      try {
        reajusteIpc = calculateIpcRentAdjustment({
          currentRentClp: arriendoPesos,
          ipcVariationPercent: ipcVariacion,
        });
      } catch (error) {
        showInlineError(
          error instanceof Error
            ? error.message
            : "No se pudo calcular el reajuste por IPC."
        );
        return;
      }

      const header = document.createElement("div");
      header.className =
        "mb-5 rounded-lg border border-accent/20 bg-accent/10 p-4 text-center";
      const headerTitle = document.createElement("p");
      headerTitle.className =
        "mb-1 text-xs font-bold tracking-widest text-accent uppercase";
      headerTitle.textContent = "Arriendo reajustado";
      const headerValue = document.createElement("p");
      headerValue.className = "text-4xl font-bold";
      headerValue.textContent = fmt(reajusteIpc.adjustedRentClp);
      const headerSub = document.createElement("p");
      headerSub.className = "mt-1 text-sm text-muted";
      headerSub.textContent = `Con IPC ${ipcVariacion > 0 ? "+" : ""}${ipcVariacion}%`;
      header.append(headerTitle, headerValue, headerSub);

      const delta = renderHeadlineDelta(
        window.location.pathname + "#ipc",
        reajusteIpc.adjustedRentClp,
        fmt
      );
      if (delta) header.append(delta);

      const note = document.createElement("p");
      note.className = "mt-3 text-xs text-muted";
      note.textContent =
        "El reajuste por IPC aplica sobre el monto en pesos pactado. Solo puede hacerse en la fecha de renovación anual indicada en el contrato.";

      document
        .getElementById("resultado-contenido")!
        .replaceChildren(
          header,
          buildRow("Arriendo antes del reajuste", fmt(arriendoPesos)),
          buildRow(
            "Aumento mensual",
            `+ ${fmt(reajusteIpc.differenceClp)}`,
            "text-red-400"
          ),
          buildRow(
            "Aumento anual",
            `+ ${fmt(reajusteIpc.differenceClp * 12)}`,
            "text-red-400"
          ),
          buildRow(
            "Factor aplicado",
            `×${reajusteIpc.appliedFactor.toFixed(4)}`
          ),
          note
        );
      if (typeof window.showShareResult === "function") {
        window.showShareResult(
          `Arriendo IPC: nuevo arriendo ${fmt(reajusteIpc.adjustedRentClp)}/mes`
        );
      }
      trackAnalyticsEvent("calculator_complete", {
        calculator_slug: "reajuste-arriendo",
        calculator_name: "Calculadora de Reajuste de Arriendo",
        outcome: "ipc",
      });
    }
  });
</script>
