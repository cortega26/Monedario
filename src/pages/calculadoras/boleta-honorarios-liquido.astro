---
import Layout from "@/layouts/Layout.astro";
import CalculatorHero from "@/components/calculator/CalculatorHero.astro";
import CalculatorField from "@/components/calculator/CalculatorField.astro";
import CalculatorResultPanel from "@/components/calculator/CalculatorResultPanel.astro";
import Header from "@/components/Header.astro";
import CalculatorJsonLd from "@/components/CalculatorJsonLd.astro";
import Footer from "@/components/Footer.astro";
import MethodologyBlock from "@/components/MethodologyBlock.astro";
import PrimaryCTA from "@/components/PrimaryCTA.astro";
import ShareCalculatorResult from "@/components/ShareCalculatorResult.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CalculatorTrustBadge from "@/components/CalculatorTrustBadge.astro";
import NextSteps from "@/components/NextSteps.astro";
import { CALCULATOR_PORTFOLIO } from "@/config/calculatorPortfolio";
import { getPath } from "@/utils/getPath";
import { calculateHonorariosNet } from "@/application/use-cases/CalculateHonorariosNet";
import { honorariosWorkedExample } from "@/application/use-cases/CalculateHonorariosNet.methodology";

const fmtClp = (n: number) => "$" + Math.round(n).toLocaleString("es-CL");
const exampleResult = calculateHonorariosNet({
  grossFee: 500_000,
  withholdingRatePercent: 15.25,
});
const guidePath = getPath("/posts/boleta-honorarios-2026-retencion-cobertura/");
const rentaGuidePath = getPath("/posts/operacion-renta-f22-checklist/");
const currentCalculator = CALCULATOR_PORTFOLIO.find(
  calc => calc.slug === "boleta-honorarios-liquido"
);
const calculatorRelatedItems = (currentCalculator?.related ?? []).map(item => ({
  href: item.href,
  title: item.label,
  description: item.when,
  label: "Relacionado",
}));
const calculatorNextStepItems = [
  ...calculatorRelatedItems,
  ...(calculatorRelatedItems.length < 2
    ? [
        {
          href: "/calculadoras/",
          title: "Ver todas las calculadoras",
          description: "Compara otra herramienta si tu pregunta cambió.",
          label: "Herramientas",
        },
      ]
    : []),
];
---

<Layout
  title="Calculadora Boleta de Honorarios 2026 | Líquido y retención"
  description="Calcula cuánto te llega líquido por boleta, cuánto retiene el SII y cuál sería tu base anual de cobertura previsional orientativa."
>
  <CalculatorJsonLd
    name="Calculadora Boleta de Honorarios 2026 | Líquido y retención"
    description="Calcula cuánto te llega líquido por boleta, cuánto retiene el SII y cuál sería tu base anual de cobertura previsional orientativa."
    dateModified="2026-06-01"
  />
  <Header />
  <Breadcrumb />
  <CalculatorTrustBadge location="calculator_header" />
  <main
    data-layout="calculator"
    id="main-content"
    class="app-layout"
    data-analytics-page-type="calculator"
    data-analytics-calculator="boleta-honorarios-liquido"
    data-analytics-calculator-name="Calculadora Boleta Honorarios Liquido"
  >
    <CalculatorHero
      title="Calculadora de Boleta de Honorarios 2026"
      description="Separa tres cosas que suelen mezclarse: cuánto te retienen al emitir la boleta, cuánto recibes líquido hoy y qué base anual usaría tu cobertura previsional orientativa."
      descriptionClass="max-w-2xl text-secondary"
    />

    <section
      class="grid items-start gap-6 py-8 lg:grid-cols-[minmax(0,420px)_minmax(0,1fr)]"
    >
      <div class="rounded-xl border border-border p-6">
        <h2 class="mb-5 text-lg font-semibold">Tus supuestos</h2>

        <CalculatorField
          id="gross-fee"
          label="Monto bruto de una boleta ($)"
          min="0"
          placeholder="Ej: 500.000"
        />

        <CalculatorField
          id="issued-months"
          label="Meses con boletas este año"
          min="1"
          max="12"
          value="12"
          hint="Si no boleteas todos los meses, ajusta este número para una proyección anual más útil."
        />

        <CalculatorField
          id="annual-gross"
          label="Total bruto anual boleteado ($) - opcional"
          min="0"
          placeholder="Si ya sabes tu total anual, úsalo aquí"
          hint="Reemplaza la proyección automática `boleta × meses`."
        />

        <CalculatorField
          id="withholding-rate"
          label="Retención aplicada (%)"
          min="0"
          max="100"
          step="0.01"
          value="15.25"
          hint="En 2026 la referencia vigente es 15,25%. Solo cámbiala si estás revisando otro año."
        />

        <button
          id="calcBtn"
          class="mt-2 w-full rounded-lg bg-accent px-4 py-3 text-base font-bold text-background transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Calcular líquido →
        </button>

        <div
          id="honorarios-error"
          class="mt-3 hidden rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-sm text-red-500"
          role="alert"
        >
        </div>
      </div>

      <CalculatorResultPanel title="Resultado orientativo">
        <div id="resultado-contenido" data-is-example="true" aria-live="polite">
          <div
            class="mb-5 rounded-lg border border-border bg-surface-muted/40 p-4 text-center"
          >
            <p
              class="mb-1 text-xs font-bold tracking-widest text-muted uppercase"
            >
              Recibes líquido (Ejemplo)
            </p>
            <p class="text-4xl font-bold text-foreground/80">
              {fmtClp(exampleResult.netFeeReceived)}
            </p>
          </div>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-secondary">Boleta bruta</span>
              <span class="font-medium text-foreground/80">$500.000</span>
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Retención (15,25%)</span>
              <span class="font-medium text-foreground/80">
                − {fmtClp(exampleResult.withholdingAmount)}
              </span>
            </div>
          </div>
          <p class="mt-4 text-xs text-muted">
            Ejemplo: boleta de $500.000 con retención de 15,25%. Retención
            verificada: marzo 2026 (SII).
          </p>
        </div>
      </CalculatorResultPanel>
    </section>

    <section
      class="prose prose-sm max-w-none border-t border-border pt-8 pb-12 dark:prose-invert"
    >
      <h2>Qué sí responde esta calculadora</h2>
      <ul>
        <li>Cuánto te retienen al emitir una boleta.</li>
        <li>Cuánto recibes líquido hoy por ese documento.</li>
        <li>
          Cuál sería tu base anual de cobertura estimada si proyectas el total
          boleteado.
        </li>
        <li>
          Qué parte depende de Operación Renta y no se define al emitir cada
          boleta.
        </li>
      </ul>

      <h2>Qué no resuelve por sí sola</h2>
      <ul>
        <li>
          Si quedas eximido por no superar el umbral anual de 5 ingresos mínimos
          mensuales.
        </li>
        <li>
          Si tu situación previsional o de salud tiene una causal especial de
          exención.
        </li>
        <li>
          Si terminarás con devolución o diferencia a pagar en Operación Renta.
        </li>
      </ul>

      <p class="text-sm text-muted">
        Estimador educativo. La regularización final depende de SII, TGR y tu
        situación previsional real.
      </p>
      <p>
        Si quieres el paso a paso completo, revisa la <a
          href={guidePath}
          data-analytics-cta="calculator-guide"
          data-analytics-label="Guia de boletas honorarios 2026"
          data-analytics-location="calculator_explainer"
          >guía de boletas de honorarios 2026</a
        >. Si tu foco es la declaración anual completa, parte por el <a
          href={rentaGuidePath}
          data-analytics-cta="calculator-guide"
          data-analytics-label="Checklist operacion renta"
          data-analytics-location="calculator_explainer_secondary"
          >checklist de Operación Renta</a
        >.
      </p>
    </section>

    <PrimaryCTA
      text="Guía completa de boleta de honorarios 2026 →"
      href="/posts/boleta-honorarios-2026-retencion-cobertura/"
      context="Entiende la retención, la cobertura previsional y la declaración anual."
    />
    <ShareCalculatorResult />
    <MethodologyBlock
      example={honorariosWorkedExample.example}
      notes="La retención del 15,25% sobre el bruto es la tasa transitoria vigente para el año tributario 2026 (cambia gradualmente hasta llegar al 17%). El líquido a recibir = bruto − retención. Para emisión oficial usa el Portal del SII con tu RUT y Clave Tributaria."
      sources={[
        {
          name: "SII — Tasas de retención boleta de honorarios (transitoria 15,25%)",
          url: "https://www.sii.cl",
          date: "2026-03",
        },
        {
          name: "SII — Art. 74 nº2 Ley de la Renta (texto vigente)",
          url: "https://www.bcn.cl/leychile/navegar?idNorma=6368",
          date: "2026-01",
        },
      ]}
    />
    <NextSteps
      currentHref="/calculadoras/boleta-honorarios-liquido/"
      items={calculatorNextStepItems}
      title="Qué hacer con este resultado"
      description="Sigue con una herramienta relacionada o vuelve al índice si necesitas resolver otra pregunta."
      location="calculator_next_steps"
    />
  </main>
  <Footer />
</Layout>

<script>
  import { calculateHonorariosNet } from "@/application/use-cases/CalculateHonorariosNet";
  import { trackAnalyticsEvent } from "@/utils/analytics";
  import { renderHeadlineDelta } from "@/utils/calculatorDelta";

  declare global {
    interface Window {
      showShareResult?: (text: string) => void;
    }
  }

  const currencyFormatter = new Intl.NumberFormat("es-CL", {
    style: "currency",
    currency: "CLP",
    maximumFractionDigits: 0,
  });

  function fmtCurrency(value: number): string {
    return currencyFormatter.format(Math.round(value));
  }

  function buildRow(
    label: string,
    value: string,
    colorClass = ""
  ): HTMLDivElement {
    const line = document.createElement("div");
    line.className =
      "flex items-center justify-between border-b border-border py-2 text-sm last:border-0";

    const labelElement = document.createElement("span");
    labelElement.className = "text-secondary";
    labelElement.textContent = label;

    const valueElement = document.createElement("span");
    valueElement.className = `font-mono font-semibold ${colorClass}`.trim();
    valueElement.textContent = value;

    line.append(labelElement, valueElement);
    return line;
  }

  function showInlineError(message: string) {
    const errorBox = document.getElementById("honorarios-error");
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.remove("hidden");
  }

  function clearInlineError() {
    const errorBox = document.getElementById("honorarios-error");
    if (!errorBox) return;
    errorBox.textContent = "";
    errorBox.classList.add("hidden");
  }

  document.getElementById("calcBtn")?.addEventListener("click", () => {
    clearInlineError();

    const grossFee =
      parseFloat(
        (document.getElementById("gross-fee") as HTMLInputElement).value
      ) || 0;
    const issuedMonths =
      parseInt(
        (document.getElementById("issued-months") as HTMLInputElement).value
      ) || 0;
    const annualGrossRaw = parseFloat(
      (document.getElementById("annual-gross") as HTMLInputElement).value
    );
    const withholdingRate =
      parseFloat(
        (document.getElementById("withholding-rate") as HTMLInputElement).value
      ) || 0;

    if (grossFee <= 0) {
      showInlineError("Ingresa un monto bruto válido antes de calcular.");
      return;
    }

    let result;
    try {
      result = calculateHonorariosNet({
        grossFee,
        issuedMonthsPerYear: issuedMonths,
        annualGrossFees:
          Number.isFinite(annualGrossRaw) && annualGrossRaw > 0
            ? annualGrossRaw
            : undefined,
        withholdingRatePercent: withholdingRate,
      });
    } catch (error) {
      showInlineError(
        error instanceof Error
          ? error.message
          : "No se pudo calcular el líquido de honorarios."
      );
      return;
    }

    const headline = document.createElement("div");
    headline.className =
      "mb-5 rounded-lg border border-accent/20 bg-accent/10 p-4 text-center";

    const headlineLabel = document.createElement("p");
    headlineLabel.className =
      "mb-1 text-xs font-bold tracking-widest text-accent uppercase";
    headlineLabel.textContent = "Líquido por boleta";

    const headlineValue = document.createElement("p");
    headlineValue.className = "text-4xl font-bold";
    headlineValue.textContent = fmtCurrency(result.netFeeReceived);

    headline.append(headlineLabel, headlineValue);

    const delta = renderHeadlineDelta(
      window.location.pathname,
      result.netFeeReceived,
      fmtCurrency
    );
    if (delta) headline.append(delta);

    const assumptions = document.createElement("ul");
    assumptions.className = "mt-4 space-y-2 text-xs leading-relaxed text-muted";
    result.assumptions.forEach(item => {
      const line = document.createElement("li");
      line.textContent = `• ${item}`;
      assumptions.appendChild(line);
    });

    document
      .getElementById("resultado-contenido")
      ?.replaceChildren(
        headline,
        buildRow(
          "Bruto de la boleta",
          fmtCurrency(result.grossFee),
          "text-green-500"
        ),
        buildRow(
          `Retención (${result.withholdingRatePercent.toFixed(2)}%)`,
          `− ${fmtCurrency(result.withholdingAmount)}`,
          "text-red-400"
        ),
        buildRow(
          "Líquido recibido hoy",
          fmtCurrency(result.netFeeReceived),
          "text-accent"
        ),
        buildRow(
          "Bruto anual usado",
          fmtCurrency(result.annualGrossFees),
          "text-secondary"
        ),
        buildRow(
          "Retención anual estimada",
          fmtCurrency(result.annualWithholdingAmount),
          "text-secondary"
        ),
        buildRow(
          "Base anual de cobertura (80%)",
          fmtCurrency(result.annualCoverageBase),
          "text-secondary"
        ),
        buildRow(
          "Equivalente mensual orientativo",
          fmtCurrency(result.monthlyCoverageBaseEquivalent),
          "text-secondary"
        ),
        buildRow(
          "Ventana de cobertura estimada",
          `${result.annualCoverageWindow.startsOn} → ${result.annualCoverageWindow.endsOn}`,
          "text-secondary"
        ),
        assumptions
      );

    document.dispatchEvent(
      new CustomEvent("calculator:result", {
        detail: {
          summaryText: `Boleta honorarios: líquido ${fmtCurrency(result.netFeeReceived)} (bruto ${fmtCurrency(result.grossFee)})`,
        },
      })
    );
    trackAnalyticsEvent("calculator_complete", {
      calculator_slug: "boleta-honorarios-liquido",
      calculator_name: "Calculadora Boleta Honorarios Liquido",
      outcome: "success",
    });
  });
</script>
