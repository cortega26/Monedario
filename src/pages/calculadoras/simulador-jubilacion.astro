---
import Layout from "@/layouts/Layout.astro";
import CalculatorHero from "@/components/calculator/CalculatorHero.astro";
import CalculatorField from "@/components/calculator/CalculatorField.astro";
import CalculatorResultPanel from "@/components/calculator/CalculatorResultPanel.astro";
import Header from "@/components/Header.astro";
import CalculatorJsonLd from "@/components/CalculatorJsonLd.astro";
import Footer from "@/components/Footer.astro";
import MethodologyBlock from "@/components/MethodologyBlock.astro";
import { retirementWorkedExample } from "@/application/use-cases/SimulateRetirementProjection.methodology";
import PrimaryCTA from "@/components/PrimaryCTA.astro";
import ShareCalculatorResult from "@/components/ShareCalculatorResult.astro";
import CalculatorScenarios from "@/components/calculator/CalculatorScenarios.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CalculatorTrustBadge from "@/components/CalculatorTrustBadge.astro";
import NextSteps from "@/components/NextSteps.astro";
import { CALCULATOR_PORTFOLIO } from "@/config/calculatorPortfolio";
import { getEconomicParameters } from "@/application/use-cases/GetEconomicParameters";
import { simulateRetirementProjection } from "@/application/use-cases/SimulateRetirementProjection";
import CalculatorDataFreshness from "@/components/calculator/CalculatorDataFreshness.astro";
import { formatEconomicDate } from "@/domain/economic/economicSourcePresentation";
import { formatCLP } from "@/utils/formatCLP";

const { parameters: economicParameters } = await getEconomicParameters();
const fmtClp = formatCLP;
const exampleResult = simulateRetirementProjection({
  currentAge: 40,
  retirementAge: 65,
  grossSalary: 1_000_000,
  currentBalance: 20_000_000,
  annualReturnPercent: 5,
  lifeExpectancyAge: 85,
  economicParameters,
});
const currentCalculator = CALCULATOR_PORTFOLIO.find(
  calc => calc.slug === "simulador-jubilacion"
);
const calculatorRelatedItems = (currentCalculator?.related ?? []).map(item => ({
  href: item.href,
  title: item.label,
  description: item.when,
  label: "Relacionado",
}));
const calculatorNextStepItems = [
  ...calculatorRelatedItems,
  ...(calculatorRelatedItems.length < 2
    ? [
        {
          href: "/calculadoras/",
          title: "Ver todas las calculadoras",
          description: "Compara otra herramienta si tu pregunta cambió.",
          label: "Herramientas",
        },
      ]
    : []),
];
---

<Layout
  title="Simulador de Jubilación Chile | Proyección AFP"
  description="Proyecta tu ahorro previsional y una pensión estimada según sueldo, edad y rentabilidad esperada."
>
  <CalculatorJsonLd
    name="Simulador de Jubilación Chile | Proyección AFP"
    description="Proyecta tu ahorro previsional y una pensión estimada según sueldo, edad y rentabilidad esperada."
  />
  <Header />
  <Breadcrumb />
  <CalculatorTrustBadge location="calculator_header" />
  <main
    data-layout="calculator"
    id="main-content"
    class="app-layout"
    data-analytics-page-type="calculator"
    data-analytics-calculator="simulador-jubilacion"
    data-analytics-calculator-name="Simulador de Jubilacion"
  >
    <CalculatorHero
      title="Simulador de Jubilación"
      description="Proyecta tu saldo AFP con escenarios comparativos, tope imponible y lagunas previsionales visibles, sin mezclar beneficios que no van directo a tu cuenta individual."
      descriptionClass="max-w-xl text-secondary"
    />

    <section class="grid items-start gap-6 py-8 sm:grid-cols-2">
      <!-- FORMULARIO -->
      <div
        id="calculator-form-card"
        class="rounded-xl border border-border p-6"
      >
        <h2 class="mb-5 text-lg font-semibold">Tus datos</h2>

        <CalculatorField
          id="edad"
          label="Edad actual (años)"
          placeholder="Ej: 35"
          min="18"
          max="64"
          value="35"
        />

        <CalculatorField
          id="edad-jubilacion"
          label="Edad de jubilación (años)"
          placeholder="Ej: 65"
          min="60"
          max="75"
          value="65"
          hint="Edad legal: 65 hombres, 60 mujeres (puede anticiparse)."
        />

        <CalculatorField
          id="sueldo"
          label="Sueldo bruto mensual actual ($)"
          placeholder="Ej: 1.200.000"
          min="0"
        />

        <CalculatorField
          id="saldo-actual"
          label="Saldo actual en AFP ($) — opcional"
          placeholder="Ej: 8.000.000"
          min="0"
          hint="Consulta tu saldo en el sitio web de tu AFP."
        />

        <CalculatorField
          id="rentabilidad"
          label="Rentabilidad anual esperada (%)"
          hint="Este será tu escenario destacado. Más abajo verás también los otros escenarios comparativos."
        >
          <select
            id="rentabilidad"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          >
            <option value="3">3% — Conservadora (Fondos D/E)</option>
            <option value="5" selected>5% — Moderada (Fondo C)</option>
            <option value="7">7% — Agresiva (Fondos A/B)</option>
          </select>
        </CalculatorField>

        <CalculatorField
          id="lagunas"
          label="Lagunas previsionales esperadas (% del tiempo restante)"
          hint="Las lagunas reducen los meses en que proyectamos cotizaciones."
        >
          <select
            id="lagunas"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          >
            <option value="0">0% — Cotización continua</option>
            <option value="10" selected>10% — Lagunas ocasionales</option>
            <option value="20">20% — Intermitencia relevante</option>
            <option value="30">30% — Alta inestabilidad laboral</option>
            <option value="40">40% — Trayectoria muy irregular</option>
          </select>
        </CalculatorField>

        <CalculatorField
          id="expectativa-vida"
          label="Expectativa de vida estimada (años)"
          placeholder="Ej: 85"
          min="65"
          max="100"
          value="85"
          hint="Se usa para calcular cuántos años durará tu pensión."
        />

        <button
          id="calcBtn"
          class="mt-2 w-full rounded-lg bg-accent px-4 py-3 text-base font-bold text-background transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Simular jubilación →
        </button>
        <div
          id="jubilacion-error"
          class="mt-3 hidden rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-sm text-red-500"
          role="alert"
        >
        </div>
      </div>

      <!-- RESULTADO -->
      <CalculatorResultPanel title="Proyección">
        <div id="resultado-contenido" data-is-example="true" aria-live="polite">
          <div
            class="mb-5 rounded-lg border border-border bg-surface-muted/40 p-4 text-center"
          >
            <p
              class="mb-1 text-xs font-bold tracking-widest text-muted uppercase"
            >
              Pensión mensual estimada (Ejemplo ilustrativo)
            </p>
            <p class="text-4xl font-bold text-foreground/80">
              {fmtClp(exampleResult.selectedScenario.estimatedMonthlyPension)}
            </p>
          </div>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-secondary">Saldo proyectado</span>
              <span class="font-medium text-foreground/80">
                {fmtClp(exampleResult.selectedScenario.projectedBalance)}
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Tasa de reemplazo</span>
              <span class="font-medium text-foreground/80">
                {
                  exampleResult.selectedScenario.salaryReplacementPercent.toFixed(
                    0
                  )
                }%
              </span>
            </div>
          </div>
          <p class="mt-4 text-xs text-muted">
            Ejemplo: 40 años, sueldo $1.000.000, saldo actual $20.000.000,
            jubilación a los 65. Ingresa tus datos para ver tu resultado.
          </p>
        </div>
        <div
          id="economic-parameters"
          data-uf={String(economicParameters.uf)}
          data-pension-monthly-taxable-cap-uf={String(
            economicParameters.previsionalTopes
              ?.pensionAndHealthMonthlyTaxableCapUf ?? 90
          )}
          class="hidden"
          aria-hidden="true"
        >
        </div>
        <CalculatorDataFreshness
          source={economicParameters.source}
          updatedDate={formatEconomicDate(economicParameters.lastUpdated)}
          variant="result"
        />
      </CalculatorResultPanel>
    </section>

    <!-- EXPLICACIÓN -->
    <section
      class="prose prose-sm max-w-none border-t border-border pt-8 pb-12 dark:prose-invert"
    >
      <h2>¿Cómo funciona la simulación?</h2>
      <p>
        La calculadora proyecta el saldo acumulado en tu AFP al momento de
        jubilarte, considerando las cotizaciones mensuales del 10% de tu sueldo
        imponible, el tope imponible vigente y el tramo del aporte del empleador
        que sí entra directo a tu cuenta individual según el calendario oficial.
      </p>
      <ul>
        <li>
          <strong>Cotización base:</strong> 10% de tu sueldo imponible con tope previsional.
        </li>
        <li>
          <strong>Aporte del empleador a tu cuenta individual:</strong> la simulación
          usa un cronograma versionado de la Superintendencia de Pensiones para la
          parte que entra directo a la cuenta AFP.
        </li>
        <li>
          <strong>Lagunas previsionales:</strong> reducen los meses con cotización
          y cambian materialmente el resultado.
        </li>
        <li>
          <strong>Pensión estimada:</strong> Se calcula dividiendo el saldo acumulado
          en los meses de vida restante desde la jubilación, sin considerar rentabilidad
          posterior (estimación conservadora).
        </li>
      </ul>
      <p class="text-sm text-muted">
        ⚠️ Esta es una simulación educativa del saldo AFP individual. No incluye
        PGU, comisiones, SIS, modalidad de pensión ni los componentes de
        seguridad social que no van directo a tu saldo. Para una proyección
        oficial consulta tu AFP o la <a
          href="https://www.spensiones.cl"
          target="_blank"
          rel="noopener noreferrer">Superintendencia de Pensiones</a
        >.
      </p>
      <p>
        Si antes de proyectar quieres aclarar qué parte del nuevo aporte del
        empleador entra realmente a tu cuenta, revisa la <a
          href="/posts/reforma-previsional-2025-que-cambia-y-como-te-afecta/"
          >guía de reforma previsional</a
        >. Si tu duda todavía es elegir entre fondos A-E, parte por <a
          href="/posts/fondos-afp-a-b-c-d-e/">fondos AFP A, B, C, D y E</a
        >.
      </p>
    </section>

    <PrimaryCTA
      text="Complementa tu pensión con APV →"
      href="/calculadoras/apv/"
      context="Calcula cuánto extra puedes ahorrar en APV Régimen A o B y el ahorro tributario real."
    />
    <ShareCalculatorResult />
    <CalculatorScenarios />
    <MethodologyBlock
      example={retirementWorkedExample.example}
      notes="La proyección de pensiones se realiza con interés compuesto, cotización obligatoria del 10% del sueldo imponible y tope imponible vigente. Las tasas de rentabilidad son escenarios ilustrativos. Para una proyección oficial, usa el simulador de la Superintendencia de Pensiones en spensiones.cl."
      sources={[
        {
          name: "Superintendencia de Pensiones — Topes y tasas",
          url: "https://www.spensiones.cl",
          date: "2026-03",
        },
        {
          name: "Superpensiónes — Ley 20.255 sistema de pensiones",
          url: "https://www.bcn.cl/leychile/navegar?idNorma=269892",
          date: "2026-01",
        },
      ]}
    />
    <NextSteps
      currentHref="/calculadoras/simulador-jubilacion/"
      items={calculatorNextStepItems}
      title="Qué hacer con este resultado"
      description="Sigue con una herramienta relacionada o vuelve al índice si necesitas resolver otra pregunta."
      location="calculator_next_steps"
    />
  </main>
  <Footer />
</Layout>

<script>
  import { simulateRetirementProjection } from "@/application/use-cases/SimulateRetirementProjection";
  import { trackAnalyticsEvent } from "@/utils/analytics";
  import { renderHeadlineDelta } from "@/utils/calculatorDelta";
  import { formatCLP } from "@/utils/formatCLP";
  import {
    initScenarioPanel,
    snapshotInputs,
  } from "@/utils/calculatorScenariosUI";
  import { createScenarioSaveAdapter } from "@/utils/calculatorScenarioSave";
  import {
    markResultState,
    renderInvalidResultState,
  } from "@/utils/calculatorResultState";

  declare global {
    interface Window {
      showShareResult?: (text: string) => void;
    }
  }

  let scenarioLastResult: ReturnType<
    typeof simulateRetirementProjection
  > | null = null;
  let scenarioLastInputs: Record<string, string> | null = null;

  function fmt(n: number): string {
    return formatCLP(n);
  }

  function fmtM(n: number): string {
    if (n >= 1_000_000) return "$" + (n / 1_000_000).toFixed(1) + " millones";
    return fmt(n);
  }

  function showInlineError(message: string) {
    renderInvalidResultState();
    const errorBox = document.getElementById("jubilacion-error");
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.remove("hidden");
  }

  function clearInlineError() {
    const errorBox = document.getElementById("jubilacion-error");
    if (!errorBox) return;
    errorBox.textContent = "";
    errorBox.classList.add("hidden");
  }

  function readEconomicParameters(): {
    uf: number;
    pensionMonthlyTaxableCapUf: number;
  } {
    const element = document.getElementById("economic-parameters");
    const uf = Number(element?.dataset?.uf);
    const pensionMonthlyTaxableCapUf = Number(
      element?.dataset?.pensionMonthlyTaxableCapUf
    );

    if (
      !Number.isFinite(uf) ||
      uf <= 0 ||
      !Number.isFinite(pensionMonthlyTaxableCapUf) ||
      pensionMonthlyTaxableCapUf <= 0
    ) {
      throw new Error("No se pudieron cargar los parámetros previsionales.");
    }

    return { uf, pensionMonthlyTaxableCapUf };
  }

  const economicParameters = readEconomicParameters();

  document.getElementById("calcBtn")?.addEventListener("click", () => {
    clearInlineError();
    scenarioLastInputs = null;
    const scenarioForm = document.getElementById("calculator-form-card");
    const scenarioCandidateInputs = scenarioForm
      ? snapshotInputs(scenarioForm)
      : null;
    const edad =
      parseInt((document.getElementById("edad") as HTMLInputElement).value) ||
      35;
    const edadJubilacion =
      parseInt(
        (document.getElementById("edad-jubilacion") as HTMLInputElement).value
      ) || 65;
    const sueldo =
      parseFloat(
        (document.getElementById("sueldo") as HTMLInputElement).value
      ) || 0;
    const saldoInicial =
      parseFloat(
        (document.getElementById("saldo-actual") as HTMLInputElement).value
      ) || 0;
    const rentAnual =
      parseFloat(
        (document.getElementById("rentabilidad") as HTMLSelectElement).value
      ) / 100;
    const lagunasPercent =
      parseFloat(
        (document.getElementById("lagunas") as HTMLSelectElement).value
      ) || 0;
    const expectativaVida =
      parseInt(
        (document.getElementById("expectativa-vida") as HTMLInputElement).value
      ) || 85;

    if (sueldo <= 0) {
      showInlineError("Ingresa tu sueldo bruto mensual antes de simular.");
      return;
    }

    const añosRestantes = Math.max(0, edadJubilacion - edad);
    if (añosRestantes <= 0) {
      showInlineError(
        "La edad de jubilación debe ser mayor que tu edad actual."
      );
      return;
    }

    let proyeccion;
    try {
      proyeccion = simulateRetirementProjection({
        currentAge: edad,
        retirementAge: edadJubilacion,
        grossSalary: sueldo,
        currentBalance: saldoInicial,
        annualReturnPercent: rentAnual * 100,
        lifeExpectancyAge: expectativaVida,
        contributionDensityPercent: 100 - lagunasPercent,
        economicParameters: {
          uf: economicParameters.uf,
          previsionalTopes: {
            pensionAndHealthMonthlyTaxableCapUf:
              economicParameters.pensionMonthlyTaxableCapUf,
          },
        },
      });
    } catch (error) {
      showInlineError(
        error instanceof Error
          ? error.message
          : "No se pudo simular la jubilación."
      );
      return;
    }

    scenarioLastResult = proyeccion;

    const buildRow = (label: string, value: string, colorClass = "") => {
      const line = document.createElement("div");
      line.className =
        "flex items-center justify-between border-b border-border py-2 text-sm last:border-0";

      const labelElement = document.createElement("span");
      labelElement.className = "text-secondary";
      labelElement.textContent = label;

      const valueElement = document.createElement("span");
      valueElement.className = `font-mono font-semibold ${colorClass}`.trim();
      valueElement.textContent = value;

      line.append(labelElement, valueElement);
      return line;
    };

    const buildScenarioCard = (
      label: string,
      annualReturnPercent: number,
      monthlyPension: number,
      projectedBalance: number,
      replacementPercent: number,
      emphasized = false
    ) => {
      const card = document.createElement("div");
      card.className = `rounded-lg border p-3 ${
        emphasized
          ? "border-accent/30 bg-accent/10"
          : "border-border bg-foreground/5"
      }`;

      const title = document.createElement("p");
      title.className =
        "text-xs font-bold tracking-widest text-muted uppercase";
      title.textContent = `${label} · ${annualReturnPercent}% real`;

      const pension = document.createElement("p");
      pension.className = "mt-2 text-lg font-bold";
      pension.textContent = fmt(monthlyPension);

      const subtitle = document.createElement("p");
      subtitle.className = "mt-1 text-xs text-secondary";
      subtitle.textContent = `${replacementPercent.toFixed(0)}% de reemplazo · saldo ${fmtM(projectedBalance)}`;

      card.append(title, pension, subtitle);
      return card;
    };

    const headline = document.createElement("div");
    headline.className =
      "mb-5 rounded-lg border border-accent/20 bg-accent/10 p-4 text-center";
    const headlineLabel = document.createElement("p");
    headlineLabel.className =
      "mb-1 text-xs font-bold tracking-widest text-accent uppercase";
    headlineLabel.textContent = "Saldo estimado al jubilar";
    const headlineValue = document.createElement("p");
    headlineValue.className = "text-4xl font-bold";
    headlineValue.textContent = fmtM(
      proyeccion.selectedScenario.projectedBalance
    );
    const headlineSub = document.createElement("p");
    headlineSub.className = "mt-1 text-sm text-muted";
    headlineSub.textContent = `En ${añosRestantes} años (a los ${edadJubilacion}) · escenario ${proyeccion.selectedScenario.label.toLowerCase()}`;
    headline.append(headlineLabel, headlineValue, headlineSub);

    const delta = renderHeadlineDelta(
      window.location.pathname,
      proyeccion.selectedScenario.projectedBalance,
      fmtM
    );
    if (delta) headline.append(delta);

    const comparisonLabel = document.createElement("p");
    comparisonLabel.className =
      "mb-2 text-xs font-bold tracking-widest text-muted uppercase";
    comparisonLabel.textContent = "Escenarios comparativos";

    const comparisonGrid = document.createElement("div");
    comparisonGrid.className = "grid gap-3 sm:grid-cols-3";
    proyeccion.scenarios.forEach(scenario => {
      comparisonGrid.appendChild(
        buildScenarioCard(
          scenario.label,
          scenario.annualReturnPercent,
          scenario.estimatedMonthlyPension,
          scenario.projectedBalance,
          scenario.salaryReplacementPercent,
          scenario.id === "selected"
        )
      );
    });

    const hint = document.createElement("div");
    hint.className =
      "mt-4 rounded-lg bg-foreground/5 p-3 text-xs text-secondary";
    const hintTitle = document.createElement("strong");
    hintTitle.textContent = "¿Quieres mejorar esta proyección?";
    hint.append(
      hintTitle,
      document.createElement("br"),
      `Agregar APV mensual aumenta significativamente el saldo final. Con $100.000/mes de APV en los meses con cotización, el escenario destacado suma aprox. ${fmtM(proyeccion.selectedScenario.apvExtraProjectionAt100kMonthly)} adicionales al fondo.`
    );

    const scopeBox = document.createElement("div");
    scopeBox.className = "mt-4 rounded-lg bg-foreground/5 p-3 text-xs";
    const scopeTitle = document.createElement("p");
    scopeTitle.className =
      "mb-2 font-bold tracking-widest text-muted uppercase";
    scopeTitle.textContent = "Supuestos clave";
    const scopeList = document.createElement("ul");
    scopeList.className = "space-y-1 text-secondary";
    [
      `Meses con cotización proyectados: ${proyeccion.monthsWithContributions} de ${proyeccion.totalMonths}.`,
      `Sueldo usado para cotizar: ${fmt(proyeccion.taxableSalaryUsedClp)} (tope vigente ${fmt(proyeccion.salaryCapClp)}).`,
      `Cronograma empleador versionado: ${proyeccion.employerContributionScheduleVersion}.`,
      ...proyeccion.excludedBenefits,
    ].forEach(item => {
      const li = document.createElement("li");
      li.textContent = item;
      scopeList.appendChild(li);
    });
    const sourceLine = document.createElement("p");
    sourceLine.className = "mt-2 text-muted";
    const sourceLink = document.createElement("a");
    sourceLink.href = proyeccion.employerContributionScheduleSource.url;
    sourceLink.target = "_blank";
    sourceLink.className = "underline";
    sourceLink.textContent = "fuente oficial";
    sourceLine.append(
      "Cronograma del empleador: ",
      sourceLink,
      ` (${proyeccion.employerContributionScheduleSource.lastVerified}).`
    );
    scopeBox.append(scopeTitle, scopeList, sourceLine);

    const resultContainer = document.getElementById("resultado-contenido");
    resultContainer?.replaceChildren(
      headline,
      comparisonLabel,
      comparisonGrid,
      buildRow(
        "Pensión mensual estimada",
        fmt(proyeccion.selectedScenario.estimatedMonthlyPension),
        "text-accent"
      ),
      buildRow(
        "Como % de tu sueldo actual",
        `${proyeccion.selectedScenario.salaryReplacementPercent.toFixed(0)}%`
      ),
      buildRow(
        "Años de pensión (vida estimada)",
        `${proyeccion.pensionMonths / 12} años`
      ),
      buildRow(
        "Lagunas previsionales asumidas",
        `${lagunasPercent.toFixed(0)}% del tiempo restante`
      ),
      buildRow("Rentabilidad anual usada", `${rentAnual * 100}%`),
      buildRow("Saldo inicial ingresado", fmt(saldoInicial)),
      buildRow(
        "Aporte empleador directo proyectado",
        fmt(
          proyeccion.selectedScenario
            .totalEmployerContributionsToIndividualAccount
        )
      ),
      hint,
      scopeBox
    );
    markResultState(resultContainer, "result");
    scenarioLastInputs = scenarioCandidateInputs;

    document.dispatchEvent(
      new CustomEvent("calculator:result", {
        detail: {
          summaryText: `Jubilación estimada: ${fmt(proyeccion.selectedScenario.estimatedMonthlyPension)}/mes`,
        },
      })
    );
    trackAnalyticsEvent("calculator_complete", {
      calculator_slug: "simulador-jubilacion",
      calculator_name: "Simulador de Jubilacion",
      outcome: "success",
    });
  });

  const scenarioFormCard = document.getElementById("calculator-form-card");
  if (scenarioFormCard) {
    initScenarioPanel({
      ...createScenarioSaveAdapter({
        getLastInputs: () => scenarioLastInputs,
        getLastResult: () => scenarioLastResult,
        formCard: scenarioFormCard,
      }),
      buildSummary: () => {
        if (!scenarioLastInputs || !scenarioLastResult) return null;
        const s = scenarioLastResult.selectedScenario;
        return [
          { label: "Saldo al jubilar", value: fmtM(s.projectedBalance) },
          { label: "Pensión estimada", value: fmt(s.estimatedMonthlyPension) },
          {
            label: "Tasa de reemplazo",
            value: `${s.salaryReplacementPercent.toFixed(0)}%`,
          },
        ];
      },
    });
  }
</script>
