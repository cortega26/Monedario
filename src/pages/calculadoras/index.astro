---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import {
  CALCULATOR_FAMILIES,
  CALCULATOR_FAMILY_ORDER,
  CALCULATOR_PORTFOLIO,
} from "@/config/calculatorPortfolio";
import CalculatorCard from "@/components/CalculatorCard.astro";

const groupedFamilies = CALCULATOR_FAMILY_ORDER.map(familyId => ({
  id: familyId,
  ...CALCULATOR_FAMILIES[familyId],
  calculators: CALCULATOR_PORTFOLIO.filter(calc => calc.family === familyId),
}));

const familyJumpGuides = groupedFamilies.map(family => ({
  ...family,
  href: `#familia-${family.id}`,
}));

const tagStyles: Record<string, string> = {
  "Más usada": "border-accent/30 bg-accent/10 text-accent",
  Contingencia:
    "border-[color:var(--color-accent-2)]/30 bg-[color:var(--color-accent-2)]/10 text-[color:var(--color-accent-2-text)]",
  "Decisión APV":
    "border-[color:var(--color-accent-2)]/30 bg-[color:var(--color-accent-2)]/10 text-[color:var(--color-accent-2-text)]",
  "Largo plazo": "border-accent/30 bg-accent/10 text-accent",
  "Oferta nueva":
    "border-[color:var(--color-highlight)]/30 bg-[color:var(--color-highlight)]/10 text-[color:var(--color-highlight-text)]",
  "Deuda usada":
    "border-[color:var(--color-highlight)]/30 bg-[color:var(--color-highlight)]/10 text-[color:var(--color-highlight-text)]",
  "Abono extra":
    "border-[color:var(--color-highlight)]/30 bg-[color:var(--color-highlight)]/10 text-[color:var(--color-highlight-text)]",
  "Salida formal":
    "border-[color:var(--color-highlight)]/30 bg-[color:var(--color-highlight)]/10 text-[color:var(--color-highlight-text)]",
  Referencia: "border-border bg-background text-secondary",
  Contrato: "border-border bg-background text-secondary",
};
---

<Layout
  title="Calculadoras Financieras en Chile | Monedario"
  description="Explora calculadoras gratuitas agrupadas por ingresos, previsión, deuda y UF para llegar más rápido a la herramienta correcta."
  enableClientRouter={false}
>
  <Header />
  <Breadcrumb />
  <main
    data-layout="calculator"
    id="main-content"
    class="app-layout"
    data-analytics-page-type="calculator-index"
  >
    <section class="border-b border-border pt-8 pb-6">
      <h1 class="my-4 text-3xl font-bold sm:text-4xl">
        Calculadoras financieras para decisiones concretas
      </h1>
      <p class="max-w-3xl text-secondary">
        {CALCULATOR_PORTFOLIO.length} calculadoras organizadas en{" "}
        {groupedFamilies.length} grupos: ingresos, previsión, deuda y UF. Sin
        registro, sin datos personales.
      </p>
    </section>

    <section class="border-b border-border py-6">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <h2 class="text-xl font-semibold">Ir directo a una familia</h2>
          <p class="mt-2 text-sm leading-relaxed text-secondary">
            Este hub ya es un índice de calculadoras. Elige la familia y entra
            directo al bloque que corresponde.
          </p>
        </div>

        <ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
          {familyJumpGuides.map(guide => (
            <li>
              <a
                href={guide.href}
                class="flex h-full min-h-20 flex-col justify-between rounded-lg border border-border bg-background px-4 py-3 transition-colors hover:border-accent/30 hover:bg-accent/5"
              >
                <span class="text-base font-semibold">{guide.title}</span>
                <span class="mt-2 text-sm text-secondary">Ver familia</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <div class="py-4">
      {groupedFamilies.map(family => (
        <section
          id={`familia-${family.id}`}
          class="scroll-mt-24 border-t border-border py-8 first:border-t-0 first:pt-0"
        >
          <div class="grid gap-5 lg:grid-cols-[minmax(0,280px)_minmax(0,1fr)]">
            <div>
              <h2 class="text-2xl font-semibold">{family.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-secondary">
                {family.description}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-secondary">
                {family.chooserPrompt}
              </p>
            </div>

            <ul class="grid gap-4 sm:grid-cols-2">
              {family.calculators.map(calc => (
                <li>
                  <CalculatorCard
                    calc={calc}
                    familyId={family.id}
                    showAlternative={false}
                    tagClass={
                      tagStyles[calc.tag] ??
                      "border-border bg-background text-secondary"
                    }
                  />
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}
    </div>
  </main>
  <Footer />
</Layout>
