---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import CalculatorJsonLd from "@/components/CalculatorJsonLd.astro";
import Footer from "@/components/Footer.astro";
import MethodologyBlock from "@/components/MethodologyBlock.astro";
import ShareCalculatorResult from "@/components/ShareCalculatorResult.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CalculatorTrustBadge from "@/components/CalculatorTrustBadge.astro";
import NextSteps from "@/components/NextSteps.astro";
import { CALCULATOR_PORTFOLIO } from "@/config/calculatorPortfolio";
import { getEconomicParameters } from "@/application/use-cases/GetEconomicParameters";
import { resolveEconomicIndicatorDate } from "@/domain/economic/EconomicParameters";
import {
  formatEconomicDate,
  resolveEconomicSourceLabel,
} from "@/domain/economic/economicSourcePresentation";
import { getPath } from "@/utils/getPath";
import CalculatorHero from "@/components/calculator/CalculatorHero.astro";
import CalculatorDataFreshness from "@/components/calculator/CalculatorDataFreshness.astro";
import CalculatorField from "@/components/calculator/CalculatorField.astro";
import { buildUtmWorkedExample } from "@/application/use-cases/ConvertUtm.methodology";
import { evaluateCriticalMonthlyFreshness } from "@/utils/economicFreshness";
import UtmPostResultActions from "@/components/UtmPostResultActions.astro";
import GlossaryContentWrapper from "@/components/GlossaryContentWrapper.astro";

const { parameters: economicParameters } = await getEconomicParameters();
const utmArticlePath = getPath("/posts/utm-chile-que-es-como-funciona/");
const impuestoSegundaCategoriaPath = getPath(
  "/calculadoras/impuesto-segunda-categoria/"
);
const utmLastUpdated = resolveEconomicIndicatorDate(economicParameters, "utm");
const utmFreshness = evaluateCriticalMonthlyFreshness(utmLastUpdated);
if (utmFreshness.status === "stale") {
  throw new Error(
    `[conversor-utm] UTM crítica vencida: ${utmFreshness.reason}. Actualiza el snapshot desde SII antes de publicar.`
  );
}
const utmWorkedExample = buildUtmWorkedExample(
  economicParameters.utm,
  utmLastUpdated
);
const economicSourceLabel = resolveEconomicSourceLabel(
  economicParameters.source
);
const economicSourceMeta =
  economicParameters.source === "live"
    ? {
        bannerText: "Valor oficial publicado por el SII",
        methodologyNote:
          "El valor se contrasta con la tabla UTM oficial del SII; la consulta en línea usa mindicador.cl solo como transporte de respaldo.",
      }
    : economicParameters.source === "snapshot"
      ? {
          bannerText: "Snapshot verificado contra el SII",
          methodologyNote:
            "El valor UTM mostrado proviene del snapshot económico del sitio y se verifica contra la tabla oficial del SII.",
        }
      : {
          bannerText: "Respaldo interno — publicación bloqueada si vence",
          methodologyNote:
            "El valor UTM mostrado corresponde al valor de respaldo interno del sitio usado cuando la fuente económica no está disponible.",
        };
const utmDisplay = economicParameters.utm.toLocaleString("es-CL", {
  minimumFractionDigits: 0,
  maximumFractionDigits: 0,
});
const utmDateDisplay = formatEconomicDate(utmLastUpdated);

const utmToClp = (utmAmount: number) =>
  "$" + Math.round(utmAmount * economicParameters.utm).toLocaleString("es-CL");
const conversorUtmTitle = `Valor UTM hoy: $${utmDisplay} — Convertir UTM a pesos | Monedario`;
const conversorUtmDescription = `Valor UTM hoy: $${utmDisplay} (${utmDateDisplay}). Convierte 1, 2, 5, 10, 20, 50 o 100 UTM a pesos chilenos al valor oficial del SII, con tabla de referencia.`;
const utmRefs = [
  { label: "1 UTM", utm: 1 },
  { label: "2 UTM (multa de tránsito común)", utm: 2 },
  { label: "5 UTM", utm: 5 },
  { label: "10 UTM", utm: 10 },
  { label: "13,5 UTM (tope exención 2ª categoría)", utm: 13.5 },
  { label: "20 UTM", utm: 20 },
  { label: "30 UTM (tope 2º tramo 4%)", utm: 30 },
  { label: "50 UTM (tope 3er tramo 8%)", utm: 50 },
  { label: "100 UTM", utm: 100 },
];

const utaDisplay = economicParameters.uta
  ? "$" + Math.round(economicParameters.uta).toLocaleString("es-CL")
  : null;
// La UTA es la del cierre del año comercial (diciembre), no la "vigente hoy"
// (auditoría de correctitud F09): el período se declara explícitamente.
const utaPeriodLabel = new Intl.DateTimeFormat("es-CL", {
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(
  new Date(
    `${resolveEconomicIndicatorDate(economicParameters, "uta")}T00:00:00.000Z`
  )
);

const currentCalculator = CALCULATOR_PORTFOLIO.find(
  calc => calc.slug === "conversor-utm"
);
const calculatorRelatedItems = (currentCalculator?.related ?? []).map(item => ({
  href: item.href,
  title: item.label,
  description: item.when,
  label: "Relacionado",
}));
const calculatorNextStepItems = [
  ...calculatorRelatedItems,
  ...(calculatorRelatedItems.length < 2
    ? [
        {
          href: "/calculadoras/",
          title: "Ver todas las calculadoras",
          description: "Compara otra herramienta si tu pregunta cambió.",
          label: "Herramientas",
        },
      ]
    : []),
];

const conversorUtmFaqs = [
  {
    question: "¿Cuánto vale 1 UTM en pesos chilenos hoy?",
    answer: `Hoy 1 UTM equivale a $${utmDisplay} según el valor oficial del SII (${utmDateDisplay}). La UTM se reajusta mensualmente de acuerdo con el IPC y el SII publica su valor para cada mes, así que conviene confirmar el valor vigente antes de usarlo en una multa, un impuesto o un trámite.`,
  },
  {
    question:
      "¿Cómo convierto un monto en UTM (por ejemplo, una multa) a pesos?",
    answer:
      "Ingresa la cantidad de UTM en la calculadora y se multiplica automáticamente por el valor vigente del mes. Por ejemplo, una multa de 10 UTM o un derecho de 5 UTM se convierten al instante a pesos. También puedes hacer la conversión inversa: escribir el monto en pesos y ver a cuántas UTM equivale.",
  },
  {
    question: "¿Por qué el valor de la UTM cambia todos los meses?",
    answer:
      "Porque la UTM es una unidad reajustable: se reajusta mensualmente de acuerdo con la inflación medida por el IPC, y el SII publica su valor para cada mes. Por eso un monto expresado en UTM se ajusta con la inflación en vez de quedar fijo en pesos, aunque su equivalente en pesos cambie con cada reajuste mensual.",
  },
  {
    question: "¿Qué diferencia hay entre UTM, UTA y UF?",
    answer:
      "La UTM (Unidad Tributaria Mensual) se usa para multas e impuestos, y se reajusta cada mes. La UTA (Unidad Tributaria Anual) es la UTM multiplicada por 12 y se usa en el impuesto a la renta anual. La UF (Unidad de Fomento) es otra unidad reajustable distinta, usada en créditos, arriendos y contratos, y cambia a diario.",
  },
  {
    question: "¿Cuánto es 10 UTM en pesos chilenos?",
    answer: `Al ${utmDateDisplay}, 10 UTM equivalen a ${utmToClp(10)} (UTM = $${utmDisplay}). Para cualquier otro monto, multiplica la cantidad de UTM por el valor vigente del mes o usa el conversor de arriba.`,
  },
  {
    question: "¿Cuánto es 100 UTM en pesos chilenos?",
    answer: `Al ${utmDateDisplay}, 100 UTM equivalen a ${utmToClp(100)}. La tabla de referencia de esta página muestra también 1, 2, 5, 20, 30, 50 y 13,5 UTM con el mismo valor oficial del SII.`,
  },
];
---

<Layout title={conversorUtmTitle} description={conversorUtmDescription}>
  <CalculatorJsonLd
    name="Conversor UTM a Pesos Chilenos"
    description={conversorUtmDescription}
    faqs={conversorUtmFaqs}
    dateModified={utmLastUpdated}
  />
  <Header />
  <Breadcrumb />
  <CalculatorTrustBadge location="calculator_header" />
  <main
    data-layout="calculator"
    id="main-content"
    class="app-layout"
    data-analytics-page-type="calculator"
    data-analytics-calculator="conversor-utm"
    data-analytics-calculator-name="Conversor UTM a Pesos"
  >
    <CalculatorHero
      title="Conversor UTM a Pesos Chilenos"
      description="Convierte Unidades Tributarias Mensuales al valor oficial del SII actualizado cada mes. Sin registro, sin publicidad."
      descriptionClass="max-w-xl text-secondary"
    />

    <section class="grid items-start gap-6 py-8 sm:grid-cols-2">
      <!-- CONVERSOR -->
      <div
        id="calculator-form-card"
        class="rounded-xl border border-border p-6"
      >
        <!-- UTM → Pesos -->
        <CalculatorField
          id="utm-input"
          label="Unidades Tributarias Mensuales (UTM)"
          placeholder="Ej: 10"
          min="0"
          step="0.01"
          inputClass="text-lg"
          wrapperClass="mb-6"
        />

        <div class="mb-6 flex items-center gap-3">
          <div class="h-px flex-1 bg-border"></div>
          <button
            id="swap-btn"
            class="rounded-full border border-border px-3 py-1 text-sm text-secondary transition-all hover:border-accent hover:text-accent"
          >
            ⇅ invertir
          </button>
          <div class="h-px flex-1 bg-border"></div>
        </div>

        <CalculatorField
          id="pesos-input"
          label="Pesos chilenos ($)"
          type="text"
          placeholder="Ej: 700000"
          inputClass="text-lg"
          wrapperClass="mb-6"
          hint="Escribe solo números; aplicamos el formato chileno automáticamente."
          inputAttrs={{
            inputmode: "numeric",
            autocomplete: "off",
            spellcheck: "false",
          }}
        />

        <!-- RESULTADO VISUAL -->
        <div
          id="resultado"
          class="hidden rounded-lg bg-foreground/5 p-4 text-center"
          aria-live="polite"
        >
          <h2
            id="resultado-heading"
            tabindex="-1"
            class="text-sm font-semibold tracking-wide text-secondary uppercase"
          >
            Resultado
          </h2>
          <p id="resultado-texto" class="mt-1 text-4xl font-bold"></p>
          <p id="resultado-sub" class="mt-1 text-sm text-muted"></p>
          <p id="resultado-fuente" class="mt-2 text-xs text-muted">
            Fuente: SII · Vigente al {utmDateDisplay} ({economicSourceLabel})
          </p>
        </div>
        <div
          id="economic-parameters"
          data-utm={String(economicParameters.utm)}
          data-last-updated={utmLastUpdated}
          class="hidden"
          aria-hidden="true"
        ></div>
      </div>

      <!-- COLUMNA DERECHA: valor del mes + referencia -->
      <div class="space-y-6">
        <!-- VALOR DEL MES -->
        <div
          id="valor-utm-banner"
          class="flex items-center justify-between gap-4 rounded-xl border border-accent/30 bg-accent/5 p-4"
        >
          <div>
            <p class="mb-0.5 text-xs font-bold tracking-widest text-accent uppercase">
              Valor UTM vigente
            </p>
            <p id="utm-display" class="text-3xl font-bold">
              {"$" + utmDisplay}
            </p>
            <p id="utm-fecha" class="mt-0.5 text-xs text-muted">
              {utmDateDisplay} · {economicSourceMeta.bannerText} (
              {economicSourceLabel})
            </p>
          </div>
          <span class="text-4xl">🇨🇱</span>
        </div>

        <!-- TABLA DE REFERENCIA RÁPIDA -->
        <div class="rounded-xl border border-border p-6">
          <h2 class="mb-2 text-base font-semibold">
            Valor UTM hoy y conversión a pesos
          </h2>
          <p class="mb-3 text-sm text-secondary">
            Al {utmDateDisplay}, 1 UTM = ${utmDisplay}; 10 UTM = {utmToClp(10)};
            100 UTM = {utmToClp(100)}.
          </p>
          <table class="w-full text-sm">
            <caption class="sr-only">
              Conversión de UTM a pesos chilenos al{utmDateDisplay}
            </caption>
            <thead>
              <tr class="border-b border-border">
                <th scope="col" class="py-1.5 text-left font-medium">
                  Monto en UTM
                </th>
                <th scope="col" class="py-1.5 text-right font-medium">
                  Equivalente en CLP
                </th>
              </tr>
            </thead>
            <tbody>
              {utmRefs.map(reference => (
                <tr class="border-b border-border last:border-0">
                  <th
                    scope="row"
                    class="py-1.5 text-left font-normal text-secondary"
                  >
                    {reference.label}
                  </th>
                  <td class="py-1.5 text-right font-mono font-semibold">
                    {utmToClp(reference.utm)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <CalculatorDataFreshness
            source={economicParameters.source}
            updatedDate={utmDateDisplay}
          />
          {utaDisplay ? (
            <p class="mt-1 text-xs text-muted">
              UTA de referencia anual: {utaDisplay} (12 × UTM de{" "}
              {utaPeriodLabel}, cierre del año comercial).
            </p>
          ) : null}
        </div>
      </div>
    </section>

    <section class="prose prose-sm max-w-none border-t border-border pt-8 pb-12 dark:prose-invert">
      <h2>¿Qué es la UTM y para qué sirve?</h2>
      <p>
        La <strong>Unidad Tributaria Mensual (UTM)</strong> es la unidad que usa
        el Estado chileno para fijar multas y tramos de impuestos. Se reajusta
        mensualmente de acuerdo con el IPC y el SII publica su valor para cada
        mes.
      </p>
      <ul>
        <li>
          <strong>Multas de tránsito:</strong> el artículo 201 de la Ley de
          Tránsito N°18.290 fija las multas en escalas de UTM. Para saber qué
          valor de la UTM se aplica a tu pago, consulta al juzgado de policía
          local.
        </li>
        <li>
          <strong>Impuesto a la renta:</strong> el tramo exento del Impuesto de
          Segunda Categoría equivale a 13,5 UTM mensuales. La tabla completa se
          reajusta cada mes con la UTM.
        </li>
      </ul>
      <p class="text-sm text-muted">
        ⚠️ El valor de la UTM cambia cada mes. Este conversor usa la última
        actualización disponible. Para el dato oficial vigente consulta el{" "}
        <a
          href="https://www.sii.cl/valores_y_fechas/utm/utm2026.htm"
          target="_blank"
          rel="noopener noreferrer"
        >
          SII
        </a>
        .
      </p>
      <p>
        Para entender en detalle cómo se reajusta la UTM, en qué se diferencia
        de la UF y cómo afecta tus impuestos, revisa la{" "}
        <a
          href={utmArticlePath}
          data-analytics-cta="calculator-guide"
          data-analytics-label="Guia UTM completa"
          data-analytics-location="calculator_explainer"
        >
          guía completa de la UTM en Chile
        </a>
        .
      </p>
      <p>
        Si necesitas convertir UF (Unidad de Fomento) en lugar de UTM, usa el{" "}
        <a
          href="/calculadoras/conversor-uf/"
          data-analytics-cta="calculator-related"
          data-analytics-label="Conversor UF a pesos"
          data-analytics-location="calculator_explainer"
        >
          conversor UF a pesos chilenos
        </a>
        , actualizado a diario con el valor del Banco Central.
      </p>
      <p>
        Si tu cálculo es el impuesto mensual sobre tu sueldo, usa la{" "}
        <a
          href={impuestoSegundaCategoriaPath}
          data-analytics-cta="calculator-related"
          data-analytics-label="Calculadora impuesto segunda categoria"
          data-analytics-location="calculator_explainer"
        >
          calculadora de Impuesto de Segunda Categoría
        </a>
        , que aplica los tramos progresivos del SII con la UTM vigente.
      </p>
    </section>

    <UtmPostResultActions />
    <ShareCalculatorResult />
    <MethodologyBlock
      example={utmWorkedExample.example}
      notes={`${economicSourceMeta.methodologyNote} La UTM se reajusta mensualmente de acuerdo con el IPC (SII, Diccionario básico tributario contable; SII Educa) y el SII publica su valor para cada mes. La UTA de referencia mostrada usa el valor anual informado por la misma fuente cuando está disponible; si no, se aproxima desde la serie económica cargada por el sitio. Verifica siempre el dato vigente en el SII antes de usarlo en trámites, multas o impuestos.`}
      sources={[
        {
          name: "SII — Valores UTM vigentes",
          url: "https://www.sii.cl/valores_y_fechas/utm/utm2026.htm",
          date: utmLastUpdated,
        },
        {
          name: "SII — Diccionario básico tributario contable (UTM)",
          url: "https://www.sii.cl/ayudas/ayudas_por_servicios/4669-u.html",
          date: "2026-11-10",
        },
        {
          name: "SII Educa — Tipos de impuestos en Chile (reajuste mensual de la UTM)",
          url: "https://www.sii.cl/siieduca/aprende-con-nosotros/tipos-de-impuestos-en-chile.html",
          date: "2026-11-10",
        },
        {
          name: "mindicador.cl — transporte de respaldo del snapshot",
          url: "https://mindicador.cl/api/utm",
          date: utmLastUpdated,
        },
      ]}
    />
    <section class="border-t border-border pt-8 pb-4">
      <h2 class="mb-6 text-xl font-semibold">
        Preguntas frecuentes sobre el conversor UTM
      </h2>
      <dl class="space-y-6">
        {conversorUtmFaqs.map(faq => (
          <div>
            <dt class="mb-1 font-medium text-foreground">{faq.question}</dt>
            <dd class="text-sm leading-relaxed text-secondary">
              <GlossaryContentWrapper>{faq.answer}</GlossaryContentWrapper>
            </dd>
          </div>
        ))}
      </dl>
    </section>
    <NextSteps
      currentHref="/calculadoras/conversor-utm/"
      items={calculatorNextStepItems}
      title="Qué hacer con este resultado"
      description="Sigue con una herramienta relacionada o vuelve al índice si necesitas resolver otra pregunta."
      location="calculator_next_steps"
    />
  </main>
  <Footer />
</Layout>

<script>
  import { convertUtm } from "@/application/use-cases/ConvertUtm";
  import { trackAnalyticsEvent } from "@/utils/analytics";
  import { formatCLP } from "@/utils/formatCLP";

  declare global {
    interface Window {
      showShareResult?: (text: string) => void;
    }
  }

  function readEconomicContext(): { utm: number; lastUpdated: string } {
    const element = document.getElementById("economic-parameters");
    const utm = Number(element?.dataset?.utm);
    const lastUpdated = element?.dataset?.lastUpdated;
    if (!Number.isFinite(utm) || utm <= 0 || !lastUpdated) {
      throw new Error("No se pudo cargar el valor UTM para el conversor.");
    }
    return { utm, lastUpdated };
  }

  const economicContext = readEconomicContext();

  const fmt = formatCLP;
  const fmtUtm = (n: number) =>
    n.toLocaleString("es-CL", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 4,
    }) + " UTM";
  const formatClpInput = (n: number) => Math.round(n).toLocaleString("es-CL");
  const parseClpInput = (raw: string) => {
    const digitsOnly = raw.replace(/\D/g, "");
    return digitsOnly ? Number(digitsOnly) : NaN;
  };

  const utmInput = document.getElementById("utm-input") as HTMLInputElement;
  const pesosInput = document.getElementById("pesos-input") as HTMLInputElement;
  const resultado = document.getElementById("resultado")!;
  const resultadoTexto = document.getElementById("resultado-texto")!;
  const resultadoSub = document.getElementById("resultado-sub")!;
  let hasTrackedCompletion = false;

  function mostrarResultado(principal: string, sub: string) {
    resultado.classList.remove("hidden");
    resultadoTexto.textContent = principal;
    resultadoSub.textContent = sub;
    // A11y F2: no se mueve el foco al resultado en cada tecla (rompería la
    // escritura en este conversor en vivo); la región aria-live anuncia el
    // cambio y #resultado-heading (tabindex=-1) queda disponible para foco
    // programático si un flujo futuro lo requiere.
    document.dispatchEvent(
      new CustomEvent("calculator:result", {
        detail: { summaryText: `Conversor UTM: ${sub}` },
      })
    );
    if (!hasTrackedCompletion) {
      hasTrackedCompletion = true;
      trackAnalyticsEvent("calculator_complete", {
        calculator_slug: "conversor-utm",
        calculator_name: "Conversor UTM a Pesos",
        outcome: "success",
      });
    }
  }

  utmInput.addEventListener("input", () => {
    const utm = parseFloat(utmInput.value);
    if (!isNaN(utm) && utm > 0) {
      const conversion = convertUtm({
        amount: utm,
        utmValue: economicContext.utm,
        direction: "utm_to_clp",
      });
      pesosInput.value = formatClpInput(conversion.clpAmount);
      mostrarResultado(
        fmt(conversion.clpAmount),
        `${fmtUtm(conversion.utmAmount)} = ${fmt(conversion.clpAmount)} al ${economicContext.lastUpdated}`
      );
    } else {
      pesosInput.value = "";
      resultado.classList.add("hidden");
    }
  });

  pesosInput.addEventListener("input", () => {
    const pesos = parseClpInput(pesosInput.value);
    if (!isNaN(pesos) && pesos > 0) {
      pesosInput.value = formatClpInput(pesos);
      const conversion = convertUtm({
        amount: pesos,
        utmValue: economicContext.utm,
        direction: "clp_to_utm",
      });
      utmInput.value = conversion.utmAmount.toFixed(4);
      mostrarResultado(
        fmtUtm(conversion.utmAmount),
        `${fmt(conversion.clpAmount)} = ${fmtUtm(conversion.utmAmount)} al ${economicContext.lastUpdated}`
      );
    } else {
      utmInput.value = "";
      resultado.classList.add("hidden");
    }
  });

  document.getElementById("swap-btn")?.addEventListener("click", () => {
    const utmValue = parseFloat(utmInput.value);
    const pesosValue = parseClpInput(pesosInput.value);

    if (!isNaN(pesosValue) && pesosValue > 0) {
      utmInput.value = (pesosValue / economicContext.utm).toFixed(4);
      utmInput.dispatchEvent(new Event("input"));
      return;
    }

    if (!isNaN(utmValue) && utmValue > 0) {
      pesosInput.value = formatClpInput(utmValue * economicContext.utm);
      pesosInput.dispatchEvent(new Event("input"));
      return;
    }

    resultado.classList.add("hidden");
  });
</script>
