---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import CalculatorJsonLd from "@/components/CalculatorJsonLd.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CalculatorTrustBadge from "@/components/CalculatorTrustBadge.astro";
import NextSteps from "@/components/NextSteps.astro";
import { CALCULATOR_PORTFOLIO } from "@/config/calculatorPortfolio";
import MethodologyBlock from "@/components/MethodologyBlock.astro";
import PrimaryCTA from "@/components/PrimaryCTA.astro";
import ShareCalculatorResult from "@/components/ShareCalculatorResult.astro";
import CalculatorResultNextActions from "@/components/CalculatorResultNextActions.astro";
import NextBestStep from "@/components/NextBestStep.astro";
import SupportCallout from "@/components/SupportCallout.astro";
import { SITE } from "@/config";
import CalculatorHero from "@/components/calculator/CalculatorHero.astro";
import CalculatorField from "@/components/calculator/CalculatorField.astro";
import CalculatorResultPanel from "@/components/calculator/CalculatorResultPanel.astro";
import CalculatorScenarios from "@/components/calculator/CalculatorScenarios.astro";
import CalculatorExplainerSection from "@/components/calculator/CalculatorExplainerSection.astro";

const currentCalculator = CALCULATOR_PORTFOLIO.find(
  calc => calc.slug === "interes-compuesto"
);
const calculatorRelatedItems = (currentCalculator?.related ?? []).map(item => ({
  href: item.href,
  title: item.label,
  description: item.when,
  label: "Relacionado",
}));
const calculatorNextStepItems = [
  ...calculatorRelatedItems,
  ...(calculatorRelatedItems.length < 2
    ? [
        {
          href: "/calculadoras/",
          title: "Ver todas las calculadoras",
          description: "Compara otra herramienta si tu pregunta cambió.",
          label: "Herramientas",
        },
      ]
    : []),
];

const interesCompuestoFaqs = [
  {
    question: "¿Qué es el interés compuesto?",
    answer:
      "El interés compuesto es el interés que se calcula sobre el capital inicial más los intereses ya acumulados en períodos anteriores. A diferencia del interés simple, cada período los intereses ganados se reinvierten y generan nuevos intereses, produciendo un crecimiento exponencial del capital.",
  },
  {
    question: "¿Cómo se calcula el monto final con interés compuesto?",
    answer:
      "La fórmula es: Monto final = Capital × (1 + tasa/n)^(n × años), donde 'tasa' es la tasa anual decimal, 'n' es la frecuencia de capitalización (1=anual, 2=semestral, 4=trimestral, 12=mensual) y 'años' es el período de inversión.",
  },
  {
    question: "¿Qué frecuencia de capitalización conviene elegir?",
    answer:
      "A mayor frecuencia de capitalización, mayor es el monto final. La capitalización mensual produce un resultado ligeramente mayor que la anual, dado que los intereses se reinvierten más seguido. Para tasas anuales similares, la diferencia suele ser pequeña, pero se hace notable en horizontes de 10 años o más.",
  },
  {
    question: "¿Esta calculadora incluye inflación o impuestos?",
    answer:
      "No. La calculadora muestra el crecimiento nominal del capital sin descontar inflación ni impuestos sobre ganancias de capital. Para inversiones en Chile, el impuesto sobre ganancias de capital puede variar según el instrumento y tu situación tributaria.",
  },
];
---

<Layout
  title="Calculadora de Interés Compuesto | Simula tu ahorro e inversión"
  description="Calcula cuánto crece tu dinero con interés compuesto: monto final, interés generado y evolución año a año. Gratis, sin registro."
>
  <CalculatorJsonLd
    name="Calculadora de Interés Compuesto"
    description="Calcula cuánto crece tu dinero con interés compuesto: monto final, interés generado y evolución año a año."
    faqs={interesCompuestoFaqs}
  />
  <Header />
  <Breadcrumb />
  <CalculatorTrustBadge location="calculator_header" />
  <main
    data-layout="calculator"
    id="main-content"
    class="app-layout"
    data-analytics-page-type="calculator"
    data-analytics-calculator="interes-compuesto"
    data-analytics-calculator-name="Calculadora de Interes Compuesto"
    data-site-title={SITE.title}
  >
    <CalculatorHero
      title="Calculadora de Interés Compuesto"
      description="Simula cómo crece un capital inicial en el tiempo con interés compuesto. Ve el monto final, el interés total generado y la evolución año a año."
      descriptionClass="max-w-lg text-sm leading-relaxed text-foreground"
    />

    <section class="grid items-start gap-6 py-8 sm:grid-cols-2">
      <!-- FORMULARIO -->
      <div
        id="calculator-form-card"
        class="rounded-xl border border-border p-6"
      >
        <h2 class="mb-5 text-lg font-semibold">Parámetros de la inversión</h2>

        <CalculatorField
          id="capital-inicial"
          label="Capital inicial ($)"
          placeholder="Ej: 1.000.000"
          min="1"
        />

        <CalculatorField
          id="tasa-anual"
          label="Tasa anual (%)"
          placeholder="Ej: 8"
          min="0.01"
          max="100"
          step="0.01"
          hint="Tasa nominal anual, antes de inflación e impuestos."
        />

        <CalculatorField
          id="periodo-anos"
          label="Período (años)"
          placeholder="Ej: 10"
          min="1"
          max="50"
          step="1"
          value="10"
        />

        <CalculatorField id="frecuencia" label="Frecuencia de capitalización">
          <select
            id="frecuencia"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          >
            <option value="12">Mensual (12 veces/año)</option>
            <option value="4">Trimestral (4 veces/año)</option>
            <option value="2">Semestral (2 veces/año)</option>
            <option value="1">Anual (1 vez/año)</option>
          </select>
        </CalculatorField>

        <div
          id="calc-error"
          class="mb-3 hidden rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-sm text-red-500"
          role="alert"
          aria-live="assertive"
        >
        </div>
        <button
          id="calcBtn"
          class="mt-2 w-full rounded-lg bg-accent px-4 py-3 text-base font-bold text-background transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
        >
          <span id="calcBtn-label">Calcular →</span>
        </button>
      </div>

      <!-- RESULTADO -->
      <CalculatorResultPanel headingId="resultado-heading" title="Resultado">
        <div id="resultado-contenido" data-is-example="true" aria-live="polite">
          <div
            class="mb-5 rounded-lg border border-border bg-surface-muted/40 p-4 text-center"
          >
            <p
              class="mb-1 text-xs font-bold tracking-widest text-muted uppercase"
            >
              Monto final (Ejemplo)
            </p>
            <p class="text-4xl font-bold text-foreground/80">$2.707.041</p>
          </div>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-secondary">Capital inicial</span>
              <span class="font-medium text-foreground/80">$1.000.000</span>
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Interés generado</span>
              <span class="font-medium text-foreground/80">$1.707.041</span>
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Rentabilidad total</span>
              <span class="font-medium text-foreground/80">170,7%</span>
            </div>
          </div>
          <p class="mt-4 text-xs text-muted">
            Ejemplo: $1.000.000 al 10% anual capitalización mensual por 10 años.
          </p>
        </div>
      </CalculatorResultPanel>
    </section>

    <!-- TABLA DE EVOLUCIÓN -->
    <section
      id="tabla-evolucion-section"
      class="hidden border-t border-border pt-6 pb-8"
    >
      <h2 class="mb-4 text-lg font-semibold">Evolución año a año</h2>
      <div class="overflow-x-auto">
        <table id="tabla-evolucion" class="w-full border-collapse text-sm">
          <thead>
            <tr class="border-b border-border text-left">
              <th class="py-2 pr-4 font-medium text-secondary">Año</th>
              <th class="py-2 pr-4 font-medium text-secondary">Capital</th>
              <th class="py-2 pr-4 font-medium text-secondary">Interés año</th>
              <th class="py-2 font-medium text-secondary">Interés acumulado</th>
            </tr>
          </thead>
          <tbody id="tabla-evolucion-body" class="divide-y divide-border">
          </tbody>
        </table>
      </div>
    </section>

    <NextBestStep slug="interes-compuesto" />

    <!-- EXPLICACIÓN -->
    <CalculatorExplainerSection>
      <h2>¿Cómo funciona el interés compuesto?</h2>
      <p>
        El interés compuesto es el mecanismo por el cual los intereses ganados
        se reinvierten automáticamente al capital, generando intereses sobre
        intereses. Esto produce un crecimiento exponencial: cuanto más tiempo
        pasa, mayor es el efecto del reinvertir.
      </p>
      <p>
        La fórmula base es: <strong>Monto = Capital × (1 + r/n)^(n×t)</strong>,
        donde <em>r</em> es la tasa anual, <em>n</em> la frecuencia de capitalización
        y <em>t</em> el período en años.
      </p>
      <p>
        La frecuencia de capitalización importa: capitalizar mensualmente (n=12)
        genera un poco más que hacerlo anualmente (n=1) con la misma tasa
        nominal, porque los intereses se reinvierten más seguido.
      </p>
      <p>
        Para ver el poder del interés compuesto en un caso concreto para Chile,
        revisa el artículo <a
          href="/posts/el-poder-del-interes-compuesto/"
          data-analytics-cta="calculator-guide"
          data-analytics-label="Articulo interes compuesto"
          data-analytics-location="calculator_explainer"
          >El poder del interés compuesto</a
        >.
      </p>
      <p class="text-sm text-muted">
        Esta calculadora muestra crecimiento nominal sin descontar inflación ni
        impuestos. Los resultados son educativos y no constituyen asesoría
        financiera.
      </p>
    </CalculatorExplainerSection>

    <section
      class="max-w-none border-t border-border pt-8 pb-12"
      style="content-visibility: auto; contain-intrinsic-size: 400px;"
    >
      <h2 class="mb-4 text-xl font-semibold">Preguntas frecuentes</h2>
      <div class="space-y-2">
        <details class="group rounded-lg border border-border">
          <summary
            class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium hover:bg-accent/5 [&::-webkit-details-marker]:hidden"
          >
            ¿Qué es el interés compuesto?
            <span
              class="text-xs text-muted transition-transform group-open:rotate-180"
              >▼</span
            >
          </summary>
          <div class="border-t border-border px-4 py-3 text-sm text-secondary">
            El interés compuesto es el interés que se calcula sobre el capital
            inicial más los intereses ya acumulados. Cada período, los intereses
            se reinvierten y generan nuevos intereses, produciendo un
            crecimiento exponencial del capital.
          </div>
        </details>

        <details class="group rounded-lg border border-border">
          <summary
            class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium hover:bg-accent/5 [&::-webkit-details-marker]:hidden"
          >
            ¿Cómo se calcula el monto final?
            <span
              class="text-xs text-muted transition-transform group-open:rotate-180"
              >▼</span
            >
          </summary>
          <div class="border-t border-border px-4 py-3 text-sm text-secondary">
            Monto final = Capital × (1 + tasa/n)^(n × años), donde "tasa" es la
            tasa anual decimal, "n" la frecuencia de capitalización (1=anual,
            2=semestral, 4=trimestral, 12=mensual) y "años" el período.
          </div>
        </details>

        <details class="group rounded-lg border border-border">
          <summary
            class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium hover:bg-accent/5 [&::-webkit-details-marker]:hidden"
          >
            ¿Qué frecuencia de capitalización conviene elegir?
            <span
              class="text-xs text-muted transition-transform group-open:rotate-180"
              >▼</span
            >
          </summary>
          <div class="border-t border-border px-4 py-3 text-sm text-secondary">
            A mayor frecuencia, mayor monto final. La capitalización mensual
            produce un resultado ligeramente mayor que la anual con la misma
            tasa nominal, porque los intereses se reinvierten más seguido. Para
            tasas moderadas y horizontes cortos la diferencia es pequeña; se
            hace notable en horizontes de 10+ años.
          </div>
        </details>

        <details class="group rounded-lg border border-border">
          <summary
            class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium hover:bg-accent/5 [&::-webkit-details-marker]:hidden"
          >
            ¿Esta calculadora incluye inflación o impuestos?
            <span
              class="text-xs text-muted transition-transform group-open:rotate-180"
              >▼</span
            >
          </summary>
          <div class="border-t border-border px-4 py-3 text-sm text-secondary">
            No. La calculadora muestra el crecimiento nominal del capital, sin
            descontar inflación ni impuestos sobre ganancias de capital. Para
            inversiones en Chile, el impuesto sobre ganancias varía según el
            instrumento y tu situación tributaria.
          </div>
        </details>
      </div>
    </section>

    <PrimaryCTA
      text="Lee cómo funciona el interés compuesto en la práctica →"
      href="/posts/el-poder-del-interes-compuesto/"
      context="Ejemplo real: cuánto crece una inversión en el tiempo con distintas tasas."
    />
    <ShareCalculatorResult />
    <CalculatorScenarios />
    <CalculatorResultNextActions
      calculatorSlug="interes-compuesto"
      actions={[
        { label: "Imprimir resultado", href: "#", type: "print" },
        {
          label: "Artículo: interés compuesto",
          href: "/posts/el-poder-del-interes-compuesto/",
          type: "article",
        },
        {
          label: "Simulador de jubilación",
          href: "/calculadoras/simulador-jubilacion/",
          type: "calculator",
        },
      ]}
    />
    <MethodologyBlock
      notes="Esta calculadora aplica la fórmula estándar de interés compuesto: FV = PV × (1 + r/n)^(n×t), donde PV es el capital inicial, r la tasa anual nominal, n la frecuencia de capitalización anual y t el período en años. Los resultados son nominales (sin ajuste por inflación ni impuestos). La tabla de evolución muestra el saldo al cierre de cada año."
      sources={[
        {
          name: "Banco Central de Chile — Conceptos financieros básicos",
          url: "https://www.bcentral.cl/",
          date: "2026-01",
        },
        {
          name: "CMF — Educación financiera: interés compuesto",
          url: "https://www.cmfchile.cl/educa/",
          date: "2026-01",
        },
      ]}
    />
    <NextSteps
      currentHref="/calculadoras/interes-compuesto/"
      items={calculatorNextStepItems}
      title="Qué hacer con este resultado"
      description="Sigue con una herramienta relacionada o vuelve al índice si necesitas resolver otra pregunta."
      location="calculator_next_steps"
    />
    <SupportCallout
      context="calculadora-interes-compuesto"
      pageTitle="la calculadora de interés compuesto"
    />
  </main>
  <Footer />
</Layout>

<script>
  import {
    calculateCompoundInterest,
    type CompoundInterestOutput,
  } from "@/application/use-cases/CalculateCompoundInterest";
  import { trackAnalyticsEvent } from "@/utils/analytics";
  import { saveCalculatorResult } from "@/utils/resumeState";
  import { renderHeadlineDelta } from "@/utils/calculatorDelta";
  import {
    initScenarioPanel,
    restoreInputs,
    snapshotInputs,
  } from "@/utils/calculatorScenariosUI";

  declare global {
    interface Window {
      showShareResult?: (text: string) => void;
      showCalculatorNextActions?: () => void;
    }
  }

  let scenarioLastResult: ReturnType<typeof calculateCompoundInterest> | null = null;

  function fmt(n: number): string {
    return "$" + Math.round(n).toLocaleString("es-CL");
  }

  function fmtPct(n: number): string {
    return n.toFixed(2) + "%";
  }

  function showError(message: string) {
    const el = document.getElementById("calc-error");
    if (!el) return;
    el.textContent = message;
    el.classList.remove("hidden");
  }

  function hideError() {
    const el = document.getElementById("calc-error");
    if (!el) return;
    el.classList.add("hidden");
    el.textContent = "";
  }

  function focusResultado() {
    const heading = document.getElementById("resultado-heading");
    if (heading) {
      heading.focus();
      heading.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
  }

  type CompoundResult = CompoundInterestOutput;

  function renderTabla(evolucion: CompoundResult["yearlyEvolution"]) {
    const tbody = document.getElementById("tabla-evolucion-body");
    const section = document.getElementById("tabla-evolucion-section");
    if (!tbody || !section) return;

    tbody.replaceChildren();
    evolucion.forEach(
      ({ year, balance, yearInterest, accumulatedInterest }) => {
        const tr = document.createElement("tr");
        tr.className = "text-sm";
        const cells = [
          { text: String(year), cls: "py-2 pr-4 text-secondary" },
          { text: fmt(balance), cls: "py-2 pr-4 font-mono font-medium" },
          {
            text: "+" + fmt(yearInterest),
            cls: "py-2 pr-4 font-mono text-accent",
          },
          { text: fmt(accumulatedInterest), cls: "py-2 font-mono text-muted" },
        ];
        for (const { text, cls } of cells) {
          const td = document.createElement("td");
          td.className = cls;
          td.textContent = text;
          tr.appendChild(td);
        }
        tbody.append(tr);
      }
    );

    section.classList.remove("hidden");
  }

  function renderResultado(result: CompoundResult) {
    const frecuenciaLabel: Record<number, string> = {
      1: "anual",
      2: "semestral",
      4: "trimestral",
      12: "mensual",
    };

    const contenido = document.getElementById("resultado-contenido");
    if (!contenido) return;

    const headline = document.createElement("div");
    headline.className =
      "mb-5 rounded-lg border border-accent/20 bg-accent/10 p-4 text-center";
    const headlineLabel = document.createElement("p");
    headlineLabel.className =
      "mb-1 text-xs font-bold tracking-widest text-accent uppercase";
    headlineLabel.textContent = "Monto final";
    const headlineValue = document.createElement("p");
    headlineValue.className = "text-4xl font-bold";
    headlineValue.textContent = fmt(result.finalAmount);
    const headlineSub = document.createElement("p");
    headlineSub.className = "mt-1.5 text-xs text-foreground/60";
    headlineSub.textContent = `${result.years} años · capitalización ${frecuenciaLabel[result.compoundsPerYear] ?? result.compoundsPerYear + "x/año"}`;
    headline.append(headlineLabel, headlineValue, headlineSub);

    const delta = renderHeadlineDelta(
      window.location.pathname,
      result.finalAmount,
      fmt
    );
    if (delta) headline.append(delta);

    const mkRow = (label: string, value: string, colorClass = "") => {
      const row = document.createElement("div");
      row.className =
        "flex items-center justify-between border-b border-border py-2 text-sm last:border-0";
      const lbl = document.createElement("span");
      lbl.className = "text-secondary";
      lbl.textContent = label;
      const val = document.createElement("span");
      val.className = `font-mono font-semibold ${colorClass}`.trim();
      val.textContent = value;
      row.append(lbl, val);
      return row;
    };

    const mkInfoRow = (label: string, value: string) => {
      const row = document.createElement("div");
      row.className =
        "flex items-center justify-between rounded border border-border/50 bg-surface-muted/30 px-3 py-2 text-xs";
      const lbl = document.createElement("span");
      lbl.className = "text-muted";
      lbl.textContent = label;
      const val = document.createElement("span");
      val.className = "font-semibold text-foreground/80";
      val.textContent = value;
      row.append(lbl, val);
      return row;
    };

    const rows = document.createElement("div");
    rows.className = "space-y-0";
    rows.append(
      mkRow("Capital inicial", fmt(result.principal), "text-secondary"),
      mkRow("Tasa anual", fmtPct(result.annualRatePercent), "text-secondary"),
      mkRow(
        "Interés total generado",
        fmt(result.generatedInterest),
        "text-green-500"
      ),
      mkRow(
        "Rentabilidad total",
        fmtPct(result.totalReturnPercent),
        "text-accent"
      )
    );

    const extras = document.createElement("div");
    extras.className = "mt-2 space-y-1";
    extras.append(
      mkInfoRow(
        "Relación final/inicial",
        `×${(result.finalAmount / result.principal).toFixed(2)}`
      ),
      mkInfoRow(
        "Interés promedio anual",
        fmt(result.generatedInterest / result.years)
      )
    );

    contenido.replaceChildren(headline, rows, extras);
  }

  document.getElementById("calcBtn")?.addEventListener("click", () => {
    hideError();
    const capital = parseFloat(
      (document.getElementById("capital-inicial") as HTMLInputElement).value
    );
    const tasaPct = parseFloat(
      (document.getElementById("tasa-anual") as HTMLInputElement).value
    );
    const anos = parseInt(
      (document.getElementById("periodo-anos") as HTMLInputElement).value
    );
    const n = parseInt(
      (document.getElementById("frecuencia") as HTMLSelectElement).value
    );

    if (!Number.isFinite(capital) || capital <= 0) {
      showError("Ingresa un capital inicial válido.");
      return;
    }
    if (!Number.isFinite(tasaPct) || tasaPct <= 0 || tasaPct > 100) {
      showError("Ingresa una tasa anual entre 0.01% y 100%.");
      return;
    }
    if (!Number.isFinite(anos) || anos < 1 || anos > 50) {
      showError("El período debe estar entre 1 y 50 años.");
      return;
    }

    const result = calculateCompoundInterest({
      principal: capital,
      annualRatePercent: tasaPct,
      years: anos,
      compoundsPerYear: n,
    });
    scenarioLastResult = result;
    renderResultado(result);
    renderTabla(result.yearlyEvolution);
    focusResultado();
    saveCalculatorResult(
      window.location.pathname,
      "Calculadora de Interés Compuesto"
    );

    document.dispatchEvent(
      new CustomEvent("calculator:result", {
        detail: {
          summaryText: `Interés compuesto: $${Math.round(capital).toLocaleString("es-CL")} al ${tasaPct}% por ${anos} años → ${fmt(result.finalAmount)}`,
        },
      })
    );
    window.showCalculatorNextActions?.();
    trackAnalyticsEvent("calculator_complete", {
      calculator_slug: "interes-compuesto",
      calculator_name: "Calculadora de Interes Compuesto",
      outcome: "success",
    });
    trackAnalyticsEvent("calculator_completed", {
      calculator_slug: "interes-compuesto",
    });
  });

  document
    .getElementById("capital-inicial")
    ?.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Enter")
        (document.getElementById("calcBtn") as HTMLButtonElement)?.click();
    });

  const scenarioFormCard = document.getElementById("calculator-form-card");
  if (scenarioFormCard) {
    initScenarioPanel({
      calculatorId: window.location.pathname,
      readInputs: () => snapshotInputs(scenarioFormCard),
      applyInputs: inputs => {
        restoreInputs(scenarioFormCard, inputs);
        (
          document.getElementById("calcBtn") as HTMLButtonElement | null
        )?.click();
      },
      buildSummary: () => {
        if (!scenarioLastResult) return null;
        const r = scenarioLastResult;
        return [
          { label: "Monto final", value: fmt(r.finalAmount) },
          { label: "Interés generado", value: fmt(r.generatedInterest) },
          { label: "Rentabilidad", value: `${r.totalReturnPercent.toFixed(2)}%` },
        ];
      },
    });
  }
</script>
