---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import CalculatorJsonLd from "@/components/CalculatorJsonLd.astro";
import Footer from "@/components/Footer.astro";
import MethodologyBlock from "@/components/MethodologyBlock.astro";
import PrimaryCTA from "@/components/PrimaryCTA.astro";
import ShareCalculatorResult from "@/components/ShareCalculatorResult.astro";
import CalculatorScenarios from "@/components/calculator/CalculatorScenarios.astro";
import CalculatorResultNextActions from "@/components/CalculatorResultNextActions.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CalculatorTrustBadge from "@/components/CalculatorTrustBadge.astro";
import NextSteps from "@/components/NextSteps.astro";
import { CALCULATOR_PORTFOLIO } from "@/config/calculatorPortfolio";
import { getPath } from "@/utils/getPath";
import CalculatorHero from "@/components/calculator/CalculatorHero.astro";
import GlossaryContentWrapper from "@/components/GlossaryContentWrapper.astro";
import CalculatorField from "@/components/calculator/CalculatorField.astro";
import CalculatorResultPanel from "@/components/calculator/CalculatorResultPanel.astro";
import { calculateConsumerCredit } from "@/application/use-cases/CalculateConsumerCredit";
import { consumerCreditWorkedExample } from "@/application/use-cases/CalculateConsumerCredit.methodology";
import { formatCLP } from "@/utils/formatCLP";
const fmtClp = formatCLP;
const exampleResult = calculateConsumerCredit({
  principal: 2_000_000,
  termMonths: 24,
  rateValue: 3.49,
  rateType: "mensual",
  monthlyInsurance: 0,
  operatingCosts: 0,
});
const currentCalculator = CALCULATOR_PORTFOLIO.find(
  calc => calc.slug === "credito-consumo"
);
const calculatorRelatedItems = (currentCalculator?.related ?? []).map(item => ({
  href: item.href,
  title: item.label,
  description: item.when,
  label: "Relacionado",
}));
const calculatorNextStepItems = [
  ...calculatorRelatedItems,
  ...(calculatorRelatedItems.length < 2
    ? [
        {
          href: "/calculadoras/",
          title: "Ver todas las calculadoras",
          description: "Compara otra herramienta si tu pregunta cambió.",
          label: "Herramientas",
        },
      ]
    : []),
];

const creditoConsumoFaqs = [
  {
    question:
      "¿Esta calculadora es para el CAE de los créditos o para el Crédito con Aval del Estado?",
    answer:
      'En Chile la sigla "CAE" significa dos cosas distintas. Esta calculadora es para la Carga Anual Equivalente: el indicador porcentual que mide el costo total de un crédito de consumo o hipotecario. No es para el Crédito con Aval del Estado, el préstamo estudiantil universitario que gestiona la Comisión Ingresa.',
  },
  {
    question: "¿Cómo se calcula el CAE de un crédito de consumo?",
    answer:
      "La Carga Anual Equivalente (CAE) expresa el costo total del crédito como porcentaje anual. Esta calculadora estima el CAE sumando la cuota mensual (calculada con amortización francesa), los intereses, los seguros y los gastos operacionales, y convierte ese costo a una tasa anual equivalente. Así puedes comparar ofertas de crédito con distinta tasa, plazo o seguros usando un solo número.",
  },
  {
    question: "¿Qué datos necesito para usar la calculadora de CAE?",
    answer:
      "Necesitas cuatro datos de la oferta de crédito: el monto que te prestan, el plazo en meses, la tasa de interés (mensual o anual) y, si aplica, el costo mensual del seguro y los gastos notariales u operacionales. La tasa y el seguro vienen en la hoja TCEA que el ejecutivo debe entregarte por ley.",
  },
  {
    question: "¿La calculadora de CAE reemplaza la hoja TCEA del banco?",
    answer:
      "No. Esta calculadora te da una estimación del CAE para comparar ofertas antes de firmar, pero el CAE oficial lo calcula la institución financiera según la metodología de la CMF. Para la decisión final, revisa la hoja TCEA de cada oferta real y compara los CAE oficiales.",
  },
  {
    question:
      "¿Por qué el CAE es más alto que la tasa de interés que me ofrecen?",
    answer:
      "Porque la tasa de interés solo refleja el costo de pedir prestado, mientras que el CAE incluye además los seguros, los gastos notariales y el efecto del plazo. Una tasa mensual del 3,49% equivale a una tasa anual cercana al 51,5%, y al sumar seguros y gastos el CAE sube todavía más. Por eso el CAE es el número que realmente importa para comparar.",
  },
];
---

<Layout
  title="Calculadora de CAE y cuota de tu crédito de consumo | Monedario"
  description="Calcula cuota mensual, intereses totales y la Carga Anual Equivalente (CAE) de una oferta de crédito de consumo. No es el Crédito con Aval del Estado."
>
  <CalculatorJsonLd
    name="Calculadora de CAE y Crédito de Consumo"
    description="Calcula cuota mensual, intereses totales y la Carga Anual Equivalente (CAE) de una oferta de crédito de consumo. No es el Crédito con Aval del Estado."
    faqs={creditoConsumoFaqs}
  />
  <Header />
  <Breadcrumb />
  <CalculatorTrustBadge location="calculator_header" />
  <main
    data-layout="calculator"
    id="main-content"
    class="app-layout"
    data-analytics-page-type="calculator"
    data-analytics-calculator="credito-consumo"
    data-analytics-calculator-name="Calculadora de Credito de Consumo"
  >
    <CalculatorHero
      title="Calculadora de Crédito de Consumo"
      description="Calcula la cuota mensual, el costo total, los intereses y el CAE de una oferta de crédito de consumo con tus datos reales."
      descriptionClass="max-w-xl text-secondary"
    />

    <section class="grid items-start gap-6 py-8 sm:grid-cols-2">
      <!-- FORMULARIO -->
      <div
        id="calculator-form-card"
        class="rounded-xl border border-border p-6"
      >
        <h2 class="mb-5 text-lg font-semibold">Datos del crédito</h2>

        <CalculatorField
          id="monto"
          label="Monto del crédito ($)"
          placeholder="Ej: 2.000.000"
          min="0"
        />

        <CalculatorField
          id="plazo"
          label="Plazo (meses)"
          placeholder="Ej: 24"
          min="1"
          max="120"
          value="24"
        />

        <div class="mb-4">
          <fieldset class="border-0 p-0">
            <legend class="mb-1 block text-sm font-medium text-secondary">
              Tipo de tasa
            </legend>
            <div class="mb-2 flex gap-2">
              <label class="flex-1 cursor-pointer">
                <input
                  type="radio"
                  name="tasa-tipo"
                  value="mensual"
                  checked
                  class="peer sr-only"
                />
                <span class="block rounded-lg border border-border px-3 py-2 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent">
                  Mensual
                </span>
              </label>
              <label class="flex-1 cursor-pointer">
                <input
                  type="radio"
                  name="tasa-tipo"
                  value="anual"
                  class="peer sr-only"
                />
                <span class="block rounded-lg border border-border px-3 py-2 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent">
                  Anual
                </span>
              </label>
            </div>
          </fieldset>
          <CalculatorField
            id="tasa"
            label="Tasa de interés (%)"
            placeholder="Ej: 3.49"
            min="0"
            step="0.01"
            value="3.49"
            class="mt-2"
          />
          <p class="mt-1 text-xs text-muted">
            TMC para créditos hasta 200 UF: ~3.49% mensual (~51.5% anual).
            Verifica la tasa exacta de tu oferta.
          </p>
        </div>

        <CalculatorField
          id="seguro"
          label="Seguro mensual ($) — opcional"
          placeholder="Ej: 5.000"
          min="0"
          value="0"
          hint="Algunos créditos incluyen seguro de desgravamen. Si te lo ofrecen, ingresa el monto mensual."
        />

        <CalculatorField
          id="gastos"
          label="Gastos notariales / operacionales ($) — opcional"
          placeholder="Ej: 50.000"
          min="0"
          value="0"
        />

        <button
          id="calcBtn"
          class="mt-2 w-full rounded-lg bg-accent px-4 py-3 text-base font-bold text-background transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Calcular crédito →
        </button>
        <div
          id="calc-error"
          class="mt-3 hidden rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-sm text-danger"
          role="alert"
        ></div>
      </div>

      <!-- RESULTADO -->
      <CalculatorResultPanel title="Desglose del crédito" disclaimer>
        <div id="resultado-contenido" data-is-example="true" aria-live="polite">
          <div class="mb-5 rounded-lg border border-border bg-surface-muted/40 p-4 text-center">
            <p class="mb-1 text-xs font-bold tracking-widest text-muted uppercase">
              Cuota mensual (Ejemplo ilustrativo)
            </p>
            <p class="text-4xl font-bold text-foreground/80">
              {fmtClp(exampleResult.monthlyPaymentTotal)}
            </p>
          </div>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-secondary">CAE</span>
              <span class="font-medium text-foreground/80">
                {exampleResult.caePercent.toFixed(2)}%
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Total intereses</span>
              <span class="font-medium text-foreground/80">
                {fmtClp(exampleResult.totalInterest)}
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Total a pagar</span>
              <span class="font-medium text-foreground/80">
                {fmtClp(exampleResult.totalPaid)}
              </span>
            </div>
          </div>
          <p class="mt-4 text-xs text-muted">
            Ejemplo: crédito de $2.000.000 a 24 meses con tasa 3,49% mensual.
            Ingresa tus datos para ver tu resultado.
          </p>
        </div>
      </CalculatorResultPanel>
    </section>

    <!-- EXPLICACIÓN -->
    <section class="prose prose-sm max-w-none border-t border-border pt-8 pb-12 dark:prose-invert">
      <h2>¿Qué es el CAE y por qué importa?</h2>
      <p>
        El <strong>CAE (Carga Anual Equivalente)</strong> es el indicador que
        permite comparar el costo real de distintos créditos de forma justa.
        Incluye la tasa de interés, los seguros y los gastos operacionales,
        expresados como porcentaje anual del monto solicitado.
      </p>
      <ul>
        <li>
          <strong>No te fijes solo en la cuota:</strong> Una cuota baja puede
          venir con un plazo largo que duplica el costo total.
        </li>
        <li>
          <strong>No te fijes solo en la tasa:</strong> Una tasa baja con
          seguros caros puede resultar en un CAE más alto que un crédito con
          tasa mayor sin seguros.
        </li>
        <li>
          <strong>Compara siempre el CAE:</strong> La ley obliga a todas las
          instituciones financieras en Chile a informarlo. Es el único número
          que permite comparación justa.
        </li>
      </ul>
      <p class="text-sm text-muted">
        ⚠️ El CAE calculado aquí es aproximado. El CAE oficial de un crédito lo
        calcula la institución financiera según metodología CMF. Para comparar
        ofertas reales usa{" "}
        <a
          href="https://www.comparaonline.cl"
          target="_blank"
          rel="noopener noreferrer"
        >
          ComparaOnline
        </a>{" "}
        o solicita la hoja TCEA a tu banco.
      </p>
      <p class="text-sm text-muted">
        Si tu duda no es una oferta nueva sino una deuda ya usada, cambia de
        herramienta: usa la calculadora de{" "}
        <a href={getPath("/calculadoras/tarjeta-credito/")}>
          tarjeta de crédito
        </a>{" "}
        para pagos mínimos, o{" "}
        <a href={getPath("/calculadoras/prepago-credito/")}>
          prepago de crédito
        </a>{" "}
        si estás evaluando abonar anticipadamente.
      </p>
    </section>

    <PrimaryCTA
      text="Entiende el CAE y el costo real de tu crédito →"
      href="/posts/cae-costo-real-credito-chile/"
      context="Antes de firmar, compara tasas usando el CAE como referencia única."
    />
    <ShareCalculatorResult />
    <CalculatorScenarios />
    <CalculatorResultNextActions
      calculatorSlug="credito-consumo"
      actions={[
        { label: "Imprimir resultado", href: "#", type: "print" },
        {
          label: "Tarjeta de crédito",
          href: "/calculadoras/tarjeta-credito/",
          type: "calculator",
        },
        {
          label: "Prepago de crédito",
          href: "/calculadoras/prepago-credito/",
          type: "calculator",
        },
      ]}
    />
    <MethodologyBlock
      example={consumerCreditWorkedExample.example}
      notes="La cuota mensual se calcula con la fórmula de amortización francesa (cuota fija). El CAE se estima integrando gastos asociados. Las tasas de referencia corresponden a la tasa máxima convencional vigente publicada por la CMF para operaciones de crédito de consumo."
      sources={[
        {
          name: "CMF Chile — Tasa máxima convencional",
          url: "https://www.cmfchile.cl/portal/principal/613/w3-channel.html",
          date: "2026-03",
        },
        {
          name: "BCCh — Ley 18.010 art. 6 (tasas y CAE)",
          url: "https://www.bcn.cl/leychile/navegar?idNorma=29438",
          date: "2026-01",
        },
      ]}
    />
    <section class="border-t border-border pt-8 pb-4">
      <h2 class="mb-6 text-xl font-semibold">
        Preguntas frecuentes sobre la calculadora de crédito de consumo
      </h2>
      <dl class="space-y-6">
        {creditoConsumoFaqs.map(faq => (
          <div>
            <dt class="mb-1 font-medium text-foreground">{faq.question}</dt>
            <dd class="text-sm leading-relaxed text-secondary">
              <GlossaryContentWrapper>{faq.answer}</GlossaryContentWrapper>
            </dd>
          </div>
        ))}
      </dl>
    </section>
    <NextSteps
      currentHref="/calculadoras/credito-consumo/"
      items={calculatorNextStepItems}
      title="Qué hacer con este resultado"
      description="Sigue con una herramienta relacionada o vuelve al índice si necesitas resolver otra pregunta."
      location="calculator_next_steps"
    />
  </main>
  <Footer />
</Layout>

<script>
  import { calculateConsumerCredit } from "@/application/use-cases/CalculateConsumerCredit";
  import { trackAnalyticsEvent } from "@/utils/analytics";
  import { renderHeadlineDelta } from "@/utils/calculatorDelta";
  import { formatCLP } from "@/utils/formatCLP";
  import {
    initScenarioPanel,
    snapshotInputs,
  } from "@/utils/calculatorScenariosUI";
  import { createScenarioSaveAdapter } from "@/utils/calculatorScenarioSave";
  import {
    markResultState,
    renderInvalidResultState,
  } from "@/utils/calculatorResultState";

  declare global {
    interface Window {
      showShareResult?: (text: string) => void;
      showCalculatorNextActions?: () => void;
    }
  }

  let scenarioLastResult: ReturnType<typeof calculateConsumerCredit> | null =
    null;
  let scenarioLastInputs: Record<string, string> | null = null;

  function fmt(n: number): string {
    return formatCLP(n);
  }

  function showError(message: string) {
    renderInvalidResultState();
    const el = document.getElementById("calc-error");
    if (!el) return;
    el.textContent = message;
    el.classList.remove("hidden");
  }
  function hideError() {
    const el = document.getElementById("calc-error");
    if (!el) return;
    el.classList.add("hidden");
    el.textContent = "";
  }

  function setLoading(isLoading: boolean) {
    const btn = document.getElementById("calcBtn") as HTMLButtonElement;
    if (!btn) return;
    btn.disabled = isLoading;
    btn.textContent = isLoading ? "Calculando…" : "Calcular crédito →";
  }

  document.getElementById("calcBtn")?.addEventListener("click", () => {
    hideError();
    setLoading(true);
    scenarioLastInputs = null;
    const scenarioForm = document.getElementById("calculator-form-card");
    const scenarioCandidateInputs = scenarioForm
      ? snapshotInputs(scenarioForm)
      : null;
    const monto =
      parseFloat(
        (document.getElementById("monto") as HTMLInputElement).value
      ) || 0;
    const plazo =
      parseInt((document.getElementById("plazo") as HTMLInputElement).value) ||
      0;
    const tasaRaw =
      parseFloat((document.getElementById("tasa") as HTMLInputElement).value) ||
      0;
    const tipoTasa = (
      document.querySelector(
        "input[name='tasa-tipo']:checked"
      ) as HTMLInputElement
    )?.value;
    const seguro =
      parseFloat(
        (document.getElementById("seguro") as HTMLInputElement).value
      ) || 0;
    const gastos =
      parseFloat(
        (document.getElementById("gastos") as HTMLInputElement).value
      ) || 0;

    if (monto <= 0 || plazo <= 0 || tasaRaw <= 0) {
      showError("Por favor ingresa monto, plazo y tasa.");
      setLoading(false);
      return;
    }

    let resultado;
    try {
      resultado = calculateConsumerCredit({
        principal: monto,
        termMonths: plazo,
        rateValue: tasaRaw,
        rateType: tipoTasa === "anual" ? "anual" : "mensual",
        monthlyInsurance: seguro,
        operatingCosts: gastos,
      });
    } catch (error) {
      showError(
        error instanceof Error
          ? error.message
          : "No se pudo calcular el crédito de consumo."
      );
      setLoading(false);
      return;
    }

    setLoading(false);
    scenarioLastResult = resultado;
    const buildRow = (label: string, value: string, colorClass = "") => {
      const line = document.createElement("div");
      line.className =
        "flex items-center justify-between border-b border-border py-2 text-sm last:border-0";

      const labelElement = document.createElement("span");
      labelElement.className = "text-secondary";
      labelElement.textContent = label;

      const valueElement = document.createElement("span");
      valueElement.className = `font-mono font-semibold ${colorClass}`.trim();
      valueElement.textContent = value;

      line.append(labelElement, valueElement);
      return line;
    };

    const headline = document.createElement("div");
    headline.className =
      "mb-5 rounded-lg border border-accent/20 bg-accent/10 p-4 text-center";
    const headlineLabel = document.createElement("p");
    headlineLabel.className =
      "mb-1 text-xs font-bold tracking-widest text-accent uppercase";
    headlineLabel.textContent = "Cuota mensual";
    const headlineValue = document.createElement("p");
    headlineValue.className = "text-4xl font-bold";
    headlineValue.textContent = fmt(resultado.monthlyPaymentTotal);
    headline.append(headlineLabel, headlineValue);
    if (seguro > 0) {
      const insuranceNote = document.createElement("p");
      insuranceNote.className = "mt-1 text-xs text-muted";
      insuranceNote.textContent = `Incluye ${fmt(seguro)} de seguro`;
      headline.appendChild(insuranceNote);
    }

    const delta = renderHeadlineDelta(
      window.location.pathname,
      resultado.monthlyPaymentTotal,
      fmt
    );
    if (delta) headline.append(delta);

    const insight = document.createElement("div");
    insight.className =
      "mt-4 rounded-lg bg-foreground/5 p-3 text-xs text-secondary";
    const highlightedTotal = document.createElement("strong");
    highlightedTotal.textContent = fmt(
      resultado.totalPaid / (monto / 1_000_000)
    );
    insight.append(
      "Por cada $1.000.000 prestado pagas ",
      highlightedTotal,
      " en total - ",
      `${((resultado.totalInterest / monto) * 100).toFixed(0)}% más de lo que te prestaron.`
    );

    const rows = [
      buildRow("Monto solicitado", fmt(monto)),
      buildRow("Plazo", `${plazo} meses`),
      buildRow(
        "Tasa mensual",
        `${(resultado.monthlyRateDecimal * 100).toFixed(4)}%`
      ),
      buildRow(
        "Tasa anual equivalente",
        `${resultado.annualEquivalentRatePercent.toFixed(2)}%`
      ),
      buildRow(
        "CAE (Carga Anual Equiv.)",
        `${resultado.caePercent.toFixed(2)}%`,
        "text-accent"
      ),
      buildRow("Total intereses", fmt(resultado.totalInterest), "text-danger"),
      ...(gastos > 0
        ? [buildRow("Gastos operacionales", fmt(gastos), "text-danger")]
        : []),
      buildRow("Total a pagar", fmt(resultado.totalPaid), "text-danger"),
    ];

    const resultContainer = document.getElementById("resultado-contenido");
    resultContainer?.replaceChildren(headline, ...rows, insight);
    markResultState(resultContainer, "result");
    scenarioLastInputs = scenarioCandidateInputs;

    document.dispatchEvent(
      new CustomEvent("calculator:result", {
        detail: {
          summaryText: `Crédito consumo: cuota ${fmt(resultado.monthlyPaymentTotal)}/mes, total ${fmt(resultado.totalPaid)}`,
        },
      })
    );
    window.showCalculatorNextActions?.();
    trackAnalyticsEvent("calculator_complete", {
      calculator_slug: "credito-consumo",
      calculator_name: "Calculadora de Credito de Consumo",
      outcome: "success",
    });
  });

  // Cambiar label de tasa según tipo
  document.querySelectorAll("input[name='tasa-tipo']").forEach(r => {
    r.addEventListener("change", () => {
      const tipo = (
        document.querySelector(
          "input[name='tasa-tipo']:checked"
        ) as HTMLInputElement
      )?.value;
      const input = document.getElementById("tasa") as HTMLInputElement;
      if (tipo === "mensual") {
        input.value = "3.49";
        input.placeholder = "Ej: 3.49";
      } else {
        input.value = "51.5";
        input.placeholder = "Ej: 51.5";
      }
    });
  });

  const scenarioFormCard = document.getElementById("calculator-form-card");
  if (scenarioFormCard) {
    initScenarioPanel({
      ...createScenarioSaveAdapter({
        getLastInputs: () => scenarioLastInputs,
        getLastResult: () => scenarioLastResult,
        formCard: scenarioFormCard,
      }),
      buildSummary: () => {
        if (!scenarioLastInputs || !scenarioLastResult) return null;
        const r = scenarioLastResult;
        return [
          { label: "Cuota mensual", value: fmt(r.monthlyPaymentTotal) },
          { label: "CAE", value: `${r.caePercent.toFixed(2)}%` },
          { label: "Total intereses", value: fmt(r.totalInterest) },
          { label: "Total a pagar", value: fmt(r.totalPaid) },
        ];
      },
    });
  }
</script>
