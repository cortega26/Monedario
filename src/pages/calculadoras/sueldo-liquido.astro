---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import CalculatorJsonLd from "@/components/CalculatorJsonLd.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CalculatorTrustBadge from "@/components/CalculatorTrustBadge.astro";
import NextSteps from "@/components/NextSteps.astro";
import { CALCULATOR_PORTFOLIO } from "@/config/calculatorPortfolio";
import ContextLinkSection from "@/components/ContextLinkSection.astro";
import MethodologyBlock from "@/components/MethodologyBlock.astro";
import PrimaryCTA from "@/components/PrimaryCTA.astro";
import ShareCalculatorResult from "@/components/ShareCalculatorResult.astro";
import CalculatorScenarios from "@/components/calculator/CalculatorScenarios.astro";
import CalculatorResultNextActions from "@/components/CalculatorResultNextActions.astro";
import NextBestStep from "@/components/NextBestStep.astro";
import SupportCallout from "@/components/SupportCallout.astro";
import { getEconomicParameters } from "@/application/use-cases/GetEconomicParameters";
import { netSalaryWorkedExample } from "@/application/use-cases/CalculateNetSalary.methodology";
import { getPath } from "@/utils/getPath";
import { sueldoCalculatorSections } from "@/config/sueldoClusterLinks";
import { AFP_COMMISSIONS_PERCENT } from "@/config/afpCommissions";
import CalculatorHero from "@/components/calculator/CalculatorHero.astro";
import CalculatorField from "@/components/calculator/CalculatorField.astro";
import CalculatorRadioGroup from "@/components/calculator/CalculatorRadioGroup.astro";
import CalculatorResultPanel from "@/components/calculator/CalculatorResultPanel.astro";
import CalculatorExplainerSection from "@/components/calculator/CalculatorExplainerSection.astro";
import CalculatorDataFreshness from "@/components/calculator/CalculatorDataFreshness.astro";
import { calculateNetSalary } from "@/application/use-cases/CalculateNetSalary";
import { formatEconomicDate } from "@/domain/economic/economicSourcePresentation";
import { DEFAULT_IMM } from "@/domain/economic/immConstants";
import { SITE } from "@/config";

const { parameters: economicParameters } = await getEconomicParameters();
const IMM_MENSUAL_SERVER = economicParameters.imm ?? DEFAULT_IMM;
const GRATI_CAP_SERVER = Math.round((4.75 / 12) * IMM_MENSUAL_SERVER);
const salaryGuidePath = getPath("/posts/como-calcular-sueldo-liquido/");
const firstTaxExemptBracket = 13.5 * economicParameters.utm;
// El IMM es una constante legal gestionada: su fecha de procedencia es la
// vigencia de la ley, nunca la fecha de captura del snapshot económico.
const immEffectiveDateLabel = economicParameters.immEffectiveDate
  ? formatEconomicDate(economicParameters.immEffectiveDate)
  : null;
const firstTaxExemptBracketLabel =
  "$" + Math.round(firstTaxExemptBracket).toLocaleString("es-CL");

// Ejemplo ilustrativo generado con el mismo motor que el cálculo interactivo
// (auditoría de correctitud F08: el ejemplo estático no puede divergir).
const EXAMPLE_GROSS = 1_200_000;
const exampleNet = calculateNetSalary({
  grossSalary: EXAMPLE_GROSS,
  afpRatePercent: 11.27,
  healthSystem: "fonasa",
  contractType: "indefinido",
  economicParameters,
});
const exampleFmt = (value: number) =>
  "$" + Math.round(value).toLocaleString("es-CL");
const examplePct = (value: number) => `${value.toFixed(2)}%`;
const exampleWidth = (value: number) =>
  `${((value / exampleNet.grossSalary) * 100).toFixed(2)}%`;
const exampleSegments = [
  { label: "AFP", value: exampleNet.deductions.afp, tw: "bg-accent" },
  { label: "Salud", value: exampleNet.deductions.health, tw: "bg-accent/60" },
  {
    label: "Imp. 2ª cat.",
    value: exampleNet.deductions.tax,
    tw: "bg-accent/35",
  },
  {
    label: "Seg. cesantía",
    value: exampleNet.deductions.unemploymentInsurance,
    tw: "bg-accent/15",
  },
];
const sueldoLiquidoFaqs = [
  {
    question: "¿Cómo se calcula el sueldo líquido en Chile?",
    answer:
      "Se parte del sueldo bruto y se descuentan las cotizaciones previsionales obligatorias (AFP, salud, seguro de cesantía) y, si corresponde, el impuesto de segunda categoría. La base de cálculo es el sueldo imponible, que puede ser menor al bruto si tu liquidación incluye asignaciones no imponibles como colación o movilización.",
  },
  {
    question: "¿Cuánto descuenta la AFP de mi sueldo?",
    answer:
      "Entre 10,46% y 11,45% del sueldo imponible según tu AFP. Ese porcentaje incluye el 10% de cotización obligatoria —que va a tu cuenta personal y es tuyo— más la comisión de la AFP, que es el costo del servicio.",
  },
  {
    question: "¿Qué es el sueldo imponible?",
    answer:
      "Es la base sobre la que se calculan AFP, salud y seguro de cesantía. Equivale al sueldo bruto menos las asignaciones no imponibles (como colación y movilización dentro de los límites legales). Si tu liquidación no separa esos conceptos, tu imponible suele ser igual a tu bruto.",
  },
  {
    question: "¿Cuánto me descuentan de salud?",
    answer:
      "El 7% del sueldo imponible si estás en Fonasa. Si estás en Isapre y tu plan cuesta más que el 7%, la diferencia adicional también se descuenta directamente de tu sueldo.",
  },
  {
    question: "¿El seguro de cesantía se descuenta en todos los contratos?",
    answer:
      "Solo si tienes contrato indefinido (0,6% a tu cargo). Con contrato a plazo fijo u obra, y también en casa particular, el trabajador no aporta nada — el empleador paga el 3% completo. En todos los casos acumulas saldo en tu Cuenta Individual de Cesantía.",
  },
  {
    question: "¿Desde qué sueldo pago impuesto de segunda categoría?",
    answer: `Solo si tu renta tributable mensual supera el primer tramo exento de la tabla del SII. En 2026 ese umbral es aproximadamente ${firstTaxExemptBracketLabel}. El impuesto es progresivo: solo paga la parte del sueldo que supera cada tramo.`,
  },
  {
    question: "¿Cómo calculo el bruto si sé cuánto quiero recibir?",
    answer:
      'Usa el modo "Líquido → Bruto" de esta calculadora: ingresa el monto que quieres recibir en tu cuenta y el sistema estima el bruto necesario bajo los supuestos de AFP, salud y contrato que indiques. Es útil al negociar sueldo o evaluar una oferta laboral.',
  },
  {
    question: "¿Qué incluye la gratificación en el sueldo?",
    answer:
      "La gratificación legal en Chile puede pagarse mensualizada (25% de lo devengado con tope de 4,75 IMM) o como porcentaje de utilidades. Si la recibes mes a mes como parte de tu liquidación, es imponible: afecta tu AFP, salud, cesantía e impuesto. Ingrésala en el Modo avanzado de esta calculadora para un resultado más preciso.",
  },
  {
    question: "¿Las horas extra se descuentan de AFP y salud?",
    answer:
      "Sí. Las horas extra son remuneración imponible: se suman a la base de cálculo de AFP, salud y seguro de cesantía, y también entran a la base de impuesto de segunda categoría. Puedes incluirlas en el Modo avanzado. Desde abril de 2026 (Ley 40h), las horas extra comienzan en la hora 43 de la semana —no en la 46— y cada una debe pagarse con un recargo mínimo del 50%.",
  },
  {
    question: "¿La Ley 40h cambia mi sueldo líquido?",
    answer:
      "No directamente. La Ley 40h (Ley 21.561) reduce la jornada legal ordinaria de 45 a 42 horas semanales en abril de 2026 (con una bajada final a 40 h en 2028), pero no modifica tu sueldo bruto mensual pactado. Lo que cambia es que si trabajas más de 42 horas a la semana, cada hora adicional es hora extra y debe pagarse con un recargo mínimo del 50%. Lo que sí sube es el valor unitario de cada hora ordinaria, porque el denominador (horas semanales × 4,333) se reduce manteniendo el mismo sueldo.",
  },
  {
    question: "¿Cuánto me corresponde de gratificación legal mensual?",
    answer: `Si tu empleador paga gratificación mensualizada bajo art. 50 CT, el tope legal es el menor valor entre el 25% de tu remuneración mensual y $${GRATI_CAP_SERVER.toLocaleString("es-CL")} (equivalente a 4,75 IMM ÷ 12, con IMM = $${IMM_MENSUAL_SERVER.toLocaleString("es-CL")}). Ejemplo: con bruto de $900.000 el máximo legal es $${GRATI_CAP_SERVER.toLocaleString("es-CL")}; con bruto de $600.000 sería $${Math.round(600_000 * 0.25).toLocaleString("es-CL")}. Esta calculadora muestra el estimado en el resultado cuando calculas en modo Bruto → Líquido.`,
  },
  {
    question: "¿Qué AFP cobra menos comisión en Chile?",
    answer:
      "AFP Uno tiene la comisión más baja (0,46%), con un descuento total del 10,46% del sueldo imponible. AFP ProVida cobra la más alta (1,45%), con un descuento del 11,45%. Para un sueldo imponible de $1.000.000, la diferencia mensual entre ambas es $9.900 ($118.800 al año). Esta calculadora incluye una comparación automática con todas las AFP al calcular en modo Bruto → Líquido.",
  },
];
const currentCalculator = CALCULATOR_PORTFOLIO.find(
  calc => calc.slug === "sueldo-liquido"
);
const calculatorRelatedItems = (currentCalculator?.related ?? []).map(item => ({
  href: item.href,
  title: item.label,
  description: item.when,
  label: "Relacionado",
}));
const calculatorNextStepItems = [
  ...calculatorRelatedItems,
  ...(calculatorRelatedItems.length < 2
    ? [
        {
          href: "/calculadoras/",
          title: "Ver todas las calculadoras",
          description: "Compara otra herramienta si tu pregunta cambió.",
          label: "Herramientas",
        },
      ]
    : []),
];
---

<Layout
  title="Calculadora de Sueldo Líquido y Bruto Chile 2026 | Monedario"
  description="Convierte de sueldo bruto a líquido y de líquido a bruto al instante, con desglose de AFP, salud, cesantía e impuesto. Gratis y actualizado 2026."
>
  <CalculatorJsonLd
    name="Calculadora de Sueldo Líquido y Bruto Chile"
    description="Calcula tu sueldo líquido al instante: descuentos de AFP, salud, cesantía e impuesto. También convierte de líquido a bruto."
    faqs={sueldoLiquidoFaqs}
  />
  <Header />
  <Breadcrumb />
  <CalculatorTrustBadge location="calculator_header" />
  <main
    data-layout="calculator"
    id="main-content"
    class="app-layout"
    data-analytics-page-type="calculator"
    data-analytics-calculator="sueldo-liquido"
    data-analytics-calculator-name="Calculadora de Sueldo Liquido"
    data-site-title={SITE.title}
    data-profile-prefill-host="#calculator-form-card"
  >
    <CalculatorHero
      title="Calculadora de Sueldo Líquido y Bruto"
      description="Calcula cuánto recibirás desde tu bruto, o estima el bruto necesario para recibir el líquido que quieres. Desglose de AFP, salud, cesantía e impuesto de segunda categoría."
      descriptionClass="max-w-lg text-sm leading-relaxed text-foreground"
    />

    <section class="grid items-start gap-6 py-8 sm:grid-cols-2">
      <!-- FORMULARIO -->
      <div
        id="calculator-form-card"
        class="rounded-xl border border-border p-6"
      >
        <h2 class="mb-5 text-lg font-semibold">Ingresa tus datos</h2>

        <CalculatorRadioGroup
          legend="Modo de cálculo"
          name="modo-calculo"
          options={[
            {
              id: "modo-bruto",
              value: "bruto-a-liquido",
              label: "Bruto → Líquido",
              checked: true,
            },
            {
              id: "modo-liquido",
              value: "liquido-a-bruto",
              label: "Líquido → Bruto",
            },
          ]}
        />

        <div class="mb-4">
          <CalculatorField
            id="sueldo"
            label="Sueldo bruto mensual ($)"
            labelId="sueldo-label"
            placeholder="Ej: 1.200.000"
            min="0"
            wrapperClass="mb-0"
            inputAttrs={{ "aria-describedby": "sueldo-hint" }}
          />
          <p id="sueldo-hint" class="mt-1 text-xs text-muted">
            El total antes de descuentos, incluyendo bonos o asignaciones no
            imponibles si vienen en tu liquidación.
          </p>
          <div
            id="min-wage-warning"
            class="mt-2 hidden rounded-lg border border-amber-500/30 bg-amber-500/10 px-3 py-2 text-xs text-warning"
            role="status"
          >
            El sueldo mínimo mensual en Chile es $
            {IMM_MENSUAL_SERVER.toLocaleString("es-CL")}. El monto ingresado
            está por debajo del mínimo legal para jornada completa.
          </div>
        </div>

        <!-- Imponible (solo visible en modo bruto→líquido) -->
        <CalculatorField
          id="sueldo-imponible"
          label="Sueldo imponible mensual ($) - opcional"
          placeholder="Ej: 1.050.000"
          min="0"
          wrapperId="imponible-field"
          inputAttrs={{ "data-profile-bind": "sueldoImponible" }}
          hint="Si lo dejas vacío, la calculadora asume que tu imponible es igual a tu bruto total."
        />

        <div class="mb-4">
          <label class="mb-2 block text-sm font-medium text-secondary">
            Tipo de contrato
          </label>
          <div class="flex gap-2">
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="tipo-contrato"
                value="indefinido"
                checked
                data-profile-bind="contratoTipo"
                class="peer sr-only"
              />
              <span class="block rounded-lg border border-border px-3 py-3.5 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent">
                Indefinido
              </span>
            </label>
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="tipo-contrato"
                value="plazo-fijo"
                data-profile-bind="contratoTipo"
                class="peer sr-only"
              />
              <span class="block rounded-lg border border-border px-3 py-3.5 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent">
                Plazo fijo / obra
              </span>
            </label>
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="tipo-contrato"
                value="casa-particular"
                data-profile-bind="contratoTipo"
                class="peer sr-only"
              />
              <span class="block rounded-lg border border-border px-3 py-3.5 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent">
                Casa particular
              </span>
            </label>
          </div>
          <p class="mt-1 text-xs text-muted">
            El descuento del trabajador por AFC cambia según este dato. En casa
            particular no se descuenta el 0,6%: lo paga completo el empleador.
          </p>
        </div>

        <div class="mb-4">
          <label class="mb-2 block text-sm font-medium text-secondary">
            Sistema de salud
          </label>
          <div class="flex gap-2">
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="salud"
                value="fonasa"
                checked
                data-profile-bind="saludRegimen"
                class="peer sr-only"
              />
              <span class="block rounded-lg border border-border px-3 py-3.5 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent">
                Fonasa (7%)
              </span>
            </label>
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="salud"
                value="isapre"
                data-profile-bind="saludRegimen"
                class="peer sr-only"
              />
              <span class="block rounded-lg border border-border px-3 py-3.5 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent">
                Isapre (7%+)
              </span>
            </label>
          </div>
        </div>

        <CalculatorField
          id="isapre-adicional"
          label="Cotización adicional Isapre (%)"
          type="number"
          placeholder="Ej: 2.5"
          min="0"
          max="20"
          step="0.1"
          value="2"
          wrapperId="isapre-field"
          class="hidden"
          inputAttrs={{ "data-profile-bind": "isapreAdicionalPct" }}
          hint="Porcentaje adicional al 7% base según tu plan"
        />

        <CalculatorField id="afp-tasa" label="AFP">
          <select
            id="afp-tasa"
            data-profile-bind="afpId"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          >
            {AFP_COMMISSIONS_PERCENT.map(afp => (
              <option
                value={afp.name}
                data-commission={String(afp.total)}
                selected={afp.name === "Habitat"}
              >
                {afp.name} – {afp.total.toFixed(2)}%
              </option>
            ))}
          </select>
        </CalculatorField>

        <!-- MODO AVANZADO -->
        <div class="mb-4 border-t border-border pt-4">
          <button
            id="advanced-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="advanced-fields"
            class="flex w-full items-center justify-between text-sm font-medium text-secondary hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:outline-none"
          >
            <span>Modo avanzado</span>
            <span id="advanced-arrow" class="transition-transform">
              ▼
            </span>
          </button>
          <div id="advanced-fields" class="mt-4 hidden space-y-4">
            <p class="text-xs text-muted">
              Agrega conceptos adicionales para un cálculo más preciso. Solo en
              modo Bruto → Líquido.
            </p>
            <div>
              <label
                for="jornada-fraccion"
                class="mb-1 block text-sm font-medium text-secondary"
              >
                Fracción de jornada
              </label>
              <select
                id="jornada-fraccion"
                class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
              >
                <option value="100" selected>
                  Jornada completa (100%)
                </option>
                <option value="75">3/4 jornada (75%)</option>
                <option value="50">Media jornada (50%)</option>
                <option value="25">1/4 jornada (25%)</option>
              </select>
              <p class="mt-1 text-xs text-muted">
                Para jornada parcial: ingresa el sueldo bruto de jornada
                completa equivalente; la calculadora aplica la fracción al bruto
                y al mínimo legal de referencia.
              </p>
            </div>
            <CalculatorField
              id="gratificacion"
              label="Gratificación mensual ($) - opcional"
              placeholder="Ej: 150.000"
              min="0"
              wrapperClass="mb-0"
              hint="Si recibes gratificación mensualizada, ingrésala aquí. Se suma al imponible."
            />
            <CalculatorField
              id="horas-extra"
              label="Horas extra ($) - opcional"
              placeholder="Ej: 50.000"
              min="0"
              wrapperClass="mb-0"
              hint="Monto total en pesos del mes (p. ej. 5 horas × valor hora × 1,5). Son imponibles y tributan. Desde abril de 2026 (Ley 40h), la jornada máxima es 42 h/semana: toda hora sobre ese límite es extra."
            />
            <CalculatorField
              id="colacion"
              label="Colación ($) - no imponible"
              placeholder="Ej: 40.000"
              min="0"
              wrapperClass="mb-0"
              hint="Si tu liquidación incluye asignación de colación, ingrésala aquí. Reduce el sueldo imponible (no se descuenta de AFP ni salud)."
            />
            <CalculatorField
              id="movilizacion"
              label="Movilización ($) - no imponible"
              placeholder="Ej: 20.000"
              min="0"
              wrapperClass="mb-0"
              hint="Asignación de movilización visible en tu liquidación. Reduce el imponible igual que la colación."
            />
            <CalculatorField
              id="otros-descuentos"
              label="Otros descuentos ($) - opcional"
              placeholder="Ej: 50.000"
              min="0"
              wrapperClass="mb-0"
              hint="Descuentos adicionales no previsionales (préstamo empresa, caja, etc.). Se restan del líquido final."
            />
            <div>
              <CalculatorField
                id="apv-regimen-b"
                label="APV Régimen B ($) - opcional"
                placeholder="Ej: 100.000"
                min="0"
                wrapperClass="mb-0"
                inputAttrs={{ "aria-describedby": "apv-regimen-b-hint" }}
              />
              <p id="apv-regimen-b-hint" class="mt-1 text-xs text-muted">
                Aporte mensual a APV bajo <strong>Régimen B</strong>: reduce tu
                base imponible mensual y por lo tanto el impuesto de 2ª
                categoría (art. 42 bis LIR).
              </p>
              <div class="mt-2 rounded-lg border border-blue-500/30 bg-blue-500/10 px-3 py-2 text-xs text-blue-700 dark:text-blue-400">
                <strong>Régimen A vs. Régimen B:</strong> El Régimen B reduce
                directamente tu impuesto mensual al descontar el APV de la renta
                tributable. El Régimen A en cambio genera un crédito fiscal del
                15% que se aplica en tu declaración anual de impuestos
                (Operación Renta), no en tu liquidación mensual; ingrésalo aquí
                solo si cotizas bajo Régimen B.
              </div>
            </div>
          </div>
        </div>

        <div
          id="calc-error"
          class="mb-3 hidden rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-sm text-danger"
          role="alert"
          aria-live="assertive"
        ></div>
        <div class="mt-2 flex items-center justify-between gap-3 text-xs">
          <span class="inline-flex items-center gap-1.5 font-semibold text-accent">
            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-accent"></span>
            Actualizamos a medida que escribes
          </span>
          <button
            id="calcBtn"
            type="button"
            class="text-secondary underline decoration-border decoration-dashed underline-offset-4 transition-colors hover:text-foreground hover:decoration-accent disabled:cursor-not-allowed disabled:opacity-50"
          >
            <span id="calcBtn-label">Calcular ahora</span>
          </button>
        </div>
      </div>

      <CalculatorResultPanel headingId="resultado-heading">
        <div id="resultado-contenido" data-is-example="true" aria-live="polite">
          <div class="mb-5 rounded-lg border border-border bg-surface-muted/40 p-4 text-center">
            <p class="mb-1 text-xs font-bold tracking-widest text-muted uppercase">
              Ejemplo ilustrativo — no es tu resultado
            </p>
            <p
              class="font-display text-5xl font-semibold text-secondary tabular-nums"
              style="letter-spacing:-0.02em;line-height:1"
            >
              {exampleFmt(exampleNet.netSalary)}
            </p>
          </div>
          <!-- barra apilada generada desde el motor (auditoría F08) -->
          <div class="mb-3">
            <div class="flex h-3 w-full gap-px overflow-hidden rounded-full bg-border">
              {exampleSegments.map(segment => (
                <div
                  class={`h-full ${segment.tw}`}
                  style={`width:${exampleWidth(segment.value)}`}
                  title={`${segment.label}: ${exampleFmt(segment.value)}`}
                />
              ))}
              <div
                class="h-full"
                style={`width:${exampleWidth(exampleNet.netSalary)};background-color:var(--color-accent-2)`}
                title={`Líquido: ${exampleFmt(exampleNet.netSalary)}`}
              ></div>
            </div>
            <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
              {exampleSegments.map(segment => (
                <span class="flex items-center gap-1 text-xs text-muted">
                  <span
                    class={`inline-block h-2 w-2 flex-shrink-0 rounded-full ${segment.tw}`}
                  />
                  {segment.label}{" "}
                  {examplePct((segment.value / exampleNet.grossSalary) * 100)}
                </span>
              ))}
              <span class="flex items-center gap-1 text-xs">
                <span
                  class="inline-block h-2 w-2 flex-shrink-0 rounded-full"
                  style="background-color:var(--color-accent-2)"
                ></span>
