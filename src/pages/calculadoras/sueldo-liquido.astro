---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import CalculatorJsonLd from "@/components/CalculatorJsonLd.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CalculatorTrustBadge from "@/components/CalculatorTrustBadge.astro";
import NextSteps from "@/components/NextSteps.astro";
import { CALCULATOR_PORTFOLIO } from "@/config/calculatorPortfolio";
import ContextLinkSection from "@/components/ContextLinkSection.astro";
import MethodologyBlock from "@/components/MethodologyBlock.astro";
import PrimaryCTA from "@/components/PrimaryCTA.astro";
import ShareCalculatorResult from "@/components/ShareCalculatorResult.astro";
import CalculatorResultNextActions from "@/components/CalculatorResultNextActions.astro";
import NextBestStep from "@/components/NextBestStep.astro";
import SupportCallout from "@/components/SupportCallout.astro";
import { getEconomicParameters } from "@/application/use-cases/GetEconomicParameters";
import { getPath } from "@/utils/getPath";
import { sueldoCalculatorSections } from "@/config/sueldoClusterLinks";
import { AFP_COMMISSIONS_PERCENT } from "@/config/afpCommissions";
import { SITE } from "@/config";

const { parameters: economicParameters } = await getEconomicParameters();
const salaryGuidePath = getPath("/posts/como-calcular-sueldo-liquido/");
const firstTaxExemptBracket = 13.5 * economicParameters.utm;
const economicSourceLabel =
  economicParameters.source === "live"
    ? "dato en línea"
    : economicParameters.source === "snapshot"
      ? "dato de referencia"
      : "fallback de emergencia";
const firstTaxExemptBracketLabel =
  "$" + Math.round(firstTaxExemptBracket).toLocaleString("es-CL");
const sueldoLiquidoFaqs = [
  {
    question: "¿Cómo se calcula el sueldo líquido en Chile?",
    answer:
      "Se parte del sueldo bruto y se descuentan las cotizaciones previsionales obligatorias (AFP, salud, seguro de cesantía) y, si corresponde, el impuesto de segunda categoría. La base de cálculo es el sueldo imponible, que puede ser menor al bruto si tu liquidación incluye asignaciones no imponibles como colación o movilización.",
  },
  {
    question: "¿Cuánto descuenta la AFP de mi sueldo?",
    answer:
      "Entre 10,46% y 11,45% del sueldo imponible según tu AFP. Ese porcentaje incluye el 10% de cotización obligatoria —que va a tu cuenta personal y es tuyo— más la comisión de la AFP, que es el costo del servicio.",
  },
  {
    question: "¿Qué es el sueldo imponible?",
    answer:
      "Es la base sobre la que se calculan AFP, salud y seguro de cesantía. Equivale al sueldo bruto menos las asignaciones no imponibles (como colación y movilización dentro de los límites legales). Si tu liquidación no separa esos conceptos, tu imponible suele ser igual a tu bruto.",
  },
  {
    question: "¿Cuánto me descuentan de salud?",
    answer:
      "El 7% del sueldo imponible si estás en Fonasa. Si estás en Isapre y tu plan cuesta más que el 7%, la diferencia adicional también se descuenta directamente de tu sueldo.",
  },
  {
    question: "¿El seguro de cesantía se descuenta en todos los contratos?",
    answer:
      "Solo si tienes contrato indefinido (0,6% a tu cargo). Con contrato a plazo fijo u obra, el trabajador no aporta nada — el empleador paga el 3% completo. En ambos casos acumulas saldo en tu Cuenta Individual de Cesantía.",
  },
  {
    question: "¿Desde qué sueldo pago impuesto de segunda categoría?",
    answer: `Solo si tu renta tributable mensual supera el primer tramo exento de la tabla del SII. En 2026 ese umbral es aproximadamente ${firstTaxExemptBracketLabel}. El impuesto es progresivo: solo paga la parte del sueldo que supera cada tramo.`,
  },
  {
    question: "¿Cómo calculo el bruto si sé cuánto quiero recibir?",
    answer:
      'Usa el modo "Líquido → Bruto" de esta calculadora: ingresa el monto que quieres recibir en tu cuenta y el sistema estima el bruto necesario bajo los supuestos de AFP, salud y contrato que indiques. Es útil al negociar sueldo o evaluar una oferta laboral.',
  },
  {
    question: "¿Qué incluye la gratificación en el sueldo?",
    answer:
      "La gratificación legal en Chile puede pagarse mensualizada (25% de lo devengado con tope de 4,75 IMM) o como porcentaje de utilidades. Si la recibes mes a mes como parte de tu liquidación, es imponible: afecta tu AFP, salud, cesantía e impuesto. Ingrésala en el Modo avanzado de esta calculadora para un resultado más preciso.",
  },
  {
    question: "¿Las horas extra se descuentan de AFP y salud?",
    answer:
      "Sí. Las horas extra son remuneración imponible: se suman a la base de cálculo de AFP, salud y seguro de cesantía, y también entran a la base de impuesto de segunda categoría. Puedes incluirlas en el Modo avanzado. Desde abril de 2026 (Ley 40h), las horas extra comienzan en la hora 43 de la semana —no en la 46— y cada una debe pagarse con un recargo mínimo del 50%.",
  },
  {
    question: "¿La Ley 40h cambia mi sueldo líquido?",
    answer:
      "No directamente. La Ley 40h (Ley 21.561) reduce la jornada legal ordinaria de 45 a 42 horas semanales en abril de 2026 (con una bajada final a 40 h en 2028), pero no modifica tu sueldo bruto mensual pactado. Lo que cambia es que si trabajas más de 42 horas a la semana, cada hora adicional es hora extra y debe pagarse con un recargo mínimo del 50%. Lo que sí sube es el valor unitario de cada hora ordinaria, porque el denominador (horas semanales × 4,333) se reduce manteniendo el mismo sueldo.",
  },
];
const currentCalculator = CALCULATOR_PORTFOLIO.find(
  calc => calc.slug === "sueldo-liquido"
);
const calculatorRelatedItems = (currentCalculator?.related ?? []).map(item => ({
  href: item.href,
  title: item.label,
  description: item.when,
  label: "Relacionado",
}));
const calculatorNextStepItems = [
  ...calculatorRelatedItems,
  ...(calculatorRelatedItems.length < 2
    ? [
        {
          href: "/calculadoras/",
          title: "Ver todas las calculadoras",
          description: "Compara otra herramienta si tu pregunta cambió.",
          label: "Herramientas",
        },
      ]
    : []),
];
---

<Layout
  title="Calculadora de Sueldo Líquido Chile: AFP, salud e impuesto | Monedario"
  description="Calcula tu sueldo líquido al instante: descuentos de AFP, salud, cesantía e impuesto. También convierte de líquido a bruto. Gratis y actualizado 2026."
>
  <CalculatorJsonLd
    name="Calculadora de Sueldo Líquido Chile"
    description="Calcula tu sueldo líquido al instante: descuentos de AFP, salud, cesantía e impuesto. También convierte de líquido a bruto."
    faqs={sueldoLiquidoFaqs}
  />
  <Header />
  <Breadcrumb />
  <CalculatorTrustBadge location="calculator_header" />
  <main
    id="main-content"
    class="app-layout"
    data-analytics-page-type="calculator"
    data-analytics-calculator="sueldo-liquido"
    data-analytics-calculator-name="Calculadora de Sueldo Liquido"
    data-site-title={SITE.title}
    data-profile-prefill-host="#calculator-form-card"
  >
    <section class="border-b border-border pt-8 pb-6">
      <h1 class="my-4 text-3xl font-bold sm:text-4xl">
        Calculadora de Sueldo Líquido y Bruto
      </h1>
      <p class="max-w-lg text-sm leading-relaxed text-foreground">
        Calcula cuánto recibirás desde tu bruto, o estima el bruto necesario
        para recibir el líquido que quieres. Desglose de AFP, salud, cesantía e
        impuesto de segunda categoría.
      </p>
    </section>

    <section class="grid items-start gap-6 py-8 sm:grid-cols-2">
      <!-- FORMULARIO -->
      <div
        id="calculator-form-card"
        class="rounded-xl border border-border p-6"
      >
        <h2 class="mb-5 text-lg font-semibold">Ingresa tus datos</h2>

        <!-- MODO TOGGLE -->
        <div class="mb-5">
          <p class="mb-2 text-sm font-medium text-secondary">Modo de cálculo</p>
          <div class="flex gap-2">
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="modo-calculo"
                id="modo-bruto"
                value="bruto-a-liquido"
                checked
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-3.5 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                Bruto → Líquido
              </span>
            </label>
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="modo-calculo"
                id="modo-liquido"
                value="liquido-a-bruto"
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-3.5 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                Líquido → Bruto
              </span>
            </label>
          </div>
        </div>

        <div class="mb-4">
          <label
            for="sueldo"
            id="sueldo-label"
            class="mb-1 block text-sm font-medium text-secondary"
          >
            Sueldo bruto mensual ($)
          </label>
          <input
            type="number"
            id="sueldo"
            placeholder="Ej: 1.200.000"
            min="0"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          />
          <p id="sueldo-hint" class="mt-1 text-xs text-muted">
            El total antes de descuentos, incluyendo bonos o asignaciones no
            imponibles si vienen en tu liquidación.
          </p>
        </div>

        <!-- Imponible (solo visible en modo bruto→líquido) -->
        <div id="imponible-field" class="mb-4">
          <label
            for="sueldo-imponible"
            class="mb-1 block text-sm font-medium text-secondary"
          >
            Sueldo imponible mensual ($) - opcional
          </label>
          <input
            type="number"
            id="sueldo-imponible"
            data-profile-bind="sueldoImponible"
            placeholder="Ej: 1.050.000"
            min="0"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          />
          <p class="mt-1 text-xs text-muted">
            Si lo dejas vacío, la calculadora asume que tu imponible es igual a
            tu bruto total.
          </p>
        </div>

        <div class="mb-4">
          <label class="mb-2 block text-sm font-medium text-secondary"
            >Tipo de contrato</label
          >
          <div class="flex gap-2">
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="tipo-contrato"
                value="indefinido"
                checked
                data-profile-bind="contratoTipo"
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-3.5 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                Indefinido
              </span>
            </label>
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="tipo-contrato"
                value="plazo-fijo"
                data-profile-bind="contratoTipo"
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-3.5 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                Plazo fijo / obra
              </span>
            </label>
          </div>
          <p class="mt-1 text-xs text-muted">
            El descuento del trabajador por AFC cambia según este dato.
          </p>
        </div>

        <div class="mb-4">
          <label class="mb-2 block text-sm font-medium text-secondary"
            >Sistema de salud</label
          >
          <div class="flex gap-2">
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="salud"
                value="fonasa"
                checked
                data-profile-bind="saludRegimen"
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-3.5 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                Fonasa (7%)
              </span>
            </label>
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="salud"
                value="isapre"
                data-profile-bind="saludRegimen"
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-3.5 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                Isapre (7%+)
              </span>
            </label>
          </div>
        </div>

        <div id="isapre-field" class="mb-4 hidden">
          <label
            for="isapre-adicional"
            class="mb-1 block text-sm font-medium text-secondary"
          >
            Cotización adicional Isapre (%)
          </label>
          <input
            type="number"
            id="isapre-adicional"
            data-profile-bind="isapreAdicionalPct"
            placeholder="Ej: 2.5"
            min="0"
            max="20"
            step="0.1"
            value="2"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          />
          <p class="mt-1 text-xs text-muted">
            Porcentaje adicional al 7% base según tu plan
          </p>
        </div>

        <div class="mb-4">
          <label
            for="afp-tasa"
            class="mb-1 block text-sm font-medium text-secondary"
          >
            AFP
          </label>
          <select
            id="afp-tasa"
            data-profile-bind="afpId"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          >
            {
              AFP_COMMISSIONS_PERCENT.map(afp => (
                <option
                  value={afp.name}
                  data-commission={String(afp.total)}
                  selected={afp.name === "Habitat"}
                >
                  {afp.name} – {afp.total.toFixed(2)}%
                </option>
              ))
            }
          </select>
        </div>

        <!-- MODO AVANZADO -->
        <div class="mb-4 border-t border-border pt-4">
          <button
            id="advanced-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="advanced-fields"
            class="flex w-full items-center justify-between text-sm font-medium text-secondary hover:text-foreground"
          >
            <span>Modo avanzado</span>
            <span id="advanced-arrow" class="transition-transform">▼</span>
          </button>
          <div id="advanced-fields" class="mt-4 hidden space-y-4">
            <p class="text-xs text-muted">
              Agrega conceptos adicionales para un cálculo más preciso. Solo en
              modo Bruto → Líquido.
            </p>
            <div>
              <label
                for="gratificacion"
                class="mb-1 block text-sm font-medium text-secondary"
              >
                Gratificación mensual ($) - opcional
              </label>
              <input
                type="number"
                id="gratificacion"
                placeholder="Ej: 150.000"
                min="0"
                class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
              />
              <p class="mt-1 text-xs text-muted">
                Si recibes gratificación mensualizada, ingrésala aquí. Se suma
                al imponible.
              </p>
            </div>
            <div>
              <label
                for="horas-extra"
                class="mb-1 block text-sm font-medium text-secondary"
              >
                Horas extra ($) - opcional
              </label>
              <input
                type="number"
                id="horas-extra"
                placeholder="Ej: 50.000"
                min="0"
                class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
              />
              <p class="mt-1 text-xs text-muted">
                Monto total en pesos del mes (p. ej. 5 horas × valor hora ×
                1,5). Son imponibles y tributan. Desde abril de 2026 (Ley 40h),
                la jornada máxima es 42 h/semana: toda hora sobre ese límite es
                extra.
              </p>
            </div>
            <div>
              <label
                for="colacion"
                class="mb-1 block text-sm font-medium text-secondary"
              >
                Colación ($) - no imponible
              </label>
              <input
                type="number"
                id="colacion"
                placeholder="Ej: 40.000"
                min="0"
                class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
              />
              <p class="mt-1 text-xs text-muted">
                Si tu liquidación incluye asignación de colación, ingrésala
                aquí. Reduce el sueldo imponible (no se descuenta de AFP ni
                salud).
              </p>
            </div>
            <div>
              <label
                for="movilizacion"
                class="mb-1 block text-sm font-medium text-secondary"
              >
                Movilización ($) - no imponible
              </label>
              <input
                type="number"
                id="movilizacion"
                placeholder="Ej: 20.000"
                min="0"
                class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
              />
              <p class="mt-1 text-xs text-muted">
                Asignación de movilización visible en tu liquidación. Reduce el
                imponible igual que la colación.
              </p>
            </div>
            <div>
              <label
                for="otros-descuentos"
                class="mb-1 block text-sm font-medium text-secondary"
              >
                Otros descuentos ($) - opcional
              </label>
              <input
                type="number"
                id="otros-descuentos"
                placeholder="Ej: 50.000"
                min="0"
                class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
              />
              <p class="mt-1 text-xs text-muted">
                Descuentos adicionales no previsionales (préstamo empresa, caja,
                etc.). Se restan del líquido final.
              </p>
            </div>
          </div>
        </div>

        <div
          id="calc-error"
          class="mb-3 hidden rounded-lg border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-500"
          role="alert"
          aria-live="assertive"
        ></div>
        <button
          id="calcBtn"
          class="mt-2 w-full rounded-lg bg-accent px-4 py-4 text-base font-bold text-background transition-opacity hover:opacity-90 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span id="calcBtn-label">Calcular sueldo líquido →</span>
        </button>
      </div>

      <!-- RESULTADO -->
      <div
        id="resultado"
        class="rounded-xl border border-border bg-background p-6"
      >
        <h2 id="resultado-heading" class="mb-5 text-lg font-semibold" tabindex="-1">Resultado</h2>
        <div id="resultado-contenido" data-is-example="true" aria-live="polite">
          <div
            class="mb-6 rounded-lg border border-border bg-surface-muted/40 p-4 text-center"
          >
            <p
              class="mb-1 text-xs font-bold tracking-widest text-muted uppercase"
            >
              Sueldo Líquido (Ejemplo)
            </p>
            <p class="text-4xl font-bold text-foreground/60">$973.560</p>
          </div>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-secondary">Sueldo bruto</span><span
                class="font-medium text-foreground/60">$1.200.000</span
              >
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">AFP (11.27%)</span><span
                class="text-red-400/70">− $135.240</span
              >
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Salud (7%)</span><span
                class="text-red-400/70">− $84.000</span
              >
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Seg. cesantía (0.6%)</span><span
                class="text-red-400/70">− $7.200</span
              >
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Imp. 2ª categoría</span><span
                class="text-red-400/70">− $0</span
              >
            </div>
          </div>
          <p class="mt-4 text-xs text-muted">
            Ejemplo para sueldo bruto $1.200.000 con Fonasa y Habitat. Ingresa
            tus datos para calcular tu caso real.
          </p>
        </div>
        <div
          id="economic-parameters"
          data-utm={String(economicParameters.utm)}
          data-uf={String(economicParameters.uf)}
          class="hidden"
          aria-hidden="true"
        >
        </div>
        <p class="mt-3 text-xs text-muted">
          Fuente económica: {economicSourceLabel} ({
            economicParameters.lastUpdated
          }).
        </p>
        <button
          id="copy-btn"
          type="button"
          class="mt-4 hidden w-full rounded-lg border border-border px-4 py-2 text-sm font-medium text-secondary transition-colors hover:border-accent/60 hover:text-foreground"
        >
          Copiar resumen
        </button>
      </div>
    </section>

    <NextBestStep slug="sueldo-liquido" />

    <!-- EXPLICACIÓN -->
    <section
      class="prose prose-sm max-w-none border-t border-border pt-8 pb-12 dark:prose-invert"
    >
      <h2>¿Cómo se calcula el sueldo líquido en Chile?</h2>
      <p>
        El sueldo líquido es lo que efectivamente depositan en tu cuenta cada
        mes. Se obtiene restando al sueldo bruto las cotizaciones previsionales
        y, si corresponde, el impuesto de segunda categoría.
      </p>
      <p>
        Si tu liquidación separa sueldo imponible y asignaciones no imponibles,
        usa ambos datos por separado. Si no conoces el imponible, esta
        calculadora usa el bruto como supuesto rápido y lo deja visible en el
        resultado.
      </p>
      <ul>
        <li>
          <strong>AFP (10% + comisión):</strong> Entre 10.46% y 11.45% según tu AFP.
          El 10% va a tu fondo personal, el resto es la comisión del servicio.
        </li>
        <li>
          <strong>Salud (7%):</strong> Va a Fonasa o tu Isapre para cubrir atención
          médica.
        </li>
        <li>
          <strong>Seguro de cesantía (0.6%):</strong> Fondo para periodos de desempleo.
          En contrato a plazo fijo u obra, normalmente el aporte del trabajador es
          0%.
        </li>
        <li>
          <strong>Impuesto de segunda categoría:</strong> Solo aplica si tu sueldo
          supera el primer tramo exento (~{
            "$" + Math.round(firstTaxExemptBracket).toLocaleString("es-CL")
          }). Es progresivo.
        </li>
      </ul>
      <p class="text-sm text-muted">
        Esta calculadora entrega valores referenciales. Para información
        oficial consulta la <a href="https://www.spensiones.cl" target="_blank" rel="noopener noreferrer"
          >Superintendencia de Pensiones</a
        > y el <a href="https://www.sii.cl" target="_blank" rel="noopener noreferrer">SII</a>. El cálculo
        aplica topes previsionales mensuales de referencia para AFP/salud y AFC
        vigentes al momento del build.
      </p>
      <p>
        Si quieres el paso a paso completo de cada descuento, revisa la <a
          href={salaryGuidePath}
          data-analytics-cta="calculator-guide"
          data-analytics-label="Guia de sueldo liquido en Chile"
          data-analytics-location="calculator_explainer"
          >guía de sueldo líquido en Chile</a
        >.
      </p>
    </section>

    <section class="max-w-none border-t border-border pt-8 pb-12">
      <h2 class="mb-4 text-xl font-semibold">Preguntas frecuentes</h2>

      <div class="space-y-2">
        <details class="group rounded-lg border border-border">
          <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium [&amp;::-webkit-details-marker]:hidden hover:bg-accent/5">
            ¿Cómo se calcula el sueldo líquido en Chile?
            <span class="text-xs text-muted transition-transform group-open:rotate-180">▼</span>
          </summary>
          <div class="border-t border-border px-4 py-3 text-sm text-secondary">
            Se parte del sueldo bruto y se descuentan las cotizaciones previsionales obligatorias (AFP, salud, seguro de cesantía) y, si corresponde, el impuesto de segunda categoría. La base de cálculo es el sueldo imponible, que puede ser menor al bruto si tu liquidación incluye asignaciones no imponibles como colación o movilización.
          </div>
        </details>

        <details class="group rounded-lg border border-border">
          <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium [&amp;::-webkit-details-marker]:hidden hover:bg-accent/5">
            ¿Cuánto descuenta la AFP de mi sueldo?
            <span class="text-xs text-muted transition-transform group-open:rotate-180">▼</span>
          </summary>
          <div class="border-t border-border px-4 py-3 text-sm text-secondary">
            Entre 10,46% y 11,45% del sueldo imponible según tu AFP. Ese porcentaje incluye el 10% de cotización obligatoria —que va a tu cuenta personal y es tuyo— más la comisión de la AFP, que es el costo del servicio.
          </div>
        </details>

        <details class="group rounded-lg border border-border">
          <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium [&amp;::-webkit-details-marker]:hidden hover:bg-accent/5">
            ¿Qué es el sueldo imponible?
            <span class="text-xs text-muted transition-transform group-open:rotate-180">▼</span>
          </summary>
          <div class="border-t border-border px-4 py-3 text-sm text-secondary">
            Es la base sobre la que se calculan AFP, salud y seguro de cesantía. Equivale al sueldo bruto menos las asignaciones no imponibles (como colación y movilización dentro de los límites legales). Si tu liquidación no separa esos conceptos, tu imponible suele ser igual a tu bruto.
          </div>
        </details>

        <details class="group rounded-lg border border-border">
          <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium [&amp;::-webkit-details-marker]:hidden hover:bg-accent/5">
            ¿Cuánto me descuentan de salud?
            <span class="text-xs text-muted transition-transform group-open:rotate-180">▼</span>
          </summary>
          <div class="border-t border-border px-4 py-3 text-sm text-secondary">
            El 7% del sueldo imponible si estás en Fonasa. Si estás en Isapre y tu plan cuesta más que el 7%, la diferencia adicional también se descuenta directamente de tu sueldo.
          </div>
        </details>

        <details class="group rounded-lg border border-border">
          <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium [&amp;::-webkit-details-marker]:hidden hover:bg-accent/5">
            ¿El seguro de cesantía se descuenta en todos los contratos?
            <span class="text-xs text-muted transition-transform group-open:rotate-180">▼</span>
          </summary>
          <div class="border-t border-border px-4 py-3 text-sm text-secondary">
            Solo si tienes contrato indefinido (0,6% a tu cargo). Con contrato a plazo fijo u obra, el trabajador no aporta nada — el empleador paga el 3% completo. En ambos casos acumulas saldo en tu Cuenta Individual de Cesantía.
          </div>
        </details>

        <details class="group rounded-lg border border-border">
          <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium [&amp;::-webkit-details-marker]:hidden hover:bg-accent/5">
            ¿Desde qué sueldo pago impuesto de segunda categoría?
            <span class="text-xs text-muted transition-transform group-open:rotate-180">▼</span>
          </summary>
          <div class="border-t border-border px-4 py-3 text-sm text-secondary">
            Solo si tu renta tributable mensual supera el primer tramo exento de la tabla del SII. En 2026 ese umbral es aproximadamente <strong>{"$" + Math.round(firstTaxExemptBracket).toLocaleString("es-CL")}</strong>. El impuesto es progresivo: solo paga la parte del sueldo que supera cada tramo.
          </div>
        </details>

        <details class="group rounded-lg border border-border">
          <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium [&amp;::-webkit-details-marker]:hidden hover:bg-accent/5">
            ¿Cómo calculo el bruto si sé cuánto quiero recibir?
            <span class="text-xs text-muted transition-transform group-open:rotate-180">▼</span>
          </summary>
          <div class="border-t border-border px-4 py-3 text-sm text-secondary">
            Usa el modo "Líquido → Bruto" de esta calculadora: ingresa el monto que quieres recibir en tu cuenta y el sistema estima el bruto necesario bajo los supuestos de AFP, salud y contrato que indiques. Es útil al negociar sueldo o evaluar una oferta laboral.
          </div>
        </details>

        <details class="group rounded-lg border border-border">
          <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium [&amp;::-webkit-details-marker]:hidden hover:bg-accent/5">
            ¿Qué incluye la gratificación en el sueldo?
            <span class="text-xs text-muted transition-transform group-open:rotate-180">▼</span>
          </summary>
          <div class="border-t border-border px-4 py-3 text-sm text-secondary">
            La gratificación legal en Chile puede pagarse mensualizada (25% de lo devengado con tope de 4,75 IMM) o como porcentaje de utilidades. Si la recibes mes a mes como parte de tu liquidación, es imponible: afecta tu AFP, salud, cesantía e impuesto. Ingrésala en el Modo avanzado de esta calculadora para un resultado más preciso.
          </div>
        </details>

        <details class="group rounded-lg border border-border">
          <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium [&amp;::-webkit-details-marker]:hidden hover:bg-accent/5">
            ¿Las horas extra se descuentan de AFP y salud?
            <span class="text-xs text-muted transition-transform group-open:rotate-180">▼</span>
          </summary>
          <div class="border-t border-border px-4 py-3 text-sm text-secondary">
            Sí. Las horas extra son remuneración imponible: se suman a la base de cálculo de AFP, salud y seguro de cesantía, y también entran a la base de impuesto de segunda categoría. Puedes incluirlas en el Modo avanzado. Desde abril de 2026 (Ley 40h), las horas extra comienzan en la hora 43 de la semana —no en la 46— y cada una debe pagarse con un recargo mínimo del 50%.
          </div>
        </details>

        <details class="group rounded-lg border border-border">
          <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium [&amp;::-webkit-details-marker]:hidden hover:bg-accent/5">
            ¿La Ley 40h cambia mi sueldo líquido?
            <span class="text-xs text-muted transition-transform group-open:rotate-180">▼</span>
          </summary>
          <div class="border-t border-border px-4 py-3 text-sm text-secondary space-y-2">
            <p>No directamente. La Ley 40h (Ley 21.561) reduce la jornada legal ordinaria de 45 a 42 horas semanales en abril de 2026 (con una bajada final a 40 h en 2028), pero no modifica tu sueldo bruto mensual pactado. Lo que cambia es que si trabajas más de 42 horas a la semana, cada hora adicional es hora extra y debe pagarse con un recargo mínimo del 50%. Esta calculadora ya contempla las horas extra en el Modo avanzado: si las ingresas, se suman correctamente a la base imponible.</p>
            <p>Lo que sí sube es el <strong>valor unitario de cada hora</strong>. Por doctrina de la Dirección del Trabajo, el precio de la hora ordinaria se obtiene dividiendo el sueldo mensual entre las horas semanales pactadas × 4,333 (semanas promedio por mes). Al bajar la jornada de 45 a 42 horas manteniendo el mismo sueldo —protección que garantiza la propia Ley 21.561—, el denominador disminuye y el valor por hora aumenta cerca de un 7%. En la práctica: con un bruto de $1.200.000, el valor de la hora ordinaria pasa de ≈ $6.154 (con 45 h/semana) a ≈ $6.593 (con 42 h/semana), y la hora extra —con el recargo mínimo del 50% que fija el Art. 32 del Código del Trabajo— sube de ≈ $9.231 a ≈ $9.890. Esto no lo calcula la calculadora (que trabaja con montos mensuales totales), pero es el efecto que percibes si negocias horas extra o evalúas un contrato que las contempla.</p>
          </div>
        </details>
      </div>
    </section>

    <PrimaryCTA
      text="Revisa si tu liquidación de sueldo está correcta →"
      href="/posts/liquidacion-de-sueldo/"
      context="Entiende cada línea de tu liquidación y detecta errores comunes."
    />
    <ShareCalculatorResult />
    <CalculatorResultNextActions
      calculatorSlug="sueldo-liquido"
      actions={[
        { label: "Imprimir resultado", href: "#", type: "print" },
        {
          label: "Guía: liquidación de sueldo",
          href: "/posts/liquidacion-de-sueldo/",
          type: "article",
        },
        {
          label: "Calcular finiquito",
          href: "/calculadoras/finiquito-indemnizacion/",
          type: "calculator",
        },
      ]}
    />
    <MethodologyBlock
      notes="Esta calculadora aplica las tasas de cotización previsional vigentes en Chile: AFP (tasa total según administradora, que incluye 10% fondo personal + comisión), salud (7% Fonasa o cotización diferenciada Isapre), seguro de cesantía (0.6% contrato indefinido, 3% plazo fijo) e impuesto de segunda categoría por tramos UTM según tabla del SII. El sueldo mínimo legal se usa solo como referencia de validación."
      sources={[
        {
          name: "Superintendencia de Pensiones — Comisiones AFP vigentes",
          url: "https://www.spensiones.cl/portal/institucional/594/w3-article-13665.html",
          date: "2026-03",
        },
        {
          name: "SII — Tramos impuesto único segunda categoría",
          url: "https://www.sii.cl/valores_y_fechas/impuesto_2da_categoria/impuesto2026.htm",
          date: "2026-03",
        },
        {
          name: "Fonasa — Tabla de cotizaciones",
          url: "https://www.fonasa.cl/sites/fonasa/institucional/aportes-cotizaciones",
          date: "2026-01",
        },
        {
          name: "BCN — Ley 19.728 (cotizaciones del seguro de cesantía)",
          url: "https://www.bcn.cl/leychile/navegar?idNorma=184979",
          date: "2026-01",
        },
        {
          name: "Dirección del Trabajo — Código del Trabajo (Art. 32 horas extraordinarias)",
          url: "https://www.dt.gob.cl/legislacion/1624/w3-article-95516.html",
          date: "2026-04",
        },
        {
          name: "Ministerio del Trabajo — Ley 21.561 reducción gradual de jornada laboral (Ley 40h)",
          url: "https://www.mintrab.gob.cl/reduccion-jornada-laboral/",
          date: "2023-04",
        },
      ]}
    />
    {
      sueldoCalculatorSections.map(section => (
        <ContextLinkSection {...section} />
      ))
    }
    <NextSteps
      currentHref="/calculadoras/sueldo-liquido/"
      items={calculatorNextStepItems}
      title="Qué hacer con este resultado"
      description="Sigue con una herramienta relacionada o vuelve al índice si necesitas resolver otra pregunta."
      location="calculator_next_steps"
    />
    <SupportCallout
      context="calculadora-sueldo-liquido"
      pageTitle="la calculadora de sueldo líquido"
    />
  </main>
  <Footer />
</Layout>

<script>
  import "@/scripts/calculator-prefill";
  import {
    calculateNetSalary,
    estimateGrossFromNet,
  } from "@/application/use-cases/CalculateNetSalary";
  import { trackAnalyticsEvent } from "@/utils/analytics";
  import { saveCalculatorResult } from "@/utils/resumeState";

  declare global {
    interface Window {
      showShareResult?: (text: string) => void;
      showCalculatorNextActions?: () => void;
    }
  }

  function fmt(n: number): string {
    return "$" + Math.round(n).toLocaleString("es-CL");
  }

  function fmtPct(n: number): string {
    return n.toFixed(2) + "%";
  }

  // Stores last result for copy-to-clipboard
  let lastResultado: ReturnType<typeof calculateNetSalary> | null = null;
  let lastOtrosDescuentos = 0;
  let lastModoLabel = "";

  function readEconomicParameters(): { uf: number; utm: number } {
    const element = document.getElementById("economic-parameters");
    const utm = Number(element?.dataset?.utm);
    const uf = Number(element?.dataset?.uf);
    if (!Number.isFinite(utm) || utm <= 0 || !Number.isFinite(uf) || uf <= 0) {
      throw new Error("No se pudieron cargar los parámetros económicos.");
    }
    return { uf, utm };
  }

  const economicParameters = readEconomicParameters();

  function showError(message: string) {
    const el = document.getElementById("calc-error");
    if (!el) return;
    el.textContent = message;
    el.classList.remove("hidden");
  }

  function hideError() {
    const el = document.getElementById("calc-error");
    if (!el) return;
    el.classList.add("hidden");
    el.textContent = "";
  }

  function focusResultado() {
    const heading = document.getElementById("resultado-heading");
    if (heading) {
      heading.focus();
      heading.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
  }

  function getModo(): "bruto-a-liquido" | "liquido-a-bruto" {
    return (
      document.querySelector(
        "input[name='modo-calculo']:checked"
      ) as HTMLInputElement
    )?.value === "liquido-a-bruto"
      ? "liquido-a-bruto"
      : "bruto-a-liquido";
  }

  function updateModoUI() {
    const modo = getModo();
    const esLiquidoABruto = modo === "liquido-a-bruto";

    const label = document.getElementById("sueldo-label");
    const hint = document.getElementById("sueldo-hint");
    const input = document.getElementById("sueldo") as HTMLInputElement;
    const btnLabel = document.getElementById("calcBtn-label");
    const imponibleField = document.getElementById("imponible-field");
    const advancedFields = document.getElementById("advanced-fields");
    const advancedToggle = document.getElementById("advanced-toggle");

    if (label)
      label.textContent = esLiquidoABruto
        ? "Sueldo líquido deseado ($)"
        : "Sueldo bruto mensual ($)";
    if (hint)
      hint.textContent = esLiquidoABruto
        ? "Lo que quieres recibir depositado cada mes."
        : "El total antes de descuentos, incluyendo bonos o asignaciones no imponibles si vienen en tu liquidación.";
    if (input)
      input.placeholder = esLiquidoABruto ? "Ej: 900.000" : "Ej: 1.200.000";
    if (btnLabel)
      btnLabel.textContent = esLiquidoABruto
        ? "Estimar sueldo bruto necesario →"
        : "Calcular sueldo líquido →";
    if (imponibleField)
      imponibleField.classList.toggle("hidden", esLiquidoABruto);
    // Advanced mode only works in bruto→líquido
    if (esLiquidoABruto && advancedFields && advancedToggle) {
      advancedFields.classList.add("hidden");
      advancedToggle.setAttribute("aria-expanded", "false");
      const arrow = document.getElementById("advanced-arrow");
      if (arrow) arrow.style.transform = "";
    }
    if (advancedToggle)
      advancedToggle.classList.toggle(
        "opacity-40 pointer-events-none",
        esLiquidoABruto
      );
  }

  // Toggle Modo
  document.querySelectorAll("input[name='modo-calculo']").forEach(radio => {
    radio.addEventListener("change", () => {
      updateModoUI();
      trackAnalyticsEvent("calculator_mode_toggle", {
        calculator_slug: "sueldo-liquido",
        mode: getModo(),
      });
    });
  });

  // Toggle Isapre
  document.querySelectorAll("input[name='salud']").forEach(radio => {
    radio.addEventListener("change", () => {
      const isIsapre =
        (
          document.querySelector(
            "input[name='salud']:checked"
          ) as HTMLInputElement
        )?.value === "isapre";
      const field = document.getElementById("isapre-field");
      if (field) field.classList.toggle("hidden", !isIsapre);
    });
  });

  // Toggle Modo Avanzado
  document.getElementById("advanced-toggle")?.addEventListener("click", () => {
    const fields = document.getElementById("advanced-fields");
    const arrow = document.getElementById("advanced-arrow");
    const btn = document.getElementById("advanced-toggle");
    if (!fields) return;
    const isHidden = fields.classList.toggle("hidden");
    btn?.setAttribute("aria-expanded", String(!isHidden));
    if (arrow) arrow.style.transform = isHidden ? "" : "rotate(180deg)";
  });

  function getCommonInputs() {
    const afpSelect = document.getElementById("afp-tasa") as HTMLSelectElement;
    const afpTasaPercent = parseFloat(
      afpSelect.options[afpSelect.selectedIndex]?.dataset.commission ?? "0"
    );
    const healthSystem =
      (
        document.querySelector(
          "input[name='salud']:checked"
        ) as HTMLInputElement
      )?.value === "isapre"
        ? "isapre"
        : "fonasa";
    const contractType =
      (
        document.querySelector(
          "input[name='tipo-contrato']:checked"
        ) as HTMLInputElement
      )?.value === "plazo-fijo"
        ? "plazo-fijo"
        : "indefinido";
    const isapreAdicional =
      parseFloat(
        (document.getElementById("isapre-adicional") as HTMLInputElement).value
      ) || 0;
    return {
      afpTasaPercent,
      healthSystem,
      contractType,
      isapreAdicional,
    } as const;
  }

  const buildRow = (label: string, value: string, colorClass = "") => {
    const line = document.createElement("div");
    line.className =
      "flex items-center justify-between border-b border-border py-2 text-sm last:border-0";
    const labelElement = document.createElement("span");
    labelElement.className = "text-secondary";
    labelElement.textContent = label;
    const valueElement = document.createElement("span");
    valueElement.className = `font-mono font-semibold ${colorClass}`.trim();
    valueElement.textContent = value;
    line.append(labelElement, valueElement);
    return line;
  };

  function renderResultado(
    resultado: ReturnType<typeof calculateNetSalary>,
    modoLabel: string,
    extraNote?: string,
    otrosDescuentos?: number
  ) {
    lastResultado = resultado;
    lastOtrosDescuentos = otrosDescuentos ?? 0;
    lastModoLabel = modoLabel;

    const netFinal = resultado.netSalary - (otrosDescuentos ?? 0);
    const totalDed = resultado.deductions.total + (otrosDescuentos ?? 0);
    const isInverso = modoLabel === "Sueldo Bruto Estimado";
    const displayAmount = isInverso ? resultado.grossSalary : netFinal;
    const retainedPct = Math.round(
      100 - (totalDed / resultado.grossSalary) * 100
    );

    // — HEADLINE —
    const headline = document.createElement("div");
    headline.className =
      "mb-4 rounded-lg border border-accent/20 bg-accent/10 p-4 text-center";
    const headlineLabel = document.createElement("p");
    headlineLabel.className =
      "mb-1 text-xs font-bold tracking-widest text-accent uppercase";
    headlineLabel.textContent = modoLabel;
    const headlineValue = document.createElement("p");
    headlineValue.className = "text-4xl font-bold";
    headlineValue.textContent = fmt(displayAmount);
    const headlineSub = document.createElement("p");
    headlineSub.className = "mt-1.5 text-xs text-foreground/60";
    if (isInverso) {
      headlineSub.textContent = `Bruto estimado para recibir ${fmt(netFinal)} al mes`;
    } else {
      headlineSub.innerHTML = `De cada $100 brutos, recibes <strong class="text-foreground/80">$${retainedPct}</strong>`;
    }
    headline.append(headlineLabel, headlineValue, headlineSub);

    // — BARRAS VISUALES DE DESCUENTOS —
    const barsData: { label: string; value: number; color: string }[] = [
      { label: "AFP", value: resultado.deductions.afp, color: "bg-blue-400" },
      {
        label: "Salud",
        value: resultado.deductions.health,
        color: "bg-cyan-400",
      },
      {
        label: "Seg. cesantía",
        value: resultado.deductions.unemploymentInsurance,
        color: "bg-emerald-400",
      },
      {
        label: "Imp. 2ª cat.",
        value: resultado.deductions.tax,
        color: "bg-amber-400",
      },
    ];
    if (otrosDescuentos && otrosDescuentos > 0) {
      barsData.push({
        label: "Otros desc.",
        value: otrosDescuentos,
        color: "bg-rose-400",
      });
    }
    const bars = document.createElement("div");
    bars.className = "mb-4 space-y-1.5";
    for (const { label, value, color } of barsData) {
      const pct = (value / resultado.grossSalary) * 100;
      const barWrap = document.createElement("div");
      const barMeta = document.createElement("div");
      barMeta.className = "mb-0.5 flex justify-between text-xs text-muted";
      barMeta.innerHTML = `<span>${label}</span><span>${fmt(value)} (${pct.toFixed(1)}%)</span>`;
      const barTrack = document.createElement("div");
      barTrack.className =
        "h-1.5 w-full overflow-hidden rounded-full bg-border";
      const barFill = document.createElement("div");
      barFill.className = `h-full rounded-full ${color}`;
      barFill.style.width = `${Math.min(pct, 100)}%`;
      barTrack.append(barFill);
      barWrap.append(barMeta, barTrack);
      bars.append(barWrap);
    }

    // — FILAS DE DETALLE —
    const rows = [
      buildRow("Sueldo bruto", fmt(resultado.grossSalary), "text-green-500"),
      buildRow(
        "Sueldo imponible",
        fmt(resultado.taxableSalary),
        "text-secondary"
      ),
      buildRow(
        "No imponibles",
        fmt(resultado.nonTaxableIncome),
        "text-secondary"
      ),
      buildRow(
        `AFP (${fmtPct(resultado.effectiveRates.afpPercent)})`,
        `− ${fmt(resultado.deductions.afp)}`,
        "text-red-400"
      ),
      buildRow(
        `Salud (${fmtPct(resultado.effectiveRates.healthPercent)})`,
        `− ${fmt(resultado.deductions.health)}`,
        "text-red-400"
      ),
      buildRow(
        `Seg. cesantía (${fmtPct(resultado.effectiveRates.unemploymentInsurancePercent)})`,
        `− ${fmt(resultado.deductions.unemploymentInsurance)}`,
        "text-red-400"
      ),
      buildRow(
        "Imp. 2ª categoría",
        `− ${fmt(resultado.deductions.tax)}`,
        "text-red-400"
      ),
    ];

    if (otrosDescuentos && otrosDescuentos > 0) {
      rows.push(
        buildRow(
          "Otros descuentos",
          `− ${fmt(otrosDescuentos)}`,
          "text-red-400"
        )
      );
    }

    // — TOTAL DESCUENTOS —
    const totals = document.createElement("div");
    totals.className = "mt-3 flex justify-between pt-3 text-sm font-semibold";
    const totalsLabel = document.createElement("span");
    totalsLabel.textContent = "Total descuentos";
    const totalsValue = document.createElement("span");
    totalsValue.className = "text-red-400";
    totalsValue.textContent = `${fmt(totalDed)} (${fmtPct((totalDed / resultado.grossSalary) * 100)})`;
    totals.append(totalsLabel, totalsValue);

    // — FILAS INFORMATIVAS: ANUAL + COSTO EMPLEADOR —
    const mkInfoRow = (
      label: string,
      value: string,
      tooltip?: string
    ): HTMLElement => {
      const row = document.createElement("div");
      row.className =
        "flex items-center justify-between rounded border border-border/50 bg-surface-muted/30 px-3 py-2 text-xs";
      const lbl = document.createElement("span");
      lbl.className = "text-muted";
      if (tooltip) lbl.title = tooltip;
      lbl.textContent = label;
      const val = document.createElement("span");
      val.className = "font-semibold text-foreground/80";
      val.textContent = value;
      row.append(lbl, val);
      return row;
    };
    const extraRows = document.createElement("div");
    extraRows.className = "mt-2 space-y-1";
    extraRows.append(mkInfoRow("Al año (× 12)", fmt(displayAmount * 12)));
    const afcEmployerRate =
      resultado.contractType === "plazo-fijo" ? 0.03 : 0.024;
    const employerAfc =
      resultado.cappedBases.unemploymentInsurance * afcEmployerRate;
    extraRows.append(
      mkInfoRow(
        "Costo total para tu empleador ①",
        `≈ ${fmt(resultado.grossSalary + employerAfc)}`,
        `AFC empleador: ${fmt(employerAfc)}`
      )
    );

    // — SUPUESTO Y NOTAS —
    const assumption = document.createElement("p");
    assumption.className = "mt-3 text-xs text-muted";
    const baseNote =
      extraNote ??
      (resultado.taxableSalary === resultado.grossSalary
        ? "Supuesto aplicado: bruto total = imponible mensual."
        : "Usando imponible explícito distinto del bruto total.");
    assumption.textContent = `${baseNote} ① Solo AFC empleador; no incluye mutual de seguridad ni beneficios pactados.`;

    document
      .getElementById("resultado-contenido")!
      .replaceChildren(headline, bars, ...rows, totals, extraRows, assumption);

    // Show copy button after result renders
    const copyBtn = document.getElementById("copy-btn");
    if (copyBtn) copyBtn.classList.remove("hidden");
  }

  document.getElementById("calcBtn")?.addEventListener("click", () => {
    hideError();
    setLoading(true);
    const modo = getModo();
    const rawInput =
      parseFloat(
        (document.getElementById("sueldo") as HTMLInputElement).value
      ) || 0;
    hideError();
    if (rawInput <= 0) {
      showError("Por favor ingresa un monto válido.");
      setLoading(false);
      return;
    }

    const { afpTasaPercent, healthSystem, contractType, isapreAdicional } =
      getCommonInputs();

    if (modo === "liquido-a-bruto") {
      let resultado;
      try {
        resultado = estimateGrossFromNet({
          targetNetSalary: rawInput,
          afpRatePercent: afpTasaPercent,
          healthSystem,
          contractType,
          isapreAdditionalPercent: isapreAdicional,
          economicParameters,
        });
      } catch (error) {
        showError(
          error instanceof Error
            ? error.message
            : "No se pudo estimar el sueldo bruto."
        );
        setLoading(false);
        return;
      }
      setLoading(false);
      renderResultado(
        resultado,
        "Sueldo Bruto Estimado",
        "Estimación inversa: supuesto bruto = imponible. AFP, salud y contrato según tu selección."
      );
      focusResultado();
      saveCalculatorResult(
        window.location.pathname,
        "Calculadora de Sueldo Líquido y Bruto"
      );
      if (typeof window.showShareResult === "function") {
        window.showShareResult(
          `Sueldo Líquido y Bruto: bruto estimado ${fmt(resultado.grossSalary)}`
        );
      }
      window.showCalculatorNextActions?.();
      trackAnalyticsEvent("calculator_complete", {
        calculator_slug: "sueldo-liquido",
        calculator_name: "Calculadora de Sueldo Liquido",
        outcome: "success",
        mode: "liquido-a-bruto",
      });
      trackAnalyticsEvent("calculator_completed", {
        calculator_slug: "sueldo-liquido",
      });
    } else {
      const imponibleRaw = parseFloat(
        (document.getElementById("sueldo-imponible") as HTMLInputElement).value
      );
      const imponible =
        Number.isFinite(imponibleRaw) && imponibleRaw > 0
          ? imponibleRaw
          : undefined;

      // Advanced mode extras
      const gratificacion =
        parseFloat(
          (document.getElementById("gratificacion") as HTMLInputElement)?.value
        ) || 0;
      const horasExtra =
        parseFloat(
          (document.getElementById("horas-extra") as HTMLInputElement)?.value
        ) || 0;
      const colacion =
        parseFloat(
          (document.getElementById("colacion") as HTMLInputElement)?.value
        ) || 0;
      const movilizacion =
        parseFloat(
          (document.getElementById("movilizacion") as HTMLInputElement)?.value
        ) || 0;
      const otrosDescuentos =
        parseFloat(
          (document.getElementById("otros-descuentos") as HTMLInputElement)
            ?.value
        ) || 0;

      const grossBase = rawInput + gratificacion + horasExtra;
      const noImponiblesExtra = colacion + movilizacion;
      const taxableAdjusted =
        imponible !== undefined
          ? imponible + gratificacion + horasExtra
          : noImponiblesExtra > 0
            ? Math.max(0, rawInput - noImponiblesExtra) +
              gratificacion +
              horasExtra
            : undefined;

      let resultado;
      try {
        resultado = calculateNetSalary({
          grossSalary: grossBase,
          taxableSalary: taxableAdjusted,
          afpRatePercent: afpTasaPercent,
          healthSystem,
          contractType,
          isapreAdditionalPercent: isapreAdicional,
          economicParameters,
        });
      } catch (error) {
        showError(
          error instanceof Error
            ? error.message
            : "No se pudo calcular el sueldo líquido."
        );
        setLoading(false);
        return;
      }
      setLoading(false);
      renderResultado(resultado, "Sueldo Líquido", undefined, otrosDescuentos);
      focusResultado();
      saveCalculatorResult(
        window.location.pathname,
        "Calculadora de Sueldo Líquido y Bruto"
      );
      if (typeof window.showShareResult === "function") {
        window.showShareResult(
          `Sueldo Líquido y Bruto: líquido ${fmt(resultado.netSalary - (otrosDescuentos ?? 0))}`
        );
      }
      window.showCalculatorNextActions?.();
      trackAnalyticsEvent("calculator_complete", {
        calculator_slug: "sueldo-liquido",
        calculator_name: "Calculadora de Sueldo Liquido",
        outcome: "success",
        mode: "bruto-a-liquido",
      });
      trackAnalyticsEvent("calculator_completed", {
        calculator_slug: "sueldo-liquido",
      });
    }
  });

  function setLoading(isLoading: boolean) {
    const btn = document.getElementById("calcBtn") as HTMLButtonElement;
    const label = document.getElementById("calcBtn-label");
    if (!btn || !label) return;
    btn.disabled = isLoading;
    label.textContent = isLoading
      ? "Calculando…"
      : getModo() === "liquido-a-bruto"
        ? "Estimar sueldo bruto necesario →"
        : "Calcular sueldo líquido →";
  }

  document.getElementById("copy-btn")?.addEventListener("click", async () => {
    if (!lastResultado) return;

    const r = lastResultado;
    const netFinal = r.netSalary - lastOtrosDescuentos;
    const totalDed = r.deductions.total + lastOtrosDescuentos;
    const pctDed = ((totalDed / r.grossSalary) * 100).toFixed(2);
    const isInverso = lastModoLabel === "Sueldo Bruto Estimado";

    const pad = (s: string, n = 24) => s.padEnd(n, " ");

    const lines = [
      `Calculadora de Sueldo Líquido — ${document.getElementById("main-content")?.dataset.siteTitle ?? "Monedario"}`,
      "─".repeat(44),
      `${pad("Bruto:")}${fmt(r.grossSalary)}`,
      `${pad("Imponible:")}${fmt(r.taxableSalary)}`,
      `${pad("No imponibles:")}${fmt(r.nonTaxableIncome)}`,
      "─".repeat(44),
      `${pad(`AFP (${fmtPct(r.effectiveRates.afpPercent)}):`)}−${fmt(r.deductions.afp)}`,
      `${pad(`Salud (${fmtPct(r.effectiveRates.healthPercent)}):`)}−${fmt(r.deductions.health)}`,
      `${pad(`Seg. cesantía (${fmtPct(r.effectiveRates.unemploymentInsurancePercent)}):`)}−${fmt(r.deductions.unemploymentInsurance)}`,
      `${pad("Imp. 2ª categoría:")}−${fmt(r.deductions.tax)}`,
      ...(lastOtrosDescuentos > 0
        ? [`${pad("Otros descuentos:")}−${fmt(lastOtrosDescuentos)}`]
        : []),
      "─".repeat(44),
      `${pad("Total descuentos:")}−${fmt(totalDed)} (${pctDed}%)`,
      isInverso
        ? `${pad("BRUTO ESTIMADO:")}${fmt(r.grossSalary)}`
        : `${pad("SUELDO LÍQUIDO:")}${fmt(netFinal)}`,
    ];

    const text = lines.join("\n");
    const btn = document.getElementById("copy-btn") as HTMLButtonElement;

    try {
      await navigator.clipboard.writeText(text);
      btn.textContent = "¡Copiado!";
      trackAnalyticsEvent("calculator_copy_result", {
        calculator_slug: "sueldo-liquido",
      });
    } catch {
      btn.textContent = "No se pudo copiar";
    }

    setTimeout(() => {
      btn.textContent = "Copiar resumen";
    }, 2000);
  });

  document
    .getElementById("sueldo")
    ?.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Enter")
        (document.getElementById("calcBtn") as HTMLButtonElement)?.click();
    });

  // Auto-cálculo en tiempo real (debounced 600 ms)
  let autoCalcTimer: ReturnType<typeof setTimeout> | undefined;
  document.getElementById("sueldo")?.addEventListener("input", () => {
    clearTimeout(autoCalcTimer);
    autoCalcTimer = setTimeout(() => {
      const val = parseFloat(
        (document.getElementById("sueldo") as HTMLInputElement).value
      );
      if (val > 0) {
        (document.getElementById("calcBtn") as HTMLButtonElement)?.click();
      }
    }, 600);
  });

  // URL parameter pre-fill (e.g. ?bruto=1200000&afp=Habitat&contrato=plazo-fijo)
  document.addEventListener("DOMContentLoaded", () => {
    const params = new URLSearchParams(window.location.search);

    const bruto = params.get("bruto");
    const liquido = params.get("liquido");
    const imponible = params.get("imponible");
    const afpParam = params.get("afp");
    const contrato = params.get("contrato");
    const salud = params.get("salud");

    // Set mode and fill amount
    if (bruto || liquido) {
      const targetMode = liquido ? "liquido-a-bruto" : "bruto-a-liquido";
      const radio = document.querySelector(
        `input[name='modo-calculo'][value='${targetMode}']`
      ) as HTMLInputElement | null;
      if (radio) {
        radio.checked = true;
        updateModoUI();
      }
      const amount = parseFloat(
        (bruto ?? liquido)!.replace(/\./g, "").replace(",", ".")
      );
      if (Number.isFinite(amount) && amount > 0) {
        const sueldoInput = document.getElementById(
          "sueldo"
        ) as HTMLInputElement | null;
        if (sueldoInput) sueldoInput.value = String(amount);
      }
    }

    // Pre-fill imponible (bruto mode only)
    if (imponible && !liquido) {
      const amount = parseFloat(imponible.replace(/\./g, "").replace(",", "."));
      if (Number.isFinite(amount) && amount > 0) {
        const imponibleInput = document.getElementById(
          "sueldo-imponible"
        ) as HTMLInputElement | null;
        if (imponibleInput) imponibleInput.value = String(amount);
      }
    }

    // Select AFP by case-insensitive startsWith match
    if (afpParam) {
      const select = document.getElementById(
        "afp-tasa"
      ) as HTMLSelectElement | null;
      if (select) {
        const needle = afpParam.toLowerCase();
        for (const option of Array.from(select.options)) {
          if (option.text.toLowerCase().startsWith(needle)) {
            option.selected = true;
            break;
          }
        }
      }
    }

    // Select contract type radio and trigger change
    if (contrato === "plazo-fijo" || contrato === "indefinido") {
      const radio = document.querySelector(
        `input[name='tipo-contrato'][value='${contrato}']`
      ) as HTMLInputElement | null;
      if (radio) {
        radio.checked = true;
        radio.dispatchEvent(new Event("change", { bubbles: true }));
      }
    }

    // Select health system radio and trigger change (so isapre field shows if needed)
    if (salud === "fonasa" || salud === "isapre") {
      const radio = document.querySelector(
        `input[name='salud'][value='${salud}']`
      ) as HTMLInputElement | null;
      if (radio) {
        radio.checked = true;
        radio.dispatchEvent(new Event("change", { bubbles: true }));
      }
    }

    // Auto-calculate only when a main amount is provided
    if (bruto || liquido) {
      setTimeout(() => {
        (
          document.getElementById("calcBtn") as HTMLButtonElement | null
        )?.click();
      }, 100);
    }
  });
</script>
