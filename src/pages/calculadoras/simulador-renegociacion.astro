---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import CalculatorJsonLd from "@/components/CalculatorJsonLd.astro";
import Footer from "@/components/Footer.astro";
import MethodologyBlock from "@/components/MethodologyBlock.astro";
import { debtRenegotiationWorkedExample } from "@/application/use-cases/SimulateDebtRenegotiation.methodology";
import PrimaryCTA from "@/components/PrimaryCTA.astro";
import ShareCalculatorResult from "@/components/ShareCalculatorResult.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CalculatorTrustBadge from "@/components/CalculatorTrustBadge.astro";
import NextSteps from "@/components/NextSteps.astro";
import { CALCULATOR_PORTFOLIO } from "@/config/calculatorPortfolio";
import { getEconomicParameters } from "@/application/use-cases/GetEconomicParameters";
import { getPath } from "@/utils/getPath";
import CalculatorHero from "@/components/calculator/CalculatorHero.astro";
import CalculatorField from "@/components/calculator/CalculatorField.astro";
import { simulateDebtRenegotiation } from "@/application/use-cases/SimulateDebtRenegotiation";
import CalculatorDataFreshness from "@/components/calculator/CalculatorDataFreshness.astro";
import { formatEconomicDate } from "@/domain/economic/economicSourcePresentation";
import { formatCLP } from "@/utils/formatCLP";

const renegociacionGuidePath = getPath("/posts/renegociacion-superir/");
const dicomGuidePath = getPath("/posts/donde-ver-si-estoy-en-dicom-gratis/");
const { parameters: economicParameters } = await getEconomicParameters();
const fmtClp = formatCLP;
const exampleResult = simulateDebtRenegotiation({
  debts: [
    { amount: 2_000_000, overdueDays: 120 },
    { amount: 1_500_000, overdueDays: 100 },
  ],
  monthlyIncome: 700_000,
  termMonths: 36,
  monthlyRatePercent: 1.5,
  ufValue: economicParameters.uf,
  hasFirstCategoryActivityLast24Months: false,
  hasNotifiedExecutiveProceeding: false,
  hasRequiredDocuments: true,
});
const currentCalculator = CALCULATOR_PORTFOLIO.find(
  calc => calc.slug === "simulador-renegociacion"
);
const calculatorRelatedItems = (currentCalculator?.related ?? []).map(item => ({
  href: item.href,
  title: item.label,
  description: item.when,
  label: "Relacionado",
}));
const calculatorNextStepItems = [
  ...calculatorRelatedItems,
  ...(calculatorRelatedItems.length < 2
    ? [
        {
          href: "/calculadoras/",
          title: "Ver todas las calculadoras",
          description: "Compara otra herramienta si tu pregunta cambió.",
          label: "Herramientas",
        },
      ]
    : []),
];
---

<Layout
  title="Renegociación de Deudas Chile 2026 | Simulador Superir"
  description="Simula gratis tu renegociación de deudas con Superir: verifica elegibilidad y estima tu cuota mensual orientativa."
>
  <CalculatorJsonLd
    name="Renegociación de Deudas Chile 2026 | Simulador Superir"
    description="Simula gratis tu renegociación de deudas con Superir: verifica elegibilidad y estima tu cuota mensual orientativa."
  />
  <Header />
  <Breadcrumb />
  <CalculatorTrustBadge location="calculator_header" />
  <main
    data-layout="calculator"
    id="main-content"
    class="app-layout"
    data-analytics-page-type="calculator"
    data-analytics-calculator="simulador-renegociacion"
    data-analytics-calculator-name="Simulador de Renegociacion Superir"
  >
    <CalculatorHero
      title="Simulador de Renegociación Superir"
      description="Revisa primero si cumples el filtro básico de la Superir y, por separado, estima una cuota orientativa según tus deudas e ingresos."
      descriptionClass="max-w-xl text-secondary"
    />

    <section class="grid items-start gap-6 py-8 sm:grid-cols-2">
      <!-- FORMULARIO -->
      <div class="rounded-xl border border-border p-6">
        <h2 class="mb-5 text-lg font-semibold">Tus deudas e ingresos</h2>

        <div class="mb-5">
          <p class="mb-3 text-sm font-medium text-secondary">
            Deudas vencidas (cada una con más de 90 días corridos)
          </p>
          <div id="deudas-container" class="space-y-3">
            <div class="deuda-row flex items-center gap-2">
              <input
                type="number"
                aria-label="Monto de la deuda vencida 1 en pesos"
                placeholder="Monto ($) Ej: 1.500.000"
                min="0"
                class="deuda-monto flex-1 rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground focus:border-accent focus:outline-none"
              />
              <input
                type="number"
                aria-label="Días de mora de la deuda vencida 1"
                placeholder="Días mora"
                min="1"
                max="5000"
                value="91"
                class="deuda-dias w-28 rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground focus:border-accent focus:outline-none"
              />
            </div>
            <div class="deuda-row flex items-center gap-2">
              <input
                type="number"
                aria-label="Monto de la deuda vencida 2 en pesos"
                placeholder="Monto ($) Ej: 800.000"
                min="0"
                class="deuda-monto flex-1 rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground focus:border-accent focus:outline-none"
              />
              <input
                type="number"
                aria-label="Días de mora de la deuda vencida 2"
                placeholder="Días mora"
                min="1"
                max="5000"
                value="91"
                class="deuda-dias w-28 rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground focus:border-accent focus:outline-none"
              />
            </div>
          </div>
          <button
            id="agregar-deuda"
            class="mt-2 text-xs text-accent hover:underline"
            >+ Agregar otra deuda</button
          >
          <p class="mt-1 text-xs text-muted">
            La regla legal no es "3 meses aproximados": cada deuda debe superar
            90 días corridos al momento de presentar la solicitud.
          </p>
        </div>

        <CalculatorField
          id="primera-categoria"
          label="¿Tuviste inicio de actividades o rentas de primera categoría en los últimos 24 meses?"
          hint="Si emitiste boletas de honorarios, eso no equivale por sí solo a primera categoría."
        >
          <select
            id="primera-categoria"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          >
            <option value="">Selecciona una opción</option>
            <option value="no">No</option>
            <option value="si">Sí</option>
          </select>
        </CalculatorField>

        <CalculatorField
          id="juicio-ejecutivo"
          label="¿Te notificaron formalmente una demanda ejecutiva o una liquidación forzosa?"
        >
          <select
            id="juicio-ejecutivo"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          >
            <option value="">Selecciona una opción</option>
            <option value="no">No</option>
            <option value="si">Sí</option>
          </select>
        </CalculatorField>

        <CalculatorField
          id="documentos-completos"
          label="¿Ya tienes reunidos los documentos y declaraciones que pide la Superir?"
          hint="Esto no reemplaza la revisión de admisibilidad, pero sí cambia si tu caso está listo para solicitud formal o solo para evaluación."
        >
          <select
            id="documentos-completos"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          >
            <option value="">Selecciona una opción</option>
            <option value="si">Sí</option>
            <option value="no">No</option>
          </select>
        </CalculatorField>

        <CalculatorField
          id="ingreso"
          label="Ingreso mensual neto ($)"
          placeholder="Ej: 900.000"
          min="0"
          hint="Lo que recibes en tu cuenta (líquido)."
        />

        <CalculatorField
          id="plazo-renego"
          label="Plazo de renegociación deseado (meses)"
          placeholder="Ej: 36"
          min="6"
          max="120"
          value="36"
        />

        <CalculatorField
          id="tasa-renego"
          label="Tasa de interés del acuerdo (% mensual)"
          placeholder="Ej: 1.5"
          min="0"
          max="5"
          step="0.1"
          value="1.5"
          hint="La tasa varía según el acuerdo. Los acuerdos Superir suelen bajar la tasa respecto al contrato original. Usa 0% para simular cuota sin interés."
        />

        <button
          id="calcBtn"
          class="mt-2 w-full rounded-lg bg-accent px-4 py-3 text-base font-bold text-background transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Simular renegociación →
        </button>
        <div
          id="calc-error"
          class="mt-3 hidden rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-sm text-red-500"
          role="alert"
        >
        </div>
      </div>

      <!-- RESULTADO -->
      <div class="rounded-xl border border-border bg-background p-6">
        <h2 class="mb-5 text-lg font-semibold">Diagnóstico y simulación</h2>
        <div
          id="resultado-contenido"
          data-guide-url={renegociacionGuidePath}
          data-uf={String(economicParameters.uf)}
          data-is-example="true"
          aria-live="polite"
        >
          <div
            class="mb-5 rounded-lg border border-border bg-surface-muted/40 p-4 text-center"
          >
            <p
              class="mb-1 text-xs font-bold tracking-widest text-muted uppercase"
            >
              Cuota renegociada (Ejemplo ilustrativo)
            </p>
            <p class="text-4xl font-bold text-foreground/80">
              {fmtClp(exampleResult.monthlyPayment)}
            </p>
          </div>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-secondary">Deuda total</span>
              <span class="font-medium text-foreground/80">
                {fmtClp(exampleResult.totalDebtClp)}
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Total a pagar</span>
              <span class="font-medium text-foreground/80">
                {fmtClp(exampleResult.totalPaid)}
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Carga sobre el ingreso</span>
              <span class="font-medium text-foreground/80">
                {exampleResult.incomeBurdenPercent.toFixed(0)}%
              </span>
            </div>
          </div>
          <p class="mt-4 text-xs text-muted">
            Ejemplo: dos deudas ($2.000.000 + $1.500.000), ingreso $700.000,
            plazo 36 meses. Ingresa tus datos para ver tu resultado.
          </p>
        </div>
        <CalculatorDataFreshness
          source={economicParameters.source}
          updatedDate={formatEconomicDate(economicParameters.lastUpdated)}
          variant="result"
        />
      </div>
    </section>

    <div
      id="comparacion-plazos"
      hidden
      class="border-t border-border py-8"
      aria-live="polite"
    >
    </div>

    <section
      class="prose prose-sm max-w-none border-t border-border pt-8 pb-12 dark:prose-invert"
    >
      <h2>¿Qué es la renegociación Superir?</h2>
      <p>
        La <strong
          >Superintendencia de Insolvencia y Reemprendimiento (Superir)</strong
        > ofrece un procedimiento gratuito donde actúa como mediadora entre tú y tus
        acreedores para acordar nuevas condiciones de pago. No necesitas abogado y
        más del 93% de quienes lo intentan llegan a acuerdo.
      </p>
      <ul>
        <li>
          <strong>Requisito clave:</strong> 2 o más deudas vencidas hace más de 90
          días corridos que sumen más de 80 UF en total.
        </li>
        <li>
          <strong>Resultado posible:</strong> cuota más baja, plazo más largo, tasa
          menor, meses de gracia o condonación de intereses.
        </li>
        <li>
          <strong>No aplica a:</strong> contribuyentes de primera categoría (empresas
          con actividad comercial) en los últimos 24 meses.
        </li>
        <li>
          <strong>También bloquea:</strong> haber sido notificado de un juicio ejecutivo
          o de una liquidación forzosa, y llegar sin la documentación requerida.
        </li>
      </ul>
      <p class="text-sm text-muted">
        Esta simulación es educativa. El bloque superior revisa un filtro legal
        básico y el bloque de cuota es solo una referencia financiera. La
        admisibilidad final la decide la Superir al revisar tus antecedentes.
        Para iniciar el trámite visita <a
          href="https://www.superir.gob.cl"
          target="_blank"
          rel="noopener noreferrer">superir.gob.cl</a
        >.
      </p>
      <p>
        Antes de iniciar la solicitud, revisa la <a
          href={renegociacionGuidePath}
          data-analytics-cta="calculator-guide"
          data-analytics-label="Guia de renegociacion Superir"
          data-analytics-location="calculator_explainer"
          >guía de renegociación Superir paso a paso</a
        >.
      </p>
    </section>

    <section
      class="prose prose-sm max-w-none border-t border-border pt-8 pb-12 dark:prose-invert"
    >
      <h2>¿Cómo afecta la renegociación Superir a mi DICOM?</h2>
      <p>
        La renegociación ante la Superir <strong
          >no limpia automáticamente tu historial DICOM</strong
        >. El DICOM (Equifax/TransUnion) refleja deudas impagadas que los
        acreedores reportan a los burós de información financiera; el acuerdo de
        renegociación por sí solo no borra ese registro.
      </p>
      <p>
        Una vez que el acuerdo está firmado y comienzas a pagar según las nuevas
        condiciones, tus acreedores deben actualizar tu estado en el buró. En la
        práctica, el plazo varía: algunos acredores realizan la actualización
        dentro de los 30 días siguientes al primer pago regularizado, mientras
        que otros pueden demorar más. Conviene solicitarles confirmación escrita
        una vez que el acuerdo quede vigente.
      </p>
      <p>
        La <strong>Ley 21.214 («Ley DICOM»)</strong> establece que las deudas inferiores
        a 2,5 millones de pesos que queden totalmente pagadas se eliminan del registro.
        Para deudas de mayor monto, el antecedente permanece por 5 años contados desde
        la fecha del pago total. Si quieres revisar tu situación actual, puedes <a
          href={dicomGuidePath}
          data-analytics-cta="calculator-guide"
          data-analytics-label="Guia DICOM gratis"
          data-analytics-location="calculator_explainer_dicom"
          >consultar tu DICOM gratis</a
        >.
      </p>
    </section>

    <PrimaryCTA
      text="Renegociación Superir: qué es y cómo solicitarla →"
      href="/posts/renegociacion-superir/"
      context="Requisitos, documentos y pasos para iniciar el proceso en la Superir sin abogado."
    />
    <ShareCalculatorResult />
    <MethodologyBlock
      example={debtRenegotiationWorkedExample.example}
      notes="El filtro de elegibilidad Superir verifica umbrales de deuda y documentación según la normativa CMF vigente. La cuota orientativa usa la tasa máxima convencional como referencia y no considera descuentos ni acuerdos particulares con acreedores."
      sources={[
        {
          name: "CMF Chile — Tasa máxima convencional vigente",
          url: "https://www.cmfchile.cl/portal/principal/613/w3-channel.html",
          date: "2026-03",
        },
        {
          name: "Superir — Proceso de renegociación",
          url: "https://www.cmfchile.cl/portal/principal/613/w3-channel.html",
          date: "2026-01",
        },
      ]}
    />
    <NextSteps
      currentHref="/calculadoras/simulador-renegociacion/"
      items={calculatorNextStepItems}
      title="Qué hacer con este resultado"
      description="Sigue con una herramienta relacionada o vuelve al índice si necesitas resolver otra pregunta."
      location="calculator_next_steps"
    />
  </main>
  <Footer />
</Layout>

<script>
  import { simulateDebtRenegotiation } from "@/application/use-cases/SimulateDebtRenegotiation";
  import { trackAnalyticsEvent } from "@/utils/analytics";
  import { formatCLP } from "@/utils/formatCLP";
  import {
    markResultState,
    renderInvalidResultState,
  } from "@/utils/calculatorResultState";

  declare global {
    interface Window {
      showShareResult?: (text: string) => void;
    }
  }

  function fmt(n: number) {
    return formatCLP(n);
  }

  function fmtUF(n: number) {
    return n.toFixed(2) + " UF";
  }

  function buildRow(
    label: string,
    value: string,
    colorClass = ""
  ): HTMLDivElement {
    const line = document.createElement("div");
    line.className =
      "flex items-center justify-between border-b border-border py-2 text-sm last:border-0";

    const labelElement = document.createElement("span");
    labelElement.className = "text-secondary";
    labelElement.textContent = label;

    const valueElement = document.createElement("span");
    valueElement.className = `font-mono font-semibold ${colorClass}`.trim();
    valueElement.textContent = value;

    line.append(labelElement, valueElement);
    return line;
  }

  function buildChecklistLine(
    isValid: boolean,
    text: string
  ): HTMLParagraphElement {
    const line = document.createElement("p");
    line.textContent = `${isValid ? "✓" : "✗"} ${text}`;
    line.className = isValid ? "text-green-500" : "text-red-400";
    return line;
  }

  function createDebtRow(): HTMLDivElement {
    const row = document.createElement("div");
    row.className = "deuda-row flex items-center gap-2";

    const amountInput = document.createElement("input");
    amountInput.type = "number";
    amountInput.placeholder = "Monto ($)";
    amountInput.setAttribute(
      "aria-label",
      "Monto de la deuda vencida en pesos"
    );
    amountInput.min = "0";
    amountInput.className =
      "deuda-monto flex-1 rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground focus:border-accent focus:outline-none";

    const overdueInput = document.createElement("input");
    overdueInput.type = "number";
    overdueInput.placeholder = "Días mora";
    overdueInput.setAttribute("aria-label", "Días de mora de la deuda vencida");
    overdueInput.min = "1";
    overdueInput.max = "5000";
    overdueInput.value = "91";
    overdueInput.className =
      "deuda-dias w-28 rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground focus:border-accent focus:outline-none";

    const removeButton = document.createElement("button");
    removeButton.type = "button";
    removeButton.textContent = "×";
    removeButton.setAttribute("aria-label", "Eliminar deuda");
    removeButton.className =
      "eliminar-deuda text-lg leading-none text-muted hover:text-red-400";
    removeButton.addEventListener("click", () => row.remove());

    row.append(amountInput, overdueInput, removeButton);
    return row;
  }

  // Agregar deuda
  document.getElementById("agregar-deuda")?.addEventListener("click", () => {
    const container = document.getElementById("deudas-container")!;
    container.appendChild(createDebtRow());
  });

  function showError(message: string) {
    renderInvalidResultState();
    const el = document.getElementById("calc-error");
    if (!el) return;
    el.textContent = message;
    el.classList.remove("hidden");
  }
  function hideError() {
    const el = document.getElementById("calc-error");
    if (!el) return;
    el.classList.add("hidden");
    el.textContent = "";
  }

  function setLoading(isLoading: boolean) {
    const btn = document.getElementById("calcBtn") as HTMLButtonElement;
    if (!btn) return;
    btn.disabled = isLoading;
    btn.textContent = isLoading ? "Calculando…" : "Simular renegociación →";
  }

  document.getElementById("calcBtn")?.addEventListener("click", () => {
    hideError();
    setLoading(true);
    const resultContainer = document.getElementById("resultado-contenido");
    const guideUrl = resultContainer?.dataset?.guideUrl;
    const ufValue = Number(resultContainer?.dataset?.uf);
    if (!guideUrl || !Number.isFinite(ufValue) || ufValue <= 0) return;

    const filas = document.querySelectorAll(".deuda-row");
    const deudas: { monto: number; dias: number }[] = [];

    filas.forEach(fila => {
      const monto =
        parseFloat(
          (fila.querySelector(".deuda-monto") as HTMLInputElement).value
        ) || 0;
      const dias =
        parseInt(
          (fila.querySelector(".deuda-dias") as HTMLInputElement).value
        ) || 0;
      if (monto > 0) deudas.push({ monto, dias });
    });

    const ingreso =
      parseFloat(
        (document.getElementById("ingreso") as HTMLInputElement).value
      ) || 0;
    const plazo =
      parseInt(
        (document.getElementById("plazo-renego") as HTMLInputElement).value
      ) || 36;
    const tasaMensual =
      parseFloat(
        (document.getElementById("tasa-renego") as HTMLInputElement).value
      ) / 100;
    const primeraCategoria = (
      document.getElementById("primera-categoria") as HTMLSelectElement
    ).value;
    const juicioEjecutivo = (
      document.getElementById("juicio-ejecutivo") as HTMLSelectElement
    ).value;
    const documentosCompletos = (
      document.getElementById("documentos-completos") as HTMLSelectElement
    ).value;

    if (
      deudas.length === 0 ||
      ingreso <= 0 ||
      !primeraCategoria ||
      !juicioEjecutivo ||
      !documentosCompletos
    ) {
      showError(
        "Completa al menos una deuda, tu ingreso y las preguntas legales antes de simular."
      );
      setLoading(false);
      return;
    }

    let simulacion;
    try {
      simulacion = simulateDebtRenegotiation({
        debts: deudas.map(deuda => ({
          amount: deuda.monto,
          overdueDays: deuda.dias,
        })),
        monthlyIncome: ingreso,
        termMonths: plazo,
        monthlyRatePercent: tasaMensual * 100,
        ufValue,
        hasFirstCategoryActivityLast24Months: primeraCategoria === "si",
        hasNotifiedExecutiveProceeding: juicioEjecutivo === "si",
        hasRequiredDocuments: documentosCompletos === "si",
      });
    } catch (error) {
      showError(
        error instanceof Error
          ? error.message
          : "No se pudo simular la renegociación."
      );
      setLoading(false);
      return;
    }

    setLoading(false);
    const container = document.getElementById("resultado-contenido")!;

    const statusBox = document.createElement("div");
    statusBox.className = `mb-5 rounded-lg border p-4 ${
      simulacion.canSubmitApplication
        ? "border-green-500/30 bg-green-500/5"
        : simulacion.meetsBasicEligibility
          ? "border-yellow-500/30 bg-yellow-500/10"
          : "border-red-500/30 bg-red-500/10"
    }`;

    const statusTitle = document.createElement("p");
    statusTitle.className = `mb-3 text-base font-bold ${
      simulacion.canSubmitApplication
        ? "text-green-500"
        : simulacion.meetsBasicEligibility
          ? "text-yellow-500"
          : "text-red-400"
    }`;
    statusTitle.textContent = simulacion.canSubmitApplication
      ? "✓ Cumples el filtro básico y podrías preparar la solicitud"
      : simulacion.meetsBasicEligibility
        ? "Cumples el filtro básico, pero aún no estás listo para calificar formalmente"
        : "✗ No cumples el filtro básico de elegibilidad";

    const checklist = document.createElement("div");
    checklist.className = "space-y-1.5 text-sm";
    checklist.append(
      buildChecklistLine(
        simulacion.requirementChecks.hasTwoOrMoreDebts,
        `2 o más deudas distintas: ${deudas.length} ingresada${deudas.length > 1 ? "s" : ""}`
      ),
      buildChecklistLine(
        simulacion.requirementChecks.hasTwoOrMoreQualifiedDebts,
        `Con más de 90 días corridos: ${simulacion.qualifiedDebtCount} califican`
      ),
      buildChecklistLine(
        simulacion.requirementChecks.reachesMinimumUf,
        `Total supera ${simulacion.minimumDebtUf} UF: ${fmtUF(simulacion.qualifiedDebtUf)} (mín. ${simulacion.minimumDebtUf} UF = ${fmt(simulacion.minimumDebtUf * ufValue)})`
      ),
      buildChecklistLine(
        simulacion.requirementChecks.hasNoFirstCategoryActivity,
        "Sin actividad de primera categoría en los últimos 24 meses"
      ),
      buildChecklistLine(
        simulacion.requirementChecks.hasNoNotifiedExecutiveProceeding,
        "Sin juicio ejecutivo ni liquidación forzosa notificada"
      ),
      buildChecklistLine(
        simulacion.requirementChecks.hasRequiredDocuments,
        "Documentos y declaraciones listos para presentar la solicitud"
      )
    );
    const statusNote = document.createElement("p");
    statusNote.className = "mt-3 text-xs text-secondary";
    statusNote.textContent = simulacion.canSubmitApplication
      ? "Esto no garantiza admisión automática: la revisión formal final depende de la Superir y de tus respaldos."
      : simulacion.meetsBasicEligibility
        ? "Tu caso podría ser renegociable, pero todavía no equivale a 'calificas formalmente'. Te faltan antecedentes para presentar la solicitud."
        : "La cuota de abajo sigue siendo solo una simulación financiera orientativa. No corrige exclusiones legales ni reemplaza asesoría.";
    statusBox.append(statusTitle, checklist, statusNote);

    const burdenColorClass =
      simulacion.incomeBurdenPercent <= 30
        ? "text-green-500"
        : simulacion.incomeBurdenPercent <= 50
          ? "text-yellow-500"
          : "text-red-400";

    const simulationSection = document.createElement("div");
    simulationSection.className = "mt-5";
    const simulationLabel = document.createElement("p");
    simulationLabel.className = "mb-2 text-xs font-bold text-muted uppercase";
    simulationLabel.textContent = `Simulación financiera orientativa — ${plazo} meses`;
    simulationSection.append(
      simulationLabel,
      buildRow(
        "Cuota mensual estimada",
        fmt(simulacion.monthlyPayment),
        burdenColorClass
      ),
      buildRow(
        "Como % de tu ingreso",
        `${simulacion.incomeBurdenPercent.toFixed(1)}%`,
        burdenColorClass
      ),
      buildRow("Total a pagar", fmt(simulacion.totalPaid)),
      buildRow("Intereses del acuerdo", fmt(simulacion.totalInterest))
    );

    const advisory = document.createElement("div");
    advisory.className =
      "mt-3 rounded-lg bg-foreground/5 p-3 text-xs text-secondary";
    advisory.textContent =
      simulacion.incomeBurdenPercent <= 30
        ? "La cuota simulada es manejable (≤30% de tu ingreso). Úsala como punto de partida para armar tu propuesta, no como aprobación legal."
        : simulacion.incomeBurdenPercent <= 50
          ? "La cuota es alta (30–50% del ingreso). Considera extender el plazo o negociar intereses antes de presentar una propuesta."
          : "La cuota supera el 50% de tu ingreso. Antes de pensar en admisibilidad, revisa si tu propuesta es realmente pagable o si necesitas otra salida.";

    const guideLink = document.createElement("a");
    guideLink.href = guideUrl;
    guideLink.className =
      "mt-4 block text-center text-xs text-accent hover:underline";
    guideLink.dataset.analyticsCta = "calculator-guide";
    guideLink.dataset.analyticsLabel = "Guia de renegociacion Superir";
    guideLink.dataset.analyticsLocation = "calculator_result";
    guideLink.textContent = "→ Leer guía completa de la renegociación Superir";

    container.replaceChildren(
      statusBox,
      buildRow("Total deuda declarada", fmt(simulacion.totalDebtClp)),
      buildRow("En UF", fmtUF(simulacion.totalDebtUf)),
      simulationSection,
      advisory,
      guideLink
    );
    markResultState(container, "result");

    // Comparison table — same debt/income/rate, different terms
    const compTerms = (() => {
      const base = [24, 36, 60];
      if (base.includes(plazo)) return base;
      const all = [...new Set([...base, plazo])].sort((a, b) => a - b);
      const pi = all.indexOf(plazo);
      if (pi === 0) return all.slice(0, 3);
      if (pi === all.length - 1) return all.slice(-3);
      return [all[pi - 1], plazo, all[pi + 1]] as number[];
    })();

    const compRows: {
      term: number;
      sim: ReturnType<typeof simulateDebtRenegotiation>;
    }[] = [];
    for (const term of compTerms) {
      try {
        compRows.push({
          term,
          sim: simulateDebtRenegotiation({
            debts: deudas.map(deuda => ({
              amount: deuda.monto,
              overdueDays: deuda.dias,
            })),
            monthlyIncome: ingreso,
            termMonths: term,
            monthlyRatePercent: tasaMensual * 100,
            ufValue,
            hasFirstCategoryActivityLast24Months: primeraCategoria === "si",
            hasNotifiedExecutiveProceeding: juicioEjecutivo === "si",
            hasRequiredDocuments: documentosCompletos === "si",
          }),
        });
      } catch {
        // skip term if simulation fails
      }
    }

    const compSection = document.getElementById("comparacion-plazos")!;
    if (compRows.length > 0) {
      const compHeading = document.createElement("h2");
      compHeading.className = "mb-1 text-base font-bold";
      compHeading.textContent = "Compara plazos";

      const compSubtitle = document.createElement("p");
      compSubtitle.className = "mb-4 text-sm text-secondary";
      compSubtitle.textContent = "Misma deuda y tasa, distinto plazo.";

      const tableWrapper = document.createElement("div");
      tableWrapper.className = "overflow-x-auto";

      const table = document.createElement("table");
      table.className = "w-full min-w-[480px] text-sm border-collapse";

      const thead = document.createElement("thead");
      const headerRow = document.createElement("tr");
      headerRow.className = "border-b border-border";
      for (const h of [
        "Plazo",
        "Cuota mensual",
        "% del ingreso",
        "Total intereses",
        "Total a pagar",
      ]) {
        const th = document.createElement("th");
        th.className =
          "py-2 px-3 text-left text-xs font-bold text-secondary uppercase tracking-wide";
        th.textContent = h;
        headerRow.appendChild(th);
      }
      thead.appendChild(headerRow);
      table.appendChild(thead);

      const tbody = document.createElement("tbody");
      for (const { term, sim } of compRows) {
        const isSelected = term === plazo;
        const burdenColor =
          sim.incomeBurdenPercent <= 30
            ? "text-green-500"
            : sim.incomeBurdenPercent <= 50
              ? "text-yellow-500"
              : "text-red-400";

        const tr = document.createElement("tr");
        tr.className = `border-b border-border last:border-0${isSelected ? " bg-accent/10" : ""}`;

        const termTd = document.createElement("td");
        termTd.className = "py-2 px-3 whitespace-nowrap font-semibold";
        termTd.textContent = `${term} meses`;
        if (isSelected) {
          const badge = document.createElement("span");
          badge.className =
            "ml-1.5 rounded-full bg-accent px-1.5 py-0.5 text-[10px] font-bold text-background";
          badge.textContent = "tu elección";
          termTd.appendChild(badge);
        }

        const cuotaTd = document.createElement("td");
        cuotaTd.className = "py-2 px-3 font-mono";
        cuotaTd.textContent = fmt(sim.monthlyPayment);

        const burdenTd = document.createElement("td");
        burdenTd.className = `py-2 px-3 font-mono ${burdenColor}`;
        burdenTd.textContent = `${sim.incomeBurdenPercent.toFixed(1)}%`;

        const interestTd = document.createElement("td");
        interestTd.className = "py-2 px-3 font-mono";
        interestTd.textContent = fmt(sim.totalInterest);

        const totalTd = document.createElement("td");
        totalTd.className = "py-2 px-3 font-mono";
        totalTd.textContent = fmt(sim.totalPaid);

        tr.append(termTd, cuotaTd, burdenTd, interestTd, totalTd);
        tbody.appendChild(tr);
      }
      table.appendChild(tbody);
      tableWrapper.appendChild(table);
      compSection.replaceChildren(compHeading, compSubtitle, tableWrapper);
      compSection.removeAttribute("hidden");
    }

    document.dispatchEvent(
      new CustomEvent("calculator:result", {
        detail: {
          summaryText: `Renegociación Superir: cuota ${fmt(simulacion.monthlyPayment)}/mes, deuda ${fmt(simulacion.totalDebtClp)}`,
        },
      })
    );
    trackAnalyticsEvent("calculator_complete", {
      calculator_slug: "simulador-renegociacion",
      calculator_name: "Simulador de Renegociacion Superir",
      outcome: simulacion.canSubmitApplication
        ? "basic-filter-pass"
        : simulacion.meetsBasicEligibility
          ? "missing-documents"
          : "basic-filter-fail",
    });
  });
</script>
