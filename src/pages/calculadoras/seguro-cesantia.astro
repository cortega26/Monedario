---
import Layout from "@/layouts/Layout.astro";
import CalculatorHero from "@/components/calculator/CalculatorHero.astro";
import CalculatorField from "@/components/calculator/CalculatorField.astro";
import CalculatorResultPanel from "@/components/calculator/CalculatorResultPanel.astro";
import Header from "@/components/Header.astro";
import CalculatorJsonLd from "@/components/CalculatorJsonLd.astro";
import Footer from "@/components/Footer.astro";
import MethodologyBlock from "@/components/MethodologyBlock.astro";
import { unemploymentCoverageWorkedExample } from "@/application/use-cases/EstimateUnemploymentCoverage.methodology";
import PrimaryCTA from "@/components/PrimaryCTA.astro";
import ShareCalculatorResult from "@/components/ShareCalculatorResult.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CalculatorTrustBadge from "@/components/CalculatorTrustBadge.astro";
import NextSteps from "@/components/NextSteps.astro";
import { CALCULATOR_PORTFOLIO } from "@/config/calculatorPortfolio";
import { getEconomicParameters } from "@/application/use-cases/GetEconomicParameters";
import { getPath } from "@/utils/getPath";
import { estimateUnemploymentCoverage } from "@/application/use-cases/EstimateUnemploymentCoverage";
import CalculatorDataFreshness from "@/components/calculator/CalculatorDataFreshness.astro";
import { formatEconomicDate } from "@/domain/economic/economicSourcePresentation";

const { parameters: economicParameters } = await getEconomicParameters();
const fmtClp = (n: number) => "$" + Math.round(n).toLocaleString("es-CL");
const exampleResult = estimateUnemploymentCoverage({
  grossSalary: 800_000,
  contractType: "indefinido",
  terminationCause: "necesidad",
  monthsContributed: 24,
  economicParameters,
});
const unemploymentGuidePath = getPath("/posts/seguro-de-cesantia/");
const currentCalculator = CALCULATOR_PORTFOLIO.find(
  calc => calc.slug === "seguro-cesantia"
);
const calculatorRelatedItems = (currentCalculator?.related ?? []).map(item => ({
  href: item.href,
  title: item.label,
  description: item.when,
  label: "Relacionado",
}));
const calculatorNextStepItems = [
  ...calculatorRelatedItems,
  ...(calculatorRelatedItems.length < 2
    ? [
        {
          href: "/calculadoras/",
          title: "Ver todas las calculadoras",
          description: "Compara otra herramienta si tu pregunta cambió.",
          label: "Herramientas",
        },
      ]
    : []),
];

const seguroCesantiaFaqs = [
  {
    question: "¿Cómo calculo cuánto me va a pagar el seguro de cesantía?",
    answer:
      "Esta calculadora estima tu cobertura en dos partes. Primero revisa tu Cuenta Individual de Cesantía (CIC): según tu sueldo, tipo de contrato y meses cotizados, calcula cuánto tienes acumulado y cuántos meses te cubriría. Luego revisa si cumples el filtro base para acceder al Fondo de Cesantía Solidario (FCS), pero los montos exactos del FCS los entrega la AFC según su tabla vigente.",
  },
  {
    question: "¿El simulador de seguro de cesantía incluye el Fondo Solidario?",
    answer:
      "Verifica si cumples los requisitos mínimos legales para acceder al Fondo de Cesantía Solidario (causal válida, mínimo 10 cotizaciones en 24 meses y las 3 últimas continuas con el mismo empleador), pero no te da un monto exacto del FCS. Los montos del Fondo Solidario los fija y publica la AFC — debes consultar la tabla oficial vigente en afc.cl.",
  },
  {
    question:
      "¿Qué pasa si no tengo saldo suficiente en mi Cuenta Individual de Cesantía?",
    answer:
      "Si tu saldo CIC no alcanza para cubrir los meses que te corresponden, la calculadora revisa si cumples el filtro base del Fondo Solidario. Si lo cumples, el FCS puede complementar tus pagos. Si no lo cumples, recibirás solo los pagos que alcance tu CIC y se agotará cuando el saldo llegue a cero.",
  },
  {
    question: "¿Necesito mi saldo real de CIC para usar esta calculadora?",
    answer:
      "No es obligatorio, pero sí recomendado. La calculadora te da dos opciones: usar tu saldo real de CIC (que puedes consultar en afc.cl con tu ClaveÚnica) o estimarlo a partir de tus cotizaciones mensuales. La estimación no incluye rentabilidad del fondo ni retiros previos, así que si ya tienes varios años cotizando, el saldo real puede ser distinto al estimado.",
  },
];
---

<Layout
  title="Calculadora de Seguro de Cesantía | CIC y Fondo Solidario"
  description="Estima tu cobertura del seguro de cesantía en Chile según sueldo, cotizaciones, causal y saldo CIC."
>
  <CalculatorJsonLd
    name="Calculadora de Seguro de Cesantía | CIC y Fondo Solidario"
    description="Estima tu cobertura del seguro de cesantía en Chile según sueldo, cotizaciones, causal y saldo CIC."
    faqs={seguroCesantiaFaqs}
    dateModified="2026-06-01"
  />
  <Header />
  <Breadcrumb />
  <CalculatorTrustBadge location="calculator_header" />
  <main
    data-layout="calculator"
    id="main-content"
    class="app-layout"
    data-analytics-page-type="calculator"
    data-analytics-calculator="seguro-cesantia"
    data-analytics-calculator-name="Calculadora de Seguro de Cesantia"
  >
    <CalculatorHero
      title="Calculadora de Seguro de Cesantía"
      description="Separa el filtro base de elegibilidad del cobro estimado de tu CIC, sin presentar como exactos los montos que dependen de AFC."
      descriptionClass="max-w-xl text-secondary"
    />

    <section class="grid items-start gap-6 py-8 sm:grid-cols-2">
      <!-- FORMULARIO -->
      <div class="rounded-xl border border-border p-6">
        <h2 class="mb-5 text-lg font-semibold">Tus datos</h2>

        <CalculatorField
          id="sueldo"
          label="Sueldo bruto mensual ($)"
          placeholder="Ej: 1.200.000"
          min="0"
        />

        <div class="mb-4">
          <label class="mb-2 block text-sm font-medium text-secondary"
            >Tipo de contrato</label
          >
          <div class="flex gap-2">
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="contrato"
                value="indefinido"
                checked
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-2 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                Indefinido
              </span>
            </label>
            <label class="flex-1 cursor-pointer">
              <input
                type="radio"
                name="contrato"
                value="plazo-fijo"
                class="peer sr-only"
              />
              <span
                class="block rounded-lg border border-border px-3 py-2 text-center text-sm font-medium transition-all peer-checked:border-accent peer-checked:text-accent"
              >
                Plazo fijo / obra
              </span>
            </label>
          </div>
        </div>

        <CalculatorField
          id="meses-cotizados"
          label="Meses cotizados en este trabajo"
          placeholder="Ej: 24"
          min="1"
          max="600"
          value="24"
          hint="Meses desde que ingresaste o desde el último cobro del seguro."
        />

        <div class="mb-4">
          <label class="mb-2 block text-sm font-medium text-secondary"
            >Modo de cálculo CIC</label
          >
          <div class="grid gap-2">
            <label class="cursor-pointer rounded-lg border border-border p-3">
              <input
                type="radio"
                name="saldo-mode"
                value="provided"
                checked
                class="peer sr-only"
              />
              <span
                class="block text-sm font-medium transition-all peer-checked:text-accent"
              >
                Usaré mi saldo real en AFC
              </span>
              <span class="mt-1 block text-xs text-muted">
                Recomendado si ya revisaste tu Cuenta Individual de Cesantía.
              </span>
            </label>
            <label class="cursor-pointer rounded-lg border border-border p-3">
              <input
                type="radio"
                name="saldo-mode"
                value="estimated"
                class="peer sr-only"
              />
              <span
                class="block text-sm font-medium transition-all peer-checked:text-accent"
              >
                Estimaré mi CIC por cotizaciones
              </span>
              <span class="mt-1 block text-xs text-muted">
                Usa solo aportes a la CIC. No incorpora rentabilidad, retiros
                previos ni comisiones AFC.
              </span>
            </label>
          </div>
        </div>

        <CalculatorField
          id="saldo-actual"
          label="Saldo actual en CIC ($)"
          placeholder="Ej: 450.000"
          min="0"
          hint="Si eliges saldo real, este dato es obligatorio. Puedes verlo en tu cartola o sesión de AFC."
        />

        <CalculatorField id="causal" label="Causal de término">
          <select
            id="causal"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          >
            <option value="necesidad">Necesidad de la empresa (art. 161)</option
            >
            <option value="vencimiento"
              >Vencimiento de plazo / conclusión de obra</option
            >
            <option value="liquidacion"
              >Procedimiento concursal / liquidación del empleador</option
            >
            <option value="renuncia">Renuncia voluntaria</option>
            <option value="despido-culpa"
              >Despido por conducta (art. 160)</option
            >
          </select>
        </CalculatorField>

        <CalculatorField
          id="continuidad"
          label="¿Tus 3 últimas cotizaciones fueron continuas con el mismo empleador?"
          hint="Este dato ayuda a revisar el filtro base del Fondo Solidario."
        >
          <select
            id="continuidad"
            class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground focus:border-accent focus:outline-none"
          >
            <option value="si">Sí</option>
            <option value="no-se" selected>No lo sé</option>
            <option value="no">No</option>
          </select>
        </CalculatorField>

        <button
          id="calcBtn"
          class="mt-2 w-full rounded-lg bg-accent px-4 py-3 text-base font-bold text-background transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Calcular cesantía →
        </button>
        <div
          id="cesantia-error"
          class="mt-3 hidden rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-sm text-red-500"
          role="alert"
        >
        </div>
      </div>

      <!-- RESULTADO -->
      <CalculatorResultPanel title="Tu cobertura estimada">
        <div id="resultado-contenido" data-is-example="true" aria-live="polite">
          <div
            class="mb-5 rounded-lg border border-border bg-surface-muted/40 p-4 text-center"
          >
            <p
              class="mb-1 text-xs font-bold tracking-widest text-muted uppercase"
            >
              Cobertura total estimada (Ejemplo)
            </p>
            <p class="text-4xl font-bold text-foreground/80">
              {fmtClp(exampleResult.totalCoverage)}
            </p>
          </div>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-secondary">Primer pago</span>
              <span class="font-medium text-foreground/80">
                {fmtClp(exampleResult.payouts[0] ?? 0)}
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Meses cubiertos</span>
              <span class="font-medium text-foreground/80">
                {exampleResult.monthsCovered} meses
              </span>
            </div>
          </div>
          <p class="mt-4 text-xs text-muted">
            Ejemplo: contrato indefinido, sueldo $800.000, 24 cotizaciones,
            despido por necesidad de la empresa.
          </p>
        </div>
        <div
          id="economic-parameters"
          data-uf={String(economicParameters.uf)}
          data-afc-monthly-taxable-cap-uf={String(
            economicParameters.afcTopes?.monthlyTaxableCapUf ?? 131.9
          )}
          class="hidden"
          aria-hidden="true"
        >
        </div>
        <CalculatorDataFreshness
          source={economicParameters.source}
          updatedDate={formatEconomicDate(economicParameters.lastUpdated)}
        />
      </CalculatorResultPanel>
    </section>

    <section
      class="prose prose-sm max-w-none border-t border-border pt-8 pb-12 dark:prose-invert"
    >
      <h2>¿Cómo funciona el Seguro de Cesantía?</h2>
      <p>
        El Seguro de Cesantía tiene dos fondos: tu <strong
          >Cuenta Individual (CIC)</strong
        >, que es solo tuya, y el <strong>Fondo Solidario (FCS)</strong>, que es
        compartido. Siempre se usa primero la CIC; el FCS solo entra si tu saldo
        individual es insuficiente y cumples los requisitos.
      </p>
      <ul>
        <li>
          <strong>Contrato indefinido:</strong> 0,6% lo aporta la persona trabajadora,
          1,6% va a tu CIC y 0,8% al Fondo Solidario.
        </li>
        <li>
          <strong>Plazo fijo / obra:</strong> el empleador aporta 2,8% a tu CIC y
          0,2% al Fondo Solidario.
        </li>
        <li>
          <strong>Mínimo para cobrar CIC:</strong> desde el 1 de agosto de 2025 se
          exigen 10 cotizaciones para indefinido y 5 para plazo fijo/obra.
        </li>
        <li>
          <strong>Para revisar FCS:</strong> se requiere causal válida, 10 cotizaciones
          en los últimos 24 meses y las 3 últimas continuas con el mismo empleador.
        </li>
      </ul>
      <p class="text-sm text-muted">
        Esta calculadora no reemplaza la liquidación oficial de AFC. El saldo
        exacto de tu CIC está en <a
          href="https://www.afc.cl"
          target="_blank"
          rel="noopener noreferrer">afc.cl</a
        > con tu ClaveÚnica y los montos del FCS se revisan en la tabla vigente de
        AFC.
      </p>
      <p>
        Para revisar requisitos legales y causales en detalle, lee la <a
          href={unemploymentGuidePath}
          data-analytics-cta="calculator-guide"
          data-analytics-label="Guia completa del seguro de cesantia"
          data-analytics-location="calculator_explainer"
          >guía completa del seguro de cesantía</a
        >.
      </p>
    </section>

    <PrimaryCTA
      text="Guía completa del seguro de cesantía →"
      href="/posts/seguro-de-cesantia/"
      context="Cómo cotizar, cobrar y qué pasa si el Fondo Solidario no alcanza."
    />
    <ShareCalculatorResult />
    <section class="border-t border-border pt-8 pb-4">
      <h2 class="mb-6 text-xl font-semibold">
        Preguntas frecuentes sobre el seguro de cesantía
      </h2>
      <dl class="space-y-6">
        {
          seguroCesantiaFaqs.map(faq => (
            <div>
              <dt class="mb-1 font-medium text-foreground">{faq.question}</dt>
              <dd class="text-sm leading-relaxed text-secondary">
                {faq.answer}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
    <MethodologyBlock
      example={unemploymentCoverageWorkedExample.example}
      notes="Las tasas de cotización y los porcentajes de cobertura CIC se calculan según la normativa vigente de la AFC Chile. Los porcentajes de la Cuenta Individual de Cesantía (CIC) son referenciales; el monto real depende del saldo acumulado. El Fondo Solidario aplica criterios adicionales de elegibilidad."
      sources={[
        {
          name: "Superintendencia de Pensiones — Fondo de Cesantía Solidario y montos vigentes",
          url: "https://www.spensiones.cl/portal/institucional/594/w3-propertyvalue-9925.html",
          date: "2026-05",
        },
        {
          name: "Dirección del Trabajo — Seguro de cesantía",
          url: "https://www.dt.gob.cl/portal/1626/w3-channel.html",
          date: "2026-01",
        },
      ]}
    />
    <NextSteps
      currentHref="/calculadoras/seguro-cesantia/"
      items={calculatorNextStepItems}
      title="Qué hacer con este resultado"
      description="Sigue con una herramienta relacionada o vuelve al índice si necesitas resolver otra pregunta."
      location="calculator_next_steps"
    />
  </main>
  <Footer />
</Layout>

<script>
  import { estimateUnemploymentCoverage } from "@/application/use-cases/EstimateUnemploymentCoverage";
  import { animateCount } from "@/utils/animateCount";
  import { trackAnalyticsEvent } from "@/utils/analytics";
  import { renderHeadlineDelta } from "@/utils/calculatorDelta";

  declare global {
    interface Window {
      showShareResult?: (text: string) => void;
    }
  }

  const currencyFormatter = new Intl.NumberFormat("es-CL", {
    style: "currency",
    currency: "CLP",
    maximumFractionDigits: 0,
  });

  function fmtCurrency(n: number): string {
    return currencyFormatter.format(Math.round(n));
  }

  function animatedCurrency(value: number): HTMLSpanElement {
    const target = Math.round(value);
    const span = document.createElement("span");
    span.dataset.animate = "true";
    span.dataset.target = String(target);
    span.textContent = fmtCurrency(target);
    return span;
  }

  function row(
    label: string,
    value: string | Node,
    colorClass = ""
  ): HTMLDivElement {
    const line = document.createElement("div");
    line.className =
      "flex items-center justify-between border-b border-border py-2 text-sm last:border-0";

    const labelElement = document.createElement("span");
    labelElement.className = "text-secondary";
    labelElement.textContent = label;

    const valueElement = document.createElement("span");
    valueElement.className = `font-mono font-semibold ${colorClass}`.trim();
    if (typeof value === "string") {
      valueElement.textContent = value;
    } else {
      valueElement.appendChild(value);
    }

    line.append(labelElement, valueElement);
    return line;
  }

  function badge(texto: string, colorClass: string): HTMLSpanElement {
    const badgeElement = document.createElement("span");
    badgeElement.className = `inline-block rounded-full px-2 py-0.5 text-xs font-bold ${colorClass}`;
    badgeElement.textContent = texto;
    return badgeElement;
  }

  function showInlineError(message: string) {
    const errorBox = document.getElementById("cesantia-error");
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.remove("hidden");
  }

  function clearInlineError() {
    const errorBox = document.getElementById("cesantia-error");
    if (!errorBox) return;
    errorBox.textContent = "";
    errorBox.classList.add("hidden");
  }

  function readEconomicParameters(): {
    uf: number;
    afcMonthlyTaxableCapUf: number;
  } {
    const element = document.getElementById("economic-parameters");
    const uf = Number(element?.dataset?.uf);
    const afcMonthlyTaxableCapUf = Number(
      element?.dataset?.afcMonthlyTaxableCapUf
    );

    if (
      !Number.isFinite(uf) ||
      uf <= 0 ||
      !Number.isFinite(afcMonthlyTaxableCapUf) ||
      afcMonthlyTaxableCapUf <= 0
    ) {
      throw new Error("No se pudieron cargar los parámetros económicos AFC.");
    }

    return { uf, afcMonthlyTaxableCapUf };
  }

  const economicParameters = readEconomicParameters();

  function animateResultValues() {
    const container = document.getElementById("resultado-contenido");
    if (!container) return;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    container.querySelectorAll("[data-animate='true']").forEach(element => {
      const htmlElement = element as HTMLElement;
      const target = Number(htmlElement.dataset.target ?? "0");

      if (reduceMotion) {
        htmlElement.textContent = fmtCurrency(target);
        return;
      }

      htmlElement.textContent = fmtCurrency(0);
      animateCount(htmlElement, target, 800, n => fmtCurrency(n));
    });
  }

  document.getElementById("calcBtn")?.addEventListener("click", () => {
    clearInlineError();
    const sueldo =
      parseFloat(
        (document.getElementById("sueldo") as HTMLInputElement).value
      ) || 0;
    const mesesCotizados =
      parseInt(
        (document.getElementById("meses-cotizados") as HTMLInputElement).value
      ) || 0;
    const saldoIngresado =
      parseFloat(
        (document.getElementById("saldo-actual") as HTMLInputElement).value
      ) || 0;
    const contrato = (
      document.querySelector(
        "input[name='contrato']:checked"
      ) as HTMLInputElement
    )?.value;
    const balanceMode = (
      document.querySelector(
        "input[name='saldo-mode']:checked"
      ) as HTMLInputElement
    )?.value;
    const causal = (document.getElementById("causal") as HTMLSelectElement)
      .value;
    const continuidad = (
      document.getElementById("continuidad") as HTMLSelectElement
    ).value;

    if (sueldo <= 0) {
      showInlineError("Ingresa tu sueldo bruto mensual antes de calcular.");
      return;
    }

    if (balanceMode === "provided" && saldoIngresado <= 0) {
      showInlineError(
        "Si eliges saldo real, ingresa el monto de tu CIC según AFC."
      );
      return;
    }

    let estimacion;
    try {
      estimacion = estimateUnemploymentCoverage({
        grossSalary: sueldo,
        contractType: contrato as "indefinido" | "plazo-fijo",
        terminationCause: causal as
          | "necesidad"
          | "vencimiento"
          | "liquidacion"
          | "renuncia"
          | "despido-culpa",
        monthsContributed: mesesCotizados,
        currentCicBalance:
          balanceMode === "provided" && saldoIngresado > 0
            ? saldoIngresado
            : undefined,
        lastThreeContinuousContributions:
          continuidad === "si"
            ? true
            : continuidad === "no"
              ? false
              : undefined,
        economicParameters: {
          uf: economicParameters.uf,
          afcTopes: {
            monthlyTaxableCapUf: economicParameters.afcMonthlyTaxableCapUf,
          },
        },
      });
    } catch (error) {
      showInlineError(
        error instanceof Error
          ? error.message
          : "No se pudo calcular el seguro de cesantía."
      );
      return;
    }

    if (!estimacion.meetsMinimumContributions) {
      const warning = document.createElement("div");
      warning.className =
        "rounded-lg border border-red-500/30 bg-red-500/10 p-4 text-sm";

      const title = document.createElement("p");
      title.className = "mb-1 font-bold text-red-400";
      title.textContent = "No cumples el mínimo aún";

      const message = document.createElement("p");
      message.className = "text-secondary";
      const strong = document.createElement("strong");
      strong.textContent = `${estimacion.minimumContributionsRequired} cotizaciones`;
      message.append(
        "Necesitas al menos ",
        strong,
        ` para cobrar. Llevas ${mesesCotizados}.`
      );

      const missing = document.createElement("p");
      missing.className = "mt-2 text-secondary";
      const remaining =
        estimacion.minimumContributionsRequired - mesesCotizados;
      missing.textContent = `Te faltan ${remaining} ${remaining === 1 ? "mes" : "meses"}.`;

      warning.append(title, message, missing);
      document.getElementById("resultado-contenido")!.replaceChildren(warning);
      trackAnalyticsEvent("calculator_complete", {
        calculator_slug: "seguro-cesantia",
        calculator_name: "Calculadora de Seguro de Cesantia",
        outcome: "minimum-not-met",
      });
    } else {
      const header = document.createElement("div");
      header.className =
        "mb-5 rounded-lg border border-accent/20 bg-accent/10 p-4 text-center";
      const headerTitle = document.createElement("p");
      headerTitle.className =
        "mb-1 text-xs font-bold tracking-widest text-accent uppercase";
      headerTitle.textContent =
        estimacion.balanceSource === "provided"
          ? "Saldo CIC informado"
          : "Saldo CIC estimado";
      const headerValue = document.createElement("p");
      headerValue.className = "text-4xl font-bold";
      headerValue.appendChild(animatedCurrency(estimacion.estimatedCicBalance));
      const headerSubtitle = document.createElement("p");
      headerSubtitle.className = "mt-1 text-xs text-muted";
      headerSubtitle.textContent =
        estimacion.balanceSource === "provided"
          ? "Cobertura calculada con tu saldo CIC real"
          : "Estimación por cotizaciones a CIC; no incluye rentabilidad ni retiros previos";
      header.append(headerTitle, headerValue, headerSubtitle);

      const delta = renderHeadlineDelta(
        window.location.pathname,
        estimacion.estimatedCicBalance,
        fmtCurrency
      );
      if (delta) header.append(delta);

      const contributionBox = document.createElement("div");
      contributionBox.className = "mb-4 rounded-lg bg-foreground/5 p-3";
      const contributionLabel = document.createElement("p");
      contributionLabel.className =
        "mb-2 text-xs font-bold text-muted uppercase";
      contributionLabel.textContent = "Cómo se armó la CIC";
      contributionBox.append(
        contributionLabel,
        row(
          "Aporte mensual a CIC",
          animatedCurrency(estimacion.monthlyCicContribution)
        ),
        row(
          "Tasa que va a CIC",
          `${estimacion.cicContributionRatePercent.toFixed(1)}% del imponible`
        ),
        row(
          "Aporte mensual al Fondo Solidario",
          animatedCurrency(estimacion.monthlySolidarityContribution)
        )
      );

      const payoutsLabel = document.createElement("p");
      payoutsLabel.className = "mb-2 text-xs font-bold text-muted uppercase";
      payoutsLabel.textContent =
        estimacion.balanceSource === "provided"
          ? "Pagos máximos estimados desde tu CIC"
          : "Pagos orientativos desde la CIC estimada";

      const payoutRows = estimacion.payouts.map(
        (payout: number, index: number) => {
          if (payout > 0) {
            return row(
              `Mes ${index + 1} (${(estimacion.payoutRates[index] * 100).toFixed(0)}% del sueldo)`,
              animatedCurrency(payout),
              index === 0 ? "text-accent" : ""
            );
          }

          return row(`Mes ${index + 1}`, "Sin saldo", "text-muted");
        }
      );

      const totalCoverage = document.createElement("div");
      totalCoverage.className =
        "mt-4 flex justify-between border-t border-border pt-3 text-sm font-semibold";
      const totalCoverageLabel = document.createElement("span");
      totalCoverageLabel.textContent = "Total cobertura CIC";
      const totalCoverageValue = document.createElement("span");
      totalCoverageValue.append(
        animatedCurrency(estimacion.totalCoverage),
        ` · ${estimacion.monthsCovered} ${estimacion.monthsCovered === 1 ? "mes" : "meses"}`
      );
      totalCoverage.append(totalCoverageLabel, totalCoverageValue);

      const solidarityBox = document.createElement("div");
      solidarityBox.className = `mt-4 rounded-lg border p-3 text-sm ${
        estimacion.eligibleForSolidarityFund
          ? "border-green-500/30 bg-green-500/5"
          : "border-foreground/10 bg-foreground/5"
      }`;
      const solidarityHeader = document.createElement("p");
      solidarityHeader.className = "mb-1 font-bold";
      solidarityHeader.append(
        "Filtro base del Fondo Solidario (FCS) ",
        badge(
          estimacion.eligibleForSolidarityFund
            ? "Cumple mínimo"
            : estimacion.solidarityFundStatus === "requires-continuity-check"
              ? "Revisar continuidad"
              : "No cumple mínimo",
          estimacion.eligibleForSolidarityFund
            ? "bg-green-500/20 text-green-500"
            : "bg-foreground/10 text-muted"
        )
      );
      const solidarityMessage = document.createElement("p");
      solidarityMessage.className = "text-secondary";
      solidarityMessage.textContent = estimacion.eligibleForSolidarityFund
        ? `Con causal válida, ${mesesCotizados} cotizaciones y continuidad confirmada, cumples el filtro base del FCS. El monto exacto revísalo en la tabla oficial AFC vigente hasta ${estimacion.solidarityFundReference.validUntil}.`
        : estimacion.solidarityFundStatus === "ineligible-cause"
          ? "La causal seleccionada no habilita el Fondo Solidario. Solo corresponde revisar tu CIC."
          : estimacion.solidarityFundStatus === "needs-more-contributions"
            ? `Para revisar FCS necesitas al menos ${estimacion.solidarityFundMinimumContributionsRequired} cotizaciones en los últimos 24 meses. Llevas ${mesesCotizados}.`
            : "Te falta confirmar que las 3 últimas cotizaciones fueron continuas con el mismo empleador para cerrar el filtro base del FCS.";
      const solidaritySource = document.createElement("p");
      solidaritySource.className = "mt-2 text-xs text-muted";
      const solidarityLink = document.createElement("a");
      solidarityLink.href = estimacion.solidarityFundReference.url;
      solidarityLink.target = "_blank";
      solidarityLink.className = "underline";
      solidarityLink.textContent = "tabla oficial AFC";
      solidaritySource.append(
        "Referencia: ",
        solidarityLink,
        ` (${estimacion.solidarityFundReference.label}).`
      );
      solidarityBox.append(
        solidarityHeader,
        solidarityMessage,
        solidaritySource
      );

      const assumptionsList = document.createElement("ul");
      assumptionsList.className = "mt-3 space-y-1 text-xs text-muted";
      estimacion.assumptions.forEach(item => {
        const assumption = document.createElement("li");
        assumption.textContent = item;
        assumptionsList.appendChild(assumption);
      });

      const finalNote = document.createElement("p");
      finalNote.className = "mt-3 text-xs text-muted";
      finalNote.append("Consulta tu saldo real en ");
      const afcLink = document.createElement("a");
      afcLink.href = "https://www.afc.cl";
      afcLink.target = "_blank";
      afcLink.className = "underline";
      afcLink.textContent = "afc.cl";
      finalNote.append(afcLink, " con tu ClaveÚnica.");

      document
        .getElementById("resultado-contenido")!
        .replaceChildren(
          header,
          contributionBox,
          payoutsLabel,
          ...payoutRows,
          totalCoverage,
          solidarityBox,
          assumptionsList,
          finalNote
        );
      document.dispatchEvent(
        new CustomEvent("calculator:result", {
          detail: {
            summaryText: `Seguro cesantía: cobertura ${fmtCurrency(estimacion.totalCoverage)} · ${estimacion.monthsCovered} meses`,
          },
        })
      );
      trackAnalyticsEvent("calculator_complete", {
        calculator_slug: "seguro-cesantia",
        calculator_name: "Calculadora de Seguro de Cesantia",
        outcome: "success",
      });
    }
    animateResultValues();
  });
</script>
