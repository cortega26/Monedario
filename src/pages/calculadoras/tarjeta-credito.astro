---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import CalculatorJsonLd from "@/components/CalculatorJsonLd.astro";
import Footer from "@/components/Footer.astro";
import MethodologyBlock from "@/components/MethodologyBlock.astro";
import PrimaryCTA from "@/components/PrimaryCTA.astro";
import ShareCalculatorResult from "@/components/ShareCalculatorResult.astro";
import CalculatorResultNextActions from "@/components/CalculatorResultNextActions.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CalculatorTrustBadge from "@/components/CalculatorTrustBadge.astro";
import NextSteps from "@/components/NextSteps.astro";
import { CALCULATOR_PORTFOLIO } from "@/config/calculatorPortfolio";
import CalculatorHero from "@/components/calculator/CalculatorHero.astro";
import CalculatorField from "@/components/calculator/CalculatorField.astro";
import CalculatorResultPanel from "@/components/calculator/CalculatorResultPanel.astro";
import { simulateCreditCardCost } from "@/application/use-cases/SimulateCreditCardCost";
const fmtClp = (n: number) => "$" + Math.round(n).toLocaleString("es-CL");
const exampleResult = simulateCreditCardCost({
  debt: 500_000,
  monthlyRatePercent: 3.49,
  minimumPaymentPercent: 5,
});
const currentCalculator = CALCULATOR_PORTFOLIO.find(
  calc => calc.slug === "tarjeta-credito"
);
const calculatorRelatedItems = (currentCalculator?.related ?? []).map(item => ({
  href: item.href,
  title: item.label,
  description: item.when,
  label: "Relacionado",
}));
const calculatorNextStepItems = [
  ...calculatorRelatedItems,
  ...(calculatorRelatedItems.length < 2
    ? [
        {
          href: "/calculadoras/",
          title: "Ver todas las calculadoras",
          description: "Compara otra herramienta si tu pregunta cambió.",
          label: "Herramientas",
        },
      ]
    : []),
];
---

<Layout
  title="Costo Real de Tarjeta de Crédito | Pago Mínimo"
  description="Simula cuánto pagas en intereses y tiempo al cubrir pago mínimo o cuota fija de tarjeta de crédito."
>
  <CalculatorJsonLd
    name="Costo Real de Tarjeta de Crédito | Pago Mínimo"
    description="Simula cuánto pagas en intereses y tiempo al cubrir pago mínimo o cuota fija de tarjeta de crédito."
  />
  <Header />
  <Breadcrumb />
  <CalculatorTrustBadge location="calculator_header" />
  <main
    data-layout="calculator"
    id="main-content"
    class="app-layout"
    data-analytics-page-type="calculator"
    data-analytics-calculator="tarjeta-credito"
    data-analytics-calculator-name="Costo Real Tarjeta de Credito"
  >
    <CalculatorHero
      title="Costo Real de la Tarjeta de Crédito"
      description="Descubre cuánto pagas realmente si solo abonas el mínimo de tu tarjeta. Ve el costo total en tiempo e intereses."
      descriptionClass="max-w-xl text-secondary"
    />

    <section class="grid items-start gap-6 py-8 sm:grid-cols-2">
      <!-- FORMULARIO -->
      <div class="rounded-xl border border-border p-6">
        <h2 class="mb-5 text-lg font-semibold">Datos de tu deuda</h2>

        <CalculatorField
          id="deuda"
          label="Deuda actual ($)"
          placeholder="Ej: 500.000"
          min="0"
        />

        <CalculatorField
          id="tasa"
          label="Tasa de interés mensual (%)"
          placeholder="Ej: 3.5"
          min="0"
          max="10"
          step="0.01"
          value="3.49"
          hint="La TMC (tasa máxima convencional) vigente para tarjetas suele estar ~3.49% mensual. Revisa tu contrato para el valor exacto."
        />

        <CalculatorField
          id="pago-minimo-pct"
          label="Porcentaje de pago mínimo (%)"
          placeholder="Ej: 5"
          min="1"
          max="50"
          step="0.5"
          value="5"
          hint="El pago mínimo varía por banco, generalmente entre 3% y 10% del saldo."
        />

        <CalculatorField
          id="pago-fijo"
          label="O bien, pago mensual fijo ($) — opcional"
          placeholder="Ej: 80.000"
          min="0"
          hint="Si ingresas un monto fijo, se usa en lugar del porcentaje mínimo."
        />

        <button
          id="calcBtn"
          class="mt-2 w-full rounded-lg bg-accent px-4 py-3 text-base font-bold text-background transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Calcular costo real →
        </button>
      </div>

      <!-- RESULTADO -->
      <CalculatorResultPanel title="Resultado">
        <div id="resultado-contenido" data-is-example="true" aria-live="polite">
          <div
            class="mb-5 rounded-lg border border-border bg-surface-muted/40 p-4 text-center"
          >
            <p
              class="mb-1 text-xs font-bold tracking-widest text-muted uppercase"
            >
              Total a pagar (Ejemplo)
            </p>
            <p class="text-4xl font-bold text-foreground/80">
              {fmtClp(exampleResult.baseline.totalPaid)}
            </p>
          </div>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-secondary">Deuda original</span>
              <span class="font-medium text-foreground/80">$500.000</span>
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Intereses totales</span>
              <span class="font-medium text-foreground/80">
                {fmtClp(exampleResult.baseline.totalInterest)}
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-secondary">Tiempo para saldar</span>
              <span class="font-medium text-foreground/80">
                {exampleResult.baseline.months} meses
              </span>
            </div>
          </div>
          <p class="mt-4 text-xs text-muted">
            Ejemplo: deuda de $500.000 al 3,49% mensual pagando el mínimo (5%).
          </p>
        </div>
      </CalculatorResultPanel>
    </section>

    <!-- EXPLICACIÓN -->
    <section
      class="prose prose-sm max-w-none border-t border-border pt-8 pb-12 dark:prose-invert"
    >
      <h2>¿Por qué el pago mínimo es tan costoso?</h2>
      <p>
        Cuando pagas solo el mínimo de tu tarjeta, la mayor parte de ese dinero
        cubre los intereses del mes — no la deuda. El saldo baja muy lentamente,
        y los intereses se calculan sobre ese saldo cada mes. El efecto es que
        terminas pagando el doble o el triple del valor original.
      </p>
      <ul>
        <li>
          <strong>Tasa máxima convencional (TMC):</strong> Es el máximo legal que
          puede cobrar una tarjeta. Para créditos de consumo hasta 200 UF es de aproximadamente
          3.49% mensual (equivalente a más de 50% anual).
        </li>
        <li>
          <strong>Interés sobre saldo:</strong> Los intereses se calculan sobre lo
          que debes cada mes, no sobre el monto original.
        </li>
        <li>
          <strong>La solución:</strong> Pagar siempre más del mínimo, o usar el excedente
          de otros meses para abonar al capital.
        </li>
      </ul>
      <p class="text-sm text-muted">
        Valores referenciales. La simulación asume cuotas constantes. Las TMC
        reales varían por banco y tipo de operación — verifica en la <a
          href="https://www.cmfchile.cl/portal/principal/613/w3-channel.html"
          target="_blank"
          rel="noopener noreferrer">CMF</a
        >.
      </p>
    </section>

    <PrimaryCTA
      text="Costo real de tu tarjeta de crédito en Chile →"
      href="/posts/tarjeta-credito-costo-real-chile/"
      context="Entiende cómo se acumulan los intereses y qué pasa si solo pagas el mínimo."
    />
    <ShareCalculatorResult />
    <CalculatorResultNextActions
      calculatorSlug="tarjeta-credito"
      actions={[
        { label: "Imprimir resultado", href: "#", type: "print" },
        {
          label: "Crédito de consumo",
          href: "/calculadoras/credito-consumo/",
          type: "calculator",
        },
        {
          label: "Prepago de crédito",
          href: "/calculadoras/prepago-credito/",
          type: "calculator",
        },
      ]}
    />
    <MethodologyBlock
      notes="El costo total de la deuda con pago mínimo se calcula con la fórmula de amortización iterativa mes a mes. El pago mínimo usa el porcentaje informado por el emisor. La tasa de referencia máxima corresponde a la tasa máxima convencional CMF vigente para tarjetas de crédito."
      sources={[
        {
          name: "CMF Chile — Tasa máxima convencional tarjetas",
          url: "https://www.cmfchile.cl/portal/principal/613/w3-channel.html",
          date: "2026-03",
        },
        {
          name: "SERNAC — Derechos en productos financieros",
          url: "https://www.sernac.cl",
          date: "2026-01",
        },
      ]}
    />
    <NextSteps
      currentHref="/calculadoras/tarjeta-credito/"
      items={calculatorNextStepItems}
      title="Qué hacer con este resultado"
      description="Sigue con una herramienta relacionada o vuelve al índice si necesitas resolver otra pregunta."
      location="calculator_next_steps"
    />
  </main>
  <Footer />
</Layout>

<script>
  import { simulateCreditCardCost } from "@/application/use-cases/SimulateCreditCardCost";
  import { trackAnalyticsEvent } from "@/utils/analytics";
  import { renderHeadlineDelta } from "@/utils/calculatorDelta";

  declare global {
    interface Window {
      showShareResult?: (text: string) => void;
      showCalculatorNextActions?: () => void;
    }
  }

  function fmt(n: number): string {
    return "$" + Math.round(n).toLocaleString("es-CL");
  }

  function showError(message: string) {
    const el = document.getElementById("calc-error");
    if (!el) return;
    el.textContent = message;
    el.classList.remove("hidden");
  }
  function hideError() {
    const el = document.getElementById("calc-error");
    if (!el) return;
    el.classList.add("hidden");
    el.textContent = "";
  }

  function setLoading(isLoading: boolean) {
    const btn = document.getElementById("calcBtn") as HTMLButtonElement;
    if (!btn) return;
    btn.disabled = isLoading;
    btn.textContent = isLoading ? "Calculando…" : "Calcular costo real →";
  }

  document.getElementById("calcBtn")?.addEventListener("click", () => {
    hideError();
    setLoading(true);
    const deuda =
      parseFloat(
        (document.getElementById("deuda") as HTMLInputElement).value
      ) || 0;
    const tasaMensual =
      parseFloat((document.getElementById("tasa") as HTMLInputElement).value) /
      100;
    const pctMinimo =
      parseFloat(
        (document.getElementById("pago-minimo-pct") as HTMLInputElement).value
      ) / 100;
    const pagoFijo =
      parseFloat(
        (document.getElementById("pago-fijo") as HTMLInputElement).value
      ) || 0;

    if (deuda <= 0) {
      showError("Por favor ingresa una deuda válida.");
      setLoading(false);
      return;
    }

    let simulacion;
    try {
      simulacion = simulateCreditCardCost({
        debt: deuda,
        monthlyRatePercent: tasaMensual * 100,
        minimumPaymentPercent: pctMinimo * 100,
        fixedMonthlyPayment: pagoFijo > 0 ? pagoFijo : undefined,
      });
    } catch (error) {
      showError(
        error instanceof Error
          ? error.message
          : "No se pudo simular la tarjeta de crédito."
      );
      setLoading(false);
      return;
    }

    setLoading(false);
    const resultado = simulacion.baseline;
    const resultadoDoble = simulacion.doubledPayment;
    const primerasCuotas = resultado.firstMonthlyPayments;

    const años = Math.floor(resultado.months / 12);
    const mesesRest = resultado.months % 12;
    const tiempoStr =
      años > 0
        ? `${años} año${años > 1 ? "s" : ""} y ${mesesRest} meses`
        : `${resultado.months} meses`;

    const añosDoble = Math.floor(resultadoDoble.months / 12);
    const mesesDoble = resultadoDoble.months % 12;
    const tiempoDobleStr =
      añosDoble > 0
        ? `${añosDoble} año${añosDoble > 1 ? "s" : ""} y ${mesesDoble} meses`
        : `${resultadoDoble.months} meses`;

    const buildRow = (label: string, value: string, colorClass = "") => {
      const line = document.createElement("div");
      line.className =
        "flex items-center justify-between border-b border-border py-2 text-sm last:border-0";

      const labelElement = document.createElement("span");
      labelElement.className = "text-secondary";
      labelElement.textContent = label;

      const valueElement = document.createElement("span");
      valueElement.className = `font-mono font-semibold ${colorClass}`.trim();
      valueElement.textContent = value;

      line.append(labelElement, valueElement);
      return line;
    };

    const headline = document.createElement("div");
    headline.className =
      "mb-5 rounded-lg border border-red-500/20 bg-red-500/10 p-4 text-center";
    const headlineLabel = document.createElement("p");
    headlineLabel.className =
      "mb-1 text-xs font-bold tracking-widest text-red-400 uppercase";
    headlineLabel.textContent = `Total a pagar (con ${
      simulacion.usesFixedPayment ? "cuota fija" : "pago mínimo"
    })`;
    const headlineValue = document.createElement("p");
    headlineValue.className = "text-4xl font-bold";
    headlineValue.textContent = fmt(resultado.totalPaid);
    const originalDebt = document.createElement("p");
    originalDebt.className = "mt-1 text-sm text-muted";
    originalDebt.textContent = `Deuda original: ${fmt(deuda)}`;
    headline.append(headlineLabel, headlineValue, originalDebt);

    const delta = renderHeadlineDelta(
      window.location.pathname,
      resultado.totalPaid,
      fmt
    );
    if (delta) headline.append(delta);

    const firstPaymentsBox = document.createElement("div");
    firstPaymentsBox.className = "mt-4 rounded-lg bg-foreground/5 p-3";
    const firstPaymentsLabel = document.createElement("p");
    firstPaymentsLabel.className =
      "mb-2 text-xs font-bold text-muted uppercase";
    firstPaymentsLabel.textContent = "Primeras cuotas estimadas";
    firstPaymentsBox.appendChild(firstPaymentsLabel);
    for (const [index, payment] of primerasCuotas.entries()) {
      firstPaymentsBox.appendChild(buildRow(`Mes ${index + 1}`, fmt(payment)));
    }

    const doublePaymentBox = document.createElement("div");
    doublePaymentBox.className =
      "mt-5 rounded-lg border border-green-500/30 bg-green-500/5 p-4";
    const doublePaymentLabel = document.createElement("p");
    doublePaymentLabel.className =
      "mb-2 text-xs font-bold text-green-500 uppercase";
    doublePaymentLabel.textContent = "✓ Si pagas el doble cada mes";
    doublePaymentBox.append(
      doublePaymentLabel,
      buildRow("Total a pagar", fmt(resultadoDoble.totalPaid)),
      buildRow("Intereses", fmt(resultadoDoble.totalInterest)),
      buildRow("Tiempo", tiempoDobleStr),
      buildRow(
        "Ahorro vs mínimo",
        fmt(resultado.totalPaid - resultadoDoble.totalPaid),
        "text-green-500"
      )
    );

    document
      .getElementById("resultado-contenido")!
      .replaceChildren(
        headline,
        buildRow(
          "Intereses totales",
          fmt(resultado.totalInterest),
          "text-red-400"
        ),
        buildRow("Tiempo para saldar", tiempoStr, "text-red-400"),
        buildRow(
          "Factor de costo",
          `×${(resultado.totalPaid / deuda).toFixed(2)}`
        ),
        ...(primerasCuotas.length > 0 ? [firstPaymentsBox] : []),
        doublePaymentBox
      );

    if (typeof window.showShareResult === "function") {
      window.showShareResult(
        `Tarjeta de crédito: intereses totales ${fmt(resultado.totalInterest)} (deuda ${fmt(deuda)})`
      );
    }
    window.showCalculatorNextActions?.();
    trackAnalyticsEvent("calculator_complete", {
      calculator_slug: "tarjeta-credito",
      calculator_name: "Costo Real Tarjeta de Credito",
      outcome: "success",
    });
    trackAnalyticsEvent("calculator_completed", {
      calculator_slug: "tarjeta-credito",
    });
  });
</script>
