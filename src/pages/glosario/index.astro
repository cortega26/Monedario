---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SectionDivider from "@/components/SectionDivider.astro";
import { getCollection } from "astro:content";
import { getPath } from "@/utils/getPath";

const glossaryEntries = await getCollection("glossary", ({ data }) => {
  return !data.draft;
});

// Ordenar alfabéticamente por el término (ignorando mayúsculas/minúsculas)
glossaryEntries.sort((a, b) => a.data.term.localeCompare(b.data.term, "es"));

// Normaliza una letra para agrupación: elimina diacríticos (Í→I, Á→A, etc.)
function normalizeInitial(char: string): string {
  return char
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toUpperCase();
}

// Agrupar por la primera letra (normalizada, sin tilde)
const groupedEntries = glossaryEntries.reduce(
  (acc, entry) => {
    const firstLetter = normalizeInitial(entry.data.term.charAt(0));
    if (!acc[firstLetter]) {
      acc[firstLetter] = [];
    }
    acc[firstLetter].push(entry);
    return acc;
  },
  {} as Record<string, typeof glossaryEntries>
);

const letters = Object.keys(groupedEntries).sort();

const glossaryIndexUrl = new URL(
  getPath("/glosario/"),
  Astro.site ?? Astro.url.origin
).href;

const definedTermSetSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": glossaryIndexUrl,
  name: "Glosario Monedario",
  description:
    "Diccionario de términos financieros, económicos y previsionales de Chile.",
  url: glossaryIndexUrl,
  inLanguage: "es-CL",
  hasDefinedTerm: glossaryEntries.map(entry => ({
    "@type": "DefinedTerm",
    name: entry.data.term,
    description: entry.data.shortDefinition,
    url: new URL(
      getPath(`/glosario/${entry.id}/`),
      Astro.site ?? Astro.url.origin
    ).href,
  })),
};
---

<Layout
  title="Glosario Financiero | Monedario"
  description="Diccionario de términos financieros, económicos y previsionales de Chile. Encuentra definiciones claras de UF, UTM, CAE, TMC y más."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(definedTermSetSchema)}
  />
  <Header />

  <main id="main-content" class="app-layout">
    <section class="max-w-3xl pt-12 pb-6">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Glosario Financiero
      </h1>
      <p class="mt-4 text-lg text-secondary">
        Entiende la jerga económica de Chile. Encuentra explicaciones sencillas
        y ejemplos para los términos, siglas e indicadores financieros más
        utilizados.
      </p>
      <p class="mt-3 text-sm text-secondary">
        Usa el glosario cuando necesitas entender el significado de un término o
        sigla. Si tu duda es cómo funciona un producto completo, cómo calcular
        algo o qué decisión tomar, las{" "}
        <a
          href="/guias/"
          class="text-accent underline underline-offset-4 hover:opacity-80"
        >
          guías por tema
        </a>{" "}
        te darán una respuesta más completa.
      </p>
    </section>

    <SectionDivider />

    <section class="py-8">
      {
        letters.length > 0 ? (
          <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
            {letters.map(letter => (
              <div>
                <h2 class="mb-4 inline-block border-b-2 border-accent pb-1 text-2xl font-bold text-accent">
                  {letter}
                </h2>
                <ul class="flex flex-col gap-3">
                  {groupedEntries[letter].map(entry => (
                    <li class="group">
                      <a
                        href={getPath(`/glosario/${entry.id}/`)}
                        class="block rounded-lg border border-transparent p-3 transition-colors hover:border-border hover:bg-accent/5 focus:border-border focus:bg-accent/5 focus:outline-none"
                      >
                        <h3 class="font-semibold transition-colors group-hover:text-accent">
                          {entry.data.term}
                        </h3>
                        <p class="mt-1 line-clamp-2 text-sm text-secondary">
                          {entry.data.shortDefinition}
                        </p>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ) : (
          <p class="py-12 text-center text-lg text-secondary">
            No hay términos definidos en el glosario aún.
          </p>
        )
      }
    </section>
  </main>

  <Footer />
</Layout>
