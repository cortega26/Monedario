---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import GlossaryJsonLd from "@/components/GlossaryJsonLd.astro";
import { getPath } from "@/utils/getPath";
import { formatMetadataDate } from "@/utils/metadataDate";

export async function getStaticPaths() {
  const glossaryEntries = await getCollection(
    "glossary",
    ({ data }) => !data.draft
  );

  return glossaryEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const {
  term,
  seoTitle,
  shortDefinition,
  relatedTerms,
  relatedCalculators,
  relatedGuides,
  relatedLaws,
  sources,
  publishedDate,
  reviewedDate,
} = entry.data;
const canonicalUrl = new URL(
  getPath(`/glosario/${entry.id}/`),
  Astro.site ?? Astro.url.origin
).href;
const glossaryIndexUrl = new URL(
  getPath("/glosario/"),
  Astro.site ?? Astro.url.origin
).href;

const { Content } = await render(entry);

// Fetch related terms metadata
let relatedTermsData: CollectionEntry<"glossary">[] = [];
if (relatedTerms.length > 0) {
  const allEntries = await getCollection("glossary");
  relatedTermsData = allEntries.filter(
    e => relatedTerms.includes(e.id) && !e.data.draft
  );
}
---

<Layout
  title={seoTitle ?? `${term} | Glosario Financiero`}
  description={shortDefinition}
  canonicalURL={canonicalUrl}
>
  <GlossaryJsonLd
    term={term}
    shortDefinition={shortDefinition}
    canonicalUrl={canonicalUrl}
    glossaryIndexUrl={glossaryIndexUrl}
  />
  <Header />
  <div class="mx-auto flex w-full max-w-3xl justify-start px-2">
    <Breadcrumb />
  </div>

  <main id="main-content" class="app-layout">
    <article class="mx-auto max-w-3xl pt-8 pb-12">
      <h1 class="text-3xl font-bold tracking-tight text-accent sm:text-4xl">
        {term}
      </h1>

      {
        publishedDate && (
          <p class="mt-2 text-sm text-muted">
            Publicado: {formatMetadataDate(publishedDate, "long")}
            {reviewedDate && reviewedDate > publishedDate && (
              <> · Revisado: {formatMetadataDate(reviewedDate, "long")}</>
            )}
          </p>
        )
      }

      <div
        class="mt-8 mb-4 border-l-4 border-accent/30 bg-accent/5 p-4 text-lg font-medium text-secondary"
      >
        {shortDefinition}
      </div>

      <div class="app-prose content-layer mt-8 text-base leading-relaxed">
        <Content />
      </div>

      {
        sources.length > 0 && (
          <section class="bg-surface mt-12 rounded-xl border border-border p-6">
            <h2 class="mb-4 text-xl font-bold">Fuentes</h2>
            <ul class="space-y-2">
              {sources.map(source => (
                <li>
                  <a
                    href={source.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-accent underline underline-offset-4 hover:opacity-80"
                  >
                    {source.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        (relatedCalculators.length > 0 ||
          relatedGuides.length > 0 ||
          relatedLaws.length > 0) && (
          <div class="bg-surface mt-12 rounded-xl border border-border p-6">
            <h2 class="mb-4 text-xl font-bold">Dónde se usa esto</h2>
            <div class="flex flex-col gap-6">
              {relatedCalculators.length > 0 && (
                <div>
                  <h3 class="mb-2 text-sm font-semibold tracking-wider text-muted uppercase">
                    Calculadoras
                  </h3>
                  <ul class="flex flex-wrap gap-2">
                    {relatedCalculators.map(item => (
                      <li>
                        <a
                          href={getPath(item.href)}
                          class="inline-block rounded-full bg-accent/10 px-4 py-1.5 text-sm font-medium transition-colors hover:bg-accent hover:text-background"
                        >
                          {item.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {relatedGuides.length > 0 && (
                <div>
                  <h3 class="mb-2 text-sm font-semibold tracking-wider text-muted uppercase">
                    Guías y artículos
                  </h3>
                  <ul class="flex flex-wrap gap-2">
                    {relatedGuides.map(item => (
                      <li>
                        <a
                          href={getPath(item.href)}
                          class="inline-block rounded-full bg-accent/10 px-4 py-1.5 text-sm font-medium transition-colors hover:bg-accent hover:text-background"
                        >
                          {item.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {relatedLaws.length > 0 && (
                <div>
                  <h3 class="mb-2 text-sm font-semibold tracking-wider text-muted uppercase">
                    Marco legal
                  </h3>
                  <ul class="flex flex-wrap gap-2">
                    {relatedLaws.map(item => (
                      <li>
                        <a
                          href={getPath(item.href)}
                          class="inline-block rounded-full bg-accent/10 px-4 py-1.5 text-sm font-medium transition-colors hover:bg-accent hover:text-background"
                        >
                          {item.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
            <p class="mt-4 text-sm text-muted">
              Explora todas las{" "}
              <a
                href={getPath("/calculadoras/")}
                class="text-accent underline underline-offset-4 hover:opacity-80"
              >
                calculadoras
              </a>{" "}
              o las{" "}
              <a
                href={getPath("/leyes/")}
                class="text-accent underline underline-offset-4 hover:opacity-80"
              >
                leyes vigentes
              </a>{" "}
              de Monedario.
            </p>
          </div>
        )
      }

      {
        relatedTermsData.length > 0 && (
          <div class="bg-surface mt-6 rounded-xl border border-border p-6">
            <h2 class="mb-4 text-xl font-bold">Términos relacionados</h2>
            <ul class="flex flex-wrap gap-2">
              {relatedTermsData.map(relatedEntry => (
                <li>
                  <a
                    href={getPath(`/glosario/${relatedEntry.id}/`)}
                    class="inline-block rounded-full bg-accent/10 px-4 py-1.5 text-sm font-medium transition-colors hover:bg-accent hover:text-background"
                  >
                    {relatedEntry.data.term}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </article>
  </main>

  <Footer />
</Layout>
