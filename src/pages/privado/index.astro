---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getPath } from "@/utils/getPath";
---

<Layout
  title="Monedario Privado — Analiza tus movimientos sin subirlos"
  description="MVP experimental para analizar un CSV de movimientos financieros directamente en tu navegador, sin enviar tus transacciones a Monedario ni a terceros."
  enableClientRouter={false}
  privacyMode={true}
>
  <Header />
  <main
    id="main-content"
    class="app-layout py-8 lg:py-12"
    data-private-analysis
  >
    <section class="mx-auto max-w-5xl">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">
          MVP experimental
        </span>
        <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-semibold">
          <span
            class="h-2 w-2 rounded-full bg-emerald-500"
            aria-hidden="true"
          ></span>
          Modo privado activo
        </span>
      </div>

      <h1 class="mt-5 max-w-4xl text-4xl font-bold tracking-tight sm:text-5xl">
        Monedario Privado
      </h1>
      <p class="mt-4 max-w-4xl text-2xl leading-tight font-semibold tracking-tight sm:text-3xl">
        Entiende tus finanzas sin entregarnos tus movimientos.
      </p>
      <p class="mt-3 max-w-3xl text-base leading-relaxed text-secondary sm:text-lg">
        Carga una cartola CSV y obtén un resumen de ingresos, egresos y
        categorías. Tus archivos, transacciones y resultados se procesan en este
        navegador y no se envían a Monedario ni a terceros.
      </p>

      <div
        class="mt-6 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4"
        aria-label="Estado del modo privado"
      >
        <div class="grid gap-1.5 text-sm sm:grid-cols-3 sm:gap-4">
          <span class="flex items-baseline gap-1">
            <strong class="text-foreground">Archivos:</strong>
            <span class="text-secondary">local</span>
          </span>
          <span class="flex items-baseline gap-1">
            <strong class="text-foreground">Analytics:</strong>
            <span class="text-secondary">off</span>
          </span>
          <span class="flex items-baseline gap-1">
            <strong class="text-foreground">Persistencia:</strong>
            <span class="text-secondary">off</span>
          </span>
        </div>
        <p class="mt-2 text-xs leading-relaxed text-secondary">
          El archivo se lee con la API local del navegador. Esta ruta no inicia
          analytics ni guarda tus movimientos o resultados.
        </p>
      </div>
    </section>

    <section class="mx-auto mt-8 grid max-w-5xl gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div class="rounded-2xl border border-border bg-background p-5 shadow-sm sm:p-7">
        <div>
          <h2 class="text-2xl font-semibold">Carga una cartola</h2>
          <p class="mt-2 text-sm leading-relaxed text-secondary">
            Funciona mejor con columnas como
            <code>Fecha</code>, <code>Descripción</code>,<code>Cargo</code>/
            <code>Abono</code> o un
            <code>Monto</code> con signo. Por ahora interpreta los montos como
            pesos chilenos. Máximo 10 MiB en este MVP.
          </p>
        </div>

        <label
          id="private-dropzone"
          for="private-file"
          class="mt-6 flex min-h-48 cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-border bg-surface-muted/25 px-6 py-8 text-center transition hover:border-accent/50 hover:bg-accent/5"
        >
          <span class="text-lg font-semibold">Arrastra tu CSV aquí</span>
          <span class="mt-2 text-sm text-secondary">
            o toca para elegirlo desde tu dispositivo
          </span>
          <input
            id="private-file"
            class="sr-only"
            type="file"
            accept=".csv,text/csv,text/plain"
          />
        </label>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <button
            id="private-demo"
            type="button"
            class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-background transition hover:opacity-90"
          >
            Probar con datos ficticios
          </button>
          <button
            id="private-clear"
            type="button"
            class="rounded-lg border border-border px-4 py-2 text-sm font-semibold text-foreground transition hover:bg-surface-muted/40"
          >
            Borrar análisis
          </button>
          <span
            id="private-file-name"
            class="text-sm text-secondary"
            aria-live="polite"
          >
            Ningún archivo cargado
          </span>
        </div>

        <div
          id="private-error"
          class="mt-4 hidden rounded-lg border border-red-500/30 bg-red-500/10 p-4 text-sm"
          role="alert"
        ></div>
      </div>

      <aside
        class="rounded-2xl border border-border bg-surface-muted/25 p-5"
        aria-labelledby="verify-privacy-title"
      >
        <div class="flex items-center justify-between gap-3">
          <h2 id="verify-privacy-title" class="text-lg font-semibold">
            Verifica la privacidad tú mismo
          </h2>
          <span class="shrink-0 rounded-full border border-border bg-background px-2.5 py-1 text-xs font-semibold text-secondary">
            3 pasos
          </span>
        </div>
        <p class="mt-2 text-sm leading-relaxed text-secondary">
          No tienes que confiar en el texto de esta página. Puedes comprobar el
          límite de privacidad con las herramientas de desarrollo del navegador.
        </p>
        <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-secondary">
          <li>Abre DevTools → Network y limpia el registro.</li>
          <li>Carga tu CSV o usa la demo.</li>
          <li>El análisis no debe generar una nueva solicitud de red.</li>
        </ol>
        <p class="mt-4 text-xs leading-relaxed text-secondary">
          Al abrir esta página sí descargas HTML, CSS, JavaScript, fuentes y
          otros assets de Monedario. La garantía se refiere a tus datos
          financieros y a los resultados derivados de ellos.
        </p>
      </aside>
    </section>

    <section
      id="private-results"
      class="mx-auto mt-8 hidden max-w-5xl"
      aria-live="polite"
    >
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-semibold tracking-wide text-accent uppercase">
            Procesado localmente · 0 uploads
          </p>
          <h2 class="mt-1 text-2xl font-semibold">Tu resumen</h2>
        </div>
        <p id="private-row-count" class="text-sm text-secondary"></p>
      </div>

      <div class="mt-5 grid gap-4 sm:grid-cols-3">
        <article class="rounded-xl border border-border bg-background p-5">
          <p class="text-sm text-secondary">Ingresos detectados</p>
          <p id="private-income" class="mt-2 text-2xl font-bold"></p>
        </article>
        <article class="rounded-xl border border-border bg-background p-5">
          <p class="text-sm text-secondary">Egresos detectados</p>
          <p id="private-expenses" class="mt-2 text-2xl font-bold"></p>
        </article>
        <article class="rounded-xl border border-border bg-background p-5">
          <p class="text-sm text-secondary">Balance del archivo</p>
          <p id="private-net" class="mt-2 text-2xl font-bold"></p>
        </article>
      </div>

      <div
        class="mt-5 rounded-xl border border-accent/20 bg-accent/5 p-4 sm:p-5"
        aria-labelledby="private-insight-label"
      >
        <p
          id="private-insight-label"
          class="text-xs font-semibold tracking-wide text-accent uppercase"
        >
          Lectura rápida
        </p>
        <p id="private-insight" class="mt-1 text-lg font-semibold"></p>
      </div>

      <div class="mt-6 rounded-xl border border-border bg-background p-5 sm:p-6">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h3 class="text-xl font-semibold">Egresos por categoría</h3>
            <p class="mt-2 text-sm text-secondary">
              Clasificación heurística experimental. Revisa el resultado antes
              de usarlo para tomar una decisión.
            </p>
          </div>
          <span class="text-xs font-medium text-secondary">
            Proporción del total
          </span>
        </div>

        <div
          id="private-category-bars"
          class="mt-5 space-y-4"
          aria-label="Distribución visual de egresos por categoría"
        ></div>

        <details class="mt-6 border-t border-border pt-4">
          <summary class="cursor-pointer text-sm font-semibold">
            Ver detalle en tabla
          </summary>
          <div class="mt-3 overflow-x-auto">
            <table class="w-full min-w-[520px] text-left text-sm">
              <thead>
                <tr class="border-b border-border text-secondary">
                  <th class="py-2 pr-4 font-semibold">Categoría</th>
                  <th class="py-2 pr-4 text-right font-semibold">
                    Movimientos
                  </th>
                  <th class="py-2 text-right font-semibold">Monto</th>
                </tr>
              </thead>
              <tbody id="private-categories"></tbody>
            </table>
          </div>
        </details>
      </div>

      <details class="mt-4 rounded-xl border border-border bg-surface-muted/20 p-5">
        <summary class="cursor-pointer font-semibold">
          Qué columnas detectó Monedario
        </summary>
        <pre
          id="private-columns"
          class="mt-3 overflow-x-auto text-xs whitespace-pre-wrap text-secondary"
        >
        </pre>
      </details>

      <p class="mt-5 text-sm leading-relaxed text-secondary">
        Este MVP resume movimientos; no reemplaza la cartola oficial ni entrega
        asesoría financiera. Si algo no cuadra, vuelve al archivo original.
      </p>
    </section>

    <section
      class="mx-auto mt-10 max-w-5xl border-t border-border pt-8"
      aria-labelledby="private-roadmap-title"
    >
      <div class="max-w-3xl">
        <p class="text-xs font-semibold tracking-wide text-accent uppercase">
          Después del MVP
        </p>
        <h2 id="private-roadmap-title" class="mt-2 text-2xl font-semibold">
          Lo que viene
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-secondary">
          Esta primera versión prueba el núcleo local-first. Quiero ir sumando
          capacidades sin romper esa frontera. Estas etiquetas muestran
          intención de producto, no funciones disponibles hoy ni fechas
          comprometidas.
        </p>
      </div>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <article class="rounded-xl border border-border bg-background p-5">
          <span
            class="inline-flex rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold"
            data-roadmap-status="available"
          >
            Disponible ahora
          </span>
          <h3 class="mt-3 font-semibold">CSV genérico en pesos chilenos</h3>
          <p class="mt-1 text-sm leading-relaxed text-secondary">
            Detección de columnas, signos, ingresos, egresos y categorías
            básicas, todo dentro del navegador.
          </p>
        </article>

        <article class="rounded-xl border border-border bg-background p-5">
          <span
            class="inline-flex rounded-full border border-accent/30 bg-accent/10 px-2.5 py-1 text-xs font-semibold text-accent"
            data-roadmap-status="planned"
          >
            Próxima iteración
          </span>
          <h3 class="mt-3 font-semibold">
            Adaptadores por banco y más formatos
          </h3>
          <p class="mt-1 text-sm leading-relaxed text-secondary">
            Reconocimiento explícito de exportaciones bancarias y soporte
            progresivo para XLSX, OFX y PDF sin convertir el servidor en
            custodio de tus cartolas.
          </p>
        </article>

        <article class="rounded-xl border border-border bg-background p-5">
          <span
            class="inline-flex rounded-full border border-accent/30 bg-accent/10 px-2.5 py-1 text-xs font-semibold text-accent"
            data-roadmap-status="planned"
          >
            Planificado
          </span>
          <h3 class="mt-3 font-semibold">Revisar, corregir y crear reglas</h3>
          <p class="mt-1 text-sm leading-relaxed text-secondary">
            Ver cómo se clasificó cada movimiento, corregir categorías y
            reconocer transferencias internas o reglas recurrentes antes de
            consolidar los totales.
          </p>
        </article>

        <article class="rounded-xl border border-border bg-background p-5">
          <span
            class="inline-flex rounded-full border border-border bg-surface-muted/40 px-2.5 py-1 text-xs font-semibold text-secondary"
            data-roadmap-status="evaluating"
          >
            En evaluación
          </span>
          <h3 class="mt-3 font-semibold">Historial privado y tendencias</h3>
          <p class="mt-1 text-sm leading-relaxed text-secondary">
            Persistencia local opcional, cifrada y explícita para comparar
            períodos y detectar recurrencias. Nada de sincronización cloud por
            defecto.
          </p>
        </article>
      </div>
    </section>

    <section class="mx-auto mt-10 max-w-5xl border-t border-border pt-6">
      <p class="text-sm text-secondary">
        ¿Quieres volver a las herramientas públicas?
        <a
          class="font-semibold text-accent hover:underline"
          href={getPath("/calculadoras/")}
        >
          Ver calculadoras
        </a>
      </p>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import { analyzeFinancialCsv } from "@/domain/privateFinance/analyzeFinancialCsv";

  const MAX_FILE_BYTES = 10 * 1024 * 1024;
  const DEMO_CSV = [
    "Fecha;Descripción;Cargo;Abono",
    "2026-09-01;SUELDO;;1850000",
    "2026-09-02;LIDER MACUL;84500;",
    "2026-09-03;COPEC MACUL;42000;",
    "2026-09-04;NETFLIX;8990;",
    "2026-09-05;ENEL;38500;",
    "2026-09-06;FARMACIA AHUMADA;23990;",
    "2026-09-07;RESTAURANTE BARRIO ITALIA;31500;",
    "2026-09-09;TRANSFERENCIA ARRIENDO;600000;",
  ].join("\n");

  const fileInput = document.querySelector<HTMLInputElement>("#private-file");
  const dropzone = document.querySelector<HTMLElement>("#private-dropzone");
  const demoButton = document.querySelector<HTMLButtonElement>("#private-demo");
  const clearButton =
    document.querySelector<HTMLButtonElement>("#private-clear");
  const fileName = document.querySelector<HTMLElement>("#private-file-name");
  const errorBox = document.querySelector<HTMLElement>("#private-error");
  const results = document.querySelector<HTMLElement>("#private-results");
  const rowCount = document.querySelector<HTMLElement>("#private-row-count");
  const income = document.querySelector<HTMLElement>("#private-income");
  const expenses = document.querySelector<HTMLElement>("#private-expenses");
  const net = document.querySelector<HTMLElement>("#private-net");
  const categories = document.querySelector<HTMLElement>("#private-categories");
  const categoryBars = document.querySelector<HTMLElement>(
    "#private-category-bars"
  );
  const insight = document.querySelector<HTMLElement>("#private-insight");
  const columns = document.querySelector<HTMLElement>("#private-columns");

  const currency = new Intl.NumberFormat("es-CL", {
    style: "currency",
    currency: "CLP",
    maximumFractionDigits: 0,
  });

  function requireElements() {
    return Boolean(
      fileInput &&
      dropzone &&
      demoButton &&
      clearButton &&
      fileName &&
      errorBox &&
      results &&
      rowCount &&
      income &&
      expenses &&
      net &&
      categories &&
      categoryBars &&
      insight &&
      columns
    );
  }

  function showError(message: string) {
    if (!errorBox || !results) return;
    errorBox.textContent = message;
    errorBox.classList.remove("hidden");
    results.classList.add("hidden");
  }

  function resetError() {
    if (!errorBox) return;
    errorBox.textContent = "";
    errorBox.classList.add("hidden");
  }

  function renderCsv(name: string, csv: string) {
    if (
      !results ||
      !rowCount ||
      !income ||
      !expenses ||
      !net ||
      !categories ||
      !categoryBars ||
      !insight ||
      !columns ||
      !fileName
    ) {
      return;
    }

    resetError();

    try {
      const summary = analyzeFinancialCsv(csv);
      fileName.textContent = name;
      rowCount.textContent =
        `${summary.transactionCount.toLocaleString("es-CL")} movimientos · ` +
        `${summary.ignoredRows.toLocaleString("es-CL")} filas ignoradas`;
      income.textContent = currency.format(summary.income);
      expenses.textContent = currency.format(summary.expenses);
      net.textContent = currency.format(summary.net);

      categories.replaceChildren();
      categoryBars.replaceChildren();
      const visibleCategories =
        summary.categories.length > 0
          ? summary.categories
          : [
              {
                category: "Sin egresos detectados",
                amount: 0,
                transactionCount: 0,
              },
            ];
      for (const item of visibleCategories) {
        const barRow = document.createElement("div");
        const barHeader = document.createElement("div");
        barHeader.className =
          "mb-1.5 flex items-baseline justify-between gap-4";

        const barLabel = document.createElement("span");
        barLabel.className = "text-sm font-medium";
        barLabel.textContent = item.category;

        const barAmount = document.createElement("span");
        barAmount.className = "text-sm font-semibold";
        barAmount.textContent = currency.format(item.amount);

        const track = document.createElement("div");
        track.className = "h-2.5 overflow-hidden rounded-full bg-surface-muted";
        track.setAttribute("aria-hidden", "true");

        const fill = document.createElement("div");
        fill.className = "h-full rounded-full bg-accent";
        const width =
          summary.expenses > 0 ? (item.amount / summary.expenses) * 100 : 0;
        fill.style.width = `${Math.max(0, Math.min(100, width))}%`;

        barHeader.append(barLabel, barAmount);
        track.append(fill);
        barRow.append(barHeader, track);
        categoryBars.append(barRow);

        const tr = document.createElement("tr");
        tr.className = "border-b border-border/70 last:border-b-0";

        const categoryCell = document.createElement("td");
        categoryCell.className = "py-3 pr-4 font-medium";
        categoryCell.textContent = item.category;

        const countCell = document.createElement("td");
        countCell.className = "py-3 pr-4 text-right text-secondary";
        countCell.textContent = item.transactionCount.toLocaleString("es-CL");

        const amountCell = document.createElement("td");
        amountCell.className = "py-3 text-right font-semibold";
        amountCell.textContent = currency.format(item.amount);

        tr.append(categoryCell, countCell, amountCell);
        categories.append(tr);
      }

      const topCategory = summary.categories[0];
      if (topCategory && summary.expenses > 0) {
        const share = Math.round((topCategory.amount / summary.expenses) * 100);
        insight.textContent =
          `${topCategory.category} concentra ${share}% de los egresos ` +
          "detectados en este archivo.";
      } else {
        insight.textContent = "No se detectaron egresos para comparar.";
      }

      columns.textContent = JSON.stringify(summary.detectedColumns, null, 2);
      results.classList.remove("hidden");
      results.scrollIntoView({ behavior: "smooth", block: "start" });
    } catch (error) {
      showError(
        error instanceof Error
          ? error.message
          : "No pude analizar este archivo. Revisa su formato e inténtalo de nuevo."
      );
    }
  }

  async function processFile(file: File) {
    if (file.size > MAX_FILE_BYTES) {
      showError("El archivo supera el máximo de 10 MiB de este MVP.");
      return;
    }
    renderCsv(file.name, await file.text());
  }

  if (requireElements()) {
    fileInput?.addEventListener("change", () => {
      const file = fileInput.files?.[0];
      if (file) void processFile(file);
    });

    demoButton?.addEventListener("click", () => {
      renderCsv("demo-ficticio.csv", DEMO_CSV);
    });

    clearButton?.addEventListener("click", () => {
      if (fileInput) fileInput.value = "";
      if (fileName) fileName.textContent = "Ningún archivo cargado";
      resetError();
      results?.classList.add("hidden");
      categories?.replaceChildren();
      categoryBars?.replaceChildren();
      if (insight) insight.textContent = "";
      if (columns) columns.textContent = "";
    });

    dropzone?.addEventListener("dragover", event => {
      event.preventDefault();
      dropzone.classList.add("border-accent");
    });

    dropzone?.addEventListener("dragleave", () => {
      dropzone.classList.remove("border-accent");
    });

    dropzone?.addEventListener("drop", event => {
      event.preventDefault();
      dropzone.classList.remove("border-accent");
      const file = event.dataTransfer?.files[0];
      if (file) void processFile(file);
    });
  }
</script>
