---
import { SITE } from "@/config";
import { getPath } from "@/utils/getPath";

const redirectTo = getPath("/buscar/");
const canonicalUrl = new URL(redirectTo, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{`Redirigiendo a Buscar | ${SITE.title}`}</title>
  </head>
  <body>
    <p>
      Redirigiendo a <a href={redirectTo}>Buscar</a>.
    </p>
  </body>
</html>
