---
import HeroPromptWorkspace from "@/tools/hero-images/HeroPromptWorkspace.jsx";
import promptsData from "../../../scripts/hero-images/prompts.json";
import manifestData from "../../../scripts/hero-images/manifest.json";
import {
  HERO_P0_METADATA,
  HERO_P0_ORDER,
} from "@/tools/hero-images/p0-worklist.mjs";

// eslint-disable-next-line @typescript-eslint/no-explicit-any
type LooseRecord = Record<string, any>;

const promptEntries = Array.isArray(promptsData.entries)
  ? promptsData.entries
  : [];
const manifestEntries = Array.isArray(manifestData.articles)
  ? manifestData.articles
  : [];
const manifestBySlug = new Map(
  manifestEntries.map(entry => [entry.slug, entry])
);
const p0Index = new Map(HERO_P0_ORDER.map((slug, index) => [slug, index]));
const p0MetadataBySlug: LooseRecord = HERO_P0_METADATA;

const entries = promptEntries
  .map(entry => {
    const manifest = (manifestBySlug.get(entry.slug) ?? {}) as LooseRecord;
    const batch = p0MetadataBySlug[entry.slug] ?? null;
    return {
      slug: entry.slug,
      title: manifest.title ?? entry.slug,
      category: manifest.category ?? entry.selectors?.category ?? "general",
      cluster: manifest.cluster ?? entry.selectors?.cluster ?? "general",
      summary: manifest.summary ?? "",
      template: entry.template,
      approvedModelId: entry.approvedModelId,
      sceneId: entry.sceneId,
      toneClass: entry.toneClass,
      readerSituation: entry.readerSituation,
      visualEvidence: entry.visualEvidence,
      prompt: entry.prompt,
      targetImagePath: entry.targetImagePath,
      palette: entry.palette,
      inP0Batch: Boolean(batch),
      batchPriority: batch?.priority ?? null,
      batchSubgroup: batch?.subgroup ?? null,
      batchWhyFirst: batch?.whyFirst ?? manifest.summary ?? "",
      batchConcept: batch?.concept ?? "",
      batchPassCue: batch?.passCue ?? "",
      batchObservedFailures: batch?.observedFailures ?? [],
      batchRevisionGoal: batch?.revisionGoal ?? "",
      sortIndex: p0Index.get(entry.slug) ?? Number.MAX_SAFE_INTEGER,
    };
  })
  .sort((a, b) => {
    const p0Order = a.sortIndex - b.sortIndex;
    if (p0Order !== 0) return p0Order;
    return a.title.localeCompare(b.title);
  });
---

<!doctype html>
<html lang="es" style="background:#0a0a0a; color:#e5e5e5;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Hero Images – Prompt Workspace</title>
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        padding: 0;
        font-family: "DM Mono", "Courier New", monospace;
        background: #0a0a0a;
        color: #e5e5e5;
        min-height: 100vh;
      }
    </style>
  </head>
  <body>
    <HeroPromptWorkspace client:only="react" entries={entries} />
  </body>
</html>
