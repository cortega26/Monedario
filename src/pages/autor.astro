---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { getPath } from "@/utils/getPath";
import { SITE } from "@/config";

const WEB3FORMS_KEY = "4ec75a20-71b7-4f2a-8f6b-ab10b9c2fe61";

const CANONICAL_URL = new URL("/autor/", Astro.site ?? Astro.url.origin).href;
const SITE_URL = (Astro.site ?? new URL(Astro.url.origin)).href.replace(
  /\/$/,
  ""
);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": CANONICAL_URL,
  name: SITE.authorFullName,
  url: CANONICAL_URL,
  image: new URL(SITE.authorImage, Astro.site ?? Astro.url.origin).href,
  jobTitle: "Editor de educación financiera y analista de datos",
  description:
    "Vive en Santiago desde 2014. Titulado en Derecho en Venezuela (Abogado, 2004-2009) y analista de datos. Edita Monedario, sitio de educación financiera para Chile, donde explica el sistema financiero chileno combinando análisis cuantitativo con revisión del ordenamiento jurídico vigente.",
  knowsAbout: [
    "Educación financiera",
    "Finanzas personales",
    "Normativa financiera chilena",
    "Regulación del consumidor financiero",
    "AFP y sistema previsional",
    "Impuestos personas naturales Chile",
    "Ahorro e inversión",
    "Crédito de consumo",
    "Seguro de cesantía",
    "Análisis de datos",
  ],
  sameAs: [SITE.authorLinkedIn, SITE.profile, SITE.authorPortfolio],
  worksFor: {
    "@type": "Organization",
    name: SITE.title,
    url: SITE_URL,
  },
};
---

<Layout
  title={`${SITE.authorFullName} — Autor | ${SITE.title}`}
  description="Investigador financiero y desarrollador de herramientas de educación financiera para Chile. Conoce quién escribe Monedario y su proceso editorial de siete etapas."
  canonicalURL={CANONICAL_URL}
>
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify(personSchema)}
  />
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-16">
    <!-- HERO -->
    <section class="border-b border-border py-10">
      <p
        class="mb-3 text-xs font-semibold tracking-widest text-accent uppercase"
      >
        Autor
      </p>
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
        <img
          src={SITE.authorImage}
          alt={`Foto de ${SITE.authorFullName}`}
          width="452"
          height="461"
          class="h-24 w-24 shrink-0 rounded-full border-2 border-accent/30 object-cover object-center"
          loading="eager"
          decoding="async"
        />
        <div>
          <h1 class="mb-1 text-3xl font-bold sm:text-4xl">
            {SITE.authorFullName}
          </h1>
          <p class="text-sm font-medium text-accent">
            Investigador financiero · Titulado en Derecho (Venezuela) · Analista
            de datos
          </p>
          <div class="mt-3 flex flex-wrap gap-3 text-sm">
            <a
              href={SITE.authorLinkedIn}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1.5 rounded-md border border-border px-3 py-1.5 text-secondary transition-colors hover:border-accent hover:text-accent"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                ></path>
              </svg>
              LinkedIn
            </a>
            <a
              href={SITE.profile}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1.5 rounded-md border border-border px-3 py-1.5 text-secondary transition-colors hover:border-accent hover:text-accent"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                ></path>
              </svg>
              GitHub
            </a>
            <a
              href={SITE.authorPortfolio}
              target="_blank"
              rel="noopener"
              class="flex items-center gap-1.5 rounded-md border border-border px-3 py-1.5 text-secondary transition-colors hover:border-accent hover:text-accent"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
                ></path>
                <path
                  d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                ></path>
              </svg>
              Portafolio
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- BIO -->
    <section class="border-b border-border py-10">
      <h2 class="mb-4 text-xl font-bold">Sobre el autor</h2>
      <div class="max-w-2xl space-y-4 text-base leading-relaxed text-secondary">
        <p>
          Vive en Santiago desde 2014. Titulado en Derecho en Venezuela
          (Abogado, 2004-2009) y analista de datos. Investigador financiero y
          desarrollador de herramientas de educación financiera para Chile.
        </p>
        <p>
          En <strong class="text-foreground">Monedario</strong> combina ambas formaciones
          para explicar el sistema financiero chileno con dos lentes complementarias:
          la <strong class="text-foreground">matemática</strong> detrás de cada cifra
          y el <strong class="text-foreground"
            >ordenamiento jurídico vigente</strong
          > que la regula. Investiga normativa, analiza instrumentos de ahorro, deuda,
          impuestos y pensiones, y construye calculadoras y guías cuyo objetivo es
          que el lector pueda verificar, no creer.
        </p>
        <p>
          Además de Monedario, ha publicado otras herramientas financieras de
          código abierto:
          <a
            href="https://github.com/cortega26/portfolio-manager-server"
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent underline underline-offset-4 hover:opacity-80"
            >portfolio-manager-server</a
          >, un gestor de portafolio para traders, y
          <a
            href="https://pypi.org/project/bankrecon/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent underline underline-offset-4 hover:opacity-80"
            >bankrecon</a
          >, una dependencia Python autoinstalable para conciliación bancaria.
          Mantiene un
          <a
            href={SITE.authorPortfolio}
            target="_blank"
            rel="noopener"
            class="text-accent underline underline-offset-4 hover:opacity-80"
            >portafolio profesional</a
          >
          con proyectos de automatización, datos y herramientas web en producción.
          También es curador de contenidos para
          {
            /* Sin noreferrer: dominio propio del autor, conserva referrer
              para analytics cross-site. */
          }
          <a
            href="https://noticiencias.com"
            target="_blank"
            rel="noopener"
            class="text-accent underline underline-offset-4 hover:opacity-80"
            >noticiencias.com</a
          >.
        </p>
        <p>
          Carlos no es abogado habilitado para ejercer en Chile ni asesor
          financiero certificado. El sitio no apela a esos títulos: apela a un
          método auditable —fuentes citadas, fórmulas a la vista, separación
          entre quien redacta y quien revisa— descrito en la
          <a
            href={getPath("/metodologia/")}
            class="text-accent underline underline-offset-4 hover:opacity-80"
            >metodología</a
          > del sitio.
        </p>
      </div>
    </section>

    <!-- FIRMA EDITORIAL -->
    <section class="border-b border-border py-10">
      <h2 class="mb-4 text-xl font-bold">Firma editorial</h2>
      <p class="max-w-2xl text-base leading-relaxed text-secondary">
        Los contenidos firmados por Carlos siguen el
        <a
          href={getPath("/metodologia/")}
          class="text-accent underline underline-offset-4 hover:opacity-80"
          >proceso editorial de siete etapas</a
        > de Monedario: trazabilidad de fuentes oficiales, auditoría independiente
        de cálculos y revisión regulatoria antes de publicar. Sin esa firma, el artículo
        no se publica.
      </p>
    </section>

    <!-- INDEPENDENCIA EDITORIAL -->
    <section class="border-b border-border py-10">
      <div class="max-w-2xl rounded-xl border border-accent/20 bg-accent/5 p-6">
        <h2 class="mb-3 text-lg font-bold">🔒 Independencia editorial</h2>
        <p class="text-sm leading-relaxed text-secondary">
          Monedario es un proyecto de educación financiera dedicado a explicar
          el sistema financiero chileno de forma clara, rigurosa y basada en
          fuentes oficiales. Su misión es ayudar a las personas a entender
          decisiones financieras complejas —ahorro, inversión, impuestos,
          crédito o pensiones— sin conflictos de interés.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-secondary">
          <strong class="text-foreground">
            El sitio mantiene independencia editorial:
          </strong>
          su contenido no está condicionado por comisiones, publicidad financiera
          ni acuerdos con instituciones financieras.
        </p>
      </div>
    </section>

    <!-- CONTACTO -->
    <section id="contacto" class="border-b border-border py-10">
      <h2 class="mb-4 text-xl font-bold">Contacto</h2>
      <div class="max-w-2xl space-y-6">
        <p class="text-base leading-relaxed text-secondary">
          Puedes escribir directamente a{" "}
          <span
            class="inline-block rounded-md border border-border bg-surface-muted/40 px-3 py-1 font-mono text-sm text-foreground select-none"
            aria-label="Dirección de correo electrónico: contacto arroba monedario punto cl"
          >
            <span
              style="unicode-bidi: bidi-override; direction: ltr;"
              aria-hidden="true">contacto</span
            ><span aria-hidden="true">[at]</span><span
              style="unicode-bidi: bidi-override; direction: ltr;"
              aria-hidden="true">monedario.cl</span
            >
          </span>
          {" "}o usar el formulario de reporte más abajo.
        </p>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-xl border border-border p-5">
            <p class="mb-2 text-sm font-semibold text-foreground">¿Para qué sirve?</p>
            <ul class="space-y-1.5 text-sm text-secondary">
              <li class="flex gap-2">
                <span class="shrink-0 text-accent">✔</span>
                <span>Reportar un dato desactualizado o error factual.</span>
              </li>
              <li class="flex gap-2">
                <span class="shrink-0 text-accent">✔</span>
                <span>Sugerir un tema, calculadora o entrada de glosario.</span>
              </li>
              <li class="flex gap-2">
                <span class="shrink-0 text-accent">✔</span>
                <span>Preguntas sobre el contenido publicado.</span>
              </li>
            </ul>
          </div>
          <div class="rounded-xl border border-border p-5">
            <p class="mb-2 text-sm font-semibold text-foreground">¿Para qué NO sirve?</p>
            <ul class="space-y-1.5 text-sm text-secondary">
              <li class="flex gap-2">
                <span class="shrink-0 text-red-400">✕</span>
                <span>Asesoría legal, tributaria o financiera personalizada.</span>
              </li>
              <li class="flex gap-2">
                <span class="shrink-0 text-red-400">✕</span>
                <span>Revisión de documentos privados o casos individuales.</span>
              </li>
            </ul>
          </div>
        </div>

        <div
          class="rounded-xl border border-border bg-surface-muted/30 p-5 text-sm text-secondary"
        >
          <p class="font-semibold text-foreground">Aviso importante</p>
          <p class="mt-1.5 leading-relaxed">
            El contenido publicado tiene fines informativos y pedagógicos
            únicamente. No constituye asesoría legal, tributaria ni financiera,
            y no debe utilizarse como sustituto de la consulta con un
            profesional habilitado.
          </p>
        </div>
      </div>
    </section>

    <!-- REPORTAR ERROR -->
    <section id="reportar-error" class="mb-10 py-10">
      <h2 class="mb-2 text-xl font-bold">Reportar un error</h2>
      <p class="mb-6 max-w-xl text-sm text-secondary">
        Si encontraste un error factual, un cálculo incorrecto, un problema de
        visualización u otro tipo de incidencia, usa este formulario. Al enviar
        se abrirá tu cliente de email con todos los campos pre-llenados.
      </p>

      <form
        id="error-report-form"
        novalidate
        data-key={WEB3FORMS_KEY}
        class="max-w-xl space-y-5"
      >
        {/* Honeypot — bots fill this, humans don't */}
        <input type="checkbox" name="botcheck" class="hidden" aria-hidden="true" />
        <div>
          <label
            for="er-tipo"
            class="mb-1.5 block text-sm font-medium text-foreground"
            >Tipo de reporte <span class="text-red-400" aria-hidden="true">*</span></label
          >
          <select
            id="er-tipo"
            name="tipo"
            required
            class="w-full rounded-lg border border-border bg-surface-muted/30 px-3 py-2.5 text-sm text-foreground focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
          >
            <option value="">— Selecciona el tipo —</option>
            <option value="Error factual">Error factual (dato incorrecto o desactualizado)</option>
            <option value="Error de cálculo">Error de cálculo (resultado incorrecto en calculadora)</option>
            <option value="Problema de visualización">Problema de visualización (rendering, móvil, etc.)</option>
            <option value="Enlace roto">Enlace roto</option>
            <option value="Sugerencia de mejora">Sugerencia de mejora</option>
            <option value="Otro">Otro</option>
          </select>
        </div>

        <div>
          <label
            for="er-url"
            class="mb-1.5 block text-sm font-medium text-foreground"
            >URL afectada <span class="text-muted text-xs font-normal">(opcional)</span></label
          >
          <input
            id="er-url"
            name="url_afectada"
            type="url"
            placeholder="https://monedario.cl/..."
            class="w-full rounded-lg border border-border bg-surface-muted/30 px-3 py-2.5 text-sm text-foreground placeholder:text-muted focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
          />
        </div>

        <div>
          <label
            for="er-desc"
            class="mb-1.5 block text-sm font-medium text-foreground"
            >Descripción <span class="text-red-400" aria-hidden="true">*</span></label
          >
          <textarea
            id="er-desc"
            name="descripcion"
            required
            rows="4"
            placeholder="Describe el problema con el mayor detalle posible…"
            class="w-full resize-y rounded-lg border border-border bg-surface-muted/30 px-3 py-2.5 text-sm text-foreground placeholder:text-muted focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
          ></textarea>
        </div>

        <div>
          <label
            for="er-email"
            class="mb-1.5 block text-sm font-medium text-foreground"
            >Tu email <span class="text-muted text-xs font-normal">(opcional, para seguimiento)</span></label
          >
          <input
            id="er-email"
            name="email_respuesta"
            type="email"
            placeholder="tu@email.com"
            class="w-full rounded-lg border border-border bg-surface-muted/30 px-3 py-2.5 text-sm text-foreground placeholder:text-muted focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
          />
        </div>

        <div id="er-error" role="alert" class="hidden rounded-lg border border-red-400/30 bg-red-400/10 px-4 py-2.5 text-sm text-red-400"></div>

        <button
          type="submit"
          class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90 disabled:opacity-50"
        >
          Enviar reporte
        </button>

        <p id="er-success" role="status" class="hidden rounded-lg border border-green-500/30 bg-green-500/10 px-4 py-3 text-sm text-green-600 dark:text-green-400">
          Reporte enviado. Gracias — revisaremos y responderemos si dejaste email.
        </p>
      </form>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const form = document.getElementById(
    "error-report-form"
  ) as HTMLFormElement | null;
  if (!form) throw new Error("error-report-form not found");

  // Auto-fill URL from ?url= query param
  const urlParam = new URLSearchParams(window.location.search).get("url");
  if (urlParam) {
    const urlInput = form.querySelector<HTMLInputElement>('[name="url_afectada"]');
    if (urlInput) urlInput.value = decodeURIComponent(urlParam);
  }

  form.addEventListener("submit", async e => {
    e.preventDefault();
    const errorEl = document.getElementById("er-error");
    const successEl = document.getElementById("er-success");
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    if (errorEl) errorEl.classList.add("hidden");
    if (successEl) successEl.classList.add("hidden");

    const data = new FormData(form);
    const tipo = (data.get("tipo") as string) ?? "";
    const descripcion = (data.get("descripcion") as string) ?? "";

    if (!tipo || !descripcion.trim()) {
      if (errorEl) {
        errorEl.textContent =
          "Por favor, selecciona el tipo de reporte y añade una descripción.";
        errorEl.classList.remove("hidden");
      }
      return;
    }

    if (btn) {
      btn.textContent = "Enviando…";
      btn.disabled = true;
    }

    const urlAfectada = (data.get("url_afectada") as string) ?? "";
    const emailRespuesta = (data.get("email_respuesta") as string) ?? "";
    const accessKey = form.dataset.key ?? "";

    try {
      const res = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({
          access_key: accessKey,
          subject: `[Monedario] [${tipo}]${urlAfectada ? " — " + urlAfectada : ""}`,
          from_name: "Monedario — Formulario de reporte",
          replyto: emailRespuesta || undefined,
          tipo,
          url_afectada: urlAfectada || "(no especificada)",
          descripcion: descripcion.trim(),
          email_respuesta: emailRespuesta || "(no proporcionado)",
          botcheck: "",
        }),
      });

      const json = await res.json();

      if (json.success) {
        form.reset();
        if (successEl) successEl.classList.remove("hidden");
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
          "input, textarea, select"
        ).forEach(el => el.setAttribute("disabled", ""));
        if (btn) btn.textContent = "Enviado";
      } else {
        const msg = json.message ?? "Error desconocido";
        throw new Error(msg);
      }
    } catch (err) {
      const msg = err instanceof Error ? err.message : "Error de red";
      if (errorEl) {
        errorEl.textContent = msg;
        errorEl.classList.remove("hidden");
      }
      if (btn) {
        btn.textContent = "Enviar reporte";
        btn.disabled = false;
      }
    }
  });
</script>
