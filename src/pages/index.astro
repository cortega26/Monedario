---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getBalancedHomepagePosts } from "@/utils/homepage";
import ResumeWidget from "@/components/ResumeWidget.astro";
import HeroHomepage from "@/components/HeroHomepage.astro";
import ProblemCards from "@/components/ProblemCards.astro";
import IndicadoresHoy from "@/components/IndicadoresHoy.astro";
import { getPath } from "@/utils/getPath";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const { richPosts: recentRichPosts } = getBalancedHomepagePosts(sortedPosts, {
  richCount: 3,
  totalCount: 3,
});
const homeTitle = "Monedario — Guías y calculadoras financieras para Chile";
const homeDescription =
  "Calculadoras y guías para entender sueldo líquido, AFP, impuestos, crédito, UF y presupuesto con información clara y práctica para Chile.";
const heroTitle = "Calculadoras y guías sobre tu plata en Chile";
const heroDescription =
  "Calculadoras claras para sueldo líquido, AFP, impuestos, crédito, UF y presupuesto en Chile.";
---

<Layout
  title={homeTitle}
  description={homeDescription}
  enableClientRouter={false}
>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-analytics-page-type="home"
    class="app-layout"
  >
    <section class="border-b border-border py-8 lg:py-10">
      <HeroHomepage headline={heroTitle} description={heroDescription} />
    </section>

    <div class="border-b border-border py-3">
      <IndicadoresHoy />
    </div>

    <div class="py-4">
      <ResumeWidget />
    </div>

    <ProblemCards />

    <section
      class="mt-6 mb-10 rounded-xl border border-accent/15 bg-accent/5 px-6 py-5"
    >
      <div
        class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
      >
        <div>
          <h2 class="homepage-body-heading text-lg font-semibold">
            Calcula tu caso
          </h2>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-secondary">
            Estima tu sueldo líquido, AFP, crédito o costo en UF con datos
            reales. Sin registro.
          </p>
        </div>
        <LinkButton
          href={getPath("/calculadoras/")}
          data-analytics-cta="home-calculators"
          data-analytics-label="Ver calculadoras"
          data-analytics-location="home_calculators"
        >
          Ver calculadoras <IconArrowRight
            class="inline-block rtl:-rotate-180"
          />
        </LinkButton>
      </div>
    </section>

    {
      recentRichPosts.length > 0 && (
        <section
          class="py-5 lg:py-6"
          style="content-visibility: auto; contain-intrinsic-size: 600px;"
        >
          <div class="rounded-xl bg-surface-muted/22 px-4 py-5 sm:px-6 sm:py-6">
            <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
              <div>
                <h2 class="homepage-body-heading text-xl font-semibold tracking-wide">
                  Artículos recientes
                </h2>
              </div>
              <LinkButton
                href={getPath("/posts/")}
                class="text-sm font-semibold"
                data-analytics-cta="home-all-posts-inline"
                data-analytics-label="Ver todos los artículos"
                data-analytics-location="home_recent_heading"
              >
                Ver todos los artículos{" "}
                <IconArrowRight class="inline-block rtl:-rotate-180" />
              </LinkButton>
            </div>

            <ul class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
              {recentRichPosts.map(post => (
                <Card variant="h3" {...post} />
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<style is:global>
  [data-layout="index"] .homepage-body-heading {
    font-family: var(--font-body);
  }
</style>
