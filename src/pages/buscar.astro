---
import "@pagefind/default-ui/css/ui.css";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
import { getPath } from "@/utils/getPath";

const backUrl = SITE.showBackButton ? `${Astro.url.pathname}` : getPath("/");
const initialQuery = Astro.url.searchParams.get("q") ?? "";

const searchGroups = [
  {
    label: "Ingresos",
    chips: [
      {
        label: "Sueldo líquido",
        href: getPath("/calculadoras/sueldo-liquido/"),
        type: "calculadora",
      },
      {
        label: "Liquidación de sueldo",
        href: getPath("/posts/liquidacion-de-sueldo/"),
        type: "guía",
      },
      {
        label: "Finiquito",
        href: getPath("/calculadoras/finiquito-indemnizacion/"),
        type: "calculadora",
      },
      {
        label: "Honorarios",
        href: getPath("/posts/boleta-honorarios-2026-retencion-cobertura/"),
        type: "guía",
      },
      {
        label: "UF y arriendo",
        href: getPath("/calculadoras/reajuste-arriendo/"),
        type: "calculadora",
      },
    ],
  },
  {
    label: "Deudas",
    chips: [
      {
        label: "DICOM",
        href: getPath("/posts/donde-ver-si-estoy-en-dicom-gratis/"),
        type: "guía",
      },
    ],
  },
  {
    label: "Impuestos",
    chips: [
      {
        label: "Operación Renta",
        href: getPath("/posts/operacion-renta-f22-checklist/"),
        type: "guía",
      },
    ],
  },
  {
    label: "Previsión",
    chips: [
      {
        label: "AFP",
        href: getPath("/posts/cuanto-descuenta-la-afp-de-tu-sueldo/"),
        type: "guía",
      },
      {
        label: "Cesantía",
        href: getPath("/calculadoras/seguro-cesantia/"),
        type: "calculadora",
      },
      {
        label: "APV",
        href: getPath("/calculadoras/apv/"),
        type: "calculadora",
      },
    ],
  },
  {
    label: "Glosario",
    chips: [
      {
        label: "Gratificación",
        href: getPath("/glosario/gratificacion/"),
        type: "glosario",
      },
      {
        label: "CAE",
        href: getPath("/glosario/cae/"),
        type: "glosario",
      },
    ],
  },
];
---

<Layout
  title={`Buscar | ${SITE.title}`}
  description="Buscador interno de Monedario para encontrar artículos y guías. Página utilitaria excluida del objetivo de indexación orgánica."
>
  <meta name="robots" content="noindex,follow" slot="head" />
  <Header />
  <Main
    pageTitle="Buscar en Monedario"
    pageDesc="Encuentra artículos, calculadoras y definiciones de Monedario. Escribe el tema que te preocupa y te mostramos las guías, herramientas y fichas legales relacionadas."
  >
    <form
      id="search-form"
      role="search"
      class="mb-6 rounded-xl border border-border bg-surface-muted p-4 sm:p-5"
      action={Astro.url.pathname}
    >
      <label for="site-search" class="sr-only">Buscar en Monedario</label>
      <div class="flex flex-col gap-3 sm:flex-row">
        <input
          id="site-search"
          name="q"
          type="search"
          value={initialQuery}
          placeholder="Ej: sueldo líquido, AFP, DICOM"
          autocomplete="off"
          enterkeyhint="search"
          class="min-h-12 flex-1 rounded-lg border border-border bg-background px-4 py-3 text-base text-foreground placeholder:text-secondary/70 focus:border-accent focus:outline-none"
        />
        <button
          type="submit"
          class="inline-flex min-h-12 items-center justify-center rounded-lg bg-accent px-5 py-3 text-base font-medium text-background transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          Buscar
        </button>
      </div>

      <p class="mt-3 text-sm text-secondary">
        Escribe un tema y te mostramos guías, calculadoras y definiciones
        relacionadas.
      </p>
    </form>

    <div class="mb-6" id="search-chips">
      <p class="mb-3 text-sm font-medium text-secondary">Temas frecuentes</p>
      <div class="flex flex-col gap-4">
        {
          searchGroups.map(group => (
            <div>
              <p class="mb-2 text-xs font-semibold tracking-wide text-muted uppercase">
                {group.label}
              </p>
              <div class="flex flex-wrap gap-2">
                {group.chips.map(chip => (
                  <a
                    href={chip.href}
                    class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface-muted px-3 py-1 text-sm text-secondary transition-colors hover:border-accent/60 hover:text-foreground"
                    data-analytics-cta="search-chip"
                    data-analytics-label={chip.label}
                    data-analytics-location="search_chips"
                  >
                    {chip.label}
                    <span class="text-xs text-muted">({chip.type})</span>
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div
      id="pagefind-search"
      role="region"
      aria-label="Resultados de búsqueda"
      transition:persist
      data-backurl={backUrl}
    >
    </div>

    <div
      id="search-empty-state"
      class="mt-4 hidden rounded-xl border border-dashed border-border bg-surface-muted/40 p-4"
      data-search-empty-state
    >
      <p class="text-sm font-semibold text-foreground">
        No encontramos resultados para esa búsqueda.
      </p>
      <p class="mt-1 text-xs text-muted">
        Prueba con otro término o entra directo a un tema frecuente.
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <button
          type="button"
          id="search-clear-button"
          class="inline-flex items-center gap-1.5 rounded-full bg-accent px-3 py-1 text-sm font-medium text-background transition-opacity hover:opacity-90"
        >
          Limpiar búsqueda
        </button>
        {
          searchGroups
            .flatMap(group => group.chips)
            .slice(0, 6)
            .map(chip => (
              <a
                href={chip.href}
                class="inline-flex items-center gap-1.5 rounded-full border border-border bg-background px-3 py-1 text-sm text-secondary transition-colors hover:border-accent/60 hover:text-foreground"
                data-analytics-cta="search-empty-chip"
                data-analytics-label={chip.label}
                data-analytics-location="search_empty_state"
              >
                {chip.label}
              </a>
            ))
        }
      </div>
    </div>
  </Main>
  <Footer />
</Layout>

<script>
  import { trackAnalyticsEvent } from "@/utils/analytics";

  /** Sanitiza posibles patrones de PII en términos de búsqueda antes de enviarlos a analytics. */
  function sanitizeSearchTerm(term: string): string {
    return term
      .replace(/\d{1,2}\.\d{3}\.\d{3}[-][\dkK]/g, "[RUT]")
      .replace(/[\w.-]+@[\w.-]+\.\w+/g, "[email]")
      .replace(/\+?56\s?\d{3,4}\s?\d{3,4}\s?\d{3,4}/g, "[tel]");
  }

  function initSearch() {
    const pageFindSearch = document.querySelector("#pagefind-search");
    const searchForm = document.querySelector("#search-form");
    const searchField = document.querySelector("#site-search");

    if (
      !(pageFindSearch instanceof HTMLElement) ||
      !(searchForm instanceof HTMLFormElement) ||
      !(searchField instanceof HTMLInputElement)
    ) {
      return;
    }

    const params = new URLSearchParams(window.location.search);
    const onIdle = window.requestIdleCallback || (cb => setTimeout(cb, 1));

    onIdle(async () => {
      // @ts-expect-error — Missing types for @pagefind/default-ui package.
      const { PagefindUI } = await import("@pagefind/default-ui");

      const updateSearchUrl = (term: string) => {
        const normalizedTerm = term.trim();

        if (normalizedTerm) params.set("q", normalizedTerm);
        else params.delete("q");

        const nextQuery = params.toString();
        const nextUrl = nextQuery
          ? `${window.location.pathname}?${nextQuery}`
          : window.location.pathname;

        history.replaceState(history.state, "", nextUrl);

        const backUrl =
          pageFindSearch.dataset.backurl ?? window.location.pathname;
        const storageUrl = nextQuery ? `${backUrl}?${nextQuery}` : backUrl;
        sessionStorage.setItem("backUrl", storageUrl);
      };

      const BASE = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
      const search = new PagefindUI({
        element: "#pagefind-search",
        bundlePath: BASE + "pagefind/",
        showImages: false,
        showSubResults: true,
        pageSize: 8,
        translations: {
          language: "es",
          placeholder: "Buscar",
          clear_search: "Limpiar",
          load_more: "Ver más resultados",
          search_label: "Buscar en este sitio",
          filters_label: "Filtros",
          zero_results: "No se encontraron resultados para [SEARCH_TERM]",
          many_results: "[COUNT] resultados encontrados para [SEARCH_TERM]",
          one_result: "[COUNT] resultado encontrado para [SEARCH_TERM]",
          alt_search:
            "No se encontraron resultados para [SEARCH_TERM]. Mostrando resultados para [DIFFERENT_TERM]",
          search_suggestion:
            "No se encontraron resultados para [SEARCH_TERM]. Prueba una de estas búsquedas:",
          searching: "Buscando [SEARCH_TERM]...",
        },
        processTerm: (term: string) => term.trim(),
      });

      const ZERO_RESULTS_PREFIX = "No se encontraron resultados";
      const emptyState = document.getElementById("search-empty-state");
      const clearSearchButton = document.getElementById(
        "search-clear-button"
      ) as HTMLButtonElement | null;

      const syncSearchState = () => {
        const message = pageFindSearch.querySelector(".pagefind-ui__message");
        if (message instanceof HTMLElement) {
          message.setAttribute("role", "status");
          message.setAttribute("aria-live", "polite");
        }

        const isLoading =
          pageFindSearch.querySelectorAll(".pagefind-ui__loading").length > 0;
        if (isLoading) pageFindSearch.setAttribute("aria-busy", "true");
        else pageFindSearch.removeAttribute("aria-busy");

        const messageText = message?.textContent?.trim() ?? "";
        const hasQuery = searchField.value.trim().length > 0;
        const isEmpty =
          hasQuery && !isLoading && messageText.startsWith(ZERO_RESULTS_PREFIX);
        emptyState?.classList.toggle("hidden", !isEmpty);
      };

      const searchObserver = new MutationObserver(syncSearchState);
      searchObserver.observe(pageFindSearch, {
        childList: true,
        subtree: true,
        characterData: true,
      });
      syncSearchState();

      const clearInternalSearch = () => {
        const pagefindInput = pageFindSearch.querySelector(
          ".pagefind-ui__search-input"
        );
        const clearButton = pageFindSearch.querySelector(
          ".pagefind-ui__search-clear"
        );

        if (clearButton instanceof HTMLButtonElement) {
          clearButton.click();
          return;
        }

        if (pagefindInput instanceof HTMLInputElement) {
          pagefindInput.value = "";
          pagefindInput.dispatchEvent(new Event("input", { bubbles: true }));
        }
      };

      const runSearch = (term: string) => {
        const normalizedTerm = term.trim();

        if (!normalizedTerm) {
          clearInternalSearch();
          updateSearchUrl("");
          syncSearchState();
          return;
        }

        updateSearchUrl(normalizedTerm);
        search.triggerSearch(normalizedTerm);
      };

      clearSearchButton?.addEventListener("click", () => {
        searchField.value = "";
        runSearch("");
        searchField.focus();
      });

      searchForm.addEventListener("submit", event => {
        event.preventDefault();
        const term = searchField.value.trim();
        if (term) {
          trackAnalyticsEvent("search_submit", {
            search_term: sanitizeSearchTerm(term),
          });
        }
        runSearch(searchField.value);
      });

      // Track result clicks via event delegation
      pageFindSearch.addEventListener("click", (e: Event) => {
        const target = e.target as HTMLElement;
        const link = target.closest(".pagefind-ui__result-title a");
        if (link instanceof HTMLAnchorElement) {
          trackAnalyticsEvent("search_result_click", {
            result_url: link.href,
            search_term: sanitizeSearchTerm(searchField.value.trim()),
          });
        }
      });

      let debounceTimer: ReturnType<typeof setTimeout> | null = null;
      searchField.addEventListener("input", () => {
        const term = searchField.value.trim();
        if (debounceTimer !== null) clearTimeout(debounceTimer);
        if (term === "") {
          runSearch("");
          return;
        }
        debounceTimer = setTimeout(() => {
          trackAnalyticsEvent("search_submit", {
            search_term: sanitizeSearchTerm(term),
            source: "debounce",
          });
          runSearch(searchField.value);
        }, 300);
      });

      const query = params.get("q");
      if (query) {
        searchField.value = query;
        search.triggerSearch(query);
      } else {
        updateSearchUrl("");
      }
    });
  }

  document.addEventListener("astro:after-swap", () => {
    const pagefindSearch = document.querySelector("#pagefind-search");

    if (pagefindSearch && pagefindSearch.querySelector("form")) return;

    initSearch();
  });

  initSearch();
</script>

<style is:global>
  #pagefind-search {
    --pagefind-ui-font: var(--font-app);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--background);
    --pagefind-ui-border-radius: 0.375rem;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-image-border-radius: 8px;
    --pagefind-ui-image-box-ratio: 3 / 2;

    .pagefind-ui__form::before,
    .pagefind-ui__search-input,
    .pagefind-ui__search-clear {
      display: none;
    }

    .pagefind-ui__drawer,
    .pagefind-ui__results-area {
      margin-top: 0;
    }

    .pagefind-ui__message {
      padding-top: 0;
    }

    .pagefind-ui__result-title a {
      color: var(--accent);
      outline-offset: 1px;
      outline-color: var(--accent);
      text-decoration-style: dashed;
      text-underline-offset: 4px;
    }

    .pagefind-ui__result-title a:focus-visible {
      text-decoration-line: none;
      outline-width: 2px;
      outline-style: dashed;
    }

    .pagefind-ui__result:last-of-type {
      border-bottom: 0;
    }

    .pagefind-ui__result-nested .pagefind-ui__result-link:before {
      font-family: system-ui;
    }
  }
</style>
