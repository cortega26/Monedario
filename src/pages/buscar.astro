---
import "@pagefind/default-ui/css/ui.css";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
import { getPath } from "@/utils/getPath";

const backUrl = SITE.showBackButton ? `${Astro.url.pathname}` : getPath("/");
const initialQuery = Astro.url.searchParams.get("q") ?? "";
---

<Layout
  title={`Buscar | ${SITE.title}`}
  description="Buscador interno de Monedario para encontrar artículos y guías. Página utilitaria excluida del objetivo de indexación orgánica."
>
  <meta name="robots" content="noindex,follow" slot="head" />
  <Header />
  <Main
    pageTitle="Buscar"
    pageDesc="Busca artículos, leyes y calculadoras sin depender de que el widget cargue primero."
  >
    <form
      id="search-form"
      role="search"
      class="mb-6 rounded-xl border border-border bg-surface-muted p-4 sm:p-5"
      action={Astro.url.pathname}
    >
      <label for="site-search" class="sr-only">Buscar en Monedario</label>
      <div class="flex flex-col gap-3 sm:flex-row">
        <input
          id="site-search"
          name="q"
          type="search"
          value={initialQuery}
          placeholder="Busca artículos, leyes o calculadoras"
          autocomplete="off"
          enterkeyhint="search"
          class="min-h-12 flex-1 rounded-lg border border-border bg-background px-4 py-3 text-base text-foreground placeholder:text-secondary/70 focus:border-accent focus:outline-none"
        />
        <button
          type="submit"
          class="inline-flex min-h-12 items-center justify-center rounded-lg bg-accent px-5 py-3 text-base font-medium text-background transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          Buscar
        </button>
      </div>

      <p class="mt-3 text-sm text-secondary">
        Escribe una palabra clave y te mostraremos coincidencias del sitio.
      </p>
    </form>

    <div id="pagefind-search" transition:persist data-backurl={backUrl}></div>
  </Main>
  <Footer />
</Layout>

<script>
  function initSearch() {
    const pageFindSearch = document.querySelector("#pagefind-search");
    const searchForm = document.querySelector("#search-form");
    const searchField = document.querySelector("#site-search");

    if (
      !(pageFindSearch instanceof HTMLElement) ||
      !(searchForm instanceof HTMLFormElement) ||
      !(searchField instanceof HTMLInputElement)
    ) {
      return;
    }

    const params = new URLSearchParams(window.location.search);
    const onIdle = window.requestIdleCallback || (cb => setTimeout(cb, 1));

    onIdle(async () => {
      // @ts-expect-error — Missing types for @pagefind/default-ui package.
      const { PagefindUI } = await import("@pagefind/default-ui");

      const updateSearchUrl = (term: string) => {
        const normalizedTerm = term.trim();

        if (normalizedTerm) params.set("q", normalizedTerm);
        else params.delete("q");

        const nextQuery = params.toString();
        const nextUrl = nextQuery
          ? `${window.location.pathname}?${nextQuery}`
          : window.location.pathname;

        history.replaceState(history.state, "", nextUrl);

        const backUrl =
          pageFindSearch.dataset.backurl ?? window.location.pathname;
        const storageUrl = nextQuery ? `${backUrl}?${nextQuery}` : backUrl;
        sessionStorage.setItem("backUrl", storageUrl);
      };

      const BASE = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
      const search = new PagefindUI({
        element: "#pagefind-search",
        bundlePath: BASE + "pagefind/",
        showImages: false,
        showSubResults: true,
        translations: {
          language: "es",
          placeholder: "Buscar",
          clear_search: "Limpiar",
          load_more: "Ver más resultados",
          search_label: "Buscar en este sitio",
          filters_label: "Filtros",
          zero_results: "No se encontraron resultados para [SEARCH_TERM]",
          many_results: "[COUNT] resultados encontrados para [SEARCH_TERM]",
          one_result: "[COUNT] resultado encontrado para [SEARCH_TERM]",
          alt_search:
            "No se encontraron resultados para [SEARCH_TERM]. Mostrando resultados para [DIFFERENT_TERM]",
          search_suggestion:
            "No se encontraron resultados para [SEARCH_TERM]. Prueba una de estas búsquedas:",
          searching: "Buscando [SEARCH_TERM]...",
        },
        processTerm: (term: string) => {
          const normalizedTerm = term.trim();
          searchField.value = normalizedTerm;
          updateSearchUrl(normalizedTerm);
          return normalizedTerm;
        },
      });

      const clearInternalSearch = () => {
        const pagefindInput = pageFindSearch.querySelector(
          ".pagefind-ui__search-input"
        );
        const clearButton = pageFindSearch.querySelector(
          ".pagefind-ui__search-clear"
        );

        if (clearButton instanceof HTMLButtonElement) {
          clearButton.click();
          return;
        }

        if (pagefindInput instanceof HTMLInputElement) {
          pagefindInput.value = "";
          pagefindInput.dispatchEvent(new Event("input", { bubbles: true }));
        }
      };

      const runSearch = (term: string) => {
        const normalizedTerm = term.trim();

        if (!normalizedTerm) {
          clearInternalSearch();
          updateSearchUrl("");
          return;
        }

        search.triggerSearch(normalizedTerm);
      };

      searchForm.addEventListener("submit", event => {
        event.preventDefault();
        runSearch(searchField.value);
      });

      searchField.addEventListener("input", () => {
        if (searchField.value.trim() === "") {
          runSearch("");
        }
      });

      const query = params.get("q");
      if (query) {
        searchField.value = query;
        search.triggerSearch(query);
      } else {
        updateSearchUrl("");
      }
    });
  }

  document.addEventListener("astro:after-swap", () => {
    const pagefindSearch = document.querySelector("#pagefind-search");

    if (pagefindSearch && pagefindSearch.querySelector("form")) return;

    initSearch();
  });

  initSearch();
</script>

<style is:global>
  #pagefind-search {
    --pagefind-ui-font: var(--font-app);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--background);
    --pagefind-ui-border-radius: 0.375rem;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-image-border-radius: 8px;
    --pagefind-ui-image-box-ratio: 3 / 2;

    .pagefind-ui__form::before,
    .pagefind-ui__search-input,
    .pagefind-ui__search-clear {
      display: none;
    }

    .pagefind-ui__drawer,
    .pagefind-ui__results-area {
      margin-top: 0;
    }

    .pagefind-ui__message {
      padding-top: 0;
    }

    .pagefind-ui__result-title a {
      color: var(--accent);
      outline-offset: 1px;
      outline-color: var(--accent);
      text-decoration-style: dashed;
      text-underline-offset: 4px;
    }

    .pagefind-ui__result-title a:focus-visible {
      text-decoration-line: none;
      outline-width: 2px;
      outline-style: dashed;
    }

    .pagefind-ui__result:last-of-type {
      border-bottom: 0;
    }

    .pagefind-ui__result-nested .pagefind-ui__result-link:before {
      font-family: system-ui;
    }
  }
</style>
