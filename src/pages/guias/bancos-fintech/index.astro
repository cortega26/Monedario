---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ContentTypeBadge from "@/components/ContentTypeBadge.astro";
import { getPath } from "@/utils/getPath";

// Hub del cluster `bancos-fintech`. El pilar educativo
// (`/posts/bancos-y-fintech-chile/`) pasó auditoría + compliance + sign-off humano
// (Carlos Ortega, 2026-06-23), por lo que el hub quedó indexable y dentro de la
// navegación global (GUIDE_HUB_ORDER). Ver docs/adr/ADR-20260617-bancos-fintech-hub.md.

const recursos = [
  {
    title: "Bancos y fintech en Chile: cómo elegir dónde tener tu cuenta",
    description:
      "La guía completa de la sección: tipos de cuenta, banco vs. fintech, cómo abrir una cuenta básica y cómo saber si una app está regulada.",
    href: "/posts/bancos-y-fintech-chile/",
    cta: "Leer la guía completa",
  },
  {
    title: "Ley Fintech (21.521): qué regula en Chile",
    description:
      "La ficha de la ley que ordena a las apps y plataformas financieras y crea el registro de la CMF.",
    href: "/leyes/ley-21521-fintech/",
    cta: "Ver la ficha de la ley",
  },
  {
    title: "CuentaRUT",
    description:
      "Qué es la cuenta vista más usada del país, en el glosario de Monedario.",
    href: "/glosario/cuenta-rut/",
    cta: "Ver en el glosario",
  },
];

const relacionados = [
  {
    title: "Sueldo y remuneraciones",
    description: "Dónde recibir tu sueldo y entender tu liquidación.",
    href: "/guias/sueldo-remuneraciones/",
  },
  {
    title: "Ahorro e inversión",
    description:
      "Qué hacer con el excedente una vez que tu cuenta está ordenada.",
    href: "/guias/ahorro-e-inversion/",
  },
  {
    title: "Deuda y crédito",
    description: "Entender el costo real del crédito y ordenar tus deudas.",
    href: "/guias/deuda-credito/",
  },
  {
    title: "Presupuesto y control financiero",
    description: "Ordenar tu caja mensual antes de tomar otras decisiones.",
    href: "/guias/presupuesto-control-financiero/",
  },
];
---

<Layout
  title="Bancos y fintech en Chile | Monedario"
  description="Sección sobre bancos y fintech en Chile: dónde tener tu dinero, tipos de cuenta y cómo abrir una cuenta básica."
>
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout">
    <section class="border-b border-border py-8">
      <ContentTypeBadge type="Guía" />
      <h1 class="mb-4 text-3xl font-bold sm:text-4xl">
        Bancos y fintech en Chile
      </h1>
      <p class="max-w-3xl text-secondary">
        Esta sección te ayuda a entender dónde tener tu dinero y cómo moverlo:
        los tipos de cuenta que existen, en qué se diferencia un banco de una
        fintech y cómo abrir y usar una cuenta básica.
      </p>
      <p class="mt-3 max-w-3xl text-sm text-secondary">
        Empieza por la guía completa y apóyate en los recursos relacionados.
      </p>
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Recursos disponibles</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {
          recursos.map(card => (
            <article class="rounded-2xl border border-border p-5">
              <h3 class="text-lg font-semibold">{card.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-secondary">
                {card.description}
              </p>
              <a
                href={getPath(card.href)}
                class="mt-4 inline-flex text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
              >
                {card.cta}
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="py-8">
      <h2 class="mb-4 text-2xl font-bold">Secciones relacionadas</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {
          relacionados.map(item => (
            <article class="rounded-2xl border border-border p-5">
              <h3 class="mb-2 text-lg font-semibold">{item.title}</h3>
              <p class="mb-3 text-sm leading-relaxed text-secondary">
                {item.description}
              </p>
              <a
                href={getPath(item.href)}
                class="text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
              >
                Ir a la sección
              </a>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>
