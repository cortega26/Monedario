---
import { serializeJsonLd } from "@/utils/serializeJsonLd";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ContentTypeBadge from "@/components/ContentTypeBadge.astro";
import ResumeWidget from "@/components/ResumeWidget.astro";
import StartHere from "@/components/StartHere.astro";
import { getPath } from "@/utils/getPath";
import { empleoIngresosCalcCards } from "@/config/hubPillarConfig";

const SITE_BASE = (Astro.site ?? new URL(Astro.url.origin)).href.replace(
  /\/$/,
  ""
);
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Contingencias de Empleo e Ingresos en Chile",
  description:
    "Herramientas y guías para cesantía, licencia médica y finiquito en Chile.",
  url: `${SITE_BASE}/guias/empleo-ingresos/`,
  numberOfItems: 4,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Seguro de cesantía: cuándo puedes cobrar y cuánto te pagan",
      url: `${SITE_BASE}/posts/seguro-de-cesantia/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Wizard: ¿desde qué día pagan la licencia médica?",
      url: `${SITE_BASE}/guias/empleo-ingresos/licencia-medica-wizard/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Licencia médica en Chile: desde qué día te pagan y cómo reclamar",
      url: `${SITE_BASE}/posts/licencia-medica-desde-que-dia-pagan/`,
    },
    {
      "@type": "ListItem",
      position: 4,
      name: "Finiquito e indemnizaciones en Chile: qué te corresponde y cómo revisarlo",
      url: `${SITE_BASE}/posts/finiquito-e-indemnizaciones-en-chile/`,
    },
  ],
};

const articulosSeccion = [
  {
    titulo:
      "Seguro de cesantía: cómo saber tu saldo, cuándo puedes cobrar y cuánto te pagan",
    resumen:
      "Explica cuánto tienes, cuándo puedes cobrar y qué necesitas para pedir el seguro de cesantía.",
    href: getPath("/posts/seguro-de-cesantia/"),
    esHerramienta: false,
  },
  {
    titulo: "🧭 Wizard: ¿desde qué día pagan la licencia médica?",
    resumen:
      "Responde 2–3 preguntas y obtén la regla exacta para tu caso: duración, continuación y sector.",
    href: getPath("/guias/empleo-ingresos/licencia-medica-wizard/"),
    esHerramienta: true,
  },
  {
    titulo: "Licencia médica en Chile: desde qué día te pagan y cómo reclamar",
    resumen:
      "Explica desde qué día te pagan, qué hacer si la rechazan y cómo reclamar.",
    href: getPath("/posts/licencia-medica-desde-que-dia-pagan/"),
    esHerramienta: false,
  },
  {
    titulo:
      "Finiquito e indemnizaciones en Chile: qué te corresponde y cómo revisarlo",
    resumen:
      "Qué revisar en tu finiquito para no firmar con errores de cálculo.",
    href: getPath("/posts/finiquito-e-indemnizaciones-en-chile/"),
    esHerramienta: false,
  },
];
---

<Layout
  title="Contingencias de Empleo e Ingresos en Chile | Monedario"
  description="Guías y artículos sobre cesantía, licencias médicas y finiquito para saber qué hacer cuando se interrumpe tu ingreso laboral."
>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(itemListSchema)}
  />
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout">
    <section class="border-b border-border py-8">
      <!-- Removed Authority Layer tag -->
      <ContentTypeBadge type="Guía" />
      <h1 class="mb-4 text-3xl font-bold sm:text-4xl">
        Contingencias de Empleo e Ingresos en Chile
      </h1>
    </section>

    <section class="py-4">
      <ResumeWidget />
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Elige por la contingencia laboral</h2>
      <ul class="grid gap-4">
        {
          articulosSeccion.map(item => (
            <li class="rounded-xl border border-border p-5">
              {item.esHerramienta && (
                <p class="mb-2 text-xs font-bold tracking-widest text-accent uppercase">
                  Herramienta interactiva
                </p>
              )}
              <h3 class="mb-2 text-lg font-semibold">{item.titulo}</h3>
              <p class="mb-3 text-sm text-secondary">{item.resumen}</p>
              <a
                href={item.href}
                class="text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
                data-analytics-cta={
                  item.esHerramienta ? "hub-tool" : "hub-article"
                }
                data-analytics-label={item.titulo}
                data-analytics-location="empleo_ingresos_hub"
              >
                {item.esHerramienta ? "Ir a la herramienta" : "Ir a esta guía"}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Errores comunes</h2>
      <ul class="list-disc space-y-2 pl-6 text-secondary">
        <li>
          No revisar plazos de reclamo y notificación en contingencias
          laborales.
        </li>
        <li>
          Firmar documentos de cierre sin revisar el cálculo y la causal de
          término.
        </li>
        <li>
          Tratar cesantía, licencia y finiquito como temas aislados cuando
          afectan la misma caja.
        </li>
      </ul>
    </section>

    <div data-hub-section="recommended-route">
      <StartHere
        steps={[
          {
            step: 1,
            title: "Seguro de cesantía en Chile",
            description: "Qué cubre, cuánto paga y cuándo puedes usarlo.",
            href: "/posts/seguro-de-cesantia/",
          },
          {
            step: 2,
            title: "Finiquito e indemnizaciones en Chile",
            description:
              "Derechos según causal de despido y cómo calcular el monto.",
            href: "/posts/finiquito-e-indemnizaciones-en-chile/",
          },
          {
            step: 3,
            title: "Licencia médica: ¿desde qué día pagan?",
            description:
              "Plazos, topes y diferencias entre CCAF, Fonasa e Isapre.",
            href: "/posts/licencia-medica-desde-que-dia-pagan/",
          },
          {
            step: 4,
            title: "Calculadora de finiquito",
            description:
              "Estima sueldo pendiente, vacaciones, aviso previo e indemnización.",
            href: "/calculadoras/finiquito-indemnizacion/",
          },
          {
            step: 5,
            title: "Calculadora de seguro de cesantía",
            description:
              "Estima cobertura AFC según saldo CIC, causal y cotizaciones.",
            href: "/calculadoras/seguro-cesantia/",
          },
        ]}
      />
    </div>

    <section
      data-hub-section="related-calculators"
      class="border-b border-border py-8"
    >
      <h2 class="mb-4 text-2xl font-bold">Calculadoras de esta sección</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {
          empleoIngresosCalcCards.map(card => (
            <article class="rounded-2xl border border-border bg-surface-muted p-5">
              <p class="mb-2 text-xs font-semibold tracking-[0.14em] text-accent uppercase">
                {card.kind}
              </p>
              <h3 class="text-lg font-semibold">{card.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-secondary">
                {card.description}
              </p>
              <a
                href={card.href}
                class="mt-4 inline-flex text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
              >
                {card.cta}
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">No mezcles estas situaciones</h2>
      <ul class="list-disc space-y-2 pl-6 text-secondary">
        <li>
          Cesantía resuelve caja por pérdida de empleo; no reemplaza revisión de
          finiquito.
        </li>
        <li>
          Licencia médica es un flujo de subsidio y rechazo administrativo, no
          un problema de término de contrato.
        </li>
        <li>
          Si tu duda es sueldo mensual, descuentos o liquidación, esta no es la
          sección correcta.
        </li>
      </ul>
    </section>

    <section class="py-8">
      <div class="rounded-xl border border-accent/20 bg-accent/5 p-6">
        <h2 class="mb-2 text-xl font-bold">
          Última actualización de la sección
        </h2>
        <p class="text-sm text-secondary">
          Actualizado: 2026-03-02. Esta sección se revisa cuando cambian reglas
          de subsidios, cesantía, finiquito o normativa laboral con impacto
          directo en ingresos.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
