---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ContentTypeBadge from "@/components/ContentTypeBadge.astro";
import { getPath } from "@/utils/getPath";

// Hub del cluster greenfield. Conserva el alcance definido en
// docs/adr/ADR-20260622-finanzas-migrantes-hub.md.

const recursos = [
  {
    title: "Cómo ordenar tus finanzas en Chile siendo migrante",
    description:
      "Guía inicial sobre identificación tributaria, CuentaRUT y arriendo, con fuentes oficiales y límites claros.",
    href: "/posts/finanzas-para-migrantes-chile/",
    cta: "Leer la guía",
  },
  {
    title: "CuentaRUT",
    description:
      "Definición breve de esta cuenta y enlaces para seguir revisando sus características.",
    href: "/glosario/cuenta-rut/",
    cta: "Ver en el glosario",
  },
  {
    title: "Bancos y fintech",
    description:
      "Recursos para entender cuentas, instituciones y herramientas financieras en Chile.",
    href: "/guias/bancos-fintech/",
    cta: "Ir a la sección",
  },
];

const relacionados = [
  {
    title: "Empleo e ingresos",
    description:
      "Guías sobre trabajo, cesantía, licencias y continuidad de ingresos.",
    href: "/guias/empleo-ingresos/",
  },
  {
    title: "Sueldo y remuneraciones",
    description:
      "Cómo leer el sueldo, sus descuentos y la liquidación mensual.",
    href: "/guias/sueldo-remuneraciones/",
  },
  {
    title: "UF, inflación y costo de vida",
    description:
      "Recursos para entender reajustes que pueden afectar contratos y arriendos.",
    href: "/guias/uf-costo-de-vida/",
  },
  {
    title: "Presupuesto y control financiero",
    description:
      "Herramientas para ordenar ingresos y gastos durante la instalación en Chile.",
    href: "/guias/presupuesto-control-financiero/",
  },
];
---

<Layout
  title="Finanzas para migrantes en Chile | Monedario"
  description="Sección de orientación financiera para personas migrantes en Chile: identidad tributaria, cuentas, ingresos y vivienda."
>
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout">
    <section class="border-b border-border py-8">
      <ContentTypeBadge type="Guía" />
      <h1 class="mb-4 text-3xl font-bold sm:text-4xl">
        Finanzas para migrantes en Chile
      </h1>
      <p class="max-w-3xl text-secondary">
        Esta sección reúne orientación para ordenar los primeros asuntos
        financieros al instalarte en Chile, con fuentes oficiales y límites
        claros sobre lo que corresponde confirmar en cada institución.
      </p>
      <p class="mt-3 max-w-3xl text-sm text-secondary">
        Comienza por la guía principal o consulta los recursos complementarios.
      </p>
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Recursos disponibles</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {recursos.map(card => (
          <article class="rounded-lg border border-border p-5">
            <h3 class="text-lg font-semibold">{card.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-secondary">
              {card.description}
            </p>
            <a
              href={getPath(card.href)}
              class="mt-4 inline-flex text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
            >
              {card.cta}
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="py-8">
      <h2 class="mb-4 text-2xl font-bold">Secciones relacionadas</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {relacionados.map(item => (
          <article class="rounded-lg border border-border p-5">
            <h3 class="mb-2 text-lg font-semibold">{item.title}</h3>
            <p class="mb-3 text-sm leading-relaxed text-secondary">
              {item.description}
            </p>
            <a
              href={getPath(item.href)}
              class="text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
            >
              Ir a la sección
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
