---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ContextLinkSection from "@/components/ContextLinkSection.astro";
import ResumeWidget from "@/components/ResumeWidget.astro";
import StartHere from "@/components/StartHere.astro";
import { getPath } from "@/utils/getPath";
import {
  sueldoClusterHubPrimaryCards,
  sueldoClusterHubSupportCards,
} from "@/config/sueldoClusterLinks";
import { sueldoRemuneracionesCalcCards } from "@/config/hubPillarConfig";
import SupportCallout from "@/components/SupportCallout.astro";

const SITE_BASE = (Astro.site ?? new URL(Astro.url.origin)).href.replace(
  /\/$/,
  ""
);
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Sueldo Líquido y Remuneraciones en Chile",
  description:
    "Calculadoras y guías para calcular sueldo líquido, leer liquidaciones y entender descuentos previsionales en Chile.",
  url: `${SITE_BASE}/guias/sueldo-remuneraciones/`,
  numberOfItems: 6,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Calculadora de sueldo líquido",
      url: `${SITE_BASE}/calculadoras/sueldo-liquido/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Liquidación de sueldo: cómo leerla",
      url: `${SITE_BASE}/posts/liquidacion-de-sueldo/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Cómo calcular tu sueldo líquido",
      url: `${SITE_BASE}/posts/como-calcular-sueldo-liquido/`,
    },
    {
      "@type": "ListItem",
      position: 4,
      name: "Cuánto descuenta la AFP de tu sueldo",
      url: `${SITE_BASE}/posts/cuanto-descuenta-la-afp-de-tu-sueldo/`,
    },
    {
      "@type": "ListItem",
      position: 5,
      name: "Boleta de honorarios 2026",
      url: `${SITE_BASE}/calculadoras/boleta-honorarios-liquido/`,
    },
    {
      "@type": "ListItem",
      position: 6,
      name: "Descuentos de sueldo en Chile",
      url: `${SITE_BASE}/posts/descuentos-de-sueldo/`,
    },
  ],
};

const heroRoutes = {
  calculator: getPath("/calculadoras/sueldo-liquido/"),
  liquidacion: getPath("/posts/liquidacion-de-sueldo/"),
  empleo: getPath("/guias/empleo-ingresos/"),
  honorarios: getPath("/calculadoras/boleta-honorarios-liquido/"),
};

const primaryCards = sueldoClusterHubPrimaryCards.filter(
  card =>
    ![
      heroRoutes.calculator,
      heroRoutes.liquidacion,
      heroRoutes.honorarios,
    ].includes(getPath(card.href))
);

const adjacentRoutes = [
  {
    title: "Contingencias de empleo e ingresos",
    description:
      "Úsalo cuando el problema ya no es la liquidación mensual sino cesantía, licencia médica o finiquito.",
    href: heroRoutes.empleo,
  },
  {
    title: "Pensiones y AFP",
    description:
      "Úsalo cuando la decisión principal pasa a ser cambio de AFP, fondos, APV o planificación previsional.",
    href: getPath("/guias/pensiones-afp/"),
  },
];
---

<Layout
  title="Sueldo Líquido y Remuneraciones en Chile | Monedario"
  description="Guía de entrada para entender sueldo líquido, liquidación, descuentos previsionales, impuesto único y herramientas de cálculo en Chile."
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(itemListSchema)}
  />
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout">
    <section class="border-b border-border py-8">
      <p
        class="mb-2 text-xs font-semibold tracking-widest text-accent uppercase"
      >
        Guía de entrada
      </p>
      <h1 class="mb-4 text-3xl font-bold sm:text-4xl">
        Sueldo líquido y remuneraciones en Chile
      </h1>
    </section>

    <section class="py-4">
      <ResumeWidget />
    </section>

    <section class="border-b border-border py-8">
      <div class="grid gap-4 lg:grid-cols-3">
        <article class="rounded-xl border border-border bg-background p-5">
          <p
            class="text-xs font-semibold tracking-[0.16em] text-accent uppercase"
          >
            Si partes desde una oferta o un bruto
          </p>
          <h2 class="mt-3 text-xl font-semibold">Primero calcula el líquido</h2>
          <p class="mt-2 text-sm leading-relaxed text-secondary">
            Sirve para pasar de bruto e imponible a depósito final sin abrir
            todavía el detalle legal de cada línea.
          </p>
          <a
            href={heroRoutes.calculator}
            class="mt-4 inline-flex text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
          >
            Abrir calculadora
          </a>
        </article>
        <article class="rounded-xl border border-border bg-background p-5">
          <p
            class="text-xs font-semibold tracking-[0.16em] text-accent uppercase"
          >
            Si ya tienes el comprobante
          </p>
          <h2 class="mt-3 text-xl font-semibold">Audita la liquidación</h2>
          <p class="mt-2 text-sm leading-relaxed text-secondary">
            Revisa haberes, descuentos, respaldos y errores típicos antes de
            asumir que el cálculo del empleador está bien.
          </p>
          <a
            href={getPath("/posts/liquidacion-de-sueldo/")}
            class="mt-4 inline-flex text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
          >
            Leer guía
          </a>
        </article>
        <article class="rounded-xl border border-border bg-background p-5">
          <p
            class="text-xs font-semibold tracking-[0.16em] text-accent uppercase"
          >
            Si el problema cambió
          </p>
          <h2 class="mt-3 text-xl font-semibold">¿Tu duda es otra?</h2>
          <p class="mt-2 text-sm leading-relaxed text-secondary">
            Si tu caso no nace en una liquidación, parte por honorarios. Si el
            problema ya cambió a finiquito, cesantía o corte del ingreso, usa la
            sección de cambio de etapa más abajo.
          </p>
          <div class="mt-4 flex flex-wrap gap-3 text-sm font-semibold">
            <a
              href={heroRoutes.honorarios}
              class="text-accent underline underline-offset-4 hover:opacity-80"
            >
              Ver honorarios
            </a>
          </div>
        </article>
      </div>
    </section>

    <ContextLinkSection
      eyebrow="Empieza aquí"
      title="Elige la opción que mejor te ayude"
      description="La decisión correcta depende del trabajo que tienes delante: calcular el depósito, auditar el comprobante, clasificar un descuento o pasar a otra sección porque el problema ya cambió."
      items={primaryCards}
    />

    <div data-hub-section="recommended-route">
      <StartHere
        steps={[
          {
            step: 1,
            title: "Cómo calcular el sueldo líquido",
            description:
              "Fórmula, descuentos legales y qué pasa con el imponible.",
            href: "/posts/como-calcular-sueldo-liquido/",
          },
          {
            step: 2,
            title: "Descuentos de sueldo en Chile",
            description:
              "AFP, salud, cesantía, impuesto: qué descuenta cada uno y por qué.",
            href: "/posts/descuentos-de-sueldo/",
          },
          {
            step: 3,
            title: "Cómo leer tu liquidación de sueldo",
            description: "Entiende cada línea y detecta errores comunes.",
            href: "/posts/liquidacion-de-sueldo/",
          },
          {
            step: 4,
            title: "Calculadora de sueldo líquido",
            description:
              "Calcula tu líquido desde el bruto o el bruto desde el líquido deseado.",
            href: "/calculadoras/sueldo-liquido/",
          },
        ]}
      />
    </div>

    <section
      data-hub-section="related-calculators"
      class="border-b border-border py-8"
    >
      <h2 class="mb-4 text-2xl font-bold">Calculadoras de esta sección</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {
          sueldoRemuneracionesCalcCards.map(card => (
            <article class="rounded-2xl border border-border bg-surface-muted p-5">
              <p class="mb-2 text-xs font-semibold tracking-[0.14em] text-accent uppercase">
                {card.kind}
              </p>
              <h3 class="text-lg font-semibold">{card.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-secondary">
                {card.description}
              </p>
              <a
                href={card.href}
                class="mt-4 inline-flex text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
              >
                {card.cta}
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Qué encontrarás en esta sección</h2>
      <ul class="list-disc space-y-2 pl-6 text-secondary">
        <li>Diferencia entre sueldo bruto, imponible y sueldo líquido.</li>
        <li>
          Descuentos obligatorios que salen de la remuneración: AFP, salud,
          cesantía e impuesto único.
        </li>
        <li>
          Lectura de la liquidación de sueldo y conexión directa con la
          calculadora para revisar montos.
        </li>
        <li>
          Separación entre descuentos obligatorios, autorizados y prohibidos
          para auditar mejor lo que baja tu líquido.
        </li>
        <li>
          Fronteras claras para no mezclar esta sección con honorarios,
          finiquito o cesantía cuando la duda ya se movió de etapa.
        </li>
      </ul>
    </section>

    <ContextLinkSection
      eyebrow="Aclaraciones útiles"
      title="Conceptos y normas para resolver dudas puntuales"
      description="Usa estas ayudas si necesitas entender un término, confirmar una regla o revisar la base legal de un descuento."
      items={sueldoClusterHubSupportCards}
    />

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">
        Cambia de sección si tu duda es otra
      </h2>
      <div class="grid gap-4 md:grid-cols-2">
        {
          adjacentRoutes.map(route => (
            <article class="rounded-xl border border-border p-5">
              <h3 class="text-lg font-semibold">{route.title}</h3>
              <p class="mt-2 text-sm text-secondary">{route.description}</p>
              <a
                href={route.href}
                class="mt-4 inline-flex text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
              >
                Ir a esa sección
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="py-8">
      <div class="rounded-xl border border-accent/20 bg-accent/5 p-6">
        <h2 class="mb-2 text-xl font-bold">
          Última actualización de la sección
        </h2>
        <p class="text-sm text-secondary">
          Actualizado: 2026-03-12. Esta sección se revisa cuando cambian
          porcentajes de descuento, reglas de impuesto único, estructura de la
          liquidación o el puente hacia honorarios, finiquito y cesantía.
        </p>
      </div>
    </section>
    <SupportCallout
      context="guia"
      pageTitle="esta guía sobre sueldo y remuneraciones"
    />
  </main>

  <Footer />
</Layout>
