---
import { serializeJsonLd } from "@/utils/serializeJsonLd";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ContentTypeBadge from "@/components/ContentTypeBadge.astro";
import ResumeWidget from "@/components/ResumeWidget.astro";
import StartHere from "@/components/StartHere.astro";
import { getPath } from "@/utils/getPath";
import { impuestosPersonasCalcCards } from "@/config/hubPillarConfig";
import SupportCallout from "@/components/SupportCallout.astro";

const SITE_BASE = (Astro.site ?? new URL(Astro.url.origin)).href.replace(
  /\/$/,
  ""
);
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Impuestos para Personas en Chile",
  description:
    "Guías sobre Operación Renta F22, devolución de impuestos y boletas de honorarios en Chile.",
  url: `${SITE_BASE}/guias/impuestos-personas/`,
  numberOfItems: 4,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Centro Operación Renta 2026: F22, rectificación, devolución y retenciones",
      url: `${SITE_BASE}/guias/impuestos-personas/operacion-renta/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Operación Renta F22 en Chile: checklist para revisar, enviar y rectificar sin errores",
      url: `${SITE_BASE}/posts/operacion-renta-f22-checklist/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Devolución de impuestos en Chile: fechas de pago, estado y compensaciones",
      url: `${SITE_BASE}/posts/devolucion-impuestos-fechas-compensaciones/`,
    },
    {
      "@type": "ListItem",
      position: 4,
      name: "Boleta de honorarios 2026: retención 15,25%, líquido recibido y cobertura anual",
      url: `${SITE_BASE}/posts/boleta-honorarios-2026-retencion-cobertura/`,
    },
  ],
};

const rutasPrincipales = [
  {
    titulo:
      "Centro Operación Renta 2026: F22, rectificación, devolución y retenciones",
    resumen:
      "Subcaso por subcaso: calendario OR, checklist del F22, cómo rectificar observaciones, estado de devolución y compensaciones TGR.",
    href: getPath("/guias/impuestos-personas/operacion-renta/"),
    esSubhub: true,
  },
  {
    titulo:
      "Operación Renta F22 en Chile: checklist para revisar, enviar y rectificar sin errores",
    resumen:
      "Úsala si vas a declarar, si ya viste la propuesta o si necesitas revisar reemplazo y rectificatoria sin saltar entre varias páginas.",
    href: getPath("/posts/operacion-renta-f22-checklist/"),
    esSubhub: false,
  },
  {
    titulo:
      "Devolución de impuestos en Chile: fechas de pago, estado y compensaciones",
    resumen:
      "Explica ventanas de pago, seguimiento en SII/TGR y qué hacer ante retenciones o compensaciones.",
    href: getPath("/posts/devolucion-impuestos-fechas-compensaciones/"),
    esSubhub: false,
  },
  {
    titulo:
      "Boleta de honorarios 2026: retención 15,25%, líquido recibido y cobertura anual",
    resumen:
      "Aclara retención vigente, impacto en líquido mensual y cobertura previsional asociada.",
    href: getPath("/posts/boleta-honorarios-2026-retencion-cobertura/"),
    esSubhub: false,
  },
];
---

<Layout
  title="Impuestos para Personas en Chile | Monedario"
  description="Guías y artículos sobre impuestos para personas en Chile para elegir qué leer primero si vas a declarar, revisar una devolución o entender tus boletas."
>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(itemListSchema)}
  />
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout">
    <section class="border-b border-border py-8">
      <!-- Removed Topic Authority Layer tag -->
      <ContentTypeBadge type="Guía" />
      <h1 class="mb-4 text-3xl font-bold sm:text-4xl">
        Impuestos para personas en Chile
      </h1>
    </section>

    <section class="py-4">
      <ResumeWidget />
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Elige la ruta correcta</h2>
      <p class="mb-5 max-w-3xl text-sm leading-relaxed text-secondary">
        Si tu duda es declaración, observaciones o rectificatoria, todo eso vive
        en la misma guía del F22. Solo cambia de ruta cuando el problema real ya
        es la devolución o el líquido de honorarios.
      </p>
      <ul class="grid gap-4">
        {
          rutasPrincipales.map(item => (
            <li class="rounded-xl border border-border p-5">
              {item.esSubhub && (
                <p class="mb-2 text-xs font-bold tracking-widest text-accent uppercase">
                  Centro de recursos
                </p>
              )}
              <h3 class="mb-2 text-lg font-semibold">{item.titulo}</h3>
              <p class="mb-3 text-sm text-secondary">{item.resumen}</p>
              <a
                href={item.href}
                class="text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
              >
                {item.esSubhub ? "Ir al centro OR" : "Resolver esta duda"}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Errores comunes de la sección</h2>
      <ul class="list-disc space-y-2 pl-6 text-secondary">
        <li>Confundir declaración aceptada con devolución pagada.</li>
        <li>Revisar estado solo una vez y no hacer seguimiento en SII/TGR.</li>
        <li>Mezclar reglas de reemplazo con rectificatoria.</li>
        <li>Tomar decisiones sin revisar retenciones o compensaciones.</li>
        <li>
          No revisar el impacto de boletas de honorarios en cobertura anual.
        </li>
      </ul>
    </section>

    <div data-hub-section="recommended-route">
      <StartHere
        steps={[
          {
            step: 1,
            title: "Boleta de honorarios 2026",
            description:
              "Retención, cobertura previsional y declaración anual paso a paso.",
            href: "/posts/boleta-honorarios-2026-retencion-cobertura/",
          },
          {
            step: 2,
            title: "Devolución de impuestos: fechas y compensaciones",
            description:
              "Cuándo pagan, cuánto devuelven y cómo revisar tu estado.",
            href: "/posts/devolucion-impuestos-fechas-compensaciones/",
          },
          {
            step: 3,
            title: "Operación Renta: checklist del F-22",
            description:
              "Los pasos que no debes saltarte al hacer la declaración anual.",
            href: "/posts/operacion-renta-f22-checklist/",
          },
          {
            step: 4,
            title: "Calculadora de impuesto de segunda categoría",
            description:
              "Estima el impuesto mensual según tu sueldo bruto y AFP.",
            href: "/calculadoras/impuesto-segunda-categoria/",
          },
        ]}
      />
    </div>

    <section
      data-hub-section="related-calculators"
      class="border-b border-border py-8"
    >
      <h2 class="mb-4 text-2xl font-bold">Calculadoras de esta sección</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {
          impuestosPersonasCalcCards.map(card => (
            <article class="rounded-2xl border border-border bg-surface-muted p-5">
              <p class="mb-2 text-xs font-semibold tracking-[0.14em] text-accent uppercase">
                {card.kind}
              </p>
              <h3 class="text-lg font-semibold">{card.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-secondary">
                {card.description}
              </p>
              <a
                href={card.href}
                class="mt-4 inline-flex text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
              >
                {card.cta}
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">No mezcles estas decisiones</h2>
      <ul class="list-disc space-y-2 pl-6 text-secondary">
        <li>
          Declarar el F22 y corregir observaciones es la misma conversación: no
          necesitas otra salida aparte del checklist principal.
        </li>
        <li>
          Devolución no es lo mismo que declaración aceptada: cambia de ruta
          solo cuando el problema ya es pago, estado o compensación.
        </li>
        <li>
          Honorarios no se resuelven mirando F22 si tu duda principal es cuánto
          líquido recibes hoy y cómo opera la retención vigente.
        </li>
      </ul>
    </section>

    <section class="py-8">
      <div class="rounded-xl border border-accent/20 bg-accent/5 p-6">
        <h2 class="mb-2 text-xl font-bold">
          Última actualización de la sección
        </h2>
        <p class="text-sm text-secondary">
          Actualizado: 2026-05-08. Esta sección se revisa cuando cambian el
          calendario de Operación Renta, los motivos de observación o devolución
          en SII-TGR, o las reglas de retención para honorarios.
        </p>
      </div>
    </section>
    <SupportCallout
      context="guia-impuestos"
      pageTitle="esta guía sobre impuestos"
    />
  </main>

  <Footer />
</Layout>
