---
import { serializeJsonLd } from "@/utils/serializeJsonLd";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import StartHere from "@/components/StartHere.astro";
import SupportCallout from "@/components/SupportCallout.astro";
import { getPath } from "@/utils/getPath";

const hubPath = getPath("/guias/impuestos-personas/");

const startHereSteps = [
  {
    step: 1,
    title: "Qué necesitas presentar en el F-22",
    description:
      "Revisa el checklist completo antes de declarar: documentos requeridos, cómo leer la propuesta del SII y cuándo usar reemplazo.",
    href: "/posts/operacion-renta-f22-checklist/",
  },
  {
    step: 2,
    title: "Calcula tu resultado estimado",
    description:
      "Usa la calculadora de Operación Renta para estimar cuánto debes pagar o cuánto te corresponde de devolución.",
    href: "/calculadoras/operacion-renta/",
  },
  {
    step: 3,
    title: "Fechas de devolución y compensaciones",
    description:
      "Cuándo te depositan la devolución según cuándo declaraste y qué hacer si TGR tiene compensaciones activas.",
    href: "/posts/devolucion-impuestos-fechas-compensaciones/",
  },
];

const subcasos = [
  {
    id: "envio-f22",
    titulo: "Envío y declaración del F22",
    resumen:
      "Cómo revisar la propuesta del SII, cuándo usar reemplazo y cómo declarar desde cero.",
    href: getPath("/posts/operacion-renta-f22-checklist/"),
    cta: "Ver checklist F22",
  },
  {
    id: "rectificacion",
    titulo: "Rectificatoria y observaciones",
    resumen:
      "Qué hacer si el SII observó tu declaración o si cometiste un error y necesitas rectificar.",
    href: getPath("/posts/operacion-renta-f22-checklist/"),
    cta: "Ver pasos de rectificación",
  },
  {
    id: "devolucion",
    titulo: "Estado de devolución",
    resumen:
      "Cómo consultar el estado, fechas de pago y qué hacer si hay compensaciones o retenciones.",
    href: getPath("/posts/devolucion-impuestos-fechas-compensaciones/"),
    cta: "Consultar estado y fechas",
  },
  {
    id: "retenciones",
    titulo: "Retenciones y compensaciones",
    resumen:
      "Por qué TGR puede retener parte de tu devolución y cómo verificarlo.",
    href: getPath("/posts/devolucion-impuestos-fechas-compensaciones/"),
    cta: "Entender retenciones",
  },
  {
    id: "honorarios",
    titulo: "Honorarios y retención 2026",
    resumen:
      "Cómo impacta la retención del 15,25% en tu líquido mensual y en la declaración anual.",
    href: getPath("/posts/boleta-honorarios-2026-retencion-cobertura/"),
    cta: "Ver guía de honorarios",
  },
];

const faqs = [
  {
    q: "¿Puedo declarar después del 8 de mayo?",
    a: "Sí. Si debes pagar, el SII aplica multa del 10% del impuesto más interés del 1,5% mensual desde el vencimiento (Art. 97 N°2 y Art. 53 CT). Si tienes devolución a tu favor, declarar tarde no genera multa económica, pero retrasa el pago. Es siempre preferible declarar tarde que no declarar.",
  },
  {
    q: "¿Qué pasa si tengo deudas con el SII y me corresponde devolución?",
    a: "Si tienes deudas tributarias vigentes, el SII puede compensar el monto de devolución con la deuda (Art. 51 CT). Lo que quede a tu favor después de la compensación lo transfiere TGR. Si la deuda supera la devolución, recibes $0 y la deuda queda reducida.",
  },
  {
    q: "¿Necesito contador para declarar?",
    a: "Para la mayoría de trabajadores dependientes o independientes con ingresos simples (un empleador o solo honorarios), el portal del SII es suficiente sin contador. Si tienes múltiples fuentes de ingreso, rentas del exterior o ganancias de capital, un contador puede reducir el riesgo de errores.",
  },
  {
    q: "¿Qué documentos necesito tener a mano?",
    a: "Cédula de identidad y RUT; clave tributaria SII (o ClaveÚnica); certificado de remuneraciones del empleador (retenciones anuales); certificado de AFP (movimientos y retenciones del año); número de cuenta bancaria para registrar la devolución en TGR.",
  },
];

const SITE_BASE = (Astro.site ?? new URL(Astro.url.origin)).href.replace(
  /\/$/,
  ""
);
const canonicalUrl = `${SITE_BASE}/guias/impuestos-personas/operacion-renta/`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Centro Operación Renta 2026: recursos y ruta de declaración",
  description:
    "Ruta de recursos para Operación Renta 2026: checklist del F22, calculadora, fechas clave, devolución y canales oficiales.",
  url: canonicalUrl,
  datePublished: "2026-04-29",
  dateModified: "2026-09-29",
  author: { "@type": "Organization", name: "Monedario" },
  publisher: { "@type": "Organization", name: "Monedario", url: SITE_BASE },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(faq => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};
---

<Layout
  title="Operación Renta 2026: centro de recursos del F22 | Monedario"
  description="Ruta de recursos para Operación Renta 2026: checklist del F22, calculadora, plazos verificados, calendario de devolución y canales oficiales del SII."
>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(articleSchema)}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(faqSchema)}
  />
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout">
    <!-- HERO -->
    <section class="border-b border-border py-8">
      <p
        class="mb-2 text-sm font-semibold tracking-widest text-accent uppercase"
      >
        Impuestos para personas
      </p>
      <h1 class="mb-4 text-3xl font-bold sm:text-4xl">
        Centro Operación Renta 2026
      </h1>
      <p class="max-w-3xl text-secondary">
        Ruta de recursos para declarar en Chile: quién debe presentar el F22,
        plazos verificados, cómo calcular tu resultado y cuándo recibes la
        devolución. Si es tu primera vez, parte por la{" "}
        <a
          href={getPath("/posts/operacion-renta-centro/")}
          class="text-accent underline underline-offset-4 hover:opacity-80"
        >
          orientación inicial y preguntas frecuentes
        </a>.
      </p>
    </section>

    <!-- RESPUESTA RÁPIDA (detalle en el centro) -->
    <section class="border-b border-border py-8">
      <div class="rounded-xl border border-accent/30 bg-accent/5 p-6">
        <p
          class="mb-3 text-xs font-semibold tracking-widest text-accent uppercase"
        >
          Respuesta rápida
        </p>
        <h2 class="mb-3 text-xl font-bold">¿Debo declarar la renta en 2026?</h2>
        <p class="mb-3 text-sm text-secondary">
          Regla general: declaras si en 2025 tuviste dos o más empleadores,
          emitiste boletas de honorarios, recibiste rentas del exterior,
          arriendos u otras rentas distintas del sueldo único. Con un solo
          empleador y sin otros ingresos, normalmente no necesitas declarar. El
          plazo por internet vence el <strong>8 de mayo de 2026</strong>.
        </p>
        <a
          href={getPath("/posts/operacion-renta-centro/")}
          class="text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
        >
          Caso por caso y preguntas frecuentes →
        </a>
      </div>
    </section>

    <StartHere steps={startHereSteps} />

    <!-- CALCULADORA CTA -->
    <section class="border-b border-border py-8">
      <div class="rounded-xl border border-accent/20 bg-accent/5 p-6">
        <p
          class="mb-1 text-xs font-semibold tracking-widest text-accent uppercase"
        >
          Herramienta
        </p>
        <h2 class="mb-2 text-xl font-bold">Calculadora Operación Renta</h2>
        <p class="mb-4 max-w-2xl text-sm text-secondary">
          Estima cuánto deberías pagar o recibir de devolución según tu sueldo,
          retenciones y cotizaciones del año tributario.
        </p>
        <a
          href={getPath("/calculadoras/operacion-renta/")}
          class="inline-block rounded-lg bg-accent px-5 py-2.5 text-sm font-bold text-background transition-opacity hover:opacity-90"
        >
          Estimar mi Operación Renta →
        </a>
      </div>
    </section>

    <!-- QUIÉN DECLARA (detalle en el centro) -->
    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">
        ¿Quién DEBE declarar el Formulario 22?
      </h2>
      <p class="max-w-3xl text-sm text-secondary">
        Los cinco casos que obligan a declarar —dos o más empleadores,
        honorarios, rentas del exterior, arriendos y ganancias de capital— con
        montos, umbrales (13,5 UTA / $11.265.804) y ejemplos están desarrollados
        caso por caso en la{" "}
        <a
          href={getPath("/posts/operacion-renta-centro/")}
          class="text-accent underline underline-offset-4 hover:opacity-80"
        >
          orientación inicial de Operación Renta
        </a>.
      </p>
    </section>

    <!-- QUIÉN NO DECLARA (detalle en el centro) -->
    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">¿Quién NO necesita declarar?</h2>
      <p class="max-w-3xl text-sm text-secondary">
        Un solo empleador con retenciones al día, una sola pensión o ingresos
        bajo 13,5 UTA normalmente eximen de declarar. Requisitos y excepciones
        en la{" "}
        <a
          href={getPath("/posts/operacion-renta-centro/")}
          class="text-accent underline underline-offset-4 hover:opacity-80"
        >
          orientación inicial
        </a>.
      </p>
    </section>

    <!-- SUBCASOS NAV -->
    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Elige tu situación específica</h2>
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          subcasos.map(item => (
            <li class="rounded-xl border border-border p-5">
              <h3 class="mb-2 text-lg font-semibold">{item.titulo}</h3>
              <p class="mb-3 text-sm text-secondary">{item.resumen}</p>
              <a
                href={item.href}
                class="text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
              >
                {item.cta}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- FECHAS CLAVE (calendario completo en el centro) -->
    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Fechas clave 2026</h2>
      <ul
        class="mb-4 max-w-3xl list-disc space-y-2 pl-6 text-sm text-secondary"
      >
        <li>
          Declaración por internet (F22): hasta el{" "}
          <strong>8 de mayo de 2026</strong>.
        </li>
        <li>
          Devoluciones: desde el <strong>29 de abril</strong> según el tramo de presentación
          (9–23 de abril → 15 de mayo; 24 de abril–8 de mayo → 27 de mayo; sin cuenta
          bancaria → cheque el 29 de mayo).
        </li>
        <li>
          Registro de cuenta bancaria en TGR: hazlo antes de tu fecha de pago
          para recibir transferencia.
        </li>
      </ul>
      <a
        href={getPath("/posts/operacion-renta-centro/")}
        class="text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
      >
        Calendario completo y cómo registrar tu cuenta →
      </a>
      <p class="mt-4 text-xs text-secondary">
        Fuente: SII y TGR, campaña 2026. Confirma siempre en{" "}
        <a
          href="https://www.sii.cl"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent underline underline-offset-4 hover:opacity-80"
          >sii.cl</a
        > y{" "}
        <a
          href="https://pagos.tgr.cl"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent underline underline-offset-4 hover:opacity-80"
          >tgr.cl</a
        >.
      </p>
    </section>

    <!-- F22 SECCIONES (detalle en el checklist) -->
    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">
        Formulario 22: secciones principales
      </h2>
      <p class="max-w-3xl text-sm text-secondary">
        El F22 pre-carga rentas del trabajo, honorarios, PPM y retenciones desde
        las declaraciones juradas, y deja para ingreso manual arriendos y
        algunos créditos. El detalle sección por sección, con qué revisar antes
        de enviar, está en el{" "}
        <a
          href={getPath("/posts/operacion-renta-f22-checklist/")}
          class="text-accent underline underline-offset-4 hover:opacity-80"
        >
          checklist del F22
        </a>.
      </p>
    </section>

    <!-- PAGAR (detalle en el centro) -->
    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">
        ¿Qué hacer si el resultado es que debes pagar?
      </h2>
      <p class="max-w-3xl text-sm text-secondary">
        Puedes pagar en línea al enviar el F22 o convenir cuotas con TGR
        (interés del 1,5% mensual sobre el saldo insoluto, Art. 53 CT). Declarar
        fuera de plazo agrega multa del 10% del impuesto adeudado (Art. 97 N°2
        CT). El paso a paso, con opciones de pago y convenio, está en la{" "}
        <a
          href={getPath("/posts/operacion-renta-centro/")}
          class="text-accent underline underline-offset-4 hover:opacity-80"
        >
          orientación inicial
        </a>.
      </p>
      <p class="mt-4 text-xs text-secondary">
        Esta guía describe el procedimiento general. No es asesoría tributaria.
        Si tu situación es compleja, considera consultar con un contador
        habilitado.
      </p>
    </section>

    <!-- RETENCIÓN HONORARIOS -->
    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">
        Retención de honorarios: el 15,25% explicado
      </h2>
      <p class="mb-4 text-sm text-secondary">
        Si emitiste boletas de honorarios en 2025, cada boleta tuvo una
        retención del <strong>15,25%</strong> que tu cliente envió directamente al
        SII como pago provisional mensual (PPM), según la tasa vigente establecida
        por la Ley 21.133.
      </p>
      <div class="mb-4 rounded-lg border border-border p-5">
        <p class="mb-2 text-sm font-semibold">Ejemplo conceptual</p>
        <p class="text-sm text-secondary">
          Si emitiste $1.000.000 en boletas, tus clientes retuvieron y enviaron
          al SII $152.500 (15,25%). Al declarar, el SII calcula el impuesto que
          corresponde sobre tu renta total del año. Si ese impuesto es $80.000,
          el SII te devuelve $72.500. Si es $200.000, debes pagar $47.500
          adicionales.
        </p>
      </div>
      <a
        href={getPath("/posts/boleta-honorarios-2026-retencion-cobertura/")}
        class="text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
      >
        Ver guía completa: boleta de honorarios 2026, líquido y cobertura →
      </a>
    </section>

    <!-- FAQ -->
    <section class="border-b border-border py-8">
      <h2 class="mb-6 text-2xl font-bold">Preguntas frecuentes</h2>
      <div class="space-y-4">
        {
          faqs.map(faq => (
            <div class="rounded-xl border border-border p-5">
              <p class="mb-2 text-sm font-semibold">{faq.q}</p>
              <p class="text-sm text-secondary">{faq.a}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- CANALES OFICIALES -->
    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Canales oficiales</h2>
      <ul class="space-y-2 text-sm">
        <li>
          <a
            href="https://www.sii.cl"
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent underline underline-offset-4 hover:opacity-80"
          >
            SII — declaración, propuestas, tablas y valores tributarios
          </a>
        </li>
        <li>
          <a
            href="https://pagos.tgr.cl"
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent underline underline-offset-4 hover:opacity-80"
          >
            TGR — estado de devolución, calendario de pagos y convenios
          </a>
        </li>
        <li>
          <a
            href="https://www.bcn.cl"
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent underline underline-offset-4 hover:opacity-80"
          >
            BCN — texto del DL 824 (LIR) y DL 830 (Código Tributario)
          </a>
        </li>
      </ul>
    </section>

    <!-- QUÉ CAMBIÓ 2026 -->
    <section class="border-b border-border py-8">
      <div class="rounded-xl border border-accent/20 bg-accent/5 p-6">
        <h2 class="mb-2 text-xl font-bold">Qué cambió en 2026</h2>
        <p class="text-sm text-secondary">
          La retención de honorarios se mantiene en <strong>15,25%</strong> para el
          año tributario 2025 (tasa fijada por Ley 21.133). El plazo de declaración
          online cambió al <strong>8 de mayo de 2026</strong> (en campañas anteriores
          era el 30 de abril). Verifica las tablas de impuesto y topes de UTM vigentes
          en{" "}
          <a
            href="https://www.sii.cl"
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent underline underline-offset-4 hover:opacity-80"
            >sii.cl</a
          >.
        </p>
        <p class="mt-2 text-xs text-secondary">
          Última actualización: 2026-09-29. Fuentes: SII y TGR, campaña
          Operación Renta 2026.
        </p>
      </div>
    </section>

    <section class="py-8">
      <a
        href={hubPath}
        class="text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
      >
        ← Volver a Impuestos para personas
      </a>
    </section>

    <SupportCallout
      context="guia-impuestos"
      pageTitle="esta guía sobre Operación Renta"
    />
  </main>

  <Footer />
</Layout>
