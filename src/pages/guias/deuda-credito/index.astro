---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ResumeWidget from "@/components/ResumeWidget.astro";
import StartHere from "@/components/StartHere.astro";
import { getPath } from "@/utils/getPath";
import { getHubArticleAssignments } from "@/config/editorial-hub-model.mjs";
import {
  deudaClusterHubDecisionCards,
  deudaClusterHubToolCards,
} from "@/config/deudaClusterLinks";
import CompareTable from "@/components/CompareTable.astro";

const SITE_BASE = (Astro.site ?? new URL(Astro.url.origin)).href.replace(
  /\/$/,
  ""
);
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Deuda y Crédito en Chile",
  description:
    "Guías y calculadoras sobre informes de deuda, costo real del crédito y renegociación en Chile.",
  url: `${SITE_BASE}/guias/deuda-credito/`,
  numberOfItems: 6,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Informe de deudas CMF vs DICOM",
      url: `${SITE_BASE}/posts/informe-deudas-cmf-vs-dicom/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "CAE y costo real del crédito",
      url: `${SITE_BASE}/posts/cae-costo-real-credito-chile/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Renegociación Superir",
      url: `${SITE_BASE}/posts/renegociacion-superir/`,
    },
    {
      "@type": "ListItem",
      position: 4,
      name: "Calculadora de crédito de consumo",
      url: `${SITE_BASE}/calculadoras/credito-consumo/`,
    },
    {
      "@type": "ListItem",
      position: 5,
      name: "Costo real de tarjeta de crédito",
      url: `${SITE_BASE}/calculadoras/tarjeta-credito/`,
    },
    {
      "@type": "ListItem",
      position: 6,
      name: "Simulador Renegociación Superir",
      url: `${SITE_BASE}/calculadoras/simulador-renegociacion/`,
    },
  ],
};

const hubAssignments = getHubArticleAssignments("deuda-credito");

const coreLabels = {
  "informe-deudas-cmf-vs-dicom": "Diagnóstico",
  "cae-costo-real-credito-chile": "Costo real",
  "renegociacion-superir": "Salida formal",
} as const;

const guideCards = deudaClusterHubDecisionCards.map(card => ({
  ...card,
  label:
    coreLabels[
      card.href
        .replace("/posts/", "")
        .replaceAll("/", "") as keyof typeof coreLabels
    ] ?? card.kind,
}));

const toolLabels = {
  "credito-consumo": "Calculadora",
  "tarjeta-credito": "Calculadora",
  "prepago-credito": "Calculadora",
  "simulador-renegociacion": "Simulador",
} as const;

const toolCards = deudaClusterHubToolCards.map(card => ({
  ...card,
  label:
    toolLabels[
      card.href
        .replace("/calculadoras/", "")
        .replaceAll("/", "") as keyof typeof toolLabels
    ] ?? card.kind,
}));

const visibleHubHrefs = new Set(
  [...guideCards, ...toolCards].map(card => getPath(card.href))
);

const relatedCards = hubAssignments.related.filter(
  item => !visibleHubHrefs.has(getPath(item.href))
);
---

<Layout
  title="Deuda y Crédito en Chile | Monedario"
  description="Guías y artículos sobre deuda y crédito en Chile para entender informes comerciales, renegociación y costo total del crédito."
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(itemListSchema)}
  />
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout">
    <section class="border-b border-border py-8">
      <h1 class="mb-4 text-3xl font-bold sm:text-4xl">
        Deuda y Crédito en Chile
      </h1>
    </section>

    <section class="py-4">
      <ResumeWidget />
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Por dónde empezar</h2>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {
          guideCards.map(card => (
            <article class="rounded-2xl border border-border p-5">
              <p class="mb-2 text-xs font-semibold tracking-[0.14em] text-accent uppercase">
                {card.label}
              </p>
              <h3 class="text-lg font-semibold">{card.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-secondary">
                {card.description}
              </p>
              <a
                href={getPath(card.href)}
                class="mt-4 inline-flex text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
              >
                {card.cta}
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <!-- TABLA COMPARATIVA CMF vs DICOM vs BOLETÍN -->
    <section class="border-b border-border py-8">
      <h2 class="mb-2 text-2xl font-bold">CMF vs DICOM vs Boletín Comercial</h2>
      <p class="mb-4 max-w-3xl text-sm text-secondary">
        Son tres sistemas distintos. Cuál necesitas depende de para qué
        necesitas el reporte.
      </p>
      <CompareTable
        columns={[
          { header: "Informe CMF", key: "cmf" },
          { header: "DICOM (Equifax)", key: "dicom" },
          { header: "Boletín Comercial", key: "boletin" },
        ]}
        rows={[
          {
            aspecto: "¿Qué incluye?",
            cmf: "Deudas en el sistema financiero regulado (bancos, cooperativas, cajas, financieras fiscalizadas por CMF)",
            dicom:
              "Protestos, morosidades y deudas en empresas privadas adscritas al sistema Equifax",
            boletin:
              "Protestos de documentos mercantiles y algunos otros registros",
          },
          {
            aspecto: "¿Es gratis?",
            cmf: "Sí, en portal CMF",
            dicom: "Versión básica gratuita; informes detallados son de pago",
            boletin:
              "Hay consulta gratuita limitada; informes completos son de pago",
          },
          {
            aspecto: "¿Quién lo emite?",
            cmf: "Comisión para el Mercado Financiero (organismo público)",
            dicom: "Equifax Chile (empresa privada)",
            boletin:
              "Cámara de Comercio de Santiago y otras cámaras (privadas)",
          },
          {
            aspecto: "¿Cuándo lo piden?",
            cmf: "Al pedir un crédito bancario o financiero regulado",
            dicom: "Arriendos, empleos, créditos con comercio",
            boletin: "Comercio, arriendos, algunos empleos",
          },
          {
            aspecto: "¿Cómo eliminarse?",
            cmf: "Los datos se actualizan automáticamente cuando se paga la deuda",
            dicom: "Pagando y solicitando eliminación a Equifax",
            boletin: "Pagando el protesto y solicitando alzamiento",
          },
        ]}
        nota="Esta información es educativa. Verifica con cada sistema el proceso actual para consultar o reclamar datos."
      />
      <a
        href={getPath("/posts/informe-deudas-cmf-vs-dicom/")}
        class="text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
      >
        Ver guía completa: Informe CMF vs DICOM
      </a>
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Errores comunes</h2>
      <ul class="list-disc space-y-2 pl-6 text-secondary">
        <li>
          Pedir un informe privado antes de separar si necesitas CMF, Boletín
          Comercial o simplemente ordenar tus acreedores.
        </li>
        <li>
          Comparar solo cuota o tasa nominal y no el costo total en pesos con
          CAE, seguros y gastos.
        </li>
        <li>
          Entrar a renegociación sin tener claro si el caso ya cumple filtro
          legal mínimo o si todavía estás en fase de orden financiero.
        </li>
      </ul>
    </section>

    <div data-hub-section="recommended-route">
      <StartHere
        steps={[
          {
            step: 1,
            title: "DICOM: cómo ver si estás en el buró gratis",
            description: "Dónde consultar, qué deudas aparecen y cuándo salen.",
            href: "/posts/donde-ver-si-estoy-en-dicom-gratis/",
          },
          {
            step: 2,
            title: "CAE: el costo real de un crédito en Chile",
            description: "Cómo comparar ofertas más allá de la tasa nominal.",
            href: "/posts/cae-costo-real-credito-chile/",
          },
          {
            step: 3,
            title: "Renegociación en la Superir: paso a paso",
            description: "El proceso para refinanciar deudas con la SuperIR.",
            href: "/posts/renegociacion-superir/",
          },
          {
            step: 4,
            title: "Simulador de crédito de consumo",
            description: "Calcula cuotas, interés total y CAE de tu crédito.",
            href: "/calculadoras/credito-consumo/",
          },
        ]}
      />
    </div>

    <section
      data-hub-section="related-calculators"
      class="border-b border-border py-8"
    >
      <h2 class="mb-4 text-2xl font-bold">Herramientas para actuar hoy</h2>
      <p class="max-w-3xl text-sm leading-relaxed text-secondary">
        Si ya tienes números, usa la herramienta que corresponde a tu etapa. No
        sirve abrir el simulador de renegociación si todavía estás cotizando un
        crédito, ni mirar CAE si el problema real es una tarjeta rotativa ya
        usada.
      </p>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        {
          toolCards.map(card => (
            <article class="rounded-2xl border border-border bg-surface-muted p-5">
              <p class="mb-2 text-xs font-semibold tracking-[0.14em] text-accent uppercase">
                {card.label}
              </p>
              <h3 class="text-lg font-semibold">{card.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-secondary">
                {card.description}
              </p>
              <a
                href={getPath(card.href)}
                class="mt-4 inline-flex text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
              >
                {card.cta}
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Relacionado</h2>
      <div class="grid gap-4">
        {
          relatedCards.map((item: (typeof relatedCards)[number]) => (
            <article class="rounded-2xl border border-border p-5">
              <h3 class="mb-2 text-lg font-semibold">{item.title}</h3>
              <p class="mb-3 text-sm leading-relaxed text-secondary">
                {item.summary}
              </p>
              <a
                href={getPath(item.href)}
                class="text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
              >
                Ir a la guía relacionada
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="py-8">
      <div class="rounded-xl border border-accent/20 bg-accent/5 p-6">
        <h2 class="mb-2 text-xl font-bold">
          Última actualización de la sección
        </h2>
        <p class="text-sm text-secondary">
          Actualizado: 2026-03-12. Esta sección se revisa cuando cambian reglas
          de reporte comercial, requisitos de renegociación, uso regulatorio de
          CAE o el reparto entre diagnóstico, costo y salida formal dentro del
          cluster.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
