---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { getPath } from "@/utils/getPath";

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Seguridad Financiera en Chile",
  description:
    "Herramientas y guías para prevenir estafas, actuar ante fraudes y resolver suplantación de identidad.",
  url: "https://monedario.cl/guias/seguridad-financiera/",
  numberOfItems: 4,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Wizard: cargo no reconocido — tu ruta paso a paso (Ley 20.009)",
      url: "https://monedario.cl/guias/seguridad-financiera/fraude-cargo-no-reconocido/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Te hicieron un cargo que no reconoces: qué hacer en las primeras 24 horas",
      url: "https://monedario.cl/posts/fraude-tarjeta-que-hacer/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Estafas financieras en Chile: señales por canal y checklist de 24 horas",
      url: "https://monedario.cl/posts/estafas-financieras-chile-vishing-smishing-marketplace/",
    },
    {
      "@type": "ListItem",
      position: 4,
      name: "Suplantación de identidad y créditos no reconocidos: qué hacer paso a paso",
      url: "https://monedario.cl/posts/suplantacion-identidad-creditos-no-reconocidos/",
    },
  ],
};

const articulosSeccion = [
  {
    titulo: "🧭 Wizard: cargo no reconocido — tu ruta paso a paso",
    resumen:
      "Responde 2–4 preguntas y obtén los pasos exactos para tu caso según la Ley 20.009.",
    href: getPath("/guias/seguridad-financiera/fraude-cargo-no-reconocido/"),
    esHerramienta: true,
  },
  {
    titulo:
      "Te hicieron un cargo que no reconoces: qué hacer en las primeras 24 horas (Ley 20.009)",
    resumen:
      "Qué hacer para bloquear, reclamar e intentar recuperar tu plata si ya hubo fraude.",
    href: getPath("/posts/fraude-tarjeta-que-hacer/"),
    esHerramienta: false,
  },
  {
    titulo:
      "Estafas financieras en Chile: señales por canal y checklist de 24 horas",
    resumen:
      "Guía preventiva por canal para reducir riesgo antes de que exista pérdida de dinero.",
    href: getPath(
      "/posts/estafas-financieras-chile-vishing-smishing-marketplace/"
    ),
    esHerramienta: false,
  },
  {
    titulo:
      "Suplantación de identidad y créditos no reconocidos: qué hacer paso a paso",
    resumen:
      "Qué hacer para detectar la suplantación, reunir pruebas y reclamar ante la institución.",
    href: getPath("/posts/suplantacion-identidad-creditos-no-reconocidos/"),
    esHerramienta: false,
  },
];
---

<Layout
  title="Seguridad Financiera en Chile | Monedario"
  description="Guías y artículos para prevenir estafas, actuar ante fraudes y resolver casos de suplantación de identidad en Chile."
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(itemListSchema)}
  />
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout">
    <section class="border-b border-border py-8">
      <!-- Removed Authority Layer tag -->
      <h1 class="mb-4 text-3xl font-bold sm:text-4xl">
        Seguridad Financiera en Chile
      </h1>
      <p class="max-w-3xl text-secondary">
        Esta sección reúne guías para prevenir estafas, reaccionar ante cargos
        no reconocidos y actuar si usaron tu identidad para pedir créditos o
        abrir productos.
      </p>
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Elige por el problema principal</h2>
      <ul class="grid gap-4">
        {
          articulosSeccion.map(item => (
            <li class="rounded-xl border border-border p-5">
              {item.esHerramienta && (
                <p class="mb-2 text-xs font-bold tracking-widest text-accent uppercase">
                  Herramienta interactiva
                </p>
              )}
              <h3 class="mb-2 text-lg font-semibold">{item.titulo}</h3>
              <p class="mb-3 text-sm text-secondary">{item.resumen}</p>
              <a
                href={item.href}
                class="text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
                data-analytics-cta={
                  item.esHerramienta ? "hub-tool" : "hub-article"
                }
                data-analytics-label={item.titulo}
                data-analytics-location="seguridad_financiera_hub"
              >
                {item.esHerramienta ? "Ir a la herramienta" : "Ir a esta guía"}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Cómo separar bien los casos</h2>
      <ul class="list-disc space-y-2 pl-6 text-secondary">
        <li>
          Fraude con cargo o transferencia no reconocida no es lo mismo que una
          estafa que todavía no te generó pérdida.
        </li>
        <li>
          Suplantación de identidad es un flujo distinto: cambia la evidencia,
          el reclamo y los plazos.
        </li>
        <li>
          Si el problema ya ocurrió, no empieces por prevención; si aún no
          ocurrió, no empieces por recuperación.
        </li>
      </ul>
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Errores comunes</h2>
      <ul class="list-disc space-y-2 pl-6 text-secondary">
        <li>Actuar tarde por esperar “confirmación” del fraude.</li>
        <li>
          Entregar códigos de verificación en llamadas o mensajes urgentes.
        </li>
        <li>No guardar evidencia ni folios para sostener el reclamo formal.</li>
      </ul>
    </section>

    <section class="py-8">
      <div class="rounded-xl border border-accent/20 bg-accent/5 p-6">
        <h2 class="mb-2 text-xl font-bold">
          Última actualización de la sección
        </h2>
        <p class="text-sm text-secondary">
          Actualizado: 2026-03-02. Esta sección se revisa cuando cambian las
          reglas para devolver dinero por fraude, los canales más usados en
          estafas o las instrucciones oficiales en Chile.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
