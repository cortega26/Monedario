---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ResumeWidget from "@/components/ResumeWidget.astro";
import StartHere from "@/components/StartHere.astro";
import { getPath } from "@/utils/getPath";

const SITE_BASE = (Astro.site ?? new URL(Astro.url.origin)).href.replace(
  /\/$/,
  ""
);
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Ahorro e Inversión en Chile",
  description:
    "Guías y herramientas para elegir instrumentos de ahorro e inversión según plazo, riesgo e impuestos en Chile.",
  url: `${SITE_BASE}/guias/ahorro-e-inversion/`,
  numberOfItems: 5,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Ahorro e inversión en Chile: instrumentos, costos e impuestos (guía 2026)",
      url: `${SITE_BASE}/posts/ahorro-e-inversion-en-chile-instrumentos-costos-impuestos-2026/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "APV en Chile: beneficio tributario, regímenes A y B, y cuándo conviene",
      url: `${SITE_BASE}/posts/que-es-el-apv/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Depósito a plazo: UF vs pesos — qué conviene y cuándo",
      url: `${SITE_BASE}/posts/deposito-a-plazo-uf-vs-pesos/`,
    },
    {
      "@type": "ListItem",
      position: 4,
      name: "Fondos mutuos: comisiones, rescate e impuestos (sin letra chica)",
      url: `${SITE_BASE}/posts/fondos-mutuos-comisiones-rescate-impuestos/`,
    },
    {
      "@type": "ListItem",
      position: 5,
      name: "Cómo invertir en ETFs desde Chile: comisiones, custodia e impuestos",
      url: `${SITE_BASE}/posts/como-invertir-en-etfs-desde-chile/`,
    },
  ],
};

const articulosSeccion = [
  {
    titulo:
      "Ahorro e inversión en Chile: instrumentos, costos e impuestos (guía 2026)",
    resumen:
      "Guía general para elegir instrumentos según tu plazo, tu tolerancia al riesgo y sus costos.",
    href: getPath(
      "/posts/ahorro-e-inversion-en-chile-instrumentos-costos-impuestos-2026/"
    ),
  },
  {
    titulo:
      "APV en Chile: beneficio tributario, regímenes A y B, y cuándo conviene",
    resumen:
      "Explica cuándo usar APV para ahorrar con beneficio tributario y cómo compararlo con alternativas más líquidas.",
    href: getPath("/posts/que-es-el-apv/"),
  },
  {
    titulo: "Depósito a plazo: UF vs pesos — qué conviene y cuándo",
    resumen:
      "Comparativa para elegir entre tasa nominal y protección por reajuste según inflación esperada.",
    href: getPath("/posts/deposito-a-plazo-uf-vs-pesos/"),
  },
  {
    titulo: "Fondos mutuos: comisiones, rescate e impuestos (sin letra chica)",
    resumen:
      "Explica costos reales, reglas de rescate y tratamiento tributario básico al rescatar cuotas.",
    href: getPath("/posts/fondos-mutuos-comisiones-rescate-impuestos/"),
  },
  {
    titulo:
      "Cómo invertir en ETFs desde Chile: comisiones, custodia e impuestos",
    resumen:
      "Explica cómo elegir una corredora, revisar costos, custodia e impuestos antes de invertir.",
    href: getPath("/posts/como-invertir-en-etfs-desde-chile/"),
  },
];
---

<Layout
  title="Ahorro e Inversión en Chile | Monedario"
  description="Guías y artículos sobre ahorro e inversión en Chile para elegir qué leer primero según tu objetivo, plazo y nivel de riesgo."
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(itemListSchema)}
  />
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout">
    <section class="border-b border-border py-8">
      <!-- Removed Topic Authority Layer tag -->
      <h1 class="mb-4 text-3xl font-bold sm:text-4xl">
        Ahorro e inversión en Chile
      </h1>
    </section>

    <section class="py-4">
      <ResumeWidget />
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Elige por objetivo principal</h2>
      <ul class="grid gap-4">
        {
          articulosSeccion.map(item => (
            <li class="rounded-xl border border-border p-5">
              <h3 class="mb-2 text-lg font-semibold">{item.titulo}</h3>
              <p class="mb-3 text-sm text-secondary">{item.resumen}</p>
              <a
                href={item.href}
                class="text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
              >
                Ir a esta guía
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Errores comunes de la sección</h2>
      <ul class="list-disc space-y-2 pl-6 text-secondary">
        <li>Comparar solo rentabilidad y no costo total neto.</li>
        <li>
          Usar instrumentos de alta volatilidad para metas de corto plazo.
        </li>
        <li>Invertir sin revisar reglas de rescate, vencimiento o custodia.</li>
        <li>
          Asumir que todos los intermediarios tienen el mismo nivel de
          supervisión aplicable.
        </li>
        <li>Postergar revisión tributaria hasta el cierre del año.</li>
        <li>
          Confundir una decisión de ahorro con beneficio tributario con una duda
          operativa sobre AFP obligatoria.
        </li>
      </ul>
    </section>

    <StartHere
      steps={[
        {
          step: 1,
          title: "Guía general de ahorro e inversión en Chile",
          description: "Elige instrumentos según plazo, riesgo e impuestos.",
          href: "/posts/ahorro-e-inversion-en-chile-instrumentos-costos-impuestos-2026/",
        },
        {
          step: 2,
          title: "APV: beneficio tributario Régimen A y B",
          description:
            "Cuándo conviene y cómo compararlo con alternativas más líquidas.",
          href: "/posts/que-es-el-apv/",
        },
        {
          step: 3,
          title: "Depósito a plazo: UF vs pesos",
          description:
            "Cómo elegir según inflación esperada y plazo de tu meta.",
          href: "/posts/deposito-a-plazo-uf-vs-pesos/",
        },
        {
          step: 4,
          title: "Simulador APV",
          description:
            "Calcula el ahorro tributario real de tu aporte mensual.",
          href: "/calculadoras/apv/",
        },
        {
          step: 5,
          title: "Calculadora depósito a plazo",
          description:
            "Estima interés bruto, retención e interés neto con tu monto y plazo.",
          href: "/calculadoras/deposito-a-plazo/",
        },
        {
          step: 6,
          title: "Calculadora interés compuesto",
          description:
            "Proyecta crecimiento de capital con aportes periódicos y capitalización.",
          href: "/calculadoras/interes-compuesto/",
        },
      ]}
    />

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">No mezcles estas decisiones</h2>
      <ul class="list-disc space-y-2 pl-6 text-secondary">
        <li>
          APV es ahorro con beneficio tributario, no una decisión de AFP
          obligatoria.
        </li>
        <li>
          Depósito a plazo sirve para preservar capital; no reemplaza
          diversificación de largo plazo.
        </li>
        <li>
          ETFs y fondos mutuos comparten exposición a mercado, pero no
          estructura de costos, custodia ni rescate.
        </li>
        <li>
          Si todavía no sabes qué instrumento comparar, parte por la guía
          general y no por un producto aislado.
        </li>
      </ul>
    </section>

    <section class="py-8">
      <div class="rounded-xl border border-accent/20 bg-accent/5 p-6">
        <h2 class="mb-2 text-xl font-bold">
          Última actualización de la sección
        </h2>
        <p class="text-sm text-secondary">
          Actualizado: 2026-03-09. Se actualiza cuando cambian reglas
          regulatorias CMF, instrucciones tributarias SII o cambios importantes
          en estos instrumentos.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
