---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { getPath } from "@/utils/getPath";
import { getEconomicParameters } from "@/application/use-cases/GetEconomicParameters";
import { resolveEconomicIndicatorDate } from "@/domain/economic/EconomicParameters";
import { fmt, fmtFecha } from "@/utils/indicadores";

const SITE_BASE = (Astro.site ?? new URL(Astro.url.origin)).href.replace(
  /\/$/,
  ""
);
const { parameters } = await getEconomicParameters();

const items = [
  {
    codigo: "UF",
    nombre: "Unidad de Fomento",
    valor: parameters.uf,
    unidad: "CLP",
    fecha: resolveEconomicIndicatorDate(parameters, "uf"),
    impacto:
      "Afecta arriendos, dividendos y contratos reajustables. Si sube, suben esos pagos en pesos.",
  },
  {
    codigo: "UTM",
    nombre: "Unidad Tributaria Mensual",
    valor: parameters.utm,
    unidad: "CLP",
    fecha: resolveEconomicIndicatorDate(parameters, "utm"),
    impacto:
      "Se usa en multas, trámites e impuestos. Te ayuda a convertir referencias legales a pesos.",
  },
  ...(parameters.dolar !== undefined
    ? [
        {
          codigo: "USD",
          nombre: "Dólar observado",
          valor: parameters.dolar,
          unidad: "CLP",
          fecha: resolveEconomicIndicatorDate(parameters, "dolar"),
          impacto:
            "Influye en productos importados, viajes y decisiones de compra en moneda extranjera.",
        },
      ]
    : []),
  {
    codigo: "IPC",
    nombre: "Índice de Precios al Consumidor",
    valor: parameters.ipc,
    unidad: "%",
    fecha: resolveEconomicIndicatorDate(parameters, "ipc"),
    impacto:
      "Mide la inflación mensual y explica por qué cambian precios, reajustes y valor de la UF.",
  },
  ...(parameters.tmc !== undefined
    ? [
        {
          codigo: "TMC",
          nombre: "Tasa Máxima Convencional",
          valor: parameters.tmc,
          unidad: "%",
          fecha: resolveEconomicIndicatorDate(parameters, "tmc"),
          impacto:
            "Marca topes legales de interés para ciertos créditos y sirve de referencia en deuda.",
        },
      ]
    : []),
];

const sourceLabel =
  parameters.source === "live"
    ? "Datos en tiempo real"
    : parameters.source === "snapshot"
      ? "Datos del último período oficial"
      : "Valores de referencia aproximados";

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Indicadores económicos de Chile",
  description:
    "Panel de indicadores clave para Chile con fecha de actualización, explicación práctica y enlaces a herramientas.",
  url: `${SITE_BASE}/guias/uf-costo-de-vida/indicadores-economicos/`,
  numberOfItems: items.length,
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.nombre,
  })),
};
---

<Layout
  title="Indicadores económicos de Chile: UF, UTM, dólar, IPC y TMC | Monedario"
  description="Consulta indicadores económicos clave para Chile con fecha de actualización y contexto práctico para tomar decisiones financieras."
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(itemListSchema)}
  />
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout">
    <section class="border-b border-border py-8">
      <p
        class="mb-2 text-xs font-semibold tracking-widest text-accent uppercase"
      >
        Referencia rápida
      </p>
      <h1 class="mb-3 text-3xl font-bold sm:text-4xl">
        Indicadores económicos de Chile
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-secondary">
        Esta página junta los indicadores más útiles para decisiones del día a
        día. Incluye fecha por indicador, valor referencial y por qué importa en
        tu bolsillo.
      </p>
    </section>

    <section class="border-b border-border py-8">
      <div
        class="mb-3 rounded-lg border border-border bg-surface-muted px-4 py-3 text-xs text-secondary"
      >
        {sourceLabel}{parameters.source !== "fallback" && ` · Actualizado el ${fmtFecha(parameters.lastUpdated)}`}.
      </div>

      <div class="overflow-x-auto rounded-2xl border border-border">
        <table class="min-w-full divide-y divide-border text-sm">
          <thead
            class="bg-surface-muted text-left text-xs tracking-wide text-muted uppercase"
          >
            <tr>
              <th class="px-4 py-3">Indicador</th>
              <th class="px-4 py-3">Valor</th>
              <th class="px-4 py-3">Fecha</th>
              <th class="px-4 py-3">Por qué te importa</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {
              items.map(item => (
                <tr>
                  <td class="px-4 py-3">
                    <p class="font-semibold text-foreground">{item.codigo}</p>
                    <p class="text-xs text-secondary">{item.nombre}</p>
                  </td>
                  <td class="px-4 py-3 font-semibold text-foreground tabular-nums">
                    {item.unidad === "CLP"
                      ? fmt(item.valor)
                      : `${item.valor.toLocaleString("es-CL", {
                          minimumFractionDigits: 2,
                          maximumFractionDigits: 2,
                        })}${item.unidad}`}
                  </td>
                  <td class="px-4 py-3 text-secondary">
                    {fmtFecha(item.fecha)}
                  </td>
                  <td class="px-4 py-3 text-secondary">{item.impacto}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Úsalo para decidir, no solo mirar</h2>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <article class="rounded-xl border border-border p-5">
          <p
            class="mb-2 text-xs font-semibold tracking-wide text-accent uppercase"
          >
            Herramienta
          </p>
          <h3 class="text-lg font-semibold">Conversor UF a pesos</h3>
          <p class="mt-2 text-sm text-secondary">
            Convierte montos reajustables y aterriza contratos o cuotas en
            pesos.
          </p>
          <a
            href={getPath("/calculadoras/conversor-uf/")}
            class="mt-4 inline-flex text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
          >
            Usar conversor →
          </a>
        </article>

        <article class="rounded-xl border border-border p-5">
          <p
            class="mb-2 text-xs font-semibold tracking-wide text-accent uppercase"
          >
            Herramienta
          </p>
          <h3 class="text-lg font-semibold">Conversor UTM a pesos</h3>
          <p class="mt-2 text-sm text-secondary">
            Traduce referencias tributarias o administrativas a valores
            concretos.
          </p>
          <a
            href={getPath("/calculadoras/conversor-utm/")}
            class="mt-4 inline-flex text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
          >
            Usar conversor →
          </a>
        </article>

        <article class="rounded-xl border border-border p-5">
          <p
            class="mb-2 text-xs font-semibold tracking-wide text-accent uppercase"
          >
            Siguiente lectura
          </p>
          <h3 class="text-lg font-semibold">UF, inflación y costo de vida</h3>
          <p class="mt-2 text-sm text-secondary">
            Si necesitas contexto completo, sigue la ruta temática del cluster.
          </p>
          <a
            href={getPath("/guias/uf-costo-de-vida/")}
            class="mt-4 inline-flex text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
          >
            Ver sección completa
          </a>
        </article>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
