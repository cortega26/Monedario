---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ResumeWidget from "@/components/ResumeWidget.astro";
import StartHere from "@/components/StartHere.astro";
import { getPath } from "@/utils/getPath";
import { getEconomicParameters } from "@/application/use-cases/GetEconomicParameters";
import { resolveEconomicIndicatorDate } from "@/domain/economic/EconomicParameters";
import { fmt, fmtFecha } from "@/utils/indicadores";
import { getHubArticleAssignments } from "@/config/editorial-hub-model.mjs";

const SITE_BASE = (Astro.site ?? new URL(Astro.url.origin)).href.replace(
  /\/$/,
  ""
);
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "UF, Inflación y Costo de Vida en Chile",
  description:
    "Guías y herramientas sobre UF, IPC, reajuste de arriendo y costo de vida en Chile.",
  url: `${SITE_BASE}/guias/uf-costo-de-vida/`,
  numberOfItems: 7,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "UF en simple: qué es, por qué sube todos los días y cómo te afecta",
      url: `${SITE_BASE}/posts/que-es-la-uf/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Qué es el IPC en Chile: cómo se calcula y por qué afecta tu bolsillo",
      url: `${SITE_BASE}/posts/que-es-el-ipc-chile-como-se-calcula/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Reajuste de arriendo en UF e IPC en Chile",
      url: `${SITE_BASE}/posts/reajuste-arriendo-uf-ipc-chile/`,
    },
    {
      "@type": "ListItem",
      position: 4,
      name: "Conversor UF a pesos",
      url: `${SITE_BASE}/calculadoras/conversor-uf/`,
    },
    {
      "@type": "ListItem",
      position: 5,
      name: "Calculadora de reajuste de arriendo",
      url: `${SITE_BASE}/calculadoras/reajuste-arriendo/`,
    },
    {
      "@type": "ListItem",
      position: 6,
      name: "Conversor UTM a pesos",
      url: `${SITE_BASE}/calculadoras/conversor-utm/`,
    },
    {
      "@type": "ListItem",
      position: 7,
      name: "Indicadores economicos de Chile",
      url: `${SITE_BASE}/guias/uf-costo-de-vida/indicadores-economicos/`,
    },
  ],
};

const hubAssignments = getHubArticleAssignments("uf-costo-de-vida");
const { parameters } = await getEconomicParameters();

const contextualIndicators = [
  {
    code: "UF",
    title: "Unidad de Fomento",
    value: fmt(parameters.uf),
    date: fmtFecha(resolveEconomicIndicatorDate(parameters, "uf")),
    why: "Es la referencia principal en arriendos, dividendos y contratos reajustables.",
  },
  {
    code: "IPC",
    title: "Indice de Precios al Consumidor",
    value: `${parameters.ipc.toLocaleString("es-CL", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    })}%`,
    date: fmtFecha(resolveEconomicIndicatorDate(parameters, "ipc")),
    why: "Explica la inflacion del periodo y el contexto de los reajustes de bolsillo.",
  },
];

const tools = [
  {
    title: "Indicadores economicos de Chile",
    description:
      "Consulta en un solo lugar UF, UTM, dolar, IPC y TMC con fecha de referencia y contexto de uso.",
    href: getPath("/guias/uf-costo-de-vida/indicadores-economicos/"),
    cta: "Ver indicadores",
  },
  {
    title: "Conversor UF a pesos",
    description:
      "Úsalo cuando ya entendiste la lógica de la UF y necesitas pasar un monto a CLP o volver de pesos a UF con valor de referencia.",
    href: getPath("/calculadoras/conversor-uf/"),
    cta: "Convertir UF a pesos",
  },
  {
    title: "Calculadora de reajuste de arriendo",
    description:
      "Sirve para aterrizar una cláusula en UF, IPC o pesos fijos y estimar cuánto cambia realmente tu pago mensual.",
    href: getPath("/calculadoras/reajuste-arriendo/"),
    cta: "Calcular reajuste",
  },
  {
    title: "Conversor UTM a pesos",
    description:
      "Úsalo para traducir multas, trámites e impuestos expresados en UTM al valor en pesos del mes vigente.",
    href: getPath("/calculadoras/conversor-utm/"),
    cta: "Convertir UTM a pesos",
  },
];

const relatedBridges = [
  {
    title: "Deuda y crédito",
    description:
      "Cruza a esta sección solo cuando la duda principal ya no es inflación o bolsillo, sino el costo total de una obligación financiera reajustable.",
    href: getPath("/guias/deuda-credito/"),
  },
];
---

<Layout
  title="UF, inflación y costo de vida en Chile | Monedario"
  description="Guía temática para entender cómo se conectan UF, IPC, reajustes y herramientas prácticas de costo de vida en Chile."
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(itemListSchema)}
  />
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout">
    <section class="border-b border-border py-8">
      <p
        class="mb-2 text-xs font-semibold tracking-widest text-accent uppercase"
      >
        Guía temática
      </p>
      <h1 class="mb-4 text-3xl font-bold sm:text-4xl">
        UF, inflación y costo de vida en Chile
      </h1>
    </section>

    <section class="py-4">
      <ResumeWidget />
    </section>

    <section class="border-b border-border py-8">
      <div
        class="mb-4 flex flex-col gap-2 md:flex-row md:items-end md:justify-between"
      >
        <div>
          <h2 class="text-2xl font-bold">Dato clave hoy para costo de vida</h2>
          <p class="mt-1 max-w-3xl text-sm text-secondary">
            Aqui solo ves los indicadores que realmente mueven reajustes y costo
            de vida. Para la vista completa, revisa la pagina pilar.
          </p>
        </div>
        <a
          href={getPath("/guias/uf-costo-de-vida/indicadores-economicos/")}
          class="inline-flex text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
        >
          Ver todos los indicadores
        </a>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        {
          contextualIndicators.map(item => (
            <article class="rounded-2xl border border-border bg-surface-muted p-5">
              <p class="mb-2 text-xs font-semibold tracking-[0.14em] text-accent uppercase">
                {item.code}
              </p>
              <h3 class="text-lg font-semibold">{item.title}</h3>
              <p class="mt-2 text-2xl font-bold text-foreground tabular-nums">
                {item.value}
              </p>
              <p class="mt-1 text-xs text-secondary">Referencia: {item.date}</p>
              <p class="mt-3 text-sm leading-relaxed text-secondary">
                {item.why}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Ruta principal</h2>
      <ul class="grid gap-4">
        {
          hubAssignments.core.map(
            (item: (typeof hubAssignments.core)[number]) => (
              <li class="rounded-xl border border-border p-5">
                <p class="mb-2 text-xs font-semibold tracking-wide text-accent uppercase">
                  Guía base
                </p>
                <h3 class="mb-2 text-lg font-semibold">{item.title}</h3>
                <p class="mb-3 text-sm text-secondary">{item.summary}</p>
                <a
                  href={getPath(item.href)}
                  class="text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
                >
                  Ir a esta guía
                </a>
              </li>
            )
          )
        }
      </ul>
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">
        Herramientas para pasar del concepto al número
      </h2>
      <div class="grid gap-4 md:grid-cols-2">
        {
          tools.map(tool => (
            <article class="rounded-xl border border-border p-5">
              <p class="mb-2 text-xs font-semibold tracking-wide text-accent uppercase">
                Herramienta
              </p>
              <h3 class="text-lg font-semibold">{tool.title}</h3>
              <p class="mt-2 text-sm text-secondary">{tool.description}</p>
              <a
                href={tool.href}
                class="mt-4 inline-flex text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
              >
                {tool.cta}
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <StartHere
      steps={[
        {
          step: 1,
          title: "Indicadores economicos de Chile",
          description:
            "Empieza por una referencia rapida con fechas y contexto practico.",
          href: "/guias/uf-costo-de-vida/indicadores-economicos/",
        },
        {
          step: 2,
          title: "¿Qué es la UF y cómo se calcula?",
          description:
            "Por qué cambia cada día y cómo afecta deudas y contratos.",
          href: "/posts/que-es-la-uf/",
        },
        {
          step: 3,
          title: "¿Qué es el IPC y cómo se calcula?",
          description: "Cómo mide la inflación el INE y qué canasta incluye.",
          href: "/posts/que-es-el-ipc-chile-como-se-calcula/",
        },
        {
          step: 4,
          title: "Reajuste de arriendo: UF, IPC y cómo calcular",
          description:
            "Interpreta la cláusula de tu contrato y estima el nuevo canon.",
          href: "/posts/reajuste-arriendo-uf-ipc-chile/",
        },
        {
          step: 5,
          title: "Conversor UF",
          description:
            "Convierte entre UF y pesos en tiempo real con el valor oficial del día.",
          href: "/calculadoras/conversor-uf/",
        },
        {
          step: 6,
          title: "Conversor UTM",
          description:
            "Pasa de UTM a pesos para multas, aranceles y referencias tributarias.",
          href: "/calculadoras/conversor-utm/",
        },
      ]}
    />

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Secuencia recomendada</h2>
      <ul class="list-disc space-y-2 pl-6 text-secondary">
        <li>
          Parte por UF si no entiendes por qué un monto reajustable cambia mes a
          mes.
        </li>
        <li>
          Pasa a IPC cuando la duda real es de dónde viene ese reajuste y qué
          mide inflación.
        </li>
        <li>
          Termina en arriendo o herramientas solo cuando ya necesitas traducir
          la teoría a un contrato o pago real.
        </li>
      </ul>
    </section>

    <section class="border-b border-border py-8">
      <h2 class="mb-4 text-2xl font-bold">Relacionado</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {
          relatedBridges.map(item => (
            <article class="rounded-xl border border-border p-5">
              <h3 class="text-lg font-semibold">{item.title}</h3>
              <p class="mt-2 text-sm text-secondary">{item.description}</p>
              <a
                href={item.href}
                class="mt-4 inline-flex text-sm font-semibold text-accent underline underline-offset-4 hover:opacity-80"
              >
                Ver {item.title}
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="py-8">
      <div class="rounded-xl border border-accent/20 bg-accent/5 p-6">
        <h2 class="mb-2 text-xl font-bold">
          Última actualización de la sección
        </h2>
        <p class="text-sm text-secondary">
          Actualizado: 2026-03-12. Esta sección se revisa cuando cambian la
          metodología de la UF o del IPC, aparece una herramienta nueva o se
          publica una guía que ayuda a resolver mejor una duda práctica.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
