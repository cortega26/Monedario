{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.mjs",
    "workers/**/*.{ts,mjs}",
    "src/data/**/*.{md,mdx}"
  ],
  "project": ["src/**/*.{astro,ts,tsx,js,mjs}", "scripts/**/*.mjs"],
  "ignore": [
    "src/dev-pages/**",
    "src/scripts/**",
    "src/tools/**",
    "src/components/IndicadorEconomico.astro"
  ],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "off",
    "unresolved": "off",
    "binaries": "off",
    "exports": "error",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "off",
    "duplicates": "off"
  },
  "ignoreExportsUsedInFile": {
    "variable": true
  },
  "ignoreIssues": {
    "src/config/tagHubMap.ts": ["exports"],
    "src/config/editorial-topic-policy.mjs": ["exports"],
    "src/application/use-cases/shared/retirementEmployerContributionSchedule.ts": ["exports"],
    "src/utils/analytics.ts": ["exports"],
    "src/utils/indicadores.ts": ["exports"],
    "src/utils/resumeState.ts": ["exports"],
    "src/infrastructure/economic/EconomicParameterProvider.ts": ["exports"]
  },
  "ignoreDependencies": [
    "tailwindcss",
    "@tailwindcss/typography",
    "@axe-core/playwright",
    "@typescript-eslint/parser"
  ]
}
